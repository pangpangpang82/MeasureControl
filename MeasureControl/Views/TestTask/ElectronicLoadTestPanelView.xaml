<UserControl
    x:Class="MeasureControl.Views.TestTask.ElectronicLoadTestPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:MeasureControl.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="550"
    d:DesignWidth="970"
    Background="White"
    mc:Ignorable="d">

    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />

        <Style x:Key="ReadbackValueBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#D9D9D9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ToggleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="70" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="BorderBrush" Value="#d1d5db" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#3b82f6" />
                    <Setter Property="BorderBrush" Value="#2563eb" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="7*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="8,8,8,4"
            BorderBrush="#D9D9D9"
            BorderThickness="1.5"
            CornerRadius="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="22"
                    FontWeight="Bold"
                    Text="Chroma 6310A 电子负载" />

                <TextBlock
                    Margin="50,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="20"
                    Text="VISA资源：" />
                <Border
                    Width="200"
                    Height="32"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    BorderBrush="#D9D9D9"
                    BorderThickness="1"
                    CornerRadius="3">
                    <TextBox
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        FontSize="18"
                        Text="{Binding VisaResource, UpdateSourceTrigger=PropertyChanged}" />
                </Border>

                <StackPanel Margin="20,0,0,0" Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="20"
                        Text="连接状态：" />
                    <Grid Width="18" Height="18">
                        <Ellipse
                            Width="18"
                            Height="18"
                            Stroke="#d1d5db"
                            StrokeThickness="0.5" />
                        <Ellipse
                            Width="16"
                            Height="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill">
                                        <Setter.Value>
                                            <RadialGradientBrush GradientOrigin="0.3,0.3">
                                                <GradientStop Offset="0" Color="#ff6b6b" />
                                                <GradientStop Offset="1" Color="#b91c1c" />
                                            </RadialGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsElectronicLoadConnected}" Value="True">
                                            <Setter Property="Fill">
                                                <Setter.Value>
                                                    <RadialGradientBrush GradientOrigin="0.3,0.3">
                                                        <GradientStop Offset="0" Color="#4ade80" />
                                                        <GradientStop Offset="1" Color="#16a34a" />
                                                    </RadialGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="18"
                        Text="{Binding ConnectionStatus}" />
                </StackPanel>

                <Border Margin="20,0,0,0">
                    <Button
                        Width="110"
                        Height="36"
                        Margin="10,0,5,0"
                        Background="#3b82f6"
                        BorderThickness="0"
                        Command="{Binding ToggleDeviceCommand}"
                        FontSize="16">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4">
                                    <TextBlock
                                        x:Name="DeviceAction"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Text="连接仪表" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsElectronicLoadConnected}" Value="True">
                                        <Setter Property="Tag" Value="True" />
                                        <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                        <Setter TargetName="DeviceAction" Property="Text" Value="断开仪表" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsElectronicLoadConnected}" Value="False">
                                        <Setter Property="Tag" Value="False" />
                                    </DataTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="False" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                    </MultiTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="False" />
                                            <Condition Property="IsPressed" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                    </MultiTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="True" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                    </MultiTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="True" />
                                            <Condition Property="IsPressed" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>
            </StackPanel>
        </Border>

        <Border
            Grid.Row="1"
            Margin="8,4,8,8"
            BorderBrush="#D9D9D9"
            BorderThickness="1.5"
            CornerRadius="8">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="54" />
                    <RowDefinition Height="54" />
                    <RowDefinition Height="54" />
                    <RowDefinition Height="54" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="105" />
                    <ColumnDefinition Width="105" />
                    <ColumnDefinition Width="105" />
                    <ColumnDefinition Width="85" />
                    <ColumnDefinition Width="85" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Row="0"
                    Grid.ColumnSpan="9"
                    Margin="0,0,-31,0"
                    Background="#f3f4f6"
                    CornerRadius="6" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="通道" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="模式" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="设定值" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="范围" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="V_Read" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="I_Read" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="P_Read" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="7"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Load" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Short" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Text="CH1" />
                <ComboBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Height="30"
                    Margin="6"
                    ItemsSource="{Binding ModeOptions}"
                    SelectedItem="{Binding Ch1Mode, UpdateSourceTrigger=PropertyChanged}" />
                <Border
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="6"
                    Style="{StaticResource ReadbackValueBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.7*" />
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            Margin="6,0,6,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            FontSize="16"
                            Text="{Binding Ch1SetValue, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="{Binding Ch1SetUnit}" />
                        <Button
                            Grid.Column="2"
                            Width="40"
                            Height="24"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Command="{Binding ApplySetValueCommand}"
                            CommandParameter="1"
                            Content="设定"
                            FontSize="16" />
                    </Grid>
                </Border>
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="3"
                    Margin="6,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Text="{Binding Ch1RangeText}"
                    TextAlignment="Center" />
                <Border
                    Grid.Row="1"
                    Grid.Column="4"
                    Margin="6"
                    Style="{StaticResource ReadbackValueBorderStyle}">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="{Binding Ch1MeasVoltage}" />
                </Border>
                <Border
                    Grid.Row="1"
                    Grid.Column="5"
                    Margin="6"
                    Style="{StaticResource ReadbackValueBorderStyle}">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="{Binding Ch1MeasCurrent}" />
                </Border>
                <Border
                    Grid.Row="1"
                    Grid.Column="6"
                    Margin="6"
                    Style="{StaticResource ReadbackValueBorderStyle}">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="{Binding Ch1MeasPower}" />
                </Border>
                <Button
                    Grid.Row="1"
                    Grid.Column="7"
                    Command="{Binding ToggleLoadCommand}"
                    CommandParameter="1"
                    Content="{Binding Ch1LoadText}"
                    Style="{StaticResource ToggleButtonStyle}"
                    Tag="{Binding Ch1LoadOn}" />
                <Button
                    Grid.Row="1"
                    Grid.Column="8"
                    Command="{Binding ToggleShortCommand}"
                    CommandParameter="1"
                    Content="{Binding Ch1ShortText}"
                    IsEnabled="{Binding Ch1LoadOn}"
                    Style="{StaticResource ToggleButtonStyle}"
                    Tag="{Binding Ch1ShortOn}" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Text="CH2" />
                <ComboBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Height="30"
                    Margin="6"
                    ItemsSource="{Binding ModeOptions}"
                    SelectedItem="{Binding Ch2Mode, UpdateSourceTrigger=PropertyChanged}" />
                <Border
                    Grid.Row="2"
                    Grid.Column="2"
                    Margin="6"
                    Style="{StaticResource ReadbackValueBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.7*" />
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            Margin="6,0,6,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            FontSize="16"
                            Text="{Binding Ch2SetValue, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="{Binding Ch2SetUnit}" />
                        <Button
                            Grid.Column="2"
                            Width="40"
                            Height="24"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Command="{Binding ApplySetValueCommand}"
                            CommandParameter="2"
                            Content="设定"
                            FontSize="16" />
                    </Grid>
                </Border>
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="3"
                    Margin="6,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Text="{Binding Ch2RangeText}"
                    TextAlignment="Center" />
                <Border
                    Grid.Row="2"
                    Grid.Column="4"
                    Margin="6"
                    Style="{StaticResource ReadbackValueBorderStyle}">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="{Binding Ch2MeasVoltage}" />
                </Border>
                <Border
                    Grid.Row="2"
                    Grid.Column="5"
                    Margin="6"
                    Style="{StaticResource ReadbackValueBorderStyle}">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="{Binding Ch2MeasCurrent}" />
                </Border>
                <Border
                    Grid.Row="2"
                    Grid.Column="6"
                    Margin="6"
                    Style="{StaticResource ReadbackValueBorderStyle}">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="{Binding Ch2MeasPower}" />
                </Border>
                <Button
                    Grid.Row="2"
                    Grid.Column="7"
                    Command="{Binding ToggleLoadCommand}"
                    CommandParameter="2"
                    Content="{Binding Ch2LoadText}"
                    Style="{StaticResource ToggleButtonStyle}"
                    Tag="{Binding Ch2LoadOn}" />
                <Button
                    Grid.Row="2"
                    Grid.Column="8"
                    Command="{Binding ToggleShortCommand}"
                    CommandParameter="2"
                    Content="{Binding Ch2ShortText}"
                    IsEnabled="{Binding Ch2LoadOn}"
                    Style="{StaticResource ToggleButtonStyle}"
                    Tag="{Binding Ch2ShortOn}" />

                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Text="CH3" />
                <ComboBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Height="30"
                    Margin="6"
                    ItemsSource="{Binding ModeOptions}"
                    SelectedItem="{Binding Ch3Mode, UpdateSourceTrigger=PropertyChanged}" />
                <Border
                    Grid.Row="3"
                    Grid.Column="2"
                    Margin="6"
                    Style="{StaticResource ReadbackValueBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.7*" />
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            Margin="6,0,6,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            FontSize="16"
                            Text="{Binding Ch3SetValue, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="{Binding Ch3SetUnit}" />
                        <Button
                            Grid.Column="2"
                            Width="40"
                            Height="24"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Command="{Binding ApplySetValueCommand}"
                            CommandParameter="3"
                            Content="设定"
                            FontSize="16" />
                    </Grid>
                </Border>
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="3"
                    Margin="6,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Text="{Binding Ch3RangeText}"
                    TextAlignment="Center" />
                <Border
                    Grid.Row="3"
                    Grid.Column="4"
                    Margin="6"
                    Style="{StaticResource ReadbackValueBorderStyle}">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="{Binding Ch3MeasVoltage}" />
                </Border>
                <Border
                    Grid.Row="3"
                    Grid.Column="5"
                    Margin="6"
                    Style="{StaticResource ReadbackValueBorderStyle}">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="{Binding Ch3MeasCurrent}" />
                </Border>
                <Border
                    Grid.Row="3"
                    Grid.Column="6"
                    Margin="6"
                    Style="{StaticResource ReadbackValueBorderStyle}">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="{Binding Ch3MeasPower}" />
                </Border>
                <Button
                    Grid.Row="3"
                    Grid.Column="7"
                    Command="{Binding ToggleLoadCommand}"
                    CommandParameter="3"
                    Content="{Binding Ch3LoadText}"
                    Style="{StaticResource ToggleButtonStyle}"
                    Tag="{Binding Ch3LoadOn}" />
                <Button
                    Grid.Row="3"
                    Grid.Column="8"
                    Command="{Binding ToggleShortCommand}"
                    CommandParameter="3"
                    Content="{Binding Ch3ShortText}"
                    IsEnabled="{Binding Ch3LoadOn}"
                    Style="{StaticResource ToggleButtonStyle}"
                    Tag="{Binding Ch3ShortOn}" />

                <TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Text="CH4" />
                <ComboBox
                    Grid.Row="4"
                    Grid.Column="1"
                    Height="30"
                    Margin="6"
                    ItemsSource="{Binding ModeOptions}"
                    SelectedItem="{Binding Ch4Mode, UpdateSourceTrigger=PropertyChanged}" />
                <Border
                    Grid.Row="4"
                    Grid.Column="2"
                    Margin="6"
                    Style="{StaticResource ReadbackValueBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.7*" />
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            Margin="6,0,6,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            FontSize="16"
                            Text="{Binding Ch4SetValue, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="{Binding Ch4SetUnit}" />
                        <Button
                            Grid.Column="2"
                            Width="40"
                            Height="24"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Command="{Binding ApplySetValueCommand}"
                            CommandParameter="4"
                            Content="设定"
                            FontSize="16" />
                    </Grid>
                </Border>
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="3"
                    Margin="6,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Text="{Binding Ch4RangeText}"
                    TextAlignment="Center" />
                <Border
                    Grid.Row="4"
                    Grid.Column="4"
                    Margin="6"
                    Style="{StaticResource ReadbackValueBorderStyle}">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="{Binding Ch4MeasVoltage}" />
                </Border>
                <Border
                    Grid.Row="4"
                    Grid.Column="5"
                    Margin="6"
                    Style="{StaticResource ReadbackValueBorderStyle}">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="{Binding Ch4MeasCurrent}" />
                </Border>
                <Border
                    Grid.Row="4"
                    Grid.Column="6"
                    Margin="6"
                    Style="{StaticResource ReadbackValueBorderStyle}">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="{Binding Ch4MeasPower}" />
                </Border>
                <Button
                    Grid.Row="4"
                    Grid.Column="7"
                    Command="{Binding ToggleLoadCommand}"
                    CommandParameter="4"
                    Content="{Binding Ch4LoadText}"
                    Style="{StaticResource ToggleButtonStyle}"
                    Tag="{Binding Ch4LoadOn}" />
                <Button
                    Grid.Row="4"
                    Grid.Column="8"
                    Command="{Binding ToggleShortCommand}"
                    CommandParameter="4"
                    Content="{Binding Ch4ShortText}"
                    IsEnabled="{Binding Ch4LoadOn}"
                    Style="{StaticResource ToggleButtonStyle}"
                    Tag="{Binding Ch4ShortOn}" />

                <Border
                    Grid.Row="5"
                    Grid.ColumnSpan="9"
                    Margin="0,0,-61,0"
                    BorderBrush="#e5e7eb"
                    BorderThickness="0,1,0,0" />
                <StackPanel
                    Grid.Row="5"
                    Grid.ColumnSpan="9"
                    Margin="0,8,0,0"
                    VerticalAlignment="Top"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="设备信息：" />
                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="{Binding DeviceIdn}" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
