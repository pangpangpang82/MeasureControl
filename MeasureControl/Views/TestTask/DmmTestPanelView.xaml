                                                    <Setter TargetName="border" Property="Background" Value="#FFC4E5FF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Border>
                            <Border
                                Grid.Row="4"
                                Grid.Column="0"
                                Width="100"
                                Height="70"
                                Margin="0,0,0,12"
                                Background="White"
                                BorderBrush="#D9D9D9"
                                BorderThickness="2"
                                CornerRadius="8">
                                <Button
                                    Command="{Binding SetModeCommand}"
                                    CommandParameter="FREQ"
                                    Content="频率"
                                    FontSize="18">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="border"
                                                Padding="{TemplateBinding Padding}"
                                                Background="White"
                                                BorderBrush="White"
                                                BorderThickness="0"
                                                CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding SelectedModeText, Converter={StaticResource StringToBoolConverter}, ConverterParameter=FREQ}" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FFBEE6FD" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FFBEE6FD" />
                                                </Trigger>
