                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding SelectedModeText, Converter={StaticResource StringToBoolConverter}, ConverterParameter=ACV}" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FFBEE6FD" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FFBEE6FD" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FFC4E5FF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Border>
                            <Border
                                Grid.Row="1"
                                Grid.Column="0"
                                Width="100"
                                Height="70"
                                Margin="0,0,0,12"
                                Background="White"
                                BorderBrush="#D9D9D9"
                                BorderThickness="2"
                                CornerRadius="8">
                                <Button
                                    Command="{Binding SetModeCommand}"
                                    CommandParameter="DCI"
                                    Content="直流电流"
                                    FontSize="18">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="border"
                                                Padding="{TemplateBinding Padding}"
                                                Background="White"
                                                BorderBrush="White"
                                                BorderThickness="0"
                                                CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding SelectedModeText, Converter={StaticResource StringToBoolConverter}, ConverterParameter=DCI}" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FFBEE6FD" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FFBEE6FD" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FFC4E5FF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Border>
                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                Width="100"
                                Height="70"
                                Margin="0,0,0,12"
                                Background="White"
                                BorderBrush="#D9D9D9"
                                BorderThickness="2"
                                CornerRadius="8">
                                <Button
                                    Command="{Binding SetModeCommand}"
                                    CommandParameter="ACI"
                                    Content="交流电流"
                                    FontSize="18">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="border"
                                                Padding="{TemplateBinding Padding}"
                                                Background="White"
                                                BorderBrush="White"
                                                BorderThickness="0"
                                                CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding SelectedModeText, Converter={StaticResource StringToBoolConverter}, ConverterParameter=ACI}" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FFBEE6FD" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FFBEE6FD" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FFC4E5FF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Border>
                            <Border
                                Grid.Row="2"
                                Grid.Column="0"
                                Width="100"
                                Height="70"
                                Margin="0,0,0,12"
                                Background="White"
                                BorderBrush="#D9D9D9"
                                BorderThickness="2"
                                CornerRadius="8">
                                <Button
                                    Command="{Binding SetModeCommand}"
                                    CommandParameter="RES"
                                    Content="电阻"
                                    FontSize="18">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="border"
                                                Padding="{TemplateBinding Padding}"
                                                Background="White"
                                                BorderBrush="White"
                                                BorderThickness="0"
                                                CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding SelectedModeText, Converter={StaticResource StringToBoolConverter}, ConverterParameter=RES}" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FFBEE6FD" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FFBEE6FD" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FFC4E5FF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Border>
                            <Border
                                Grid.Row="2"
                                Grid.Column="1"
                                Width="100"
                                Height="70"
                                Margin="0,0,0,12"
                                Background="White"
                                BorderBrush="#D9D9D9"
                                BorderThickness="2"
                                CornerRadius="8">
                                <Button
                                    Command="{Binding SetModeCommand}"
                                    CommandParameter="CAP"
                                    Content="电容"
                                    FontSize="18">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="border"
                                                Padding="{TemplateBinding Padding}"
                                                Background="White"
                                                BorderBrush="White"
                                                BorderThickness="0"
                                                CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding SelectedModeText, Converter={StaticResource StringToBoolConverter}, ConverterParameter=CAP}" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FFBEE6FD" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FFBEE6FD" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FFC4E5FF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Border>
                            <Border
                                Grid.Row="3"
                                Grid.Column="0"
                                Width="100"
                                Height="70"
                                Margin="0,0,0,12"
                                Background="White"
                                BorderBrush="#D9D9D9"
                                BorderThickness="2"
                                CornerRadius="8">
                                <Button
                                    Command="{Binding SetModeCommand}"
                                    CommandParameter="CONT"
                                    Content="通断"
                                    FontSize="18">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="border"
                                                Padding="{TemplateBinding Padding}"
                                                Background="White"
                                                BorderBrush="White"
                                                BorderThickness="0"
                                                CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding SelectedModeText, Converter={StaticResource StringToBoolConverter}, ConverterParameter=CONT}" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FFBEE6FD" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FFBEE6FD" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FFC4E5FF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Border>
                            <Border
                                Grid.Row="3"
                                Grid.Column="1"
                                Width="100"
                                Height="70"
                                Margin="0,0,0,12"
                                Background="White"
                                BorderBrush="#D9D9D9"
                                BorderThickness="2"
                                CornerRadius="8">
                                <Button
                                    Command="{Binding SetModeCommand}"
                                    CommandParameter="DIODE"
                                    Content="二极管"
                                    FontSize="18">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="border"
                                                Padding="{TemplateBinding Padding}"
                                                Background="White"
                                                BorderBrush="White"
                                                BorderThickness="0"
                                                CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding SelectedModeText, Converter={StaticResource StringToBoolConverter}, ConverterParameter=DIODE}" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FFBEE6FD" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FFBEE6FD" />
                                                </Trigger>
