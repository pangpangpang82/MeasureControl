                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Border>
                            <Border
                                Grid.Row="4"
                                Grid.Column="1"
                                Width="100"
                                Height="70"
                                Margin="0,0,0,12"
                                Background="White"
                                BorderBrush="#D9D9D9"
                                BorderThickness="2"
                                CornerRadius="8">
                                <Button Content="占位符" FontSize="18">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="border"
                                                Padding="{TemplateBinding Padding}"
                                                Background="White"
                                                BorderBrush="White"
                                                BorderThickness="0"
                                                CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FFBEE6FD" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FFC4E5FF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Margin="4,4,8,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="2*" />
                        </Grid.RowDefinitions>
                        <Border
                            Grid.Row="0"
                            Margin="0,0,0,4"
                            BorderBrush="#D9D9D9"
                            BorderThickness="1.5"
                            CornerRadius="8">
                            <StackPanel>
                                <TextBlock
                                    Margin="10"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Text="测量结果" />
                                <TextBlock
                                    Height="85"
                                    HorizontalAlignment="Center"
                                    FontSize="48"
                                    FontWeight="Bold"
                                    Text="{Binding MeasurementResult}" />
                            </StackPanel>
                        </Border>
                        <Border
                            Grid.Row="1"
                            Margin="0,4,0,0"
                            BorderBrush="#D9D9D9"
                            BorderThickness="1.5"
                            CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="5*" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    Margin="10"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Text="历史数据" />
                                <Border
                                    Grid.Row="1"
                                    Margin="10,0,10,10"
                                    Background="White"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="1.5">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="7*" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="3*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            Text="时间" />
                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            Text="数据" />
                                        <Border
                                            Grid.RowSpan="2"
                                            Grid.Column="0"
                                            Width="1"
                                            HorizontalAlignment="Right"
                                            Background="#D9D9D9" />
                                        <Border
                                            Grid.Row="0"
                                            Grid.ColumnSpan="2"
                                            Height="1"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Bottom"
                                            Background="#D9D9D9" />

                                        <ScrollViewer
                                            Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            HorizontalScrollBarVisibility="Disabled"
                                            Style="{StaticResource SimpleScrollViewerStyle}"
                                            VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding HistoryItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#D9D9D9" BorderThickness="0,0,0,1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="1.5*" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    Grid.Column="0"
                                                                    Margin="0,6"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="18"
                                                                    Text="{Binding TimeText}" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Margin="0,6"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="18"
                                                                    Text="{Binding ValueText}" />
                                                                <Border
                                                                    Grid.Column="0"
                                                                    Width="1"
                                                                    HorizontalAlignment="Right"
                                                                    Background="#D9D9D9" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>

                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>

</UserControl>

