<UserControl
    x:Class="MeasureControl.Views.ConfigTabel.ChannelConfigTabel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:MeasureControl.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="800"
    d:DesignWidth="1500"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <helpers:EmptyStringToVisibilityConverter x:Key="EmptyToVisibility" />
        <helpers:ChannelIndexDisplayConverter x:Key="ChannelIndexDisplayConverter" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#eaeaea" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#d0d0d0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <helpers:LevelToIndentConverter x:Key="LevelToIndentConverter" />
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <helpers:BoolToExpansionIconConverter x:Key="BoolToExpansionIconConverter" />
        <helpers:BoolToTreeArrowConverter x:Key="BoolToTreeArrowConverter" />
        <helpers:StringToBrushConverter x:Key="StringToBrushConverter" />
        <helpers:ModelDisplayConverter x:Key="ModelDisplayConverter" />
        <helpers:DeviceTypeToBackgroundConverter x:Key="DeviceTypeToBackgroundConverter" />
        <helpers:DeviceTypeToHoverBackgroundConverter x:Key="DeviceTypeToHoverBackgroundConverter" />

        <!--  分页按钮样式  -->
        <Style x:Key="PaginationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DADDE2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--  鼠标悬停效果  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#e0e0e0" />
                            </Trigger>
                            <!--  按下效果  -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#c0c0c0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  激活状态的分页按钮样式（蓝色）  -->
        <Style x:Key="ActivePaginationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3b82f6" />
            <Setter Property="BorderBrush" Value="#3b82f6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--  鼠标悬停效果 - 蓝色变深  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2563eb" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#2563eb" />
                            </Trigger>
                            <!--  按下效果 - 更深的蓝色  -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1d4ed8" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#1d4ed8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  操作列按钮样式（无边框，高亮灰色）  -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ActionButtonBorder"
                            Width="25"
                            Height="25"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--  鼠标悬停效果  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionButtonBorder" Property="Background" Value="#e0e0e0" />
                            </Trigger>
                            <!--  按下效果  -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionButtonBorder" Property="Background" Value="#c0c0c0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  分页导航按钮样式（上一页/下一页，稍浅灰色高亮）  -->
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DADDE2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="NavButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--  鼠标悬停效果 - 稍浅灰色  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavButtonBorder" Property="Background" Value="#e0e0e0" />
                            </Trigger>
                            <!--  按下效果 - 稍浅灰色  -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavButtonBorder" Property="Background" Value="#c0c0c0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  简洁的滚动条样式  -->
        <Style x:Key="SimpleScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="Transparent" BorderThickness="0">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Background" Value="#CCCCCC" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border
                                                                Background="{TemplateBinding Background}"
                                                                BorderThickness="0"
                                                                CornerRadius="4" />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#999999" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter Property="Background" Value="#666666" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  简洁的ScrollViewer样式  -->
        <Style x:Key="SimpleScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />

                            <ScrollBar
                                x:Name="PART_VerticalScrollBar"
                                Grid.Row="0"
                                Grid.Column="1"
                                Maximum="{TemplateBinding ScrollableHeight}"
                                Orientation="Vertical"
                                Style="{StaticResource SimpleScrollBarStyle}"
                                ViewportSize="{TemplateBinding ViewportHeight}"
                                Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                Value="{TemplateBinding VerticalOffset}" />

                            <ScrollBar
                                x:Name="PART_HorizontalScrollBar"
                                Grid.Row="1"
                                Grid.Column="0"
                                Maximum="{TemplateBinding ScrollableWidth}"
                                Orientation="Horizontal"
                                Style="{StaticResource SimpleScrollBarStyle}"
                                ViewportSize="{TemplateBinding ViewportWidth}"
                                Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                Value="{TemplateBinding HorizontalOffset}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!--  左侧：原有的表格区域  -->
                <ColumnDefinition Width="Auto" />
                <!--  GridSplitter  -->
                <ColumnDefinition Width="250" />
                <!--  右侧：PXI通道树形区域  -->
            </Grid.ColumnDefinitions>

            <!--  左侧：原有的通道配置表格  -->
            <Border Grid.Column="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70*" />
                        <RowDefinition Height="29*" />
                    </Grid.RowDefinitions>
                    <Border x:Name="CenterRegion" Grid.Row="0">
                        <Border.Resources>
                            <!--  按钮样式定义在这里，这样浮动时也能保持样式  -->
                            <Style x:Key="TitleBarButtonStyle" TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="Border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#3d455d" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#4d556d" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Border.Resources>
                        <Grid Background="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="5*" />
                                <RowDefinition Height="97*" />
                            </Grid.RowDefinitions>
                            <Border
                                x:Name="line"
                                Grid.Row="0"
                                Background="#2d354d"
                                Cursor="Hand"
                                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                                <Grid>
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="White"
                                        Text="{Binding DisplayPath}" />
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Button Click="OnMinimizeButtonClick" Style="{StaticResource TitleBarButtonStyle}">
                                            <Image
                                                Width="30"
                                                Margin="0,0,5,0"
                                                Source="/Resources/Logo/min.png" />
                                        </Button>
                                        <Border Width="30" Margin="0,0,5,0">
                                            <Button Click="OnFloatButtonClick" Style="{StaticResource TitleBarButtonStyle}">
                                                <Image
                                                    x:Name="FloatImage"
                                                    Width="15"
                                                    Source="/Resources/Logo/float.png" />
                                            </Button>
                                        </Border>
                                        <Button Click="OnCloseButtonClick" Style="{StaticResource TitleBarButtonStyle}">
                                            <Image Margin="0,0,5,0" Source="/Resources/Logo/close.png" />
                                        </Button>
                                    </StackPanel>

                                </Grid>
                            </Border>

                            <Border Grid.Row="1">
                                <Grid Background="White">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="{Binding ElementName=line, Path=ActualHeight}" />
                                        <RowDefinition Height="15*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border
                                        Grid.Row="0"
                                        Background="#cccccc"
                                        BorderBrush="Black"
                                        BorderThickness="0,0,0,1">
                                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                            <Button Margin="15,0,0,0" Command="{Binding AddChannelCommand}">
                                                <Border Padding="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition />
                                                            <ColumnDefinition />
                                                        </Grid.ColumnDefinitions>
                                                        <Image
                                                            Width="15"
                                                            VerticalAlignment="Center"
                                                            Source="/Resources/Logo/add_b.png" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="5,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="14"
                                                            Text="新增通道" />
                                                    </Grid>
                                                </Border>
                                            </Button>

                                            <Button Margin="15,0,0,0" Command="{Binding ConnectChassisCommand}">
                                                <Border Padding="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition />
                                                            <ColumnDefinition />
                                                        </Grid.ColumnDefinitions>
                                                        <Image
                                                            Grid.Column="0"
                                                            Width="18"
                                                            VerticalAlignment="Center"
                                                            Source="/Resources/Logo/search_b.png" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="5,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="14"
                                                            Text="查找" />
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1">
                                        <Border
                                            Background="Black"
                                            BorderBrush="#D9D9D9"
                                            BorderThickness="1.5">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="16*" />
                                                </Grid.RowDefinitions>

                                                <Border
                                                    Grid.Row="0"
                                                    Background="#f5f5f5"
                                                    BorderBrush="#D9D9D9"
                                                    BorderThickness="0,0,0,1.5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="2.2*" />
                                                            <ColumnDefinition Width="2.8*" />
                                                            <ColumnDefinition Width="4.2*" />
                                                            <ColumnDefinition Width="1.6*" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border>
                                                            <TextBlock
                                                                Grid.Column="0"
                                                                Margin="15,0,0,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="14"
                                                                Foreground="Black"
                                                                Text="序号" />
                                                        </Border>
                                                        <Border Grid.Column="1">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock
                                                                    Margin="30,0,5,0"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="14"
                                                                    Foreground="Black"
                                                                    Text="通道名称" />
                                                                <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                                                                    <Button
                                                                        Height="8"
                                                                        Background="Transparent"
                                                                        FontSize="7"
                                                                        Foreground="#a0a7b3">
                                                                        <Button.Content>
                                                                            <TextBlock VerticalAlignment="Center" Text="▲" />
                                                                        </Button.Content>
                                                                        <Button.LayoutTransform>
                                                                            <ScaleTransform ScaleX="1.5" />
                                                                        </Button.LayoutTransform>
                                                                    </Button>
                                                                    <Button
                                                                        Height="8"
                                                                        Background="Transparent"
                                                                        FontSize="7"
                                                                        Foreground="#a0a7b3">
                                                                        <Button.Content>
                                                                            <TextBlock VerticalAlignment="Center" Text="▼" />
                                                                        </Button.Content>
                                                                        <Button.LayoutTransform>
                                                                            <ScaleTransform ScaleX="1.5" />
                                                                        </Button.LayoutTransform>
                                                                    </Button>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Grid.Column="2">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock
                                                                    Margin="30,0,5,0"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="14"
                                                                    Foreground="Black"
                                                                    Text="物理通道" />
                                                                <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                                                                    <Button
                                                                        Height="8"
                                                                        Background="Transparent"
                                                                        FontSize="7"
                                                                        Foreground="#a0a7b3">
                                                                        <Button.Content>
                                                                            <TextBlock VerticalAlignment="Center" Text="▲" />
                                                                        </Button.Content>
                                                                        <Button.LayoutTransform>
                                                                            <ScaleTransform ScaleX="1.5" />
                                                                        </Button.LayoutTransform>
                                                                    </Button>
                                                                    <Button
                                                                        Height="8"
                                                                        Background="Transparent"
                                                                        FontSize="7"
                                                                        Foreground="#a0a7b3">
                                                                        <Button.Content>
                                                                            <TextBlock VerticalAlignment="Center" Text="▼" />
                                                                        </Button.Content>
                                                                        <Button.LayoutTransform>
                                                                            <ScaleTransform ScaleX="1.5" />
                                                                        </Button.LayoutTransform>
                                                                    </Button>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Grid.Column="3">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock
                                                                    Margin="30,0,5,0"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="14"
                                                                    Foreground="Black"
                                                                    Text="备注" />
                                                                <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                                                                    <Button
                                                                        Height="8"
                                                                        Background="Transparent"
                                                                        FontSize="7"
                                                                        Foreground="#a0a7b3">
                                                                        <Button.Content>
                                                                            <TextBlock VerticalAlignment="Center" Text="▲" />
                                                                        </Button.Content>
                                                                        <Button.LayoutTransform>
                                                                            <ScaleTransform ScaleX="1.5" />
                                                                        </Button.LayoutTransform>
                                                                    </Button>
                                                                    <Button
                                                                        Height="8"
                                                                        Background="Transparent"
                                                                        FontSize="7"
                                                                        Foreground="#a0a7b3">
                                                                        <Button.Content>
                                                                            <TextBlock VerticalAlignment="Center" Text="▼" />
                                                                        </Button.Content>
                                                                        <Button.LayoutTransform>
                                                                            <ScaleTransform ScaleX="1.5" />
                                                                        </Button.LayoutTransform>
                                                                    </Button>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Grid.Column="4">
                                                            <TextBlock
                                                                Margin="30,0,5,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="14"
                                                                Foreground="Black"
                                                                Text="操作" />
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <ItemsControl
                                                    Grid.Row="1"
                                                    Grid.RowSpan="14"
                                                    AlternationCount="14"
                                                    Background="white"
                                                    ItemsSource="{Binding PagedChannels}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="1.3*" />
                                                                    <RowDefinition Height="1.3*" />
                                                                    <RowDefinition Height="1.3*" />
                                                                    <RowDefinition Height="1.3*" />
                                                                    <RowDefinition Height="1.3*" />
                                                                    <RowDefinition Height="1.3*" />
                                                                    <RowDefinition Height="1.3*" />
                                                                    <RowDefinition Height="1.3*" />
                                                                    <RowDefinition Height="1.3*" />
                                                                    <RowDefinition Height="1.3*" />
                                                                    <RowDefinition Height="1.3*" />
                                                                    <RowDefinition Height="1.3*" />
                                                                    <RowDefinition Height="1.3*" />
                                                                    <RowDefinition Height="1.3*" />
                                                                </Grid.RowDefinitions>
                                                            </Grid>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Grid.Row" Value="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource Self}}" />
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border
                                                                Background="White"
                                                                BorderBrush="#D9D9D9"
                                                                BorderThickness="0,0,0,1.5">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                                                                                <Setter Property="BorderThickness" Value="0,1.5,0,1.5" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="1">
                                                                                <Setter Property="Background" Value="#f5f5f5" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="3">
                                                                                <Setter Property="Background" Value="#f5f5f5" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="5">
                                                                                <Setter Property="Background" Value="#f5f5f5" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="7">
                                                                                <Setter Property="Background" Value="#f5f5f5" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="9">
                                                                                <Setter Property="Background" Value="#f5f5f5" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="11">
                                                                                <Setter Property="Background" Value="#f5f5f5" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="13">
                                                                                <Setter Property="Background" Value="#f5f5f5" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid TextElement.FontSize="13">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="2.2*" />
                                                                        <ColumnDefinition Width="2.8*" />
                                                                        <ColumnDefinition Width="4.2*" />
                                                                        <ColumnDefinition Width="1.6*" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock
                                                                        Grid.Column="0"
                                                                        Margin="24,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="14"
                                                                        Foreground="Black">
                                                                        <TextBlock.Text>
                                                                            <MultiBinding Converter="{StaticResource ChannelIndexDisplayConverter}">
                                                                                <Binding Path="IsEmpty" />
                                                                                <Binding Path="Index" />
                                                                                <Binding Path="ChannelName" />
                                                                            </MultiBinding>
                                                                        </TextBlock.Text>
                                                                    </TextBlock>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                        <TextBlock
                                                                            Margin="30,0,5,0"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="14"
                                                                            Foreground="Black"
                                                                            Text="{Binding ChannelName, TargetNullValue=''}" />
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                                        <TextBlock
                                                                            Margin="30,0,5,0"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="14"
                                                                            Foreground="Black"
                                                                            Text="{Binding PhysicalChannel, TargetNullValue=''}" />
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                                        <TextBlock
                                                                            Margin="30,0,5,0"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="14"
                                                                            Foreground="Black"
                                                                            Text="{Binding Remarks, TargetNullValue=''}" />
                                                                    </StackPanel>

                                                                    <StackPanel
                                                                        Grid.Column="4"
                                                                        Margin="30,0,5,0"
                                                                        Orientation="Horizontal">
                                                                        <Button Command="{Binding DataContext.EditChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                                            <Button.Style>
                                                                                <Style BasedOn="{StaticResource ActionButtonStyle}" TargetType="Button">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding ChannelName}" Value="{x:Null}">
                                                                                            <Setter Property="Visibility" Value="Hidden" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding ChannelName}" Value="">
                                                                                            <Setter Property="Visibility" Value="Hidden" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Button.Style>
                                                                            <Image Width="20" Source="/Resources/Logo/modify_b.png" />
                                                                        </Button>
                                                                        <Button
                                                                            Margin="10,0,0,0"
                                                                            Command="{Binding DataContext.DeleteChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}">
                                                                            <Button.Style>
                                                                                <Style BasedOn="{StaticResource ActionButtonStyle}" TargetType="Button">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding ChannelName}" Value="{x:Null}">
                                                                                            <Setter Property="Visibility" Value="Hidden" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding ChannelName}" Value="">
                                                                                            <Setter Property="Visibility" Value="Hidden" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Button.Style>
                                                                            <Image Width="20" Source="/Resources/Logo/delete_b.png" />
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </Border>

                                    <Border
                                        Grid.Row="2"
                                        Background="#f9fafb"
                                        BorderBrush="#f0f1f3"
                                        BorderThickness="1">
                                        <Grid>
                                            <TextBlock
                                                x:Name="channel_num"
                                                Margin="20,0,0,0"
                                                VerticalAlignment="Center"
                                                Foreground="#8C939C"
                                                Text="{Binding PaginationInfo}" />

                                            <StackPanel
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Button
                                                    Width="50"
                                                    Height="25"
                                                    Margin="0,0,5,0"
                                                    Command="{Binding PreviousPageCommand}"
                                                    Style="{StaticResource NavigationButtonStyle}">
                                                    <TextBlock Foreground="Black" Text="上一页" />
                                                </Button>

                                                <ItemsControl ItemsSource="{Binding PageNumbers}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button
                                                                Width="25"
                                                                Height="25"
                                                                Margin="0,0,5,0"
                                                                Command="{Binding Command}">
                                                                <Button.Style>
                                                                    <Style BasedOn="{StaticResource PaginationButtonStyle}" TargetType="Button">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCurrentPage}" Value="True">
                                                                                <Setter Property="Background" Value="#3b82f6" />
                                                                                <Setter Property="BorderBrush" Value="#3b82f6" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <TextBlock Text="{Binding PageNumber}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="Black" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCurrentPage}" Value="True">
                                                                                    <Setter Property="Foreground" Value="White" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Button
                                                    Width="50"
                                                    Height="25"
                                                    Margin="0,0,50,0"
                                                    Command="{Binding NextPageCommand}"
                                                    Style="{StaticResource NavigationButtonStyle}">
                                                    <TextBlock Foreground="Black" Text="下一页" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                        </Grid>
                    </Border>

                    <GridSplitter
                        Grid.Row="0"
                        Height="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Background="#1c1c1c"
                        ShowsPreview="True" />

                    <Border Grid.Row="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="15*" />
                            </Grid.RowDefinitions>
                            <Border Background="#b2b2b2">
                                <TextBlock
                                    Grid.Row="0"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="常规" />
                            </Border>
                            <Border
                                Grid.Row="1"
                                Background="#ffffff"
                                BorderBrush="#1c1c1c"
                                BorderThickness="0,1.5,0,0">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="4*" />
                                        <RowDefinition Height="12*" />
                                        <RowDefinition Height="10*" />
                                        <RowDefinition Height="5*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel
                                        Grid.Row="0"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Image
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Source="/Resources/Logo/warning.png" />
                                        <TextBlock
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="Black"
                                            Text="暂无信息" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!--  GridSplitter  -->
            <GridSplitter
                Grid.Column="1"
                Width="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Background="#1c1c1c"
                ShowsPreview="True" />

            <!--  右侧：PXI通道树形结构  -->
            <Border Grid.Column="2" Background="#eaeaea">
                <TreeView
                    x:Name="ChannelTreeView"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding ChannelTreeRoot}">
                    <TreeView.Style>
                        <Style TargetType="TreeView">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TreeView">
                                        <Border
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                            <ScrollViewer
                                                Focusable="False"
                                                HorizontalScrollBarVisibility="Auto"
                                                Style="{StaticResource SimpleScrollViewerStyle}"
                                                VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TreeView.Style>
                    <TreeView.Resources>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <EventSetter Event="MouseDoubleClick" Handler="ChannelTreeViewItem_MouseDoubleClick" />
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ChannelTreeViewItem_PreviewMouseLeftButtonDown" />
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="Padding" Value="5,4,5,4" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type TreeViewItem}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <Border
                                                x:Name="Bd"
                                                Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                MouseLeftButtonUp="ChannelTreeViewItem_Border_MouseLeftButtonUp">
                                                <ContentPresenter
                                                    x:Name="PART_Header"
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    ContentSource="Header" />
                                            </Border>
                                            <ItemsPresenter
                                                x:Name="ItemsHost"
                                                Grid.Row="1"
                                                Margin="20,0,0,0" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger SourceName="PART_Header" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#d3e0ea" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#a8c6df" />
                                            </Trigger>
                                            <Trigger Property="IsExpanded" Value="True">
                                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger Property="IsExpanded" Value="False">
                                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TreeView.Resources>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Width="16"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe UI Symbol"
                                    FontSize="14"
                                    Foreground="#666666"
                                    Text="{Binding IsExpanded, Converter={StaticResource BoolToTreeArrowConverter}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Children.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="{Binding DisplayName}" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>
        </Grid>
    </Border>
</UserControl>
