<UserControl
    x:Class="MeasureControl.Views.ConfigTabel.IcdConfigTabel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MeasureControl.Views.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:MeasureControl.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="800"
    d:DesignWidth="1500"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ComboBoxStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#eaeaea" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#d0d0d0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <helpers:LevelToIndentConverter x:Key="LevelToIndentConverter" />
            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <helpers:BoolToExpansionIconConverter x:Key="BoolToExpansionIconConverter" />
            <helpers:StringToBrushConverter x:Key="StringToBrushConverter" />
            <helpers:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <helpers:ModelDisplayConverter x:Key="ModelDisplayConverter" />
            <helpers:DeviceTypeToBackgroundConverter x:Key="DeviceTypeToBackgroundConverter" />
            <helpers:DeviceTypeToHoverBackgroundConverter x:Key="DeviceTypeToHoverBackgroundConverter" />
            <helpers:DisplayNameToGridLengthConverter x:Key="DisplayNameToGridLengthConverter" DefaultWidth="100" />
            <helpers:DisplayNameAndMapToGridLengthConverter x:Key="DisplayNameAndMapToGridLengthConverter" DefaultWidth="100" />
            <helpers:ObjectEqualityConverter x:Key="ObjectEqualityConverter" />
            <Style x:Key="PaginationButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="#DADDE2" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#e0e0e0" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#c0c0c0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ActivePaginationButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#3b82f6" />
                <Setter Property="BorderBrush" Value="#3b82f6" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#2563eb" />
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#2563eb" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#1d4ed8" />
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#1d4ed8" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SimpleScrollBarStyle" TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="8" />
                <Setter Property="MinWidth" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="Transparent" BorderThickness="0">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Style>
                                                <Style TargetType="Thumb">
                                                    <Setter Property="Background" Value="#CCCCCC" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderThickness="0"
                                                                    CornerRadius="4" />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#999999" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter Property="Background" Value="#666666" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Thumb.Style>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CustomContextMenuStyle" TargetType="ContextMenu">
                <Setter Property="Background" Value="#ffffff" />
                <Setter Property="BorderBrush" Value="#cccccc" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="2" />
            </Style>

            <Style x:Key="CustomMenuItemStyle" TargetType="MenuItem">
                <Setter Property="Background" Value="#ffffff" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border
                                x:Name="Border"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0">
                                <ContentPresenter
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    ContentSource="Header" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#f0f0f0" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#cccccc" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SimpleScrollViewerStyle" TargetType="ScrollViewer">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="8" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ScrollContentPresenter
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="{TemplateBinding Padding}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />

                                <ScrollBar
                                    x:Name="PART_VerticalScrollBar"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Maximum="{TemplateBinding ScrollableHeight}"
                                    Orientation="Vertical"
                                    Style="{StaticResource SimpleScrollBarStyle}"
                                    ViewportSize="{TemplateBinding ViewportHeight}"
                                    Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                    Value="{TemplateBinding VerticalOffset}" />

                                <ScrollBar
                                    x:Name="PART_HorizontalScrollBar"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Maximum="{TemplateBinding ScrollableWidth}"
                                    Orientation="Horizontal"
                                    Style="{StaticResource SimpleScrollBarStyle}"
                                    ViewportSize="{TemplateBinding ViewportWidth}"
                                    Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                    Value="{TemplateBinding HorizontalOffset}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80*" />
                <ColumnDefinition Width="15*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70*" />
                        <RowDefinition Height="29*" />
                    </Grid.RowDefinitions>
                    <Border x:Name="CenterRegion" Grid.Row="0">
                        <Border.Resources>
                            <Style x:Key="TitleBarButtonStyle" TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="Border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#3d455d" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#4d556d" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Border.Resources>
                        <Grid Background="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="5*" />
                                <RowDefinition Height="97*" />
                            </Grid.RowDefinitions>
                            <Border
                                x:Name="line"
                                Grid.Row="0"
                                Background="#2d354d"
                                Cursor="Hand"
                                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                                <Grid PreviewMouseDown="Root_PreviewMouseDown">
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="White"
                                        Text="{Binding DisplayPath}" />
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Button Click="OnMinimizeButtonClick" Style="{StaticResource TitleBarButtonStyle}">
                                            <Image
                                                Width="30"
                                                Margin="0,0,5,0"
                                                Source="/Resources/Logo/min.png" />
                                        </Button>
                                        <Border Width="30" Margin="0,0,5,0">
                                            <Button Click="OnFloatButtonClick" Style="{StaticResource TitleBarButtonStyle}">
                                                <Image
                                                    x:Name="FloatImage"
                                                    Width="15"
                                                    Source="/Resources/Logo/float.png" />
                                            </Button>
                                        </Border>
                                        <Button Click="OnCloseButtonClick" Style="{StaticResource TitleBarButtonStyle}">
                                            <Image Margin="0,0,5,0" Source="/Resources/Logo/close.png" />
                                        </Button>
                                    </StackPanel>

                                </Grid>
                            </Border>

                            <Border Grid.Row="1">
                                <Grid Background="White">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="{Binding ElementName=line, Path=ActualHeight}" />
                                        <RowDefinition Height="15*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>


                                    <Border
                                        Grid.Row="0"
                                        Background="#cccccc"
                                        BorderBrush="Black"
                                        BorderThickness="0,0,0,1">
                                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                            <Button Margin="15,0,0,0" Command="{Binding AddIcdFrameCommand}">
                                                <Border Padding="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition />
                                                            <ColumnDefinition />
                                                        </Grid.ColumnDefinitions>
                                                        <Image
                                                            Width="15"
                                                            VerticalAlignment="Center"
                                                            Source="/Resources/Logo/add_b.png" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="5,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="14"
                                                            Text="添加ICD帧" />
                                                    </Grid>
                                                </Border>
                                            </Button>

                                            <Button Margin="15,0,0,0">
                                                <Border Padding="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition />
                                                            <ColumnDefinition />
                                                        </Grid.ColumnDefinitions>
                                                        <Image
                                                            Grid.Column="0"
                                                            Width="18"
                                                            VerticalAlignment="Center"
                                                            Source="/Resources/Logo/search_b.png" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="5,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="14"
                                                            Text="查找" />
                                                    </Grid>
                                                </Border>
                                            </Button>

                                            <Button
                                                Margin="15,0,0,0"
                                                Command="{Binding DeleteIcdFrameCommand}"
                                                CommandParameter="{Binding SelectedFrame}"
                                                IsEnabled="{Binding SelectedFrame, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Border Padding="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition />
                                                            <ColumnDefinition />
                                                        </Grid.ColumnDefinitions>
                                                        <Image
                                                            Grid.Column="0"
                                                            Width="16"
                                                            VerticalAlignment="Center"
                                                            Source="/Resources/Logo/delete_b.png" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="5,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="14"
                                                            Text="删除" />
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </StackPanel>

                                    </Border>

                                    <Border
                                        x:Name="ICD_infomation"
                                        Grid.Row="1"
                                        Margin="0,0,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="17*" />
                                            </Grid.ColumnDefinitions>

                                            <ItemsControl
                                                Grid.Row="0"
                                                Grid.RowSpan="10"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                AlternationCount="10"
                                                ItemsSource="{Binding PagedFrames}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Grid
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Stretch"
                                                            Grid.IsSharedSizeScope="True">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="17*" />
                                                            </Grid.ColumnDefinitions>
                                                        </Grid>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Grid.Row" Value="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource Self}}" />
                                                        <Setter Property="Grid.Column" Value="0" />
                                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="17*" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0">
                                                                <TextBlock
                                                                    Margin="10,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="14"
                                                                    Foreground="Black"
                                                                    Text="{Binding FrameName, FallbackValue=''}" />
                                                            </Border>
                                                            <!--  帧背景Border，用于选中和删除  -->
                                                            <Border
                                                                Grid.Column="1"
                                                                Margin="0,0,10,0"
                                                                Background="Transparent"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="2"
                                                                ContextMenuOpening="FrameBorder_ContextMenuOpening"
                                                                CornerRadius="3"
                                                                MouseLeftButtonDown="FrameBorder_MouseLeftButtonDown"
                                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Cursor" Value="Hand" />
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding IsSelected}" Value="True" />
                                                                                    <Condition Binding="{Binding IsEmpty}" Value="False" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="BorderBrush" Value="#4d6186" />
                                                                                <Setter Property="Background" Value="#d8dee9" />
                                                                            </MultiDataTrigger>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding IsEmpty}" Value="False" />
                                                                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="BorderBrush" Value="#90caf9" />
                                                                                <Setter Property="Background" Value="#eef2fb" />
                                                                            </MultiDataTrigger>
                                                                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                                <Setter Property="Cursor" Value="Arrow" />
                                                                                <Setter Property="Opacity" Value="0.7" />
                                                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                                                <Setter Property="Background" Value="Transparent" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Border.ContextMenu>
                                                                    <ContextMenu Style="{StaticResource CustomContextMenuStyle}">
                                                                        <MenuItem
                                                                            Command="{Binding PlacementTarget.Tag.DeleteIcdFrameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                            Header="删除帧">
                                                                            <MenuItem.Style>
                                                                                <Style BasedOn="{StaticResource CustomMenuItemStyle}" TargetType="MenuItem">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                                            <Setter Property="IsEnabled" Value="False" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </MenuItem.Style>
                                                                        </MenuItem>
                                                                    </ContextMenu>
                                                                </Border.ContextMenu>

                                                                <Border BorderBrush="Black" BorderThickness="1,1,1,1">
                                                                    <Grid>
                                                                        <Grid>
                                                                            <Border>
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Background" Value="Transparent" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                                                                                                <Setter Property="BorderThickness" Value="1,0,1,1" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                                <Setter Property="Background" Value="#cdd5e6" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <ItemsControl ItemsSource="{Binding Fields}">
                                                                                        <ItemsControl.Style>
                                                                                            <Style TargetType="ItemsControl">
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </ItemsControl.Style>
                                                                                        <ItemsControl.ItemTemplate>
                                                                                            <DataTemplate>
                                                                                                <Grid Margin="5,4,5,4">
                                                                                                    <Grid.ColumnDefinitions>
                                                                                                        <ColumnDefinition SharedSizeGroup="{Binding DisplayName}">
                                                                                                            <ColumnDefinition.Width>
                                                                                                                <MultiBinding Converter="{StaticResource DisplayNameAndMapToGridLengthConverter}">
                                                                                                                    <Binding Path="DisplayName" />
                                                                                                                    <Binding Path="DataContext.FieldWidthMap" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                                                                </MultiBinding>
                                                                                                            </ColumnDefinition.Width>
                                                                                                        </ColumnDefinition>
                                                                                                    </Grid.ColumnDefinitions>
                                                                                                    <Border
                                                                                                        Grid.Column="0"
                                                                                                        MinWidth="100"
                                                                                                        HorizontalAlignment="Stretch"
                                                                                                        Background="{Binding BackgroundColor}"
                                                                                                        CornerRadius="3"
                                                                                                        Cursor="Hand"
                                                                                                        MouseLeftButtonDown="FieldBorder_MouseLeftButtonDown">
                                                                                                        <Border.Style>
                                                                                                            <Style TargetType="Border">
                                                                                                                <Setter Property="BorderBrush" Value="#D9D9D9" />
                                                                                                                <Setter Property="BorderThickness" Value="1" />
                                                                                                                <Style.Triggers>
                                                                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                                                        <Setter Property="BorderBrush" Value="#3b82f6" />
                                                                                                                        <Setter Property="BorderThickness" Value="2" />
                                                                                                                    </DataTrigger>
                                                                                                                    <DataTrigger Value="True">
                                                                                                                        <DataTrigger.Binding>
                                                                                                                            <MultiBinding Converter="{StaticResource ObjectEqualityConverter}">
                                                                                                                                <Binding />
                                                                                                                                <Binding Path="DataContext.SelectedField" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                                                                            </MultiBinding>
                                                                                                                        </DataTrigger.Binding>
                                                                                                                        <Setter Property="BorderBrush" Value="#3b82f6" />
                                                                                                                        <Setter Property="BorderThickness" Value="2" />
                                                                                                                    </DataTrigger>
                                                                                                                </Style.Triggers>
                                                                                                            </Style>
                                                                                                        </Border.Style>
                                                                                                        <TextBlock
                                                                                                            HorizontalAlignment="Center"
                                                                                                            VerticalAlignment="Center"
                                                                                                            FontSize="14"
                                                                                                            Foreground="White"
                                                                                                            Text="{Binding DisplayName}" />
                                                                                                    </Border>
                                                                                                </Grid>
                                                                                            </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                        <ItemsControl.ItemsPanel>
                                                                                            <ItemsPanelTemplate>
                                                                                                <StackPanel Orientation="Horizontal" />
                                                                                            </ItemsPanelTemplate>
                                                                                        </ItemsControl.ItemsPanel>
                                                                                    </ItemsControl>

                                                                                </StackPanel>
                                                                            </Border>
                                                                        </Grid>
                                                                        <TextBlock
                                                                            Margin="0,0,10,0"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="26"
                                                                            FontWeight="Bold"
                                                                            Foreground="#8a92a1"
                                                                            IsHitTestVisible="False"
                                                                            Opacity="0.85"
                                                                            Text="{Binding FrameIdFieldValue}" />


                                                                    </Grid>
                                                                </Border>
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>

                                    <Border
                                        Grid.Row="2"
                                        Background="#f9fafb"
                                        BorderBrush="#f0f1f3"
                                        BorderThickness="1">
                                        <Grid>
                                            <TextBlock
                                                Width="180"
                                                Margin="20,0,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Foreground="#8C939C"
                                                Text="{Binding PaginationInfo}" />

                                            <StackPanel
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Button
                                                    Width="50"
                                                    Height="25"
                                                    Margin="0,0,5,0"
                                                    Command="{Binding PreviousPageCommand}"
                                                    Style="{StaticResource PaginationButtonStyle}">
                                                    <TextBlock Foreground="Black" Text="上一页" />
                                                </Button>

                                                <ItemsControl ItemsSource="{Binding PageNumbers}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button
                                                                Width="25"
                                                                Height="25"
                                                                Margin="0,0,5,0"
                                                                Command="{Binding Command}">
                                                                <Button.Style>
                                                                    <Style BasedOn="{StaticResource PaginationButtonStyle}" TargetType="Button">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCurrentPage}" Value="True">
                                                                                <Setter Property="Background" Value="#3b82f6" />
                                                                                <Setter Property="BorderBrush" Value="#3b82f6" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <TextBlock>
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="Black" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCurrentPage}" Value="True">
                                                                                    <Setter Property="Foreground" Value="White" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                    <Run Text="{Binding PageNumber}" />
                                                                </TextBlock>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>

                                                <Button
                                                    Width="50"
                                                    Height="25"
                                                    Margin="0,0,50,0"
                                                    Command="{Binding NextPageCommand}"
                                                    Style="{StaticResource PaginationButtonStyle}">
                                                    <TextBlock Foreground="Black" Text="下一页" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <GridSplitter
                        Grid.Row="0"
                        Height="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Background="#1c1c1c"
                        ShowsPreview="True" />

                    <Border Grid.Row="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="15*" />
                            </Grid.RowDefinitions>
                            <Border Background="#b2b2b2">
                                <TextBlock
                                    Grid.Row="0"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="常规" />
                            </Border>
                            <Border
                                Grid.Row="1"
                                Background="#ffffff"
                                BorderBrush="#1c1c1c"
                                BorderThickness="0,1.5,0,0">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="4*" />
                                        <RowDefinition Height="27*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel
                                        Grid.Row="0"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Image
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Source="/Resources/Logo/warning.png" />
                                        <TextBlock
                                            x:Name="chosed_icdframe"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="Black"
                                            Text="{Binding SelectedField.DisplayName, FallbackValue='暂无信息'}" />
                                    </StackPanel>
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding FieldConfigItems}">

                                        <ItemsControl.ItemTemplate>

                                            <DataTemplate>

                                                <Grid Margin="10">

                                                    <Grid.Style>

                                                        <Style TargetType="Grid">

                                                            <Setter Property="Visibility" Value="Visible" />

                                                            <Style.Triggers>

                                                                <DataTrigger Binding="{Binding IsVisible}" Value="False">

                                                                    <Setter Property="Visibility" Value="Collapsed" />

                                                                </DataTrigger>

                                                            </Style.Triggers>

                                                        </Style>

                                                    </Grid.Style>

                                                    <Grid.ColumnDefinitions>

                                                        <ColumnDefinition Width="Auto" />

                                                        <ColumnDefinition Width="130" />

                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="14"
                                                        Text="{Binding Name, StringFormat='{}{0}：'}" />

                                                    <ComboBox
                                                        Grid.Column="1"
                                                        Width="130"
                                                        Height="25"
                                                        HorizontalAlignment="Left"
                                                        FontSize="14"
                                                        ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                                                        ItemsSource="{Binding Options}"
                                                        SelectedItem="{Binding Value}">

                                                        <ComboBox.Style>

                                                            <Style BasedOn="{StaticResource CustomComboBoxStyle}" TargetType="ComboBox">

                                                                <Setter Property="Visibility" Value="Visible" />

                                                                <Style.Triggers>

                                                                    <DataTrigger Binding="{Binding ConfigType}" Value="TextBox">

                                                                        <Setter Property="Visibility" Value="Collapsed" />

                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{Binding ConfigType}" Value="TextBlock">

                                                                        <Setter Property="Visibility" Value="Collapsed" />

                                                                    </DataTrigger>

                                                                </Style.Triggers>

                                                            </Style>

                                                        </ComboBox.Style>

                                                    </ComboBox>

                                                    <Border
                                                        Grid.Column="1"
                                                        Width="130"
                                                        Height="25"
                                                        HorizontalAlignment="Left"
                                                        BorderBrush="#D9D9D9"
                                                        BorderThickness="1"
                                                        CornerRadius="3">

                                                        <Border.Style>

                                                            <Style TargetType="Border">

                                                                <Setter Property="Visibility" Value="Collapsed" />

                                                                <Style.Triggers>

                                                                    <DataTrigger Binding="{Binding ConfigType}" Value="TextBox">

                                                                        <Setter Property="Visibility" Value="Visible" />

                                                                    </DataTrigger>

                                                                </Style.Triggers>

                                                            </Style>

                                                        </Border.Style>

                                                        <TextBox
                                                            Margin="6,0,6,0"
                                                            VerticalContentAlignment="Center"
                                                            BorderThickness="0"
                                                            FontSize="14"
                                                            Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />

                                                    </Border>

                                                    <Border
                                                        Grid.Column="1"
                                                        Width="130"
                                                        Height="25"
                                                        HorizontalAlignment="Left"
                                                        BorderBrush="#D9D9D9"
                                                        BorderThickness="1"
                                                        CornerRadius="3">

                                                        <Border.Style>

                                                            <Style TargetType="Border">

                                                                <Setter Property="Visibility" Value="Collapsed" />

                                                                <Style.Triggers>

                                                                    <DataTrigger Binding="{Binding ConfigType}" Value="TextBlock">

                                                                        <Setter Property="Visibility" Value="Visible" />

                                                                    </DataTrigger>

                                                                </Style.Triggers>

                                                            </Style>

                                                        </Border.Style>

                                                        <TextBlock
                                                            Margin="6,0,6,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="14"
                                                            Text="{Binding Value}" />

                                                    </Border>

                                                </Grid>

                                            </DataTemplate>

                                        </ItemsControl.ItemTemplate>

                                        <ItemsControl.ItemsPanel>

                                            <ItemsPanelTemplate>

                                                <controls:ColumnFirstUniformGrid Columns="5" Rows="4" />

                                            </ItemsPanelTemplate>

                                        </ItemsControl.ItemsPanel>

                                    </ItemsControl>

                                </Grid>

                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter
                Grid.Column="0"
                Width="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="#1c1c1c"
                ShowsPreview="True" />


            <Border
                Grid.Row="0"
                Grid.Column="1"
                Background="#eaeaea" />
        </Grid>
    </Border>
</UserControl>
