                                                                <TextBlock
                                                                    Margin="5,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="14"
                                                                    Foreground="black"
                                                                    Text="双字位数2" />
                                                            </Border>

                                                            <Border
