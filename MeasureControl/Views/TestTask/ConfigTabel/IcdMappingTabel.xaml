                                                                <TextBlock
                                                                    Margin="5,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="14"
                                                                    Foreground="black"
                                                                    Text="实际位长" />
                                                            </Border>

                                                            <Border
                                                                Grid.Column="6"
                                                                BorderBrush="Black"
                                                                BorderThickness="0,0,1.5,0">
                                                                <TextBlock
