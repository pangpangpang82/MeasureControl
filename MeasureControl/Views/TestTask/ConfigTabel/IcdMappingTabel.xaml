                                                                    Width="80"
                                                                    MinWidth="60" />
                                                                <ColumnDefinition
                                                                    x:Name="双字位置2"
                                                                    Width="100"
                                                                    MinWidth="60" />
                                                                <ColumnDefinition
                                                                    x:Name="字内位置2"
                                                                    Width="100"
                                                                    MinWidth="60" />
                                                                <ColumnDefinition
                                                                    x:Name="位长2"
                                                                    Width="80"
                                                                    MinWidth="60" />
                                                                <ColumnDefinition
                                                                    x:Name="双字位置3"
                                                                    Width="100"
                                                                    MinWidth="60" />
                                                                <ColumnDefinition
                                                                    x:Name="字内位置3"
                                                                    Width="100"
                                                                    MinWidth="60" />
                                                                <ColumnDefinition
                                                                    x:Name="位长3"
                                                                    Width="80"
                                                                    MinWidth="60" />
                                                                <ColumnDefinition
                                                                    x:Name="双字位置4"
                                                                    Width="100"
                                                                    MinWidth="60" />
                                                                <ColumnDefinition
                                                                    x:Name="字内位置4"
                                                                    Width="100"
                                                                    MinWidth="60" />
                                                                <ColumnDefinition
                                                                    x:Name="位长4"
                                                                    Width="80"
                                                                    MinWidth="60" />
                                                                <ColumnDefinition
                                                                    x:Name="双字位置5"
                                                                    Width="100"
                                                                    MinWidth="60" />
                                                                <ColumnDefinition
                                                                    x:Name="字内位置5"
                                                                    Width="100"
                                                                    MinWidth="60" />
                                                                <ColumnDefinition
                                                                    x:Name="位长5"
                                                                    Width="100"
                                                                    MinWidth="60" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border
                                                                Grid.Column="0"
                                                                BorderBrush="Black"
                                                                BorderThickness="0,0,1.5,0">
                                                                <TextBlock
                                                                    Margin="5,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="14"
                                                                    Foreground="black"
                                                                    Text="信号标识" />
                                                            </Border>

                                                            <GridSplitter
                                                                Grid.Column="0"
                                                                Width="3"
