                                                                ShowsPreview="True" />

                                                            <Border
                                                                Grid.Column="1"
                                                                BorderBrush="Black"
                                                                BorderThickness="0,0,1.5,0">
                                                                <TextBlock
                                                                    Margin="5,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="14"
