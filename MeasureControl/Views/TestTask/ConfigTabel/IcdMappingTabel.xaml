                                                                <TextBlock
                                                                    Margin="5,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="14"
                                                                    Foreground="black"
                                                                    Text="双字位数1" />
                                                            </Border>

                                                            <Border
                                                                Grid.Column="12"
                                                                BorderBrush="Black"
                                                                BorderThickness="0,0,1.5,0">
                                                                <TextBlock
                                                                    Margin="5,0,0,0"
                                                                    VerticalAlignment="Center"
