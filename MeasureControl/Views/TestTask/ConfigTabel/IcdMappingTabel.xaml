                                                                    FontSize="14"
                                                                    Foreground="black"
                                                                    Text="字内位置2" />
                                                            </Border>

                                                            <Border
                                                                Grid.Column="16"
                                                                BorderBrush="Black"
                                                                BorderThickness="0,0,1.5,0">
                                                                <TextBlock
                                                                    Margin="5,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="14"
                                                                    Foreground="black"
                                                                    Text="位长2" />
                                                            </Border>

                                                            <Border
                                                                Grid.Column="17"
                                                                BorderBrush="Black"
                                                                BorderThickness="0,0,1.5,0">
