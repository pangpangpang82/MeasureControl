                                                            ResizeDirection="Columns"
                                                            ShowsPreview="True" />

                                                        <Border
                                                            Grid.Column="5"
                                                            HorizontalAlignment="Right"
                                                            BorderBrush="#D9D9D9"
                                                            BorderThickness="0,0,1.5,0">
                                                            <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
