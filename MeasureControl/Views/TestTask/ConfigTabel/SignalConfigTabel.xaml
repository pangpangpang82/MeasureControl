<UserControl
    x:Class="MeasureControl.Views.ConfigTabel.SignalConfigTabel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:MeasureControl.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:MeasureControl.Views"
    d:DesignHeight="800"
    d:DesignWidth="1500"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#eaeaea" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#d0d0d0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <helpers:LevelToIndentConverter x:Key="LevelToIndentConverter" />
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <helpers:BoolToExpansionIconConverter x:Key="BoolToExpansionIconConverter" />
        <helpers:BoolToTreeArrowConverter x:Key="BoolToTreeArrowConverter" />
        <helpers:StringToBrushConverter x:Key="StringToBrushConverter" />
        <helpers:ModelDisplayConverter x:Key="ModelDisplayConverter" />
        <helpers:DeviceTypeToBackgroundConverter x:Key="DeviceTypeToBackgroundConverter" />
        <helpers:DeviceTypeToHoverBackgroundConverter x:Key="DeviceTypeToHoverBackgroundConverter" />
        <helpers:SignalIndexDisplayConverter x:Key="SignalIndexDisplayConverter" />
        <helpers:EmptyValueConverter x:Key="EmptyValueConverter" />
        <helpers:ValueWithUnitConverter x:Key="ValueWithUnitConverter" />

        <!--  分页按钮样式  -->
        <Style x:Key="PaginationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DADDE2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--  鼠标悬停效果  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#e0e0e0" />
                            </Trigger>
                            <!--  按下效果  -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#c0c0c0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  激活状态的分页按钮样式（蓝色）  -->
        <Style x:Key="ActivePaginationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3b82f6" />
            <Setter Property="BorderBrush" Value="#3b82f6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--  鼠标悬停效果 - 蓝色变深  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2563eb" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#2563eb" />
                            </Trigger>
                            <!--  按下效果 - 更深的蓝色  -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1d4ed8" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#1d4ed8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  操作列按钮样式（无边框，高亮灰色）  -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ActionButtonBorder"
                            Width="25"
                            Height="25"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--  鼠标悬停效果  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionButtonBorder" Property="Background" Value="#e0e0e0" />
                            </Trigger>
                            <!--  按下效果  -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionButtonBorder" Property="Background" Value="#c0c0c0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  导航按钮样式（上一页/下一页）  -->
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DADDE2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="NavButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--  鼠标悬停效果 - 稍浅灰色  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavButtonBorder" Property="Background" Value="#e0e0e0" />
                            </Trigger>
                            <!--  按下效果 - 稍浅灰色  -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavButtonBorder" Property="Background" Value="#c0c0c0" />
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!--  简洁的滚动条样式  -->
        <Style x:Key="SimpleScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="Transparent" BorderThickness="0">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Background" Value="#CCCCCC" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border
                                                                Background="{TemplateBinding Background}"
                                                                BorderThickness="0"
                                                                CornerRadius="4" />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#999999" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter Property="Background" Value="#666666" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  简洁的ScrollViewer样式  -->
        <Style x:Key="SimpleScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="8" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />

                            <ScrollBar
                                x:Name="PART_VerticalScrollBar"
                                Grid.Row="0"
                                Grid.Column="1"
                                Maximum="{TemplateBinding ScrollableHeight}"
                                Orientation="Vertical"
                                Style="{StaticResource SimpleScrollBarStyle}"
                                ViewportSize="{TemplateBinding ViewportHeight}"
                                Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                Value="{TemplateBinding VerticalOffset}" />

                            <ScrollBar
                                x:Name="PART_HorizontalScrollBar"
                                Grid.Row="1"
                                Grid.Column="0"
                                Maximum="{TemplateBinding ScrollableWidth}"
                                Orientation="Horizontal"
                                Style="{StaticResource SimpleScrollBarStyle}"
                                ViewportSize="{TemplateBinding ViewportWidth}"
                                Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                Value="{TemplateBinding HorizontalOffset}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border>

        <Grid>

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="80*" />

                <ColumnDefinition Width="15*" />

            </Grid.ColumnDefinitions>

            <Border Grid.Column="0">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="70*" />

                        <RowDefinition Height="29*" />

                    </Grid.RowDefinitions>

                    <Border x:Name="CenterRegion" Grid.Row="0">

                        <Border.Resources>

                            <!--  按钮样式定义在这里，这样浮动时也能保持样式  -->

                            <Style x:Key="TitleBarButtonStyle" TargetType="Button">

                                <Setter Property="Background" Value="Transparent" />

                                <Setter Property="BorderThickness" Value="0" />

                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="Button">

                                            <Border
                                                x:Name="Border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">

                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                                            </Border>

                                            <ControlTemplate.Triggers>

                                                <Trigger Property="IsMouseOver" Value="True">

                                                    <Setter TargetName="Border" Property="Background" Value="#3d455d" />

                                                </Trigger>

                                                <Trigger Property="IsPressed" Value="True">

                                                    <Setter TargetName="Border" Property="Background" Value="#4d556d" />

                                                </Trigger>

                                                <Trigger Property="IsEnabled" Value="False">

                                                    <Setter Property="Opacity" Value="0.5" />

                                                </Trigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                            </Style>

                        </Border.Resources>

                        <Grid Background="White">

                            <Grid.RowDefinitions>

                                <RowDefinition Height="5*" />

                                <RowDefinition Height="97*" />

                            </Grid.RowDefinitions>

                            <Border
                                x:Name="line"
                                Grid.Row="0"
                                Background="#2d354d"
                                Cursor="Hand"
                                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                                <Grid>

                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="White"
                                        Text="{Binding DisplayPath}" />

                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">

                                        <Button Click="OnMinimizeButtonClick" Style="{StaticResource TitleBarButtonStyle}">

                                            <Image
                                                Width="30"
                                                Margin="0,0,5,0"
                                                Source="/Resources/Logo/min.png" />

                                        </Button>

                                        <Border Width="30" Margin="0,0,5,0">

                                            <Button Click="OnFloatButtonClick" Style="{StaticResource TitleBarButtonStyle}">

                                                <Image
                                                    x:Name="FloatImage"
                                                    Width="15"
                                                    Source="/Resources/Logo/float.png" />

                                            </Button>

                                        </Border>

                                        <Button Click="OnCloseButtonClick" Style="{StaticResource TitleBarButtonStyle}">

                                            <Image Margin="0,0,5,0" Source="/Resources/Logo/close.png" />

                                        </Button>

                                    </StackPanel>



                                </Grid>

                            </Border>



                            <Border Grid.Row="1">
                                <Grid Background="White">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="{Binding ElementName=line, Path=ActualHeight}" />
                                        <RowDefinition Height="15*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border
                                        Grid.Row="0"
                                        Background="#cccccc"
                                        BorderBrush="Black"
                                        BorderThickness="0,0,0,1">
                                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                            <Button Margin="15,0,0,0" Command="{Binding AddSignalCommand}">
                                                <Border Padding="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition />
                                                            <ColumnDefinition />
                                                        </Grid.ColumnDefinitions>
                                                        <Image
                                                            Width="15"
                                                            VerticalAlignment="Center"
                                                            Source="/Resources/Logo/add_b.png" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="5,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="14"
                                                            Text="添加信号" />
                                                    </Grid>
                                                </Border>
                                            </Button>

                                            <Button Margin="15,0,0,0" Command="{Binding ConnectChassisCommand}">
                                                <Border Padding="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition />
                                                            <ColumnDefinition />
                                                        </Grid.ColumnDefinitions>
                                                        <Image
                                                            Grid.Column="0"
                                                            Width="18"
                                                            VerticalAlignment="Center"
                                                            Source="/Resources/Logo/search_b.png" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="5,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="14"
                                                            Text="查找" />
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="valueinfo" Grid.Row="1">
                                        <Border
                                            Background="Black"
                                            BorderBrush="#D9D9D9"
                                            BorderThickness="1.5">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="16*" />
                                                </Grid.RowDefinitions>

                                                <Border
                                                    Grid.Row="0"
                                                    Background="#f5f5f5"
                                                    BorderBrush="#D9D9D9"
                                                    BorderThickness="0,0,0,1.5">
