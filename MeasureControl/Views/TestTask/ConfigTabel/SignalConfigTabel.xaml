                                                                    Margin="0,0,5,0"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="14"
                                                                    Foreground="Black"
                                                                    Text="原始值" />
                                                                <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                                                                    <Button
                                                                        Height="8"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        FontSize="7"
