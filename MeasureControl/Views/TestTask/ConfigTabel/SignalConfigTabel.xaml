                                                                x:Name="HeaderCol1"
                                                                Width="2.0*"
                                                                MinWidth="100" />
                                                            <ColumnDefinition
                                                                x:Name="HeaderCol2"
                                                                Width="1.3*"
                                                                MinWidth="80" />
                                                            <ColumnDefinition
                                                                x:Name="HeaderCol3"
                                                                Width="1.8*"
                                                                MinWidth="100" />
                                                            <ColumnDefinition
                                                                x:Name="HeaderCol4"
                                                                Width="1.2*"
                                                                MinWidth="80" />
                                                            <ColumnDefinition
                                                                x:Name="HeaderCol5"
                                                                Width="1.5*"
                                                                MinWidth="100" />
                                                            <ColumnDefinition
                                                                x:Name="HeaderCol6"
                                                                Width="1.5*"
                                                                MinWidth="100" />
                                                            <ColumnDefinition
                                                                x:Name="HeaderCol7"
                                                                Width="1.2*"
                                                                MinWidth="80" />
                                                            <ColumnDefinition
                                                                x:Name="HeaderCol8"
                                                                Width="5.0*"
