                                                                    <Button
                                                                        Height="8"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        FontSize="7"
                                                                        Foreground="#a0a7b3">
                                                                        <Button.Content>
                                                                            <TextBlock VerticalAlignment="Center" Text="▲" />
                                                                        </Button.Content>
                                                                        <Button.LayoutTransform>
                                                                            <ScaleTransform ScaleX="1.5" />
                                                                        </Button.LayoutTransform>
                                                                    </Button>
                                                                    <Button
                                                                        Height="8"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        FontSize="7"
                                                                        Foreground="#a0a7b3">
                                                                        <Button.Content>
