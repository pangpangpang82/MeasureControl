                                                            <ColumnDefinition
                                                                x:Name="HeaderCol9"
                                                                Width="1.4*"
                                                                MinWidth="100" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border BorderBrush="#D9D9D9" BorderThickness="0,0,1.5,0">
                                                            <TextBlock
                                                                Grid.Column="0"
                                                                Margin="15,0,0,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="14"
                                                                Foreground="black"
                                                                Text="序号" />
                                                        </Border>

                                                        <GridSplitter
                                                            Grid.Column="0"
                                                            Width="3"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Stretch"
                                                            Background="Transparent"
                                                            DragCompleted="GridSplitter_DragCompleted"
                                                            ResizeDirection="Columns"
                                                            ShowsPreview="True" />

                                                        <Border
                                                            Grid.Column="1"
                                                            BorderBrush="#D9D9D9"
                                                            BorderThickness="0,0,1.5,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock
                                                                    Margin="15,0,5,0"
