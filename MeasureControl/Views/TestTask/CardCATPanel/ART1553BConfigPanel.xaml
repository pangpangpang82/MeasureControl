                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Width="90"
                                        Height="32"
                                        Margin="0,10,0,0"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.BCRunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="0"
                                        Style="{StaticResource SuccessButtonStyle}"
                                        Visibility="{Binding IsBCMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="White"
                                            Text="BC运行" />
                                    </Button>
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Width="90"
                                        Height="32"
                                        Margin="10,10,0,0"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.BCStopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="0"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Visibility="{Binding IsBCMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="White"
                                            Text="BC停止" />
                                    </Button>

                                    <!--  RT模式按钮  -->
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Width="90"
                                        Height="32"
                                        Margin="0,10,0,0"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.RTRunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="0"
                                        Style="{StaticResource SuccessButtonStyle}"
                                        Visibility="{Binding IsRTMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="White"
                                            Text="RT运行" />
                                    </Button>
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Width="90"
                                        Height="32"
                                        Margin="10,10,0,0"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.RTStopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="0"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Visibility="{Binding IsRTMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="White"
                                            Text="RT停止" />
                                    </Button>

                                    <!--  BM模式按钮  -->
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Width="90"
                                        Height="32"
                                        Margin="0,10,0,0"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.BMRunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="0"
                                        Style="{StaticResource SuccessButtonStyle}"
                                        Visibility="{Binding IsBMMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="White"
                                            Text="BM运行" />
                                    </Button>
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Width="90"
                                        Height="32"
                                        Margin="10,10,0,0"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.BMStopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="0"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Visibility="{Binding IsBMMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="White"
                                            Text="BM停止" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!--  通道1 Tab  -->
                    <TabItem Header="通道1">
                        <ScrollViewer Style="{StaticResource SimpleScrollViewerStyle}" VerticalScrollBarVisibility="Auto">
                            <StackPanel
                                Margin="10"
                                DataContext="{Binding Channel1Config}"
                                Orientation="Vertical">
                                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                    <!--  工作模式选择  -->
                                    <TextBlock
                                        Margin="0,5,0,5"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="工作模式:" />
                                    <ComboBox
                                        Width="200"
                                        Height="30"
                                        Margin="10,0,0,0"
                                        ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                                        ItemsSource="{Binding TerminalModes}"
                                        SelectedItem="{Binding SelectedTerminalMode}">
                                        <ComboBox.Style>
                                            <Style BasedOn="{StaticResource CustomComboBoxStyle}" TargetType="ComboBox">
                                                <Setter Property="Opacity" Value="1" />
                                                <Setter Property="FontSize" Value="14" />
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>
                                </StackPanel>

                                <!--  BC模式配置  -->
                                <StackPanel
                                    Margin="15,15,0,0"
                                    Orientation="Vertical"
                                    Visibility="{Binding IsBCMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="BC模式配置" />

                                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                        <TextBlock
                                            Width="100"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Text="响应超时：" />
                                        <TextBox
                                            Width="100"
                                            Height="30"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource TextBoxStyle}"
                                            Text="{Binding BCResponseTimeout, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#666666"
                                            Text="(0.5us)" />
                                    </StackPanel>

                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                        <TextBlock
                                            Width="100"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Text="帧间隔：" />
                                        <TextBox
                                            Width="100"
                                            Height="30"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource TextBoxStyle}"
                                            Text="{Binding BCFrameGap, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#666666"
                                            Text="(1us)" />
                                    </StackPanel>

                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                        <TextBlock
                                            Width="100"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Text="重试次数：" />
                                        <TextBox
                                            Width="100"
                                            Height="30"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource TextBoxStyle}"
                                            Text="{Binding BCRetryCount, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <!--  发送间隔配置（参考官方例程：循环发送）  -->
                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                        <TextBlock
                                            Width="100"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Text="发送间隔：" />
                                        <TextBox
                                            Width="100"
                                            Height="30"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource TextBoxStyle}"
                                            Text="{Binding DataContext.BCSendInterval, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#666666"
                                            Text="(ms)" />
                                    </StackPanel>

                                    <!--  BC发送统计  -->
                                    <StackPanel Margin="0,15,0,0" Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="#333333"
                                            Text="发送次数：" />
                                        <TextBlock
                                            Margin="5,0,20,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="#2196F3"
                                            Text="{Binding DataContext.BCSendCount, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </StackPanel>
                                </StackPanel>

                                <!--  RT模式配置（使用Tab控件组织，参考官方例程）  -->
                                <StackPanel
                                    Margin="15,5,0,0"
                                    Orientation="Vertical"
                                    Visibility="{Binding IsRTMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="RT模式配置" />

                                    <!--  RT接收统计（参考官方例程）  -->
