<UserControl
    x:Class="MeasureControl.Views.TestTask.CardCATPanel.ART1553BConfigPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:MeasureControl.Helpers"
    xmlns:local="clr-namespace:MeasureControl.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="550"
    d:DesignWidth="970"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ComboBoxStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  转换器  -->
            <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
            <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <helpers:ChannelSelectConverter x:Key="ChannelSelectConverter" />
            <helpers:RTEnableButtonContentConverter x:Key="RTEnableButtonContentConverter" />

            <!--  RT使能按钮样式  -->
            <Style x:Key="RTEnableButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Background" Value="#9ca3af" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                        <Setter Property="Background" Value="#3b82f6" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                        <Setter Property="Background" Value="#9ca3af" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--  简洁的滚动条样式  -->
            <Style x:Key="SimpleScrollBarStyle" TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="8" />
                <Setter Property="MinWidth" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="Transparent" BorderThickness="0">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb Background="#CCCCCC">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border
                                                        Background="{TemplateBinding Background}"
                                                        BorderThickness="0"
                                                        CornerRadius="4" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  简洁的ScrollViewer样式  -->
            <Style x:Key="SimpleScrollViewerStyle" TargetType="ScrollViewer">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="8" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ScrollContentPresenter
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="{TemplateBinding Padding}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                                <ScrollBar
                                    x:Name="PART_VerticalScrollBar"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Maximum="{TemplateBinding ScrollableHeight}"
                                    Orientation="Vertical"
                                    Style="{StaticResource SimpleScrollBarStyle}"
                                    ViewportSize="{TemplateBinding ViewportHeight}"
                                    Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                    Value="{TemplateBinding VerticalOffset}" />
                                <ScrollBar
                                    x:Name="PART_HorizontalScrollBar"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Maximum="{TemplateBinding ScrollableWidth}"
                                    Orientation="Horizontal"
                                    Style="{StaticResource SimpleScrollBarStyle}"
                                    ViewportSize="{TemplateBinding ViewportWidth}"
                                    Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                    Value="{TemplateBinding HorizontalOffset}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  按钮样式  -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#3b82f6" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="60" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  成功按钮样式（绿色）  -->
            <Style x:Key="SuccessButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#10b981" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="80" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#059669" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#047857" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  危险按钮样式（红色）  -->
            <Style x:Key="DangerButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#ef4444" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="80" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#dc2626" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  文本框样式  -->
            <Style x:Key="TextBoxStyle" TargetType="TextBox">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#D9D9D9" />
                <Setter Property="Padding" Value="2" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                                <ScrollViewer
                                    x:Name="PART_ContentHost"
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        Background="White"
        Focusable="True"
        MouseDown="Border_MouseDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!--  左侧配置区域（使用TabControl显示通道0和通道1）  -->
            <Border
                Grid.Column="0"
                Margin="8,8,4,8"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">
                <TabControl
                    x:Name="ChannelTabControl"
                    Background="White"
                    FontSize="12"
                    SelectionChanged="ChannelTabControl_SelectionChanged">
                    <!--  通道0 Tab  -->
                    <TabItem Header="通道0">
                        <ScrollViewer Style="{StaticResource SimpleScrollViewerStyle}" VerticalScrollBarVisibility="Auto">
                            <StackPanel
                                Margin="10"
                                DataContext="{Binding Channel0Config}"
                                Orientation="Vertical">
                                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                    <!--  工作模式选择  -->
                                    <TextBlock
                                        Margin="0,5,0,5"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="工作模式:" />
                                    <ComboBox
                                        Width="200"
                                        Height="30"
                                        Margin="10,0,0,0"
                                        ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                                        ItemsSource="{Binding TerminalModes}"
                                        SelectedItem="{Binding SelectedTerminalMode}">
                                        <ComboBox.Style>
                                            <Style BasedOn="{StaticResource CustomComboBoxStyle}" TargetType="ComboBox">
                                                <Setter Property="Opacity" Value="1" />
                                                <Setter Property="FontSize" Value="14" />
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>
                                </StackPanel>

                                <!--  BC模式配置  -->
                                <StackPanel
                                    Margin="15,15,0,0"
                                    Orientation="Vertical"
                                    Visibility="{Binding IsBCMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="BC模式配置" />

                                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                        <TextBlock
                                            Width="100"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Text="响应超时：" />
                                        <TextBox
                                            Width="100"
                                            Height="30"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource TextBoxStyle}"
                                            Text="{Binding BCResponseTimeout, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#666666"
                                            Text="(0.5us)" />
                                    </StackPanel>

                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                        <TextBlock
                                            Width="100"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Text="帧间隔：" />
                                        <TextBox
                                            Width="100"
                                            Height="30"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource TextBoxStyle}"
                                            Text="{Binding BCFrameGap, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#666666"
                                            Text="(1us)" />
                                    </StackPanel>

                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                        <TextBlock
                                            Width="100"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Text="重试次数：" />
                                        <TextBox
                                            Width="100"
                                            Height="30"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource TextBoxStyle}"
                                            Text="{Binding BCRetryCount, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <!--  发送间隔配置（参考官方例程：循环发送）  -->
                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                        <TextBlock
                                            Width="100"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Text="发送间隔：" />
                                        <TextBox
                                            Width="100"
                                            Height="30"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource TextBoxStyle}"
                                            Text="{Binding BCSendInterval, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#666666"
                                            Text="(ms)" />
                                    </StackPanel>

                                    <!--  BC发送统计  -->
                                    <StackPanel Margin="0,15,0,0" Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="#333333"
                                            Text="发送次数：" />
                                        <TextBlock
                                            Margin="5,0,20,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="#2196F3"
                                            Text="{Binding BCSendCount}" />
                                    </StackPanel>
                                </StackPanel>

                                <!--  RT模式配置（使用Tab控件组织，参考官方例程）  -->
                                <StackPanel
                                    Margin="15,5,0,0"
                                    Orientation="Vertical"
                                    Visibility="{Binding IsRTMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="RT模式配置" />

                                    <!--  RT接收统计（参考官方例程）  -->
                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="#333333"
                                            Text="接收次数：" />
                                        <TextBlock
                                            Margin="5,0,20,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="#4CAF50"
                                            Text="{Binding DataContext.RTReceiveCount, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="#333333"
                                            Text="错误次数：" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="#F44336"
                                            Text="{Binding DataContext.RTErrorCount, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </StackPanel>

                                    <!--  Tab控件组织RT配置  -->
                                    <TabControl Margin="0,10,0,0">
                                        <!--  Tab 1: RT初始化配置  -->
                                        <TabItem Header="RT初始化配置">
                                            <ScrollViewer Style="{StaticResource SimpleScrollViewerStyle}" VerticalScrollBarVisibility="Auto">
                                                <StackPanel Margin="10" Orientation="Vertical">
                                                    <!--  RT配置列表（0-31个RT）  -->
                                                    <StackPanel Margin="0,0,0,10" Orientation="Vertical">
                                                        <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontSize="13"
                                                                FontWeight="SemiBold"
                                                                Text="RT配置列表：" />
                                                            <Button
                                                                Width="40"
                                                                Height="25"
                                                                Margin="5,0,5,0"
                                                                Command="{Binding SelectAllRTCommand}"
                                                                Content="全选"
                                                                Style="{StaticResource PrimaryButtonStyle}" />
                                                            <Button
                                                                Width="40"
                                                                Height="25"
                                                                Command="{Binding DeselectAllRTCommand}"
                                                                Content="全不选"
                                                                Style="{StaticResource PrimaryButtonStyle}" />
                                                        </StackPanel>

                                                        <Border
                                                            Height="165"
                                                            Margin="0,5,0,0"
                                                            BorderBrush="#D9D9D9"
                                                            BorderThickness="1">
                                                            <ScrollViewer Style="{StaticResource SimpleScrollViewerStyle}" VerticalScrollBarVisibility="Auto">
                                                                <ItemsControl ItemsSource="{Binding RTConfigs}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <UniformGrid Columns="2" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border
                                                                                Margin="2"
                                                                                Padding="0"
                                                                                BorderBrush="#D9D9D9"
                                                                                BorderThickness="1"
                                                                                CornerRadius="3"
                                                                                Cursor="Hand"
                                                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Background" Value="#F0F0F0" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                                                <Setter Property="Background" Value="White" />
                                                                                            </DataTrigger>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter Property="BorderBrush" Value="#3b82f6" />
                                                                                            </Trigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <!--  右键菜单：配置RT内部子地址  -->
                                                                                <Border.ContextMenu>
                                                                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                                        <MenuItem
                                                                                            Command="{Binding PlacementTarget.Tag.SelectRTForConfigCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                            CommandParameter="{Binding}"
                                                                                            Header="配置RT内部子地址">
                                                                                            <MenuItem.Icon>
                                                                                                <TextBlock FontSize="14" Text="⚙" />
                                                                                            </MenuItem.Icon>
                                                                                        </MenuItem>
                                                                                    </ContextMenu>
                                                                                </Border.ContextMenu>
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                    </Grid.ColumnDefinitions>

                                                                                    <Button
                                                                                        Grid.Column="0"
                                                                                        Width="60"
                                                                                        Height="25"
                                                                                        Margin="0,0,10,0"
                                                                                        Command="{Binding DataContext.ToggleRTEnableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                        CommandParameter="{Binding}"
                                                                                        Content="{Binding IsEnabled, Converter={StaticResource RTEnableButtonContentConverter}}"
                                                                                        Style="{StaticResource RTEnableButtonStyle}" />

                                                                                    <TextBlock
                                                                                        Grid.Column="1"
                                                                                        Margin="5,0,0,0"
                                                                                        VerticalAlignment="Center"
                                                                                        FontSize="13"
                                                                                        Text="{Binding DisplayName}" />
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>
                                                        </Border>
                                                    </StackPanel>

                                                </StackPanel>
                                            </ScrollViewer>
                                        </TabItem>

                                    </TabControl>
                                </StackPanel>

                                <!--  BM模式配置  -->
                                <StackPanel
                                    Margin="15,15,0,0"
                                    Orientation="Vertical"
                                    Visibility="{Binding IsBMMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="BM模式配置" />
                                    <TextBlock
                                        Margin="0,5,0,0"
                                        FontSize="12"
                                        Foreground="#666666"
                                        Text="BM模式用于监控总线消息" />

                                    <!--  BM过滤配置  -->
                                    <StackPanel Margin="0,15,0,0" Orientation="Vertical">
                                        <TextBlock
                                            Margin="0,0,0,5"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="消息过滤" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="0,0,10,5"
                                                VerticalAlignment="Center"
                                                Text="RT地址:" />
                                            <TextBox
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Height="25"
                                                Margin="0,0,0,5"
                                                Style="{StaticResource TextBoxStyle}"
                                                Text="{Binding BMFilterRTAddress, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.ToolTip>
                                                    <ToolTip Content="输入0-31过滤指定RT地址，-1表示不过滤" />
                                                </TextBox.ToolTip>
                                            </TextBox>

                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center"
                                                Text="消息类型:" />
                                            <ComboBox
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Height="25"
                                                ItemsSource="{Binding BMFilterMessageTypes}"
                                                SelectedItem="{Binding BMFilterMessageType, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </StackPanel>

                                    <!--  BM统计信息  -->
                                    <StackPanel Margin="0,15,0,0" Orientation="Vertical">
                                        <TextBlock
                                            Margin="0,0,0,5"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="统计信息" />
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock FontSize="11" Foreground="#666666">
                                                <Run Text="总消息数: " />
                                                <Run FontWeight="SemiBold" Text="{Binding BMTotalMessageCount}" />
                                            </TextBlock>
                                            <TextBlock
                                                Margin="0,3,0,0"
                                                FontSize="11"
                                                Foreground="#666666">
                                                <Run Text="错误消息数: " />
                                                <Run
                                                    FontWeight="SemiBold"
                                                    Foreground="#ef4444"
                                                    Text="{Binding BMErrorMessageCount}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!--  操作按钮 2x2布局  -->
                                <Grid Margin="15,20,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1*" />
                                        <RowDefinition Height="1*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  第一行：保存配置 | 读取配置  -->
                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Width="90"
                                        Height="32"
                                        BorderThickness="0"
                                        Command="{Binding SaveConfigCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,5,0"
                                                Source="/Resources/Logo/save_white.png" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="White"
                                                Text="保存配置" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Width="90"
                                        Height="32"
                                        Margin="10,0,0,0"
                                        BorderThickness="0"
                                        Command="{Binding ReloadConfigCommand}"
