<UserControl
    x:Class="MeasureControl.Views.TestTask.CardCATPanel.MTX970_LVDS"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:MeasureControl.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="550"
    d:DesignWidth="970"
    Background="White"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ComboBoxStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <helpers:AlternationIndexToOneBasedConverter x:Key="AlternationIndexToOneBasedConverter" />
            <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
            <helpers:BooleanAndConverter x:Key="BooleanAndConverter" />
            <helpers:BoolToYesNoConverter x:Key="BoolToYesNoConverter" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <helpers:BoolToYesNoConverter
                x:Key="BoolToStaticCountConverter"
                FalseText="计数"
                TrueText="静态" />

            <x:Array x:Key="YesNoOptions" Type="sys:String">
                <sys:String>是</sys:String>
                <sys:String>否</sys:String>
            </x:Array>

            <x:Array x:Key="StaticCountOptions" Type="sys:String">
                <sys:String>静态</sys:String>
                <sys:String>计数</sys:String>
            </x:Array>

            <Style x:Key="DisabledSectionBorderStyle" TargetType="Border">
                <Setter Property="Opacity" Value="1" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.6" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsLeftConfigLocked}" Value="True">
                        <Setter Property="Opacity" Value="0.6" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--  全局配置锁定下拉框样式  -->
            <Style
                x:Key="ConfigLockedComboBoxStyle"
                BasedOn="{StaticResource CustomComboBoxStyle}"
                TargetType="ComboBox">
                <Setter Property="Opacity" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsConfigurationLocked}" Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                        <Setter Property="Opacity" Value="0.5" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--  全局配置锁定输入框样式  -->
            <Style x:Key="ConfigLockedTextBoxStyle" TargetType="TextBox">
                <Setter Property="Height" Value="32" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="BorderBrush" Value="#D9D9D9" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="White" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Opacity" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsConfigurationLocked}" Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                        <Setter Property="Opacity" Value="0.5" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--  简洁的滚动条样式  -->
            <Style x:Key="SimpleScrollBarStyle" TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="8" />
                <Setter Property="MinWidth" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="Transparent" BorderThickness="0">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Style>
                                                <Style TargetType="Thumb">
                                                    <Setter Property="Background" Value="#CCCCCC" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderThickness="0"
                                                                    CornerRadius="4" />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#999999" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter Property="Background" Value="#666666" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Thumb.Style>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  简洁的ScrollViewer样式  -->
            <Style x:Key="SimpleScrollViewerStyle" TargetType="ScrollViewer">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="8" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ScrollContentPresenter
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="{TemplateBinding Padding}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />

                                <ScrollBar
                                    x:Name="PART_VerticalScrollBar"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Maximum="{TemplateBinding ScrollableHeight}"
                                    Orientation="Vertical"
                                    Style="{StaticResource SimpleScrollBarStyle}"
                                    ViewportSize="{TemplateBinding ViewportHeight}"
                                    Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                    Value="{TemplateBinding VerticalOffset}" />

                                <ScrollBar
                                    x:Name="PART_HorizontalScrollBar"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Maximum="{TemplateBinding ScrollableWidth}"
                                    Orientation="Horizontal"
                                    Style="{StaticResource SimpleScrollBarStyle}"
                                    ViewportSize="{TemplateBinding ViewportWidth}"
                                    Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                    Value="{TemplateBinding HorizontalOffset}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  使能CheckBox样式：勾选背景蓝色，勾选标记白色  -->
            <Style x:Key="EnableCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid>
                                <Border
                                    x:Name="checkBoxBorder"
                                    Width="16"
                                    Height="16"
                                    Background="White"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="1"
                                    CornerRadius="2">
                                    <Path
                                        x:Name="checkMark"
                                        Data="M 2 8 L 6 12 L 14 4"
                                        Stroke="White"
                                        StrokeThickness="2"
                                        Visibility="Collapsed" />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="checkBoxBorder" Property="Background" Value="#3b82f6" />
                                    <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#3b82f6" />
                                    <Setter TargetName="checkMark" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#3b82f6" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  TextBox样式  -->
            <Style TargetType="TextBox">
                <Setter Property="Height" Value="32" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="#D9D9D9" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border
                                x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                                <ScrollViewer
                                    x:Name="PART_ContentHost"
                                    Margin="2"
                                    Focusable="false"
                                    HorizontalScrollBarVisibility="Hidden"
                                    VerticalScrollBarVisibility="Hidden" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#3b82f6" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#3b82f6" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  Label样式  -->
            <Style TargetType="Label">
                <Setter Property="Foreground" Value="#333333" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <!--  数字调整按钮样式  -->
            <Style x:Key="NumberAdjustButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#F5F5F5" />
                <Setter Property="BorderBrush" Value="#D9D9D9" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="15" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Foreground" Value="#666666" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#E8E8E8" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="#3b82f6" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#D0D0D0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  主按钮样式  -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#3b82f6" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Height" Value="36" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="border"
                                Padding="16,0"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="White" Focusable="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="Card_name"
                Grid.Column="0"
                Margin="8,8,4,8"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">

                <Grid>
                    <Grid IsHitTestVisible="{Binding IsLeftConfigLocked, Converter={StaticResource InverseBoolConverter}}">
                        <StackPanel Orientation="Vertical">
                            <TextBlock
                                Grid.Column="0"
                                Margin="15,10,0,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="Bold"
                                Text="{Binding Model, StringFormat='{}{0} 配置'}" />
                            <StackPanel Margin="15,20,0,0" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Text="测试任务：" />

                                <ComboBox
                                    Width="200"
                                    Height="30"
                                    FontSize="14"
                                    ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                                    ItemsSource="{Binding AvailableTestTasks}"
                                    SelectedItem="{Binding SelectedTestTask, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource ConfigLockedComboBoxStyle}">
                                    <ComboBox.IsEnabled>
                                        <Binding Path="HasTestTaskOptions" />
                                    </ComboBox.IsEnabled>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Margin="15,20,10,0" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Text="配置OSC：" />
                                <ComboBox
                                    Width="200"
                                    Height="{Binding ElementName=LvdsDataSampleWrTextBox, Path=ActualHeight}"
                                    FontSize="15"
                                    ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                                    ItemsSource="{StaticResource YesNoOptions}"
                                    SelectedItem="{Binding ConfigOsc, Mode=TwoWay, Converter={StaticResource BoolToYesNoConverter}, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource ConfigLockedComboBoxStyle}" />
                            </StackPanel>

                            <StackPanel Margin="15,20,10,0" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Text="发送模式：" />
                                <ComboBox
                                    Width="200"
                                    Height="{Binding ElementName=LvdsDataSampleWrTextBox, Path=ActualHeight}"
                                    FontSize="15"
                                    ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                                    ItemsSource="{StaticResource StaticCountOptions}"
                                    SelectedItem="{Binding StaticCount, Mode=TwoWay, Converter={StaticResource BoolToStaticCountConverter}, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource ConfigLockedComboBoxStyle}" />
                            </StackPanel>

                            <!--  时钟频率  -->
                            <StackPanel Margin="15,20,10,0">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Text="时钟频率 (Hz)" />


                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="ClockFrequencyTextBox"
                                        Margin="0,10,0,0"
                                        FontSize="15"
                                        Text="{Binding ClockFrequencyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="4,10,0,0"
                                        VerticalAlignment="Center">
                                        <Button
                                            Margin="0,0,0,5"
                                            Command="{Binding ClockFrequencyUpCommand}"
                                            Content="▲"
                                            Style="{StaticResource NumberAdjustButtonStyle}" />
                                        <Button
                                            Command="{Binding ClockFrequencyDownCommand}"
                                            Content="▼"
                                            Style="{StaticResource NumberAdjustButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!--  LVDS数据采样写  -->
                            <StackPanel Margin="15,10,10,0">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Text="发送数据" />
                                <Grid x:Name="line1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="LvdsDataSampleWrTextBox"
                                        Margin="0,10,0,0"
                                        FontSize="15"
                                        Text="{Binding LvdsDataSampleWrText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="4,10,0,0"
                                        VerticalAlignment="Center">
                                        <Button
                                            Margin="0,0,0,5"
                                            Command="{Binding LvdsDataSampleWrUpCommand}"
                                            Content="▲"
                                            Style="{StaticResource NumberAdjustButtonStyle}" />
                                        <Button
                                            Command="{Binding LvdsDataSampleWrDownCommand}"
                                            Content="▼"
                                            Style="{StaticResource NumberAdjustButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!--  模式匹配  -->
                            <StackPanel Margin="15,10,10,0">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Text="模式匹配" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="PatternMatchTextBox"
                                        Margin="0,10,0,0"
                                        FontSize="15"
                                        Text="{Binding PatternMatchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="4,10,0,0"
                                        VerticalAlignment="Center">
                                        <Button
                                            Margin="0,0,0,5"
                                            Command="{Binding PatternMatchUpCommand}"
                                            Content="▲"
                                            Style="{StaticResource NumberAdjustButtonStyle}" />
                                        <Button
                                            Command="{Binding PatternMatchDownCommand}"
                                            Content="▼"
                                            Style="{StaticResource NumberAdjustButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!--  采样数量  -->
                            <StackPanel Margin="15,10,10,0">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Text="采样数量" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="NumSamplesTextBox"
                                        Margin="0,10,0,0"
                                        FontSize="15"
                                        Text="{Binding NumSamplesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="4,10,0,0"
                                        VerticalAlignment="Center">
                                        <Button
                                            Margin="0,0,0,5"
                                            Command="{Binding NumSamplesUpCommand}"
                                            Content="▲"
                                            Style="{StaticResource NumberAdjustButtonStyle}" />
                                        <Button
                                            Command="{Binding NumSamplesDownCommand}"
                                            Content="▼"
                                            Style="{StaticResource NumberAdjustButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Grid.Column="0"
                                    Width="80"
                                    Height="32"
                                    Margin="25,0,0,0"
                                    BorderThickness="0"
                                    Command="{Binding SaveConfigCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#3b82f6" />
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border
                                                            x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="3">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConfigurationLocked}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Setter Property="Opacity" Value="0.5" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Image
                                            Width="15"
                                            Height="15"
                                            Margin="5,0,5,0"
                                            Source="/Resources/Logo/save_white.png" />
                                        <TextBlock
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="White"
                                            Text="保存配置" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Grid.Column="1"
                                    Width="80"
                                    Height="32"
                                    Margin="0,0,0,0"
                                    BorderThickness="0"
                                    Command="{Binding LoadConfigCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#3b82f6" />
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border
                                                            x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="3">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConfigurationLocked}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Setter Property="Opacity" Value="0.5" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Image
                                            Width="15"
                                            Height="15"
                                            Margin="5,0,5,0"
                                            Source="/Resources/Logo/read.png" />
                                        <TextBlock
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="White"
                                            Text="加载配置" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Border
                        Background="#9ca3af"
                        IsHitTestVisible="False"
                        Opacity="0.15"
                        Visibility="{Binding IsLeftConfigLocked, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
                </Grid>
            </Border>

            <!--  右侧结果面板  -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*" />
                    <RowDefinition Height="45*" />
                </Grid.RowDefinitions>

                <!--  顶部信息栏  -->
                <Border
                    Grid.Row="0"
                    Margin="4,8,8,4"
                    Background="White"
                    BorderBrush="#D9D9D9"
                    BorderThickness="1.5"
                    CornerRadius="8">
                    <StackPanel
                        Height="30"
                        Margin="15,0,0,0"
                        Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Text="{Binding Model}" />
                        <TextBlock
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="15"
                            Text="板卡名称：" />
                        <Border
                            Grid.Column="1"
                            Width="120"
                            Height="30"
                            VerticalAlignment="Center"
                            BorderBrush="#D9D9D9"
                            BorderThickness="1"
                            CornerRadius="3">
                            <TextBox
                                x:Name="CardNameTextBox"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                BorderThickness="0"
                                FontSize="15"
                                IsReadOnly="{Binding IsTesting}"
                                Text="{Binding CardName, UpdateSourceTrigger=PropertyChanged}" />
                        </Border>

                        <StackPanel
                            Height="25"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="15"
                                Text="连接状态：" />
                            <Grid
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center">
                                <Ellipse
                                    Width="18"
                                    Height="18"
                                    Stroke="#d1d5db"
                                    StrokeThickness="0.5" />
                                <Ellipse
                                    Width="16"
                                    Height="16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill">
                                                <Setter.Value>
                                                    <RadialGradientBrush GradientOrigin="0.3,0.3">
                                                        <GradientStop Offset="0" Color="#ff6b6b" />
                                                        <GradientStop Offset="1" Color="#b91c1c" />
                                                    </RadialGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Fill">
                                                        <Setter.Value>
                                                            <RadialGradientBrush GradientOrigin="0.3,0.3">
                                                                <GradientStop Offset="0" Color="#4ade80" />
                                                                <GradientStop Offset="1" Color="#16a34a" />
                                                            </RadialGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>
                            <TextBlock
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="15"
                                Text="{Binding ConnectionStatus}" />
                        </StackPanel>

                        <Border Margin="15,0,0,0">
                            <Button
                                x:Name="ConnectButton"
                                Width="80"
                                Height="30"
                                Background="#3b82f6"
                                BorderThickness="0"
                                Command="{Binding ToggleDeviceCommand}"
                                Foreground="White">
                                <Button.IsEnabled>
                                    <MultiBinding Converter="{StaticResource BooleanAndConverter}">
                                        <Binding Converter="{StaticResource InverseBoolConverter}" Path="IsBusy" />
                                        <Binding Converter="{StaticResource InverseBoolConverter}" Path="IsTesting" />
                                    </MultiBinding>
                                </Button.IsEnabled>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="border"
                                            Background="#3b82f6"
                                            CornerRadius="4">
                                            <StackPanel Orientation="Horizontal">
                                                <Image
                                                    x:Name="DeviceImage"
                                                    Width="15"
                                                    Height="15"
                                                    Margin="5,0,5,0"
                                                    Source="/Resources/Logo/export.png" />
                                                <TextBlock
                                                    x:Name="DeviceAction"
                                                    Margin="0,0,5,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="White"
                                                    Text="打开板卡" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <!--  1. 已连接时的基础状态  -->
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Tag" Value="True" />
                                                <Setter TargetName="DeviceImage" Property="Source" Value="/Resources/Logo/import.png" />
                                                <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                                <Setter TargetName="DeviceAction" Property="Text" Value="关闭板卡" />
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                <Setter Property="Tag" Value="False" />
                                            </DataTrigger>

                                            <!--  2. 未连接 + 悬停  -->
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="Tag" Value="False" />
                                                    <Condition Property="IsMouseOver" Value="True" />
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                            </MultiTrigger>

                                            <!--  3. 未连接 + 按下  -->
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="Tag" Value="False" />
                                                    <Condition Property="IsPressed" Value="True" />
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                            </MultiTrigger>

                                            <!--  4. 已连接 + 悬停（优先级更高，放在后面）  -->
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="Tag" Value="True" />
                                                    <Condition Property="IsMouseOver" Value="True" />
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                            </MultiTrigger>

                                            <!--  5. 已连接 + 按下  -->
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="Tag" Value="True" />
                                                    <Condition Property="IsPressed" Value="True" />
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                            </MultiTrigger>

                                            <!--  6. 禁用状态（最高优先级）  -->
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Border>
                        <Border Margin="15,0,0,0">
                            <Button
                                x:Name="RunButton"
                                Width="80"
                                Height="30"
                                Background="#22c55e"
                                BorderThickness="0"
                                Command="{Binding RunLoopbackCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="3">
                                            <StackPanel Orientation="Horizontal">
                                                <Image
                                                    Width="15"
                                                    Height="15"
                                                    Margin="5,0,5,0"
                                                    Source="/Resources/Logo/begin.png" />
                                                <TextBlock
                                                    Margin="0,0,5,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="White"
                                                    Text="开始采集" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#16a34a" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#15803d" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Border>
                    </StackPanel>
                </Border>

                <!--  结果显示区域  -->
                <Border
                    Grid.Row="1"
                    Margin="4,8,8,8"
                    Background="White"
                    BorderBrush="#D9D9D9"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  结果标题  -->
                        <Border
                            Grid.Row="0"
                            Padding="16,12"
                            Background="#F9FAFB"
                            BorderBrush="#D9D9D9"
                            BorderThickness="0,0,0,1"
                            CornerRadius="8,8,0,0">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="运行结果" />
                        </Border>

                        <!--  输出参数  -->
                        <Grid Grid.Row="1" Margin="16,16,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock
                                    FontSize="15"
                                    Foreground="Black"
                                    Text="元素索引" />
                                <TextBox
                                    x:Name="IndexOfElementTextBox"
                                    Margin="0,10,0,0"
                                    Background="White"
                                    FontSize="14"
                                    IsReadOnly="True"
                                    Text="{Binding IndexOfElementText, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock
                                    FontSize="14"
                                    Foreground="Black"
                                    Text="触发采样位置 " />
                                <TextBox
                                    x:Name="TriggerSampleLocationTextBox"
                                    Margin="0,10,0,0"
                                    Background="White"
                                    FontSize="14"
                                    IsReadOnly="True"
                                    Text="{Binding TriggerSampleLocationText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>

                        <!--  数组显示  -->
                        <Border
                            Grid.Row="2"
                            Margin="16,8,16,8"
                            BorderBrush="#D9D9D9"
                            BorderThickness="1"
                            CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--  数组标题  -->
                                <Border
                                    Grid.Row="0"
                                    Padding="12,5"
                                    Background="#F9FAFB"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="0,0,0,1">
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Text="采集数组" />
                                </Border>

                                <!--  数组内容  -->
                                <ScrollViewer
                                    Grid.Row="1"
                                    MaxHeight="300"
                                    Style="{StaticResource SimpleScrollViewerStyle}">
                                    <ItemsControl
                                        x:Name="ArrayItemsControl"
                                        AlternationCount="1000000"
                                        ItemsSource="{Binding ArrayItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Padding="12,8"
                                                    BorderBrush="#F3F4F6"
                                                    BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            FontSize="14"
                                                            Foreground="Black"
                                                            Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource AlternationIndexToOneBasedConverter}}"
                                                            TextAlignment="Center" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="12,0,0,0"
                                                            FontSize="14"
                                                            Text="{Binding}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!--  数组统计  -->
                                <Border
                                    Grid.Row="2"
                                    Padding="12,5"
                                    Background="#F9FAFB"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="0,1,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            x:Name="ArrayCountText"
                                            FontSize="14"
                                            Foreground="Black"
                                            Text="{Binding ArrayCountText}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
