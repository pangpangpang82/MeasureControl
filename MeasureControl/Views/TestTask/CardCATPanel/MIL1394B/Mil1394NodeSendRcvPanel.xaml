<UserControl
    x:Class="MeasureControl.Views.TestTask.CardCATPanel.Mil1394B.Mil1394NodeSendRcvPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="550"
    Background="White"
    BorderBrush="Transparent"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  简洁的滚动条样式  -->
        <Style x:Key="SimpleScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="Transparent" BorderThickness="0">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Background" Value="#CCCCCC" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border
                                                                Background="{TemplateBinding Background}"
                                                                BorderThickness="0"
                                                                CornerRadius="4" />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#999999" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter Property="Background" Value="#666666" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  简洁的ScrollViewer样式  -->
        <Style x:Key="SimpleScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="8" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />

                            <ScrollBar
                                x:Name="PART_VerticalScrollBar"
                                Grid.Row="0"
                                Grid.Column="1"
                                Maximum="{TemplateBinding ScrollableHeight}"
                                Orientation="Vertical"
                                Style="{StaticResource SimpleScrollBarStyle}"
                                ViewportSize="{TemplateBinding ViewportHeight}"
                                Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                Value="{TemplateBinding VerticalOffset}" />

                            <ScrollBar
                                x:Name="PART_HorizontalScrollBar"
                                Grid.Row="1"
                                Grid.Column="0"
                                Maximum="{TemplateBinding ScrollableWidth}"
                                Orientation="Horizontal"
                                Style="{StaticResource SimpleScrollBarStyle}"
                                ViewportSize="{TemplateBinding ViewportWidth}"
                                Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                Value="{TemplateBinding HorizontalOffset}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  主要按钮样式（蓝色）  -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3b82f6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563eb" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--
        说明：
        - 外层ScrollViewer：当父容器高度不足时允许整体滚动，避免撑高"数据收发"区域
        - Grid第二行使用*：表格区在可用高度内伸缩
        - MaxHeight限制：防止面板超出父容器高度
    -->

    <ScrollViewer
        Background="White"
        HorizontalScrollBarVisibility="Disabled"
        PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
        Style="{StaticResource SimpleScrollViewerStyle}"
        VerticalScrollBarVisibility="Auto">

        <Grid
            MinHeight="0"
            Margin="8"
            Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="23*" />
                <ColumnDefinition Width="316*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  按钮栏（固定宽度，防止界面移动）  -->
            <Border
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Margin="0,0,0,5"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">
                <Grid Margin="4,4,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="90" />

                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="BtnStart"
                        Grid.Column="0"
                        MinWidth="70"
                        MaxWidth="70"
                        Margin="2"
                        Click="BtnStart_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="border"
                                    Background="#52c41a"
                                    CornerRadius="4">

                                    <TextBlock
                                        x:Name="DeviceAction"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Text="开始发送" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <!--  1. 已连接时的基础状态  -->
                                    <DataTrigger Binding="{Binding IsSending, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Tag" Value="True" />
                                        <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                        <Setter TargetName="DeviceAction" Property="Text" Value="停止发送" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding IsSending, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                        <Setter Property="Tag" Value="False" />
                                    </DataTrigger>

                                    <!--  2. 未连接 + 悬停  -->
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="False" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#237804" />
                                    </MultiTrigger>

                                    <!--  3. 未连接 + 按下  -->
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="False" />
                                            <Condition Property="IsPressed" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#237804" />
                                    </MultiTrigger>

                                    <!--  4. 已连接 + 悬停（优先级更高，放在后面）  -->
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="True" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                    </MultiTrigger>

                                    <!--  5. 已连接 + 按下  -->
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="True" />
                                            <Condition Property="IsPressed" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                    </MultiTrigger>

                                    <!--  6. 禁用状态（最高优先级）  -->
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button
                        x:Name="BtnRcv"
                        Grid.Column="1"
                        MinWidth="70"
                        MaxWidth="70"
                        Margin="2"
                        Click="BtnRcv_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="border"
                                    Background="#52c41a"
                                    CornerRadius="4">

                                    <TextBlock
                                        x:Name="DeviceAction"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Text="接收" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <!--  1. 已连接时的基础状态  -->
                                    <DataTrigger Binding="{Binding IsReceiving, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Tag" Value="True" />
                                        <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                        <Setter TargetName="DeviceAction" Property="Text" Value="停止接收" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding IsReceiving, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                        <Setter Property="Tag" Value="False" />
                                    </DataTrigger>

                                    <!--  2. 未连接 + 悬停  -->
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="False" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#237804" />
                                    </MultiTrigger>

                                    <!--  3. 未连接 + 按下  -->
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="False" />
                                            <Condition Property="IsPressed" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#237804" />
                                    </MultiTrigger>

                                    <!--  4. 已连接 + 悬停（优先级更高，放在后面）  -->
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="True" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                    </MultiTrigger>

                                    <!--  5. 已连接 + 按下  -->
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="True" />
                                            <Condition Property="IsPressed" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                    </MultiTrigger>

                                    <!--  6. 禁用状态（最高优先级）  -->
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button
                        x:Name="BtnBMStart"
                        Grid.Column="2"
                        MinWidth="85"
                        MaxWidth="85"
                        Margin="2"
                        Click="BtnBMStart_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="border"
                                    Background="#52c41a"
                                    CornerRadius="4">

                                    <TextBlock
                                        x:Name="DeviceAction"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Text="启动数据监控" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <!--  1. 已连接时的基础状态  -->
                                    <DataTrigger Binding="{Binding IsBMDataMonitorRunning, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Tag" Value="True" />
                                        <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                        <Setter TargetName="DeviceAction" Property="Text" Value="结束数据监控" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding IsBMDataMonitorRunning, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                        <Setter Property="Tag" Value="False" />
                                    </DataTrigger>

                                    <!--  2. 未连接 + 悬停  -->
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="False" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#237804" />
                                    </MultiTrigger>

                                    <!--  3. 未连接 + 按下  -->
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="False" />
                                            <Condition Property="IsPressed" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#237804" />
                                    </MultiTrigger>

                                    <!--  4. 已连接 + 悬停（优先级更高，放在后面）  -->
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="True" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                    </MultiTrigger>

                                    <!--  5. 已连接 + 按下  -->
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="True" />
                                            <Condition Property="IsPressed" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                    </MultiTrigger>

                                    <!--  6. 禁用状态（最高优先级）  -->
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button
                        x:Name="BtnBMDataClear"
                        Grid.Column="3"
                        MinWidth="70"
                        MaxWidth="70"
                        Margin="2"
                        Click="BtnBMDataClear_Click"
                        Content="清空数据"
                        Style="{StaticResource PrimaryButtonStyle}" />
                    <Button
                        x:Name="BtnSaveData"
                        Grid.Column="4"
                        MinWidth="60"
                        MaxWidth="60"
                        Margin="2"
                        Click="BtnSaveData_Click"
                        Content="保存数据"
                        Style="{StaticResource PrimaryButtonStyle}" />
                    <Button
                        x:Name="BtnDataReadFromFile"
                        Grid.Column="5"
                        MinWidth="80"
                        MaxWidth="80"
                        Margin="2"
                        Click="BtnDataReadFromFile_Click"
                        Content="从文件读取"
                        Style="{StaticResource PrimaryButtonStyle}" />

                </Grid>
            </Border>

            <!--  数据表格  -->
            <Border
                Grid.Row="1"
                Grid.ColumnSpan="2"
                MinHeight="0"
                VerticalAlignment="Stretch"
                Background="White"
                BorderBrush="Transparent"
                BorderThickness="1.5"
                CornerRadius="8">
                <TabControl VerticalAlignment="Stretch" Background="{x:Null}">
                    <TabItem BorderBrush="#FF95A1CE" Header="BM数据">
                        <!--  仅表格内滚动（纵/横），外层ScrollViewer只负责整体高度兜底  -->
                        <ScrollViewer
                            Margin="5"
                            CanContentScroll="True"
                            HorizontalScrollBarVisibility="Auto"
                            PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                            Style="{StaticResource SimpleScrollViewerStyle}"
                            VerticalScrollBarVisibility="Auto">
                            <DataGrid
                                x:Name="DgvBMData"
                                AutoGenerateColumns="False"
                                Background="White"
                                BorderBrush="#FF95A1CE"
                                BorderThickness="0"
                                CanUserAddRows="False"
                                HeadersVisibility="Column"
                                HorizontalScrollBarVisibility="Disabled"
                                SelectionChanged="DgvBMData_SelectionChanged"
                                SelectionMode="Single"
                                SelectionUnit="FullRow"
                                VerticalScrollBarVisibility="Disabled">
                                <DataGrid.Resources>
                                    <Style x:Key="CenterTextStyle" TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="50"
                                        Binding="{Binding Num}"
                                        ElementStyle="{StaticResource CenterTextStyle}"
                                        Header="Num" />
                                    <DataGridTextColumn
                                        Width="70"
                                        Binding="{Binding MsgType}"
                                        ElementStyle="{StaticResource CenterTextStyle}"
                                        Header="MsgType" />
                                    <DataGridTextColumn
                                        Width="50"
                                        Binding="{Binding MsgId}"
                                        ElementStyle="{StaticResource CenterTextStyle}"
                                        Header="Msg id" />
                                    <DataGridTextColumn
                                        Width="50"
                                        Binding="{Binding ChnnelID}"
                                        ElementStyle="{StaticResource CenterTextStyle}"
                                        Header="Chnnel ID" />
                                    <DataGridTextColumn
                                        Width="50"
                                        Binding="{Binding LRTC}"
                                        ElementStyle="{StaticResource CenterTextStyle}"
                                        Header="LRTC" />
                                    <DataGridTextColumn
                                        Width="50"
                                        Binding="{Binding RTC}"
                                        ElementStyle="{StaticResource CenterTextStyle}"
                                        Header="RTC" />
                                    <DataGridTextColumn
                                        Width="50"
                                        Binding="{Binding VPC}"
                                        ElementStyle="{StaticResource CenterTextStyle}"
                                        Header="VPC" />
                                    <DataGridTextColumn
                                        Width="50"
                                        Binding="{Binding CRC}"
                                        ElementStyle="{StaticResource CenterTextStyle}"
                                        Header="CRC" />
                                    <DataGridTextColumn
                                        Width="60"
                                        Binding="{Binding LenErr}"
                                        ElementStyle="{StaticResource CenterTextStyle}"
                                        Header="Len_err" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="校验数据">
                        <ScrollViewer
                            Margin="2"
                            HorizontalScrollBarVisibility="Auto"
                            PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                            Style="{StaticResource SimpleScrollViewerStyle}"
                            VerticalScrollBarVisibility="Auto">
                            <ListView x:Name="LvwCheckData" Background="White">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn
                                            Width="60"
                                            DisplayMemberBinding="{Binding Index}"
                                            Header="序号" />
                                        <GridViewColumn
                                            Width="150"
                                            DisplayMemberBinding="{Binding Time}"
                                            Header="时间" />
                                        <GridViewColumn DisplayMemberBinding="{Binding Data}" Header="数据" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </ScrollViewer>

</UserControl>
