<UserControl
    x:Class="MeasureControl.Views.TestTask.CardCATPanel.Mil1394B.Mil1394TestPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winForms="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
    d:DesignHeight="600"
    d:DesignWidth="1100"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ComboBoxStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  简洁的滚动条样式  -->
            <Style x:Key="SimpleScrollBarStyle" TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="8" />
                <Setter Property="MinWidth" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="Transparent" BorderThickness="0">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Style>
                                                <Style TargetType="Thumb">
                                                    <Setter Property="Background" Value="#CCCCCC" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderThickness="0"
                                                                    CornerRadius="4" />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#999999" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter Property="Background" Value="#666666" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Thumb.Style>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  简洁的ScrollViewer样式  -->
            <Style x:Key="SimpleScrollViewerStyle" TargetType="ScrollViewer">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="8" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ScrollContentPresenter
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="{TemplateBinding Padding}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />

                                <ScrollBar
                                    x:Name="PART_VerticalScrollBar"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Maximum="{TemplateBinding ScrollableHeight}"
                                    Orientation="Vertical"
                                    Style="{StaticResource SimpleScrollBarStyle}"
                                    ViewportSize="{TemplateBinding ViewportHeight}"
                                    Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                    Value="{TemplateBinding VerticalOffset}" />

                                <ScrollBar
                                    x:Name="PART_HorizontalScrollBar"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Maximum="{TemplateBinding ScrollableWidth}"
                                    Orientation="Horizontal"
                                    Style="{StaticResource SimpleScrollBarStyle}"
                                    ViewportSize="{TemplateBinding ViewportWidth}"
                                    Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                    Value="{TemplateBinding HorizontalOffset}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="White" Focusable="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="10*" />
            </Grid.RowDefinitions>

            <!--  标题栏 - 参考AnalogInputConfigPanel.xaml  -->
            <Border
                Grid.Row="0"
                Margin="5,8,8,4"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">
                <StackPanel Margin="10,5,0,5" Orientation="Horizontal">
                    <TextBlock
                        x:Name="Card_class"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Text="HZ-1394B 配置" />
                    <StackPanel Margin="10,0,0,0" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="测试任务：" />
                        <ComboBox
                            Width="140"
                            Height="27"
                            Margin="5,0,0,0"
                            ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                            ItemsSource="{Binding AvailableTestTasks}"
                            SelectedItem="{Binding SelectedTestTask, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.Style>
                                <Style BasedOn="{StaticResource CustomComboBoxStyle}" TargetType="ComboBox">
                                    <Setter Property="Opacity" Value="1" />
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="板卡名称：" />
                    <Border
                        Width="100"
                        Height="28"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        BorderBrush="#D9D9D9"
                        BorderThickness="1"
                        CornerRadius="3">
                        <TextBox
                            x:Name="CardNameTextBox"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            LostFocus="CardNameTextBox_LostFocus"
                            Text="{Binding CardName, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="连接状态：" />
                        <Grid
                            Width="18"
                            Height="18"
                            Margin="5,0,0,0">
                            <Ellipse
                                Width="18"
                                Height="18"
                                Stroke="#d1d5db"
                                StrokeThickness="0.5" />
                            <Ellipse
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill">
                                            <Setter.Value>
                                                <RadialGradientBrush GradientOrigin="0.3,0.3">
                                                    <GradientStop Offset="0" Color="#ff6b6b" />
                                                    <GradientStop Offset="1" Color="#dc2626" />
                                                </RadialGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                                                <Setter Property="Fill">
                                                    <Setter.Value>
                                                        <RadialGradientBrush GradientOrigin="0.3,0.3">
                                                            <GradientStop Offset="0" Color="#4ade80" />
                                                            <GradientStop Offset="1" Color="#16a34a" />
                                                        </RadialGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>
                        <TextBlock
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="{Binding ConnectionStatus}" />
                        <Border Margin="5,0,0,0">
                            <Button
                                Width="80"
                                Height="25"
                                Background="#3b82f6"
                                BorderThickness="0"
                                Command="{Binding ToggleDeviceCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="4">
                                            <StackPanel Orientation="Horizontal">
                                                <Image
                                                    Width="15"
                                                    Height="15"
                                                    Margin="5,0,5,0"
                                                    Source="/Resources/Logo/export.png" />
                                                <TextBlock
                                                    x:Name="DeviceAction"
                                                    Margin="0,0,5,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="White"
                                                    Text="连接板卡" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                                <Setter TargetName="DeviceAction" Property="Text" Value="断开连接" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsDeviceConnected}" Value="True" />
                                                    <Condition Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsMouseOver}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="border" Property="Background" Value="#dc2626" />
                                            </MultiDataTrigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Border>
                        <Button
                            Width="80"
                            Height="25"
                            Margin="5,0,0,0"
                            Background="#3b82f6"
                            BorderThickness="0"
                            Command="{Binding SwitchToNodeConfigCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="4">
                                        <TextBlock
                                            Margin="5,0,5,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="White"
                                            Text="节点配置" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button
                            Width="80"
                            Height="25"
                            Margin="5,0,0,0"
                            Background="#3b82f6"
                            BorderThickness="0"
                            Command="{Binding SwitchToDataTransferCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="4">
                                        <TextBlock
                                            Margin="5,0,5,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="White"
                                            Text="数据收发" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  WPF内容容器  -->
            <Border
                x:Name="HostBorder"
                Grid.Row="1"
                Margin="5,5,8,8"
                BorderBrush="#D9D9D9"
                BorderThickness="1"
                ClipToBounds="True"
                CornerRadius="8">
                <Grid x:Name="ContentGrid" ClipToBounds="True">
                    <!--  WPF内容将通过代码添加到这里  -->
                </Grid>
            </Border>

            <!--  加载提示  -->
            <Grid Grid.Row="1" Background="#E0FFFFFF">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock
                        Margin="0,10"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Text="正在加载1394B板卡界面..." />
                    <TextBlock
                        Margin="0,5"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="Gray"
                        Text="{Binding StatusMessage}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
