<UserControl
    x:Class="MeasureControl.Views.TestTask.CardCATPanel.Mil1394B.Mil1394NodeConfigPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:MeasureControl.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="400"
    d:DesignWidth="950"
    Background="White"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ComboBoxStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  16进制转换器（用于MessageID显示）  -->
            <helpers:IntToHexConverter x:Key="IntToHexConverter" />

            <!--  简洁的滚动条样式  -->
            <Style x:Key="SimpleScrollBarStyle" TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="8" />
                <Setter Property="MinWidth" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="Transparent" BorderThickness="0">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Style>
                                                <Style TargetType="Thumb">
                                                    <Setter Property="Background" Value="#CCCCCC" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderThickness="0"
                                                                    CornerRadius="4" />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#999999" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter Property="Background" Value="#666666" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Thumb.Style>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  简洁的ScrollViewer样式  -->
            <Style x:Key="SimpleScrollViewerStyle" TargetType="ScrollViewer">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="8" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ScrollContentPresenter
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="{TemplateBinding Padding}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />

                                <ScrollBar
                                    x:Name="PART_VerticalScrollBar"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Maximum="{TemplateBinding ScrollableHeight}"
                                    Orientation="Vertical"
                                    Style="{StaticResource SimpleScrollBarStyle}"
                                    ViewportSize="{TemplateBinding ViewportHeight}"
                                    Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                    Value="{TemplateBinding VerticalOffset}" />

                                <ScrollBar
                                    x:Name="PART_HorizontalScrollBar"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Maximum="{TemplateBinding ScrollableWidth}"
                                    Orientation="Horizontal"
                                    Style="{StaticResource SimpleScrollBarStyle}"
                                    ViewportSize="{TemplateBinding ViewportWidth}"
                                    Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                    Value="{TemplateBinding HorizontalOffset}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  主要按钮样式（蓝色）  -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#3b82f6" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  成功按钮样式（绿色）  -->
            <Style x:Key="SuccessButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#52c41a" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#389e0d" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#237804" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        MaxWidth="1200"
        Margin="8"
        Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" />
            <ColumnDefinition Width="600" />
        </Grid.ColumnDefinitions>

        <!--  左侧：节点初始化 + STOF配置和异步流包接收配置  -->

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  节点初始化区域  -->
            <Border
                Grid.Row="0"
                Margin="5,5,5,5"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Margin="5">
                    <TextBlock
                        Margin="0,0,0,8"
                        FontWeight="Bold"
                        Text="节点初始化" />
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Text="发送速率：" />
                        <Border
                            Grid.Column="1"
                            BorderBrush="#D9D9D9"
                            BorderThickness="1"
                            CornerRadius="3">
                            <ComboBox
                                x:Name="ComboBoxNodeRate"
                                Height="25"
                                Margin="10,0,2,0"
                                BorderThickness="0"
                                ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                                SelectedIndex="2"
                                Style="{StaticResource CustomComboBoxStyle}">
                                <ComboBoxItem Content="100M" />
                                <ComboBoxItem Content="200M" />
                                <ComboBoxItem Content="400M" />
                            </ComboBox>
                        </Border>
                    </Grid>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Text="节点类型：" />
                        <Border
                            Grid.Column="1"
                            BorderBrush="#D9D9D9"
                            BorderThickness="1"
                            CornerRadius="3">
                            <ComboBox
                                x:Name="ComboBoxNodeType"
                                Height="25"
                                Margin="10,0,2,0"
                                BorderThickness="0"
                                ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                                SelectedIndex="2"
                                Style="{StaticResource CustomComboBoxStyle}">
                                <ComboBoxItem Content="CC" />
                                <ComboBoxItem Content="RN" />
                                <ComboBoxItem Content="BM" />
                            </ComboBox>
                        </Border>
                    </Grid>
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Text="BM使能：" />
                        <CheckBox
                            x:Name="CbxEnableBM"
                            Grid.Column="1"
                            Content="使能/取消"
                            IsChecked="True" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  STOF配置和异步流包接收配置切换区域  -->
            <Border
                Grid.Row="1"
                Margin="5,0,5,5"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1"
                CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  切换按钮区域  -->
                    <UniformGrid
                        Grid.Row="0"
                        Margin="4"
                        Columns="2">
                        <Button
                            x:Name="BtnSTOFConfig"
                            Margin="2,0"
                            Click="BtnSTOFConfig_Click"
                            Content="STOF配置"
                            Style="{StaticResource PrimaryButtonStyle}" />
                        <Button
                            x:Name="BtnAsyncReceiveConfig"
                            Margin="2,0"
                            Click="BtnAsyncReceiveConfig_Click"
                            Content="异步流包接收配置"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    </UniformGrid>

                    <!--  STOF配置内容区域  -->
                    <Border
                        x:Name="STOFConfigPanel"
                        Grid.Row="1"
                        Visibility="Visible">
                        <ScrollViewer
                            Margin="12"
                            HorizontalScrollBarVisibility="Disabled"
                            PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                            Style="{StaticResource SimpleScrollViewerStyle}"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Text="发送方式：" />
                                    <Border
                                        Grid.Column="1"
                                        BorderBrush="#D9D9D9"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <ComboBox
                                            x:Name="CboSTOFSendStyle"
                                            Height="25"
                                            Margin="10,0,2,0"
                                            BorderThickness="0"
                                            ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                                            SelectedIndex="1"
                                            SelectionChanged="CboSTOFSendStyle_SelectionChanged"
                                            Style="{StaticResource CustomComboBoxStyle}">
                                            <ComboBoxItem Content="按周期" />
                                            <ComboBoxItem Content="按次数" />
                                        </ComboBox>
                                    </Border>
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Text="周期间隔(ms)：" />
                                    <Border
                                        Grid.Column="1"
                                        BorderBrush="#D9D9D9"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <TextBox
                                            x:Name="TxtSTOFPeriod"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            BorderThickness="0"
                                            IsEnabled="False"
                                            Text="15" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Text="发送次数：" />
                                    <Border
                                        Grid.Column="1"
                                        BorderBrush="#D9D9D9"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <TextBox
                                            x:Name="TxtSTOFSendTimes"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            BorderThickness="0"
                                            IsEnabled="True"
                                            Text="100" />
                                    </Border>
                                </Grid>

                                <!--  STOF Payload配置  -->
                                <TextBlock
                                    Margin="0,8,0,5"
                                    FontWeight="Bold"
                                    Text="STOF Payload配置：" />
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Text="STOFPayload0：" />
                                    <Border
                                        Grid.Column="1"
                                        BorderBrush="#D9D9D9"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <TextBox
                                            x:Name="TextBox0"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            BorderThickness="0"
                                            Text="0" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Text="STOFPayload1：" />
                                    <Border
                                        Grid.Column="1"
                                        BorderBrush="#D9D9D9"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <TextBox
                                            x:Name="TextBox1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            BorderThickness="0"
                                            Text="0" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Text="STOFPayload2：" />
                                    <Border
                                        Grid.Column="1"
                                        BorderBrush="#D9D9D9"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <TextBox
                                            x:Name="TextBox2"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            BorderThickness="0"
                                            Text="0" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Text="STOFPayload3：" />
                                    <Border
                                        Grid.Column="1"
                                        BorderBrush="#D9D9D9"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <TextBox
                                            x:Name="TextBox3"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            BorderThickness="0"
                                            Text="0" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Text="STOFPayload4：" />
                                    <Border
                                        Grid.Column="1"
                                        BorderBrush="#D9D9D9"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <TextBox
                                            x:Name="TextBox4"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            BorderThickness="0"
                                            Text="0" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Text="STOFPayload5：" />
                                    <Border
                                        Grid.Column="1"
                                        BorderBrush="#D9D9D9"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <TextBox
                                            x:Name="TextBox5"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            BorderThickness="0"
                                            Text="0" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Text="STOFPayload6：" />
                                    <Border
                                        Grid.Column="1"
                                        BorderBrush="#D9D9D9"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <TextBox
                                            x:Name="TextBox6"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            BorderThickness="0"
                                            Text="0" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Text="STOFPayload7：" />
                                    <Border
                                        Grid.Column="1"
                                        BorderBrush="#D9D9D9"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <TextBox
                                            x:Name="TextBox7"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            BorderThickness="0"
                                            Text="0" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Text="STOFPayload8：" />
                                    <Border
                                        Grid.Column="1"
                                        BorderBrush="#D9D9D9"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <TextBox
                                            x:Name="TextBox8"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            BorderThickness="0"
                                            Text="0" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Text="STOFVPC：" />
                                    <Border
                                        Grid.Column="1"
                                        BorderBrush="#D9D9D9"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <TextBox
                                            x:Name="TextBoxSTOFVPC"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            BorderThickness="0"
                                            Text="0" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!--  异步流包接收配置内容区域  -->
                    <Border
                        x:Name="AsyncReceiveConfigPanel"
                        Grid.Row="1"
                        Visibility="Collapsed">
                        <ScrollViewer
                            Margin="12"
                            HorizontalScrollBarVisibility="Disabled"
                            PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                            Style="{StaticResource SimpleScrollViewerStyle}"
                            VerticalScrollBarVisibility="Disabled">
                            <StackPanel>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Text="接收通道：" />
                                    <Border
                                        Grid.Column="1"
                                        Width="100"
                                        HorizontalAlignment="Left"
                                        BorderBrush="#D9D9D9"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <TextBox
                                            x:Name="RecvAsyncChannel"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            BorderThickness="0"
                                            Text="0" />
                                    </Border>
                                </Grid>

                                <Border
                                    Height="400"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <DataGrid
                                        x:Name="DgvRecvAsync"
                                        AutoGenerateColumns="False"
                                        Background="White"
                                        BorderThickness="0"
                                        CanUserAddRows="False"
                                        CanUserDeleteRows="False"
                                        ColumnWidth="*"
                                        HeadersVisibility="Column"
                                        HorizontalScrollBarVisibility="Disabled"
                                        Loaded="DgvRecvAsync_Loaded"
                                        SelectionMode="Single"
                                        SelectionUnit="FullRow"
                                        VerticalScrollBarVisibility="Disabled">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Width="80">
                                                <DataGridTemplateColumn.Header>
                                                    <CheckBox
                                                        x:Name="RecvChk"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Checked="RecvChk_Checked"
                                                        Content="全选/取消"
                                                        Unchecked="RecvChk_Unchecked" />
                                                </DataGridTemplateColumn.Header>
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox HorizontalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Binding="{Binding MsgID}" Header="MsgID" />
                                            <DataGridTextColumn Binding="{Binding DataLength}" Header="RcvDataLength" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>


        <!--  右侧：数据配置  -->
        <Grid Grid.Column="1" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.4*" />
                <RowDefinition Height="5*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  数据配置按钮  -->
            <Border
                Grid.Row="0"
                Margin="0,0,0,0"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Margin="8">
                    <TextBlock
                        Margin="0,0,0,8"
                        FontWeight="Bold"
                        Text="异步流包数据配置" />
                    <UniformGrid Columns="3">
                        <Button
                            x:Name="BtnAddAsync"
                            Margin="2"
                            Click="BtnAddAsync_Click"
                            Content="添加异步数据"
                            Style="{StaticResource PrimaryButtonStyle}" />
                        <Button
                            x:Name="BtnDel"
                            Margin="2"
                            Click="BtnDel_Click"
                            Content="删除数据"
                            Style="{StaticResource PrimaryButtonStyle}" />
                        <Button
                            x:Name="BtnChange"
                            Margin="2"
                            Click="BtnChange_Click"
                            Content="编辑数据"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!--  数据表格  -->
            <Border
                Grid.Row="1"
                Height="255"
                Margin="0,0,0,8"
                BorderBrush="#D9D9D9"
                BorderThickness="1"
                CornerRadius="3">
                <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                    Style="{StaticResource SimpleScrollViewerStyle}"
                    VerticalScrollBarVisibility="Auto">
                    <DataGrid
                        x:Name="Dgv1394CfgData"
                        AutoGenerateColumns="False"
                        Background="White"
                        BorderThickness="0"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        HeadersVisibility="Column"
                        HorizontalScrollBarVisibility="Disabled"
                        SelectionChanged="Dgv1394CfgData_SelectionChanged"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        VerticalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="*" Header="消息编号">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{Binding MessageID, Converter={StaticResource IntToHexConverter}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Channel}"
                                Header="通道号" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Heartbeat}"
                                Header="心跳字" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Health}"
                                Header="健康字" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding HeartbeatStep}"
                                Header="心跳步长" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding PayloadLength, TargetNullValue=64}"
                                Header="负载长度" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding SendOffset}"
                                Header="发送偏移" />
                            <DataGridCheckBoxColumn
                                Width="*"
                                Binding="{Binding VPC}"
                                Header="VPC" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding VPCAsync}"
                                Header="VPCASYNC" />
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>
            </Border>

            <!--  保存配置和读取配置按钮  -->
            <Grid Grid.Row="2" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="BtnSaveConfig"
                    Grid.Column="1"
                    Width="80"
                    Height="32"
                    Margin="0,0,15,0"
                    HorizontalAlignment="Center"
                    Background="#3b82f6"
                    BorderThickness="0"
                    Click="ConfigOk_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                                <StackPanel Orientation="Horizontal">
                                    <Image
                                        Width="18"
                                        Height="18"
                                        Margin="5,0,5,0"
                                        Source="/Resources/Logo/save_white.png" />
                                    <TextBlock
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Text="保存配置" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button
                    x:Name="BtnReadConfig"
                    Grid.Column="2"
                    Width="80"
                    Height="32"
                    HorizontalAlignment="Center"
                    Background="#3b82f6"
                    BorderThickness="0"
                    Click="RestoreConfigState_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                                <StackPanel Orientation="Horizontal">
                                    <Image
                                        Width="15"
                                        Height="15"
                                        Margin="5,0,5,0"
                                        Source="/Resources/Logo/read.png" />
                                    <TextBlock
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Text="读取配置" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Grid>

</UserControl>
