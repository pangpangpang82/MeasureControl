                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="55"
                            Height="45"
                            Background="White"
                            BorderBrush="#D9D9D9"
                            BorderThickness="2"
                            CornerRadius="8">
                            <Button
                                Background="White"
                                Command="{Binding ToggleRelayCommand}"
                                CommandParameter="1"
                                Content="DO1"
                                FontSize="16"
                                IsEnabled="{Binding CanUseRelay}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="border"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="White"
                                            BorderThickness="0"
                                            CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding RelayChannels[1].IsOn}" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#93c5fd" />
                                            </DataTrigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="border" Property="Opacity" Value="0.5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Border>
                        <Border
                            Grid.Row="0"
                            Grid.Column="2"
                            Width="55"
                            Height="45"
                            Background="White"
                            BorderBrush="#D9D9D9"
                            BorderThickness="2"
                            CornerRadius="8">
                            <Button
                                Background="White"
                                Command="{Binding ToggleRelayCommand}"
                                CommandParameter="2"
                                Content="DO2"
                                FontSize="16"
                                IsEnabled="{Binding CanUseRelay}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="border"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="White"
                                            BorderThickness="0"
                                            CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding RelayChannels[2].IsOn}" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#93c5fd" />
