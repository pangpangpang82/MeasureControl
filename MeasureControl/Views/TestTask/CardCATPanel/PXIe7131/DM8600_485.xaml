                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="White"
                    Text="电源/继电器配置" />
                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Width="30"
                        Height="30"
                        VerticalAlignment="Center"
                        Click="MinimizeWindow"
                        Style="{StaticResource DialogButtonStyle}">
                        <Image
                            Width="35"
                            Height="35"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="/Resources/Logo/min.png" />
                    </Button>
                    <Button
                        Width="30"
                        Height="30"
                        VerticalAlignment="Center"
                        Click="CloseWindow"
                        Content="✖"
                        FontSize="16"
                        Style="{StaticResource DialogButtonStyle}" />
                </StackPanel>
            </Grid>

