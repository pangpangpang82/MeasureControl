<UserControl
    x:Class="MeasureControl.Views.TestTask.CardCATPanel.PXI7012_RO"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:MeasureControl.Helpers"
    xmlns:local="clr-namespace:MeasureControl.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="550"
    d:DesignWidth="970"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  布尔值转可见性转换器  -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!--  布尔值反转转换器  -->
        <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />

        <!--  简洁的滚动条样式  -->
        <Style x:Key="SimpleScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="Transparent" BorderThickness="0">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Background" Value="#CCCCCC" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border
                                                                Background="{TemplateBinding Background}"
                                                                BorderThickness="0"
                                                                CornerRadius="4" />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#999999" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter Property="Background" Value="#666666" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  简洁的ScrollViewer样式  -->
        <Style x:Key="SimpleScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="8" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />

                            <ScrollBar
                                x:Name="PART_VerticalScrollBar"
                                Grid.Row="0"
                                Grid.Column="1"
                                Maximum="{TemplateBinding ScrollableHeight}"
                                Orientation="Vertical"
                                Style="{StaticResource SimpleScrollBarStyle}"
                                ViewportSize="{TemplateBinding ViewportHeight}"
                                Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                Value="{TemplateBinding VerticalOffset}" />

                            <ScrollBar
                                x:Name="PART_HorizontalScrollBar"
                                Grid.Row="1"
                                Grid.Column="0"
                                Maximum="{TemplateBinding ScrollableWidth}"
                                Orientation="Horizontal"
                                Style="{StaticResource SimpleScrollBarStyle}"
                                ViewportSize="{TemplateBinding ViewportWidth}"
                                Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                Value="{TemplateBinding HorizontalOffset}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  使能CheckBox样式  -->
        <Style x:Key="EnableCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border
                                x:Name="checkBoxBorder"
                                Width="16"
                                Height="16"
                                Background="White"
                                BorderBrush="#D9D9D9"
                                BorderThickness="1"
                                CornerRadius="2">
                                <Path
                                    x:Name="checkMark"
                                    Data="M 2 8 L 6 12 L 14 4"
                                    Stroke="White"
                                    StrokeThickness="2"
                                    Visibility="Collapsed" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkBoxBorder" Property="Background" Value="#3b82f6" />
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#3b82f6" />
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#3b82f6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  全局配置锁定下拉框样式  -->
        <Style
            x:Key="ConfigLockedComboBoxStyle"
            BasedOn="{StaticResource CustomComboBoxStyle}"
            TargetType="ComboBox">
            <Setter Property="Opacity" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConfigurationLocked}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Opacity" Value="0.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  全局配置锁定输入框边框样式  -->
        <Style x:Key="ConfigLockedBorderStyle" TargetType="Border">
            <Setter Property="Opacity" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConfigurationLocked}" Value="True">
                    <Setter Property="Opacity" Value="0.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  开关按钮样式  -->
        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="48" Height="22">
                            <!--  背景条  -->
                            <Border x:Name="Track" CornerRadius="11">
                                <Border.Background>
                                    <SolidColorBrush Color="#e5e7eb" />
                                </Border.Background>
                            </Border>
                            <!--  滑块  -->
                            <Border
                                x:Name="Thumb"
                                Width="20"
                                Height="20"
                                Margin="1"
                                HorizontalAlignment="Left"
                                Background="White"
                                CornerRadius="10">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" />
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="4"
                                        Opacity="0.3"
                                        ShadowDepth="1" />
                                </Border.Effect>
                            </Border>
                            <!--  文本  -->
                            <TextBlock
                                x:Name="ContentText"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="#374151"
                                Text="关" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!--  开关状态：IsChecked=True 表示开  -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ContentText" Property="Text" Value="开" />
                                <Setter TargetName="ContentText" Property="Foreground" Value="White" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation
                                                Storyboard.TargetName="Track"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#22c55e"
                                                Duration="0:0:0.15" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="ThumbTransform"
                                                Storyboard.TargetProperty="X"
                                                To="26"
                                                Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation
                                                Storyboard.TargetName="Track"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#e5e7eb"
                                                Duration="0:0:0.15" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="ThumbTransform"
                                                Storyboard.TargetProperty="X"
                                                To="0"
                                                Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <!--  鼠标悬停时略微加深背景  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DisabledSectionBorderStyle" TargetType="Border">
            <Setter Property="Opacity" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.6" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border
        Background="White"
        Focusable="True"
        MouseDown="Border_MouseDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <!--  左侧再加宽一些，右侧略收窄，减少留白  -->
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1.9*" />
            </Grid.ColumnDefinitions>

            <!--  左侧：板卡信息  -->
            <Border
                x:Name="Card_name"
                Grid.Column="0"
                Margin="8,8,4,8"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8"
                Style="{StaticResource DisabledSectionBorderStyle}">

                <StackPanel Orientation="Vertical">

                    <TextBlock
                        x:Name="Card_class"
                        Margin="15,10,0,0"
                        FontSize="16"
                        FontWeight="Bold"
                        Text="{Binding CardModel, StringFormat='{}{0} 配置'}" />

                    <StackPanel Margin="15,10,0,0" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="测试任务：" />

                        <ComboBox
                            Width="220"
                            Height="30"
                            ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                            ItemsSource="{Binding AvailableTestTasks}"
                            SelectedItem="{Binding SelectedTestTask, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource ConfigLockedComboBoxStyle}">
                            <ComboBox.IsEnabled>
                                <Binding Path="HasTestTaskOptions" />
                            </ComboBox.IsEnabled>
                        </ComboBox>
                    </StackPanel>

                    <!--  输出模式  -->
                    <TextBlock
                        Margin="15,10,0,5"
                        FontSize="16"
                        FontWeight="Bold"
                        Text="输出参数" />
                    <StackPanel Margin="15,10,0,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="输出模式：" />

                        <ComboBox
                            Width="220"
                            Height="30"
                            HorizontalAlignment="Left"
                            ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                            SelectedValue="{Binding OutputMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedValuePath="Content"
                            Style="{StaticResource ConfigLockedComboBoxStyle}">
                            <ComboBoxItem Content="无等待，禁止建立时间" />
                            <ComboBoxItem Content="先断后连" />
                            <ComboBoxItem Content="先通后断" />
                            <ComboBoxItem Content="立即执行后，等待建立时间" />
                        </ComboBox>
                    </StackPanel>

                    <!--  通道配置（左侧）：通道、偏移值、修改值、使能  -->
                    <TextBlock
                        Margin="15,10,0,0"
                        FontSize="16"
                        FontWeight="Bold"
                        Text="通道配置" />

                    <!--  表头  -->
                    <Border
                        Width="335"
                        MaxHeight="335"
                        Margin="15,10,0,15"
                        HorizontalAlignment="Left"
                        BorderBrush="#D9D9D9"
                        BorderThickness="1.5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Grid.ColumnSpan="4"
                                    Background="#F5F5F5"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="0,0,0,1.5" />

                                <Border
                                    Grid.Column="0"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="0,0,1.5,0">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Text="通道" />
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="0,0,1.5,0">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Text="偏移值 (Ω)" />
                                </Border>

                                <Border
                                    Grid.Column="2"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="0,0,1.5,0">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Text="设定值 (Ω)" />
                                </Border>

                                <Border Grid.Column="3" BorderBrush="#D9D9D9">
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Text="使能" />
                                        <CheckBox
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding IsAllEnabled, Mode=TwoWay}"
                                            IsEnabled="{Binding IsConfigurationLocked, Converter={StaticResource InverseBoolConverter}}"
                                            Style="{StaticResource EnableCheckBoxStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>


                            <!--  通道配置列表  -->
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Channels}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="32" Background="White">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>

                                            <!--  通道名称  -->
                                            <Border
                                                Grid.Column="0"
                                                BorderBrush="#D9D9D9"
                                                BorderThickness="0,0,1,1">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="{Binding ChannelName}" />
                                            </Border>

                                            <!--  偏移值  -->
                                            <Border
                                                Grid.Column="1"
                                                Padding="8,2"
                                                BorderBrush="#D9D9D9"
                                                BorderThickness="0,0,1,1">
                                                <Border
                                                    Background="White"
                                                    BorderBrush="#D9D9D9"
                                                    BorderThickness="1"
                                                    CornerRadius="3">
                                                    <TextBox
                                                        Height="24"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        FontSize="16"
                                                        GotFocus="ResistanceValueTextBox_GotFocus"
                                                        LostFocus="ResistanceValueTextBox_LostFocus"
                                                        Text="{Binding Offset, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F3}'}" />
                                                </Border>
                                            </Border>

                                            <!--  设定值  -->
                                            <Border
                                                Grid.Column="2"
                                                Padding="8,2"
                                                BorderBrush="#D9D9D9"
                                                BorderThickness="0,0,1,1">
                                                <Border
                                                    Background="White"
                                                    BorderBrush="#D9D9D9"
                                                    BorderThickness="1"
                                                    CornerRadius="3">
                                                    <TextBox
                                                        Height="24"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        FontSize="16"
                                                        GotFocus="ResistanceValueTextBox_GotFocus"
                                                        LostFocus="ResistanceValueTextBox_LostFocus"
                                                        Text="{Binding TargetResistance, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F3}'}" />
                                                </Border>
                                            </Border>

                                            <!--  使能开关  -->
                                            <Border
                                                Grid.Column="3"
                                                BorderBrush="#D9D9D9"
                                                BorderThickness="0,0,0,1">
                                                <CheckBox
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                    IsEnabled="{Binding DataContext.CanEditChannelEnable, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Style="{StaticResource EnableCheckBoxStyle}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Grid>
                        <Border Margin="10,0,0,0">
                            <Button
                                Width="80"
                                Height="32"
                                Margin="60,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                BorderThickness="0"
                                Command="{Binding SaveConfigCommand}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#3b82f6" />
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border
                                                        x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="3">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConfigurationLocked}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Setter Property="Opacity" Value="0.5" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Image
                                        Width="18"
                                        Height="18"
                                        Margin="5,0,5,0"
                                        Source="/Resources/Logo/save_white.png" />
                                    <TextBlock
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Text="保存配置" />
                                </StackPanel>
                            </Button>
                        </Border>
                        <Border Margin="10,0,10,0">
                            <Button
                                Width="80"
                                Height="32"
                                Margin="130,0,0,0"
                                VerticalAlignment="Center"
                                BorderThickness="0"
                                Command="{Binding ReloadConfigCommand}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#3b82f6" />
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border
                                                        x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="3">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConfigurationLocked}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Setter Property="Opacity" Value="0.5" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Image
                                        Width="15"
                                        Height="15"
                                        Margin="5,0,5,0"
                                        Source="/Resources/Logo/read.png" />
                                    <TextBlock
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Text="读取配置" />
                                </StackPanel>
                            </Button>
                        </Border>
                    </Grid>

                </StackPanel>

            </Border>

            <!--  右侧：9个通道配置区域  -->

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*" />
                    <RowDefinition Height="45*" />
                </Grid.RowDefinitions>


                <Border
                    Grid.Row="0"
                    Margin="4,8,8,4"
                    Background="White"
                    BorderBrush="#D9D9D9"
                    BorderThickness="1.5"
                    CornerRadius="8">
                    <StackPanel
                        Height="30"
                        Margin="15,0,0,0"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="板卡名称：" />
                        <StackPanel Margin="15,0,0,0" Orientation="Horizontal">
                            <Border
                                x:Name="card_name"
                                Width="120"
                                Height="30"
                                VerticalAlignment="Center"
                                BorderBrush="#D9D9D9"
                                BorderThickness="1"
                                CornerRadius="3">
                                <TextBox
                                    x:Name="CardNameTextBox"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    BorderThickness="0"
                                    LostFocus="CardNameTextBox_LostFocus"
                                    Text="{Binding CardName, UpdateSourceTrigger=PropertyChanged}" />
                            </Border>
                        </StackPanel>

                        <Border>
                            <StackPanel
                                Height="25"
                                Margin="15,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="连接状态：" />
                                <Grid Width="18" Height="18">
                                    <Ellipse
                                        Width="18"
                                        Height="18"
                                        Stroke="#d1d5db"
                                        StrokeThickness="0.5" />
                                    <Ellipse
                                        Width="16"
                                        Height="16"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill">
                                                    <Setter.Value>
                                                        <RadialGradientBrush GradientOrigin="0.3,0.3">
                                                            <GradientStop Offset="0" Color="#ff6b6b" />
                                                            <GradientStop Offset="1" Color="#b91c1c" />
                                                        </RadialGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                                                        <Setter Property="Fill">
                                                            <Setter.Value>
                                                                <RadialGradientBrush GradientOrigin="0.3,0.3">
                                                                    <GradientStop Offset="0" Color="#4ade80" />
                                                                    <GradientStop Offset="1" Color="#16a34a" />
                                                                </RadialGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Grid>
                                <TextBlock
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="{Binding ConnectionStatus}" />

                            </StackPanel>
                        </Border>

                        <Border Margin="10,0,0,0">
                            <Button
                                Width="80"
                                Height="30"
                                VerticalAlignment="Center"
                                BorderThickness="0"
                                Command="{Binding ToggleDeviceCommand}">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="border"
                                            Background="#3b82f6"
                                            CornerRadius="4">
                                            <StackPanel Orientation="Horizontal">
                                                <Image
                                                    x:Name="DeviceImage"
                                                    Width="15"
                                                    Height="15"
                                                    Margin="5,0,5,0"
                                                    Source="/Resources/Logo/export.png" />
                                                <TextBlock
                                                    x:Name="DeviceAction"
                                                    Margin="0,0,5,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="White"
                                                    Text="打开板卡" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <!--  1. 已连接时的基础状态  -->
                                            <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                                                <Setter Property="Tag" Value="True" />
                                                <Setter TargetName="DeviceImage" Property="Source" Value="/Resources/Logo/import.png" />
                                                <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                                <Setter TargetName="DeviceAction" Property="Text" Value="关闭板卡" />
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding IsDeviceConnected}" Value="False">
                                                <Setter Property="Tag" Value="False" />
                                            </DataTrigger>

                                            <!--  2. 未连接 + 悬停  -->
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="Tag" Value="False" />
                                                    <Condition Property="IsMouseOver" Value="True" />
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                            </MultiTrigger>

                                            <!--  3. 未连接 + 按下  -->
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="Tag" Value="False" />
                                                    <Condition Property="IsPressed" Value="True" />
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                            </MultiTrigger>

                                            <!--  4. 已连接 + 悬停（优先级更高，放在后面）  -->
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="Tag" Value="True" />
                                                    <Condition Property="IsMouseOver" Value="True" />
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                            </MultiTrigger>

                                            <!--  5. 已连接 + 按下  -->
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="Tag" Value="True" />
                                                    <Condition Property="IsPressed" Value="True" />
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                            </MultiTrigger>

                                            <!--  6. 禁用状态（最高优先级）  -->
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Border>

                    </StackPanel>
                </Border>

                <Border
                    x:Name="current_data"
                    Grid.Row="2"
                    Margin="4,4,8,8"
                    Background="White"
                    BorderBrush="#D9D9D9"
                    BorderThickness="1.5"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            Margin="15,10,0,0"
                            FontSize="16"
                            FontWeight="Bold"
                            Text="电阻信息" />
                        <!--  表头（右侧）：仅显示已使能通道的状态与操作  -->
                        <Border
                            Grid.Row="0"
                            Height="28"
                            Margin="10,12,10,6"
                            Background="#F5F5F5"
                            BorderBrush="#D9D9D9"
                            BorderThickness="1.5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6*" />
                                    <ColumnDefinition Width="8*" />
                                    <ColumnDefinition Width="8.5*" />
                                    <ColumnDefinition Width="8.5*" />
                                    <ColumnDefinition Width="7*" />
                                    <ColumnDefinition Width="7*" />
                                    <ColumnDefinition Width="8*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="0,0,1.5,0">
                                    <TextBlock
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Text="通道" />
                                </Border>
                                <Border
                                    Grid.Column="1"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="0,0,1.5,0">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Text="当前阻值 (Ω)" />
                                </Border>
                                <Border
                                    Grid.Column="2"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="0,0,1.5,0">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Text="获取阻值" />
                                </Border>
                                <Border
                                    Grid.Column="3"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="0,0,1.5,0">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Text="设置" />
                                </Border>
                                <Border
                                    Grid.Column="4"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="0,0,1.5,0">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Text="断路" />
                                </Border>
                                <Border
                                    Grid.Column="5"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="0,0,1.5,0">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Text="短路" />
                                </Border>
                                <Border Grid.Column="6" BorderBrush="#D9D9D9">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Text="设定值 (Ω)" />
                                </Border>
                            </Grid>
                        </Border>

                        <!--  通道列表  -->
                        <ItemsControl
                            Grid.Row="1"
                            Margin="10,0,10,0"
                            ItemsSource="{Binding Channels}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,5"
                                        Background="White"
                                        BorderBrush="#D9D9D9"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid Height="40">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6*" />
                                                <ColumnDefinition Width="8*" />
                                                <ColumnDefinition Width="8.5*" />
                                                <ColumnDefinition Width="8.5*" />
                                                <ColumnDefinition Width="7*" />
                                                <ColumnDefinition Width="7*" />
                                                <ColumnDefinition Width="8*" />
                                            </Grid.ColumnDefinitions>

                                            <!--  通道  -->
                                            <Border
                                                Grid.Column="0"
                                                BorderBrush="#D9D9D9"
                                                BorderThickness="0,0,1,0">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    FontWeight="Bold"
                                                    Text="{Binding ChannelName}" />
                                            </Border>

                                            <!--  当前阻值  -->
                                            <Border
                                                Grid.Column="1"
                                                Padding="6,0"
                                                BorderBrush="#D9D9D9"
                                                BorderThickness="0,0,1,0">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    Text="{Binding CurrentResistanceDisplay, Mode=OneWay}" />
                                            </Border>

                                            <!--  获取阻值  -->
                                            <Border
                                                Grid.Column="2"
                                                BorderBrush="#D9D9D9"
                                                BorderThickness="0,0,1,0">
                                                <Button
                                                    Width="80"
                                                    Height="28"
                                                    HorizontalAlignment="Center"
                                                    Command="{Binding GetResistanceCommand}"
                                                    Content="获取阻值">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="#3b82f6" />
                                                            <Setter Property="Foreground" Value="White" />
                                                            <Setter Property="BorderThickness" Value="0" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border
                                                                            Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="3">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#2563eb" />
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter Property="Background" Value="#1d4ed8" />
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="Background" Value="#D9D9D9" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Border>

                                            <!--  设定阻值  -->
                                            <Border
                                                Grid.Column="3"
                                                BorderBrush="#D9D9D9"
                                                BorderThickness="0,0,1,0">
                                                <Button
                                                    Width="80"
                                                    Height="28"
                                                    HorizontalAlignment="Center"
                                                    Command="{Binding SetResistanceCommand}"
                                                    Content="设定阻值">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="#22c55e" />
                                                            <Setter Property="Foreground" Value="White" />
                                                            <Setter Property="BorderThickness" Value="0" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border
                                                                            Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="3">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#16a34a" />
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter Property="Background" Value="#15803d" />
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="Background" Value="#D9D9D9" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Border>

                                            <!--  ????  -->
                                            <Border
                                                Grid.Column="4"
                                                BorderBrush="#D9D9D9"
                                                BorderThickness="0,0,1,0">
                                                <ToggleButton
                                                    Margin="2,0"
                                                    HorizontalAlignment="Center"
                                                    Command="{Binding TogglePathRelayCommand}"
                                                    IsChecked="{Binding IsBreakEnabled, Mode=TwoWay}"
                                                    Style="{StaticResource ToggleSwitchStyle}" />
                                            </Border>

                                            <!--  ????  -->
                                            <Border
                                                Grid.Column="5"
                                                BorderBrush="#D9D9D9"
                                                BorderThickness="0,0,1,0">
                                                <ToggleButton
                                                    Margin="2,0"
                                                    HorizontalAlignment="Center"
                                                    Command="{Binding ToggleShortCircuitCommand}"
                                                    IsChecked="{Binding IsShortCircuitClosed, Mode=TwoWay}"
                                                    Style="{StaticResource ToggleSwitchStyle}" />
                                            </Border>

                                            <!--  ?????  -->
                                            <Border
                                                Grid.Column="6"
                                                Padding="6,0"
                                                BorderBrush="#D9D9D9"
                                                BorderThickness="0">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    Text="{Binding TargetResistance, StringFormat='{}{0:F0}'}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </Border>


            </Grid>


        </Grid>
    </Border>
</UserControl>

