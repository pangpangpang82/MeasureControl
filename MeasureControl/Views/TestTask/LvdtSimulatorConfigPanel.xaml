<UserControl
    x:Class="MeasureControl.Views.TestTask.LvdtSimulatorConfigPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:MeasureControl.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:MeasureControl.Views.TestTask"
    d:DesignHeight="600"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <UserControl.Resources>
        <helpers:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <helpers:StringEqualsToVisibilityConverter x:Key="StringEqualsToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
        <helpers:ObjectEqualsMultiConverter x:Key="ObjectEqualsMultiConverter" />

        <Style x:Key="SimpleScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="8" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />

                            <ScrollBar
                                x:Name="PART_VerticalScrollBar"
                                Grid.Row="0"
                                Grid.Column="1"
                                Maximum="{TemplateBinding ScrollableHeight}"
                                Orientation="Vertical"
                                Style="{StaticResource SimpleScrollBarStyle}"
                                ViewportSize="{TemplateBinding ViewportHeight}"
                                Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                Value="{TemplateBinding VerticalOffset}" />

                            <ScrollBar
                                x:Name="PART_HorizontalScrollBar"
                                Grid.Row="1"
                                Grid.Column="0"
                                Maximum="{TemplateBinding ScrollableWidth}"
                                Orientation="Horizontal"
                                Style="{StaticResource SimpleScrollBarStyle}"
                                ViewportSize="{TemplateBinding ViewportWidth}"
                                Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                Value="{TemplateBinding HorizontalOffset}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EnableCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border
                                x:Name="checkBoxBorder"
                                Width="16"
                                Height="16"
                                Background="White"
                                BorderBrush="#D9D9D9"
                                BorderThickness="1"
                                CornerRadius="2">
                                <Path
                                    x:Name="checkMark"
                                    Data="M 2 8 L 6 12 L 14 4"
                                    Stroke="White"
                                    StrokeThickness="2"
                                    Visibility="Collapsed" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkBoxBorder" Property="Background" Value="#3b82f6" />
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#3b82f6" />
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#3b82f6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="checkBoxBorder" Property="Background" Value="#E5E5E5" />
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#CCCCCC" />
                                <Setter TargetName="checkMark" Property="Stroke" Value="#999999" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style BasedOn="{StaticResource CustomComboBoxStyle}" TargetType="ComboBox">
            <Setter Property="ItemContainerStyle" Value="{StaticResource CustomComboBoxItemStyle}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderBrush" Value="#D9D9D9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,0" />
        </Style>

        <!--  按钮样式（放在 DataTemplate 之前，避免 StaticResource 查找失败）  -->
        <Style x:Key="CustomButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3b82f6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563eb" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.6" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  ToggleButton 专用样式（复制 Button 样式，TargetType 调整为 ToggleButton）  -->
        <Style x:Key="CustomToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#3b82f6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563eb" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.6" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#1e40af" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToggleDeviceButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3b82f6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563eb" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#ef4444" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsConnected}" Value="True" />
                                    <Condition Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsMouseOver}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#dc2626" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsConnected}" Value="True" />
                                    <Condition Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsKeyboardFocusWithin}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#dc2626" />
                            </MultiDataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  通道配置项模版（简化）：仅保留工作模式、激励、外部激励传输比、Va/Vb反相和设置按钮  -->
        <DataTemplate x:Key="ChannelConfigTemplate">
            <Border
                Margin="0,0,0,10"
                Padding="12"
                Background="#F8FAFB"
                BorderBrush="#E6EEF8"
                BorderThickness="1"
                CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  第一行：通道名称 + 启用  -->
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="{Binding ChannelName}" />
                    </StackPanel>

                    <!--  第二行：工作模式与激励选项（移除通道级传感器选择）  -->
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,8,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Width="80"
                            VerticalAlignment="Center"
                            Text="工作模式:" />
                        <ComboBox
                            Width="140"
                            Height="28"
                            SelectedValue="{Binding WorkMode, Mode=TwoWay}"
                            SelectedValuePath="Tag">
                            <ComboBoxItem Content="测试输入" Tag="TestInput" />
                            <ComboBoxItem Content="仿真输出" Tag="SimulateOutput" />
                        </ComboBox>

                        <StackPanel
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <CheckBox
                                VerticalAlignment="Center"
                                Content="使用内部激励"
                                IsChecked="{Binding UseInternalExcitation, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>

                    <!--  第三行：外部激励传输比 + Va/Vb 反相 + 设置按钮  -->
                    <StackPanel
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,8,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Width="120"
                            VerticalAlignment="Center"
                            Text="外部激励传输比:" />
                        <TextBox
                            Width="100"
                            Height="26"
                            Text="{Binding TransmissionRatio, Mode=TwoWay}" />

                        <StackPanel
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <CheckBox
                                Margin="8,0"
                                Content="Va反相"
                                IsChecked="{Binding VaInverse, Mode=TwoWay}" />
                            <CheckBox
                                Margin="8,0"
                                Content="Vb反相"
                                IsChecked="{Binding VbInverse, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>

                    <!--  右侧：设置按钮  -->
                    <StackPanel
                        Grid.Row="1"
                        Grid.RowSpan="2"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                        <!--  顶层通道列表的“设置”在此改为直接应用通道配置  -->
                        <Button
                            Width="80"
                            Height="28"
                            Margin="6,0,0,0"
                            Command="{Binding DataContext.ApplyChannelConfigCommand, RelativeSource={RelativeSource AncestorType={x:Type views:LvdtSimulatorConfigPanel}}}"
                            CommandParameter="{Binding}"
                            Content="设置"
                            Style="{StaticResource CustomButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  单通道仿真输出模版  -->
        <DataTemplate x:Key="ChannelSimulateTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  左侧主区  -->
                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                    <!--  仿真输出视图  -->
                    <StackPanel Visibility="{Binding DataContext.ActiveChannelViewMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Simulate}">
                        <!--  仿真输出界面：激励与输出设置（参考 PXI-4087 手册）  -->

                        <GroupBox
                            MaxWidth="720"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            Header="激励与输出设置">
                            <StackPanel Margin="8" Orientation="Vertical">
                                <StackPanel
                                    Margin="0,0,0,6"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        Width="120"
                                        VerticalAlignment="Center"
                                        Text="激励有效值 (Vrms):" />
                                    <TextBox Width="120" Text="{Binding ExcitationVoltage, Mode=TwoWay}" />
                                    <TextBlock
                                        Width="120"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="激励频率 (Hz):" />
                                    <TextBox Width="120" Text="{Binding ExcitationFrequency, Mode=TwoWay}" />
                                    <Button
                                        Width="80"
                                        Margin="12,0,0,0"
                                        Command="{Binding DataContext.SetChannelInternalExcCommand, RelativeSource={RelativeSource AncestorType={x:Type views:LvdtSimulatorConfigPanel}}}"
                                        CommandParameter="{Binding}"
                                        Content="设置"
                                        Style="{StaticResource CustomButtonStyle}" />
                                </StackPanel>
                                <!--  外部激励测量显示（只读）  -->
                                <StackPanel
                                    Margin="0,6,0,6"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        Width="120"
                                        VerticalAlignment="Center"
                                        Text="外部激励 Vrms:" />
                                    <TextBox
                                        Width="120"
                                        IsReadOnly="True"
                                        Text="{Binding MeasuredExcitationVoltage, Mode=OneWay, StringFormat={}{0:F6}}" />
                                    <TextBlock
                                        Width="120"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="外部激励 频率:" />
                                    <TextBox
                                        Width="120"
                                        IsReadOnly="True"
                                        Text="{Binding MeasuredExcitationFrequency, Mode=OneWay, StringFormat={}{0:F1}}" />
                                </StackPanel>

                                <StackPanel
                                    Margin="0,0,0,6"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        Width="120"
                                        VerticalAlignment="Center"
                                        Text="输出类型:" />
                                    <StackPanel
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <RadioButton
                                            Margin="0,0,8,0"
                                            Content="静态"
                                            GroupName="OutputTypeGroup"
                                            IsChecked="{Binding IsDynamicOutput, Converter={StaticResource InverseBoolConverter}, Mode=TwoWay}" />
                                        <RadioButton
                                            Content="动态"
                                            GroupName="OutputTypeGroup"
                                            IsChecked="{Binding IsDynamicOutput, Mode=TwoWay}" />
                                    </StackPanel>
                                </StackPanel>

                                <!--  静态输出的专用配置面板（当 IsDynamicOutput == false 显示）  -->
                                <GroupBox Margin="0,6,0,8" Header="静态输出配置">
                                    <GroupBox.Style>
                                        <Style TargetType="GroupBox">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDynamicOutput}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </GroupBox.Style>
                                    <StackPanel Margin="8">
                                        <!--  输出模式配置（统一显示，增加旋变角度输出）  -->
                                        <StackPanel Margin="0,2,0,2" Orientation="Horizontal">
                                            <TextBlock
                                                Width="120"
                                                VerticalAlignment="Center"
                                                Text="输出模式:" />
                                            <ComboBox
                                                Width="220"
                                                Height="28"
                                                SelectedValue="{Binding OutputMode, Mode=TwoWay}"
                                                SelectedValuePath="Tag">
                                                <ComboBoxItem Content="位置输出" Tag="Position" />
                                                <ComboBoxItem Content="Va/Vb有效值输出" Tag="VaVb" />
                                                <ComboBoxItem Content="和差值输出" Tag="SumDiff" />
                                                <ComboBoxItem Content="角度输出 (RVDT)" Tag="Resolver" />
                                            </ComboBox>
                                            <Button
                                                Width="80"
                                                Margin="8,0,0,0"
                                                Command="{Binding DataContext.ApplyChannelConfigCommand, RelativeSource={RelativeSource AncestorType={x:Type views:LvdtSimulatorConfigPanel}}}"
                                                CommandParameter="{Binding}"
                                                Content="设置"
                                                Style="{StaticResource CustomButtonStyle}" />
                                        </StackPanel>

                                        <!--  位置输出配置  -->
                                        <StackPanel
                                            Margin="0,6,0,2"
                                            Orientation="Horizontal"
                                            Visibility="{Binding OutputMode, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Position}">
                                            <TextBlock
                                                Width="120"
                                                VerticalAlignment="Center"
                                                Text="位置值 (-1.0~1.0):" />
                                            <TextBox
                                                Width="120"
                                                Language="en-US"
                                                Text="{Binding Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ConverterCulture=en-US}" />
                                        </StackPanel>

                                        <!--  Va/Vb 输出配置  -->
                                        <StackPanel
                                            Margin="0,6,0,2"
                                            Orientation="Horizontal"
                                            Visibility="{Binding OutputMode, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=VaVb}">
                                            <TextBlock
                                                Width="120"
                                                VerticalAlignment="Center"
                                                Text="Va 有效值 (V):" />
                                            <TextBox
                                                Width="100"
                                                Language="en-US"
                                                Text="{Binding VaVoltage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ConverterCulture=en-US}" />
                                            <TextBlock
                                                Width="120"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                Text="Vb 有效值 (V):" />
                                            <TextBox
                                                Width="100"
                                                Language="en-US"
                                                Text="{Binding VbVoltage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ConverterCulture=en-US}" />
                                            <Button
                                                Width="80"
                                                Margin="8,0,0,0"
                                                Command="{Binding DataContext.ApplyChannelConfigCommand, RelativeSource={RelativeSource AncestorType={x:Type views:LvdtSimulatorConfigPanel}}}"
                                                CommandParameter="{Binding}"
                                                Content="设置"
                                                Style="{StaticResource CustomButtonStyle}" />
                                        </StackPanel>

                                        <!--  和差输出配置  -->
                                        <StackPanel
                                            Margin="0,6,0,2"
                                            Orientation="Horizontal"
                                            Visibility="{Binding OutputMode, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=SumDiff}">
                                            <TextBlock
                                                Width="120"
                                                VerticalAlignment="Center"
                                                Text="Vsum (V):" />
                                            <TextBox
                                                Width="100"
                                                Language="en-US"
                                                Text="{Binding Vsum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ConverterCulture=en-US}" />
                                            <TextBlock
                                                Width="120"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                Text="Vdiff (V):" />
                                            <TextBox
                                                Width="100"
                                                Language="en-US"
                                                Text="{Binding Vdiff, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ConverterCulture=en-US}" />
                                            <Button
                                                Width="80"
                                                Margin="8,0,0,0"
                                                Command="{Binding DataContext.ApplyChannelConfigCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="设置"
                                                Style="{StaticResource CustomButtonStyle}" />
                                        </StackPanel>

                                        <!--  RVDT角度输出配置（仅当输出模式为Resolver时显示）  -->
                                        <StackPanel
                                            Margin="0,6,0,2"
                                            Orientation="Vertical"
                                            Visibility="{Binding OutputMode, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Resolver}">
                                            <TextBlock
                                                Margin="0,0,0,8"
                                                FontSize="11"
                                                Foreground="#666666"
                                                TextWrapping="Wrap">
                                                4087A硬件通过RVDT位置值实现角度输出。角度范围-90°到+90°对应位置值-1.0到1.0
                                            </TextBlock>
                                            <StackPanel Margin="0,2,0,2" Orientation="Horizontal">
                                                <TextBlock
                                                    Width="120"
                                                    VerticalAlignment="Center"
                                                    Text="输出角度 (-90~90°):" />
                                                <TextBox
                                                    Width="100"
                                                    Language="en-US"
                                                    Text="{Binding ResolverOutputAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ConverterCulture=en-US}" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="#666666"
                                                    Text="{Binding ResolverAngleToPosition, StringFormat=位置值: {0:F3}}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,2,0,2" Orientation="Horizontal">
                                                <TextBlock
                                                    Width="120"
                                                    VerticalAlignment="Center"
                                                    Text="相位差 (-180~180°):" />
                                                <TextBox
                                                    Width="100"
                                                    Language="en-US"
                                                    Text="{Binding ResolverPhaseDiff, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ConverterCulture=en-US}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,6,0,2" Orientation="Horizontal">
                                                <Button
                                                    Width="80"
                                                    Command="{Binding DataContext.ApplyChannelConfigCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="设置角度"
                                                    Style="{StaticResource CustomButtonStyle}" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="#0066cc"
                                                    Text="4087A: 角度→位置值自动转换" />
                                            </StackPanel>
                                            <TextBlock
                                                Margin="0,8,0,0"
                                                FontSize="11"
                                                Foreground="#0066cc"
                                                TextWrapping="Wrap">
                                                转换公式: 位置值 = 角度 / 90.0
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>

                                <!--  动态输出配置（显示于输出类型下方，与静态配置位置一致）  -->
                                <GroupBox Margin="0,6,0,8" Header="动态输出配置">
                                    <GroupBox.Style>
                                        <Style TargetType="GroupBox">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDynamicOutput}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </GroupBox.Style>
                                    <StackPanel Margin="8" Orientation="Vertical">
                                        <!--  LVDT位置动态输出配置（与示意图一致）  -->
                                        <StackPanel>
                                            <!--  第一行：旋变下相位差（复用 ResolverPhaseDiff） + 数据长度  -->
                                            <StackPanel Margin="0,2,0,2" Orientation="Horizontal">
                                                <TextBlock
                                                    Width="180"
                                                    VerticalAlignment="Center"
                                                    Foreground="Blue"
                                                    Text="数据长度" />
                                                <TextBox Width="100" Text="{Binding DynamicWaveformLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <!--  第二行：起始位置 + 每点时间间隔 (s)  -->
                                            <StackPanel Margin="0,2,0,2" Orientation="Horizontal">
                                                <TextBlock
                                                    Width="180"
                                                    VerticalAlignment="Center"
                                                    Text="起始位置 (-1.0~1.0)" />
                                                <TextBox Width="100" Text="{Binding DynamicStartPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock
                                                    Width="120"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="每点时间间隔 (s)" />
                                                <TextBox Width="100" Text="{Binding DynamicPointPeriod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <!--  第三行：终点位置 + 波形个数  -->
                                            <StackPanel Margin="0,2,0,2" Orientation="Horizontal">
                                                <TextBlock
                                                    Width="180"
                                                    VerticalAlignment="Center"
                                                    Text="终点位置 (-1.0~1.0)" />
                                                <TextBox Width="100" Text="{Binding DynamicEndPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock
                                                    Width="120"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="波形个数 (0连续输出)" />
                                                <TextBox Width="100" Text="{Binding DynamicOutputCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <!--  复选项：往返输出、旋变角度输出、自动加载  -->

                                            <StackPanel Margin="0,6,0,2" Orientation="Horizontal">
                                                <Button
                                                    Width="80"
                                                    Command="{Binding DataContext.ApplyChannelConfigCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="设置"
                                                    Style="{StaticResource CustomButtonStyle}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!--  RVDT动态配置（当输出模式为 Resolver 时显示）  -->
                                        <GroupBox
                                            Margin="0,6,0,2"
                                            Header="RVDT动态配置"
                                            Visibility="{Binding OutputMode, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Resolver}">
                                            <StackPanel Margin="8">
                                                <StackPanel Margin="0,2,0,2" Orientation="Horizontal">
                                                    <TextBlock
                                                        Width="120"
                                                        VerticalAlignment="Center"
                                                        Text="起始角度:" />
                                                    <TextBox
                                                        Width="100"
                                                        Language="en-US"
                                                        Text="{Binding ResolverStartAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ConverterCulture=en-US}" />
                                                    <TextBlock
                                                        Width="120"
                                                        Margin="12,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Text="结束角度:" />
                                                    <TextBox
                                                        Width="100"
                                                        Language="en-US"
                                                        Text="{Binding ResolverEndAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ConverterCulture=en-US}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,2,0,2" Orientation="Horizontal">
                                                    <TextBlock
                                                        Width="120"
                                                        VerticalAlignment="Center"
                                                        Text="波形长度:" />
                                                    <TextBox Width="100" Text="{Binding ResolverWaveformLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,6,0,2" Orientation="Horizontal">
                                                    <Button
                                                        Width="80"
                                                        Command="{Binding DataContext.ApplyChannelConfigCommand, RelativeSource={RelativeSource AncestorType={x:Type views:LvdtSimulatorConfigPanel}}}"
                                                        CommandParameter="{Binding}"
                                                        Content="设置"
                                                        Style="{StaticResource CustomButtonStyle}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                </GroupBox>

                                <StackPanel
                                    Margin="0,0,0,6"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Button
                                        Width="140"
                                        Command="{Binding DataContext.ReadExternalExcitationCommand, RelativeSource={RelativeSource AncestorType={x:Type views:LvdtSimulatorConfigPanel}}}"
                                        CommandParameter="{Binding}"
                                        Content="读取外部激励信号"
                                        Style="{StaticResource CustomButtonStyle}" />
                                </StackPanel>

                                <StackPanel
                                    Margin="0,0,0,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        Width="120"
                                        VerticalAlignment="Center"
                                        Text="外部激励 Vrms:" />
                                    <TextBox
                                        Width="120"
                                        IsReadOnly="True"
                                        Text="{Binding MeasuredExcitationVoltage, Mode=OneWay, StringFormat={}{0:F6}}" />
                                    <TextBlock
                                        Width="120"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="外部激励 频率:" />
                                    <TextBox
                                        Width="120"
                                        IsReadOnly="True"
                                        Text="{Binding MeasuredExcitationFrequency, Mode=OneWay, StringFormat={}{0:F1}}" />
                                </StackPanel>

                            </StackPanel>
                        </GroupBox>

                        <!--  波形显示区：分为激励和输出两个独立画布  -->
                        <StackPanel
                            Margin="0,8,0,0"
                            Orientation="Vertical"
                            Visibility="Collapsed">
                            <!--  顶部控制行  -->
                            <StackPanel
                                Margin="6"
                                HorizontalAlignment="Left"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Text="显示:" />
                                <ComboBox
                                    Width="120"
                                    SelectedValue="{Binding DataContext.WaveformViewMode, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                    SelectedValuePath="Tag">
                                    <ComboBoxItem Content="激励信号" Tag="Excitation" />
                                    <ComboBoxItem Content="动态输出" Tag="Dynamic" />
                                </ComboBox>

                                <TextBlock
                                    Margin="12,0,8,0"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Text="通道:" />
                                <ComboBox
                                    Width="100"
                                    SelectedValue="{Binding DataContext.WaveformSignal, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                    SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Va" Tag="Va" />
                                    <ComboBoxItem Content="Vb" Tag="Vb" />
                                </ComboBox>

                                <TextBlock
                                    Margin="12,0,8,0"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Text="激励源:" />
                                <ComboBox
                                    Width="120"
                                    SelectedValue="{Binding DataContext.WaveformExcitationSource, RelativeSource={RelativeSource AncestorType={x:Type views:LvdtSimulatorConfigPanel}}, Mode=TwoWay}"
                                    SelectedValuePath="Tag">
                                    <ComboBoxItem Content="外部" Tag="External" />
                                    <ComboBoxItem Content="内部" Tag="Internal" />
                                    <ComboBoxItem Content="两者" Tag="Both" />
                                </ComboBox>

                                <Button
                                    Width="80"
                                    Margin="12,0,0,0"
                                    Command="{Binding DataContext.StartWaveformReadCommand, RelativeSource={RelativeSource AncestorType={x:Type views:LvdtSimulatorConfigPanel}}}"
                                    Content="显示" />
                            </StackPanel>

                            <!--  激励画布  -->
                            <Border
                                Height="120"
                                Margin="0,6,0,6"
                                Background="Black"
                                CornerRadius="4">
                                <Grid>
                                    <TextBlock
                                        x:Name="ExcitationPlaceholder"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="Gray"
                                        Text="等待激励数据..."
                                        Visibility="Visible" />
                                    <Canvas x:Name="WaveformCanvas_Excitation" Background="Black" />
                                    <StackPanel
                                        Margin="8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Orientation="Horizontal">
                                        <StackPanel Margin="4" Orientation="Horizontal">
                                            <Rectangle
                                                Width="12"
                                                Height="6"
                                                Margin="4,6,4,0"
                                                Fill="Lime" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="White"
                                                Text="内部" />
                                        </StackPanel>
                                        <StackPanel Margin="4" Orientation="Horizontal">
                                            <Rectangle
                                                Width="12"
                                                Height="6"
                                                Margin="4,6,4,0"
                                                Fill="Yellow" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="White"
                                                Text="外部" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!--  输出画布  -->
                            <Border
                                Height="120"
                                Margin="0,6,0,0"
                                Background="Black"
                                CornerRadius="4">
                                <Grid>
                                    <TextBlock
                                        x:Name="OutputPlaceholder"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="Gray"
                                        Text="等待输出数据..."
                                        Visibility="Visible" />
                                    <Canvas x:Name="WaveformCanvas_Output" Background="Black" />
                                    <StackPanel
                                        Margin="8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Orientation="Horizontal">
                                        <StackPanel Margin="4" Orientation="Horizontal">
                                            <Rectangle
                                                Width="12"
                                                Height="6"
                                                Margin="4,6,4,0"
                                                Fill="Lime" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="White"
                                                Text="输出" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!--  注意：测试输入由 ChannelTestTemplate 提供，此处移除重复内容  -->
                </StackPanel>

                <!--  右侧控制列（通道相关操作）  -->
                <StackPanel
                    Grid.Column="1"
                    Margin="0,0,0,0"
                    VerticalAlignment="Top">
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="14"
                        FontWeight="Bold"
                        Text="{Binding ChannelName}" />
                    <TextBlock
                        Margin="0,0,0,8"
                        Text="{Binding DataContext.ConnectionStatus, RelativeSource={RelativeSource AncestorType={x:Type views:LvdtSimulatorConfigPanel}}, StringFormat='状态: {0}'}"
                        Visibility="Collapsed" />
                    <Button
                        Width="110"
                        Height="36"
                        Margin="0,0,0,8"
                        Command="{Binding DataContext.StartChannelOutputCommand, RelativeSource={RelativeSource AncestorType={x:Type views:LvdtSimulatorConfigPanel}}}"
                        CommandParameter="{Binding}"
                        Content="开始双通道输出"
                        Style="{StaticResource CustomButtonStyle}" />
                    <Button
                        Width="110"
                        Height="36"
                        Margin="0,0,0,8"
                        Command="{Binding DataContext.StopChannelOutputCommand, RelativeSource={RelativeSource AncestorType={x:Type views:LvdtSimulatorConfigPanel}}}"
                        CommandParameter="{Binding}"
                        Content="停止双通道输出"
                        Style="{StaticResource CustomButtonStyle}" />
                    <Button
                        Margin="0,0,0,6"
                        Command="{Binding DataContext.StartChannelMeasurementCommand, RelativeSource={RelativeSource AncestorType={x:Type views:LvdtSimulatorConfigPanel}}}"
                        CommandParameter="{Binding}"
                        Content="启动采集"
                        Style="{StaticResource CustomButtonStyle}"
                        Visibility="Collapsed" />
                    <Button
                        Margin="0,0,0,12"
                        Command="{Binding DataContext.StopChannelMeasurementCommand, RelativeSource={RelativeSource AncestorType={x:Type views:LvdtSimulatorConfigPanel}}}"
                        CommandParameter="{Binding}"
                        Content="停止采集"
                        Style="{StaticResource CustomButtonStyle}"
                        Visibility="Collapsed" />

                    <Button
                        Width="110"
                        Height="36"
                        Margin="0,0,0,8"
                        Command="{Binding DataContext.SaveConfigCommand, RelativeSource={RelativeSource AncestorType={x:Type views:LvdtSimulatorConfigPanel}}}"
                        Style="{StaticResource CustomButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Image
                                Width="15"
                                Height="15"
                                Margin="6,0,3,0"
                                Source="/Resources/Logo/save_white.png" />
                            <TextBlock
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="White"
                                Text="保存配置" />
                        </StackPanel>
                    </Button>
                    <Button
                        Width="110"
                        Height="36"
                        Margin="0,0,0,8"
                        Command="{Binding DataContext.ReloadConfigCommand, RelativeSource={RelativeSource AncestorType={x:Type views:LvdtSimulatorConfigPanel}}}"
                        Style="{StaticResource CustomButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Image
                                Width="15"
                                Height="15"
                                Margin="6,0,3,0"
                                Source="/Resources/Logo/read.png" />
                            <TextBlock
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="White"
                                Text="读取配置" />
                        </StackPanel>
                    </Button>

                    <!--  测量值显示区域  -->
                    <GroupBox
                        Margin="0,0,0,8"
                        Header="当前测量值"
                        Visibility="Collapsed">
                        <StackPanel Margin="8" Orientation="Vertical">
                            <StackPanel Margin="0,2,0,2" Orientation="Horizontal">
                                <TextBlock
                                    Width="60"
                                    VerticalAlignment="Center"
                                    Text="Va (V):" />
                                <TextBox
                                    Width="80"
                                    IsReadOnly="True"
                                    Text="{Binding MeasuredVaVoltage, Mode=OneWay, StringFormat={}{0:F6}}" />
                            </StackPanel>
                            <StackPanel Margin="0,2,0,2" Orientation="Horizontal">
                                <TextBlock
                                    Width="60"
                                    VerticalAlignment="Center"
                                    Text="Vb (V):" />
                                <TextBox
                                    Width="80"
                                    IsReadOnly="True"
                                    Text="{Binding MeasuredVbVoltage, Mode=OneWay, StringFormat={}{0:F6}}" />
                            </StackPanel>
                            <StackPanel Margin="0,2,0,2" Orientation="Horizontal">
                                <TextBlock
                                    Width="60"
                                    VerticalAlignment="Center"
                                    Text="Vdiff (V):" />
                                <TextBox
                                    Width="80"
                                    IsReadOnly="True"
                                    Text="{Binding MeasuredVdiff, Mode=OneWay, StringFormat={}{0:F6}}" />
                            </StackPanel>
                            <StackPanel Margin="0,2,0,2" Orientation="Horizontal">
                                <TextBlock
                                    Width="60"
                                    VerticalAlignment="Center"
                                    Text="Ratio:" />
                                <TextBox
                                    Width="80"
                                    IsReadOnly="True"
                                    Text="{Binding MeasuredRatio, Mode=OneWay, StringFormat={}{0:F6}}" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox
                        Margin="0,6,0,0"
                        Header="高级配置"
                        Visibility="Collapsed">
                        <StackPanel Margin="8">
                            <!--  传输比和 Va/Vb 反相 已移至通道列表中的简化项，详情页仅保留设备级或输出级高级配置  -->
                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                <TextBlock
                                    Width="120"
                                    VerticalAlignment="Center"
                                    Text="相位延迟:" />
                                <TextBox Width="120" Text="{Binding PhaseDelay, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <Button
                        Margin="0,12,0,0"
                        Command="{Binding DataContext.ResetDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Content="重置设备"
                        Style="{StaticResource CustomButtonStyle}"
                        Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!--  单通道测试输入模版  -->
        <DataTemplate x:Key="ChannelTestTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--  采集控制  -->
                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                    <Button
                        Width="120"
                        Height="36"
                        Margin="0,0,8,0"
                        Command="{Binding DataContext.StartChannelMeasurementCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Content="开始采集"
                        Style="{StaticResource CustomButtonStyle}" />
                    <Button
                        Width="120"
                        Height="36"
                        Command="{Binding DataContext.StopChannelMeasurementCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Content="停止采集"
                        Style="{StaticResource CustomButtonStyle}" />
                </StackPanel>
                <!--  图表与测量数据显示  -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        Background="Black"
                        CornerRadius="4"
                        Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  波形视图切换与控制（与仿真输出一致）  -->
                            <StackPanel
                                Grid.Row="0"
                                Margin="6"
                                HorizontalAlignment="Left"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Text="显示:" />
                                <ComboBox
                                    Width="120"
                                    SelectedValue="{Binding DataContext.WaveformViewMode, RelativeSource={RelativeSource AncestorType={x:Type views:LvdtSimulatorConfigPanel}}, Mode=TwoWay}"
                                    SelectedValuePath="Tag">
                                    <ComboBoxItem Content="激励信号" Tag="Excitation" />
                                    <ComboBoxItem Content="动态输出" Tag="Dynamic" />
                                </ComboBox>

                                <TextBlock
                                    Margin="12,0,8,0"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Text="通道:" />
                                <ComboBox
                                    Width="100"
                                    SelectedValue="{Binding DataContext.WaveformSignal, RelativeSource={RelativeSource AncestorType={x:Type views:LvdtSimulatorConfigPanel}}, Mode=TwoWay}"
                                    SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Va" Tag="Va" />
                                    <ComboBoxItem Content="Vb" Tag="Vb" />
                                </ComboBox>

                                <TextBlock
                                    Margin="12,0,8,0"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Text="激励源:" />
                                <ComboBox
                                    Width="120"
                                    SelectedValue="{Binding DataContext.WaveformExcitationSource, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                    SelectedValuePath="Tag">
                                    <ComboBoxItem Content="外部" Tag="External" />
                                    <ComboBoxItem Content="内部" Tag="Internal" />
                                    <ComboBoxItem Content="两者" Tag="Both" />
                                </ComboBox>

                                <Button
                                    Width="80"
                                    Margin="12,0,0,0"
                                    Command="{Binding DataContext.StartWaveformReadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Content="开始" />
                                <Button
                                    Width="80"
                                    Margin="6,0,0,0"
                                    Command="{Binding DataContext.StopWaveformReadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Content="停止" />
                            </StackPanel>

                            <!--  绘图画布  -->
                            <Canvas
                                x:Name="WaveformCanvas"
                                Grid.Row="1"
                                Background="Black" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="0" Grid.ColumnSpan="2">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontWeight="Bold"
                            Text="测量值" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!--  内部激励设置（测试输入面板）  -->
                            <GroupBox
                                Grid.Column="0"
                                Margin="0,0,0,0"
                                Header="内部激励设置">
                                <StackPanel Margin="8" Orientation="Vertical">
                                    <StackPanel Margin="0,2,0,2" Orientation="Horizontal">
                                        <TextBlock
                                            Width="120"
                                            VerticalAlignment="Center"
                                            Text="内部激励 Vrms:" />
                                        <TextBox Width="140" Text="{Binding ExcitationVoltage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,2,0,2" Orientation="Horizontal">
                                        <TextBlock
                                            Width="120"
                                            VerticalAlignment="Center"
                                            Text="频率 (Hz):" />
                                        <TextBox Width="140" Text="{Binding ExcitationFrequency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel
                                        Margin="0,6,0,0"
                                        HorizontalAlignment="Left"
                                        Orientation="Horizontal">
                                        <Button
                                            Width="80"
                                            Command="{Binding DataContext.SetChannelInternalExcCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="设置"
                                            Style="{StaticResource CustomButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <!--  外部激励与测量值显示（放到内部激励右侧）  -->
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <TextBlock
                                        Width="120"
                                        VerticalAlignment="Center"
                                        Text="外部激励大小(Vrms):" />
                                    <TextBox
                                        Width="140"
                                        IsReadOnly="True"
                                        Text="{Binding MeasuredExcitationVoltage, Mode=OneWay, StringFormat={}{0:F6}}" />
                                </StackPanel>
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <TextBlock
                                        Width="120"
                                        VerticalAlignment="Center"
                                        Text="外部激励频率(Hz):" />
                                    <TextBox
                                        Width="140"
                                        IsReadOnly="True"
                                        Text="{Binding MeasuredExcitationFrequency, Mode=OneWay, StringFormat={}{0:F1}}" />
                                </StackPanel>
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <TextBlock Width="60" Text="Va:" />
                                    <TextBox Width="80" Text="{Binding MeasuredVaVoltage, Mode=OneWay, StringFormat={}{0:F6}}" />
                                </StackPanel>
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <TextBlock Width="60" Text="Vb:" />
                                    <TextBox Width="80" Text="{Binding MeasuredVbVoltage, Mode=OneWay, StringFormat={}{0:F6}}" />
                                </StackPanel>
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <TextBlock Width="60" Text="Vdiff:" />
                                    <TextBox Width="80" Text="{Binding MeasuredVdiff, Mode=OneWay, StringFormat={}{0:F6}}" />
                                </StackPanel>
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <TextBlock Width="60" Text="Ratio:" />
                                    <TextBox Width="80" Text="{Binding MeasuredRatio, Mode=OneWay, StringFormat={}{0:F6}}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <Border
        Background="White"
        Focusable="True"
        MouseDown="Border_MouseDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  右侧：设备信息和激励信号配置  -->
            <Border
                Grid.Column="1"
                Margin="8,8,4,8"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8"
                Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15,15,15,15">
                        <!--  设备信息  -->
                        <TextBlock
                            FontSize="16"
                            FontWeight="Bold"
                            Text="{Binding CardModel, StringFormat='{}{0} 配置'}" />

                        <TextBlock
                            Margin="0,5,0,0"
                            FontSize="14"
                            Foreground="#666666"
                            Text="设备模式: LVDT/RVDT" />

                        <TextBlock
                            Margin="0,10,0,0"
                            FontSize="14"
                            Text="{Binding CardName, StringFormat='设备名称: {0}'}" />

                        <TextBlock
                            Margin="0,5,0,0"
                            FontSize="14"
                            Foreground="#666666"
                            Text="{Binding ConnectionStatus, StringFormat='状态: {0}'}" />

                        <!--  连接控制  -->

                        <!--  激励信号配置  -->
                        <TextBlock
                            Margin="0,20,0,0"
                            FontSize="16"
                            FontWeight="Bold"
                            Text="激励信号配置" />

                        <CheckBox
                            Margin="0,10,0,0"
                            Content="使用内部激励"
                            IsChecked="{Binding UseInternalExcitation, Mode=TwoWay}" />

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <TextBlock
                                Width="100"
                                VerticalAlignment="Center"
                                Text="激励电压 (Vrms):" />
                            <TextBox
                                Width="120"
                                Height="28"
                                IsEnabled="{Binding UseInternalExcitation}"
                                Text="{Binding ExcitationVoltage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <TextBlock
                                Width="100"
                                VerticalAlignment="Center"
                                Text="激励频率 (Hz):" />
                            <TextBox
                                Width="120"
                                Height="28"
                                IsEnabled="{Binding UseInternalExcitation}"
                                Text="{Binding ExcitationFrequency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!--  高级配置  -->
                        <TextBlock
                            Margin="0,20,0,0"
                            FontSize="16"
                            FontWeight="Bold"
                            Text="高级配置" />

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <TextBlock
                                Width="100"
                                VerticalAlignment="Center"
                                Text="传输比:" />
                            <TextBox
                                Width="120"
                                Height="28"
                                Text="{Binding TransmissionRatio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#666666"
                                Text="(0.1-10.0)" />
                        </StackPanel>

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <TextBlock
                                Width="100"
                                VerticalAlignment="Center"
                                Text="相位延迟:" />
                            <TextBox
                                Width="120"
                                Height="28"
                                Text="{Binding PhaseDelay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F0}}" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#666666"
                                Text="(0-65535, 100ns)" />
                        </StackPanel>

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <TextBlock
                                Width="100"
                                VerticalAlignment="Center"
                                Text="ADC范围:" />
                            <ComboBox
                                Width="120"
                                Height="28"
                                SelectedValue="{Binding AdcRangeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="范围0 (G=0.444)" Tag="0" />
                                <ComboBoxItem Content="范围1 (G=0.333)" Tag="1" />
                                <ComboBoxItem Content="范围2 (G=0.222)" Tag="2" />
                                <ComboBoxItem Content="范围3 (G=0.111)" Tag="3" />
                            </ComboBox>
                        </StackPanel>

                        <!--  校准配置  -->
                        <TextBlock
                            Margin="0,20,0,0"
                            FontSize="16"
                            FontWeight="Bold"
                            Text="校准配置" />

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <TextBlock
                                Width="100"
                                VerticalAlignment="Center"
                                Text="校准组:" />
                            <ComboBox
                                Width="120"
                                Height="28"
                                SelectedValue="{Binding CalibrationGroupIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="组0" Tag="0" />
                                <ComboBoxItem Content="组1" Tag="1" />
                                <ComboBoxItem Content="组2" Tag="2" />
                                <ComboBoxItem Content="组3" Tag="3" />
                                <ComboBoxItem Content="组4" Tag="4" />
                                <ComboBoxItem Content="组5" Tag="5" />
                                <ComboBoxItem Content="组6" Tag="6" />
                                <ComboBoxItem Content="组7" Tag="7" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <TextBlock
                                Width="100"
                                VerticalAlignment="Center"
                                Text="参数A:" />
                            <TextBox
                                Width="120"
                                Height="28"
                                Text="{Binding CalibrationScaleA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F6}}" />
                        </StackPanel>

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <TextBlock
                                Width="100"
                                VerticalAlignment="Center"
                                Text="参数B:" />
                            <TextBox
                                Width="120"
                                Height="28"
                                Text="{Binding CalibrationScaleB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F6}}" />
                        </StackPanel>

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <TextBlock
                                Width="100"
                                VerticalAlignment="Center"
                                Text="参数C:" />
                            <TextBox
                                Width="120"
                                Height="28"
                                Text="{Binding CalibrationScaleC, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F6}}" />
                        </StackPanel>

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <Button
                                Width="100"
                                Height="32"
                                Margin="0,0,10,0"
                                Command="{Binding SaveCalibrationCommand}"
                                Content="保存校准"
                                Style="{StaticResource CustomButtonStyle}" />
                            <Button
                                Width="100"
                                Height="32"
                                Command="{Binding LoadCalibrationCommand}"
                                Content="加载校准"
                                Style="{StaticResource CustomButtonStyle}" />
                        </StackPanel>

                        <!--  波形输出配置  -->
                        <TextBlock
                            Margin="0,20,0,0"
                            FontSize="16"
                            FontWeight="Bold"
                            Text="波形输出配置" />

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <TextBlock
                                Width="100"
                                VerticalAlignment="Center"
                                Text="扫描频率 (Hz):" />
                            <TextBox
                                Width="120"
                                Height="28"
                                Text="{Binding ScanFrequency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F1}}" />
                        </StackPanel>

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <TextBlock
                                Width="100"
                                VerticalAlignment="Center"
                                Text="扫描周期 (s):" />
                            <TextBox
                                Width="120"
                                Height="28"
                                Text="{Binding ScanPeriod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F6}}" />
                        </StackPanel>

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <TextBlock
                                Width="100"
                                VerticalAlignment="Center"
                                Text="波形长度:" />
                            <TextBox
                                Width="120"
                                Height="28"
                                Text="{Binding WaveformLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F0}}" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#666666"
                                Text="(1-2048)" />
                        </StackPanel>

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <TextBlock
                                Width="100"
                                VerticalAlignment="Center"
                                Text="输出次数:" />
                            <TextBox
                                Width="120"
                                Height="28"
                                Text="{Binding WaveformOutputCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F0}}" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#666666"
                                Text="(0=连续)" />
                        </StackPanel>

                        <!--  输出控制  -->
                        <TextBlock
                            Margin="0,20,0,0"
                            FontSize="16"
                            FontWeight="Bold"
                            Text="输出控制" />

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <Button
                                Width="100"
                                Height="32"
                                Margin="0,0,10,0"
                                Command="{Binding StartOutputCommand}"
                                Content="启动输出"
                                Style="{StaticResource CustomButtonStyle}" />
                            <Button
                                Width="100"
                                Height="32"
                                Command="{Binding StopOutputCommand}"
                                Content="停止输出"
                                Style="{StaticResource CustomButtonStyle}" />
                        </StackPanel>

                        <!--  测量控制  -->
                        <TextBlock
                            Margin="0,20,0,0"
                            FontSize="16"
                            FontWeight="Bold"
                            Text="测量功能" />

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <Button
                                Width="100"
                                Height="32"
                                Margin="0,0,10,0"
                                Command="{Binding StartMeasurementCommand}"
                                Content="启用测量"
                                Style="{StaticResource CustomButtonStyle}" />
                            <Button
                                Width="100"
                                Height="32"
                                Command="{Binding StopMeasurementCommand}"
                                Content="停止测量"
                                Style="{StaticResource CustomButtonStyle}" />
                        </StackPanel>

                        <CheckBox
                            Margin="0,10,0,0"
                            Content="实时测量激励信号"
                            IsChecked="{Binding IsMeasuringEnabled, Mode=TwoWay}" />

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <Button
                                Width="150"
                                Height="32"
                                Margin="0,0,10,0"
                                Command="{Binding MeasureExcitationSignalCommand}"
                                Content="测量激励信号"
                                Style="{StaticResource CustomButtonStyle}" />
                        </StackPanel>

                        <!--  测量数据显示  -->
                        <TextBlock
                            Margin="0,10,0,0"
                            FontSize="14"
                            FontWeight="Bold"
                            Text="测量结果" />

                        <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                            <TextBlock
                                Width="120"
                                VerticalAlignment="Center"
                                Text="激励电压 (Vrms):" />
                            <TextBox
                                Width="100"
                                Height="28"
                                IsReadOnly="True"
                                Text="{Binding MeasuredExcitationVoltage, Mode=OneWay, StringFormat={}{0:F3}}" />
                        </StackPanel>

                        <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                            <TextBlock
                                Width="120"
                                VerticalAlignment="Center"
                                Text="激励频率 (Hz):" />
                            <TextBox
                                Width="100"
                                Height="28"
                                IsReadOnly="True"
                                Text="{Binding MeasuredExcitationFrequency, Mode=OneWay, StringFormat={}{0:F1}}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!--  左侧：通道配置  -->
            <Border
                Grid.Column="0"
                Margin="4,8,8,8"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Margin="15,15,15,10"
                        Background="White"
                        BorderBrush="#D9D9D9"
                        BorderThickness="1.5"
                        CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel
                                Grid.Row="0"
                                Height="30"
                                Margin="15,0,0,0"
                                Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Text="{Binding CardModel}" />
                                <TextBlock
                                    Margin="35,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    Text="板卡名称：" />
                                <Border
                                    Width="200"
                                    Height="30"
                                    VerticalAlignment="Center"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <TextBox
                                        x:Name="CardNameTextBox"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        BorderThickness="0"
                                        FontSize="15"
                                        LostFocus="CardNameTextBox_LostFocus"
                                        Text="{Binding CardName, UpdateSourceTrigger=PropertyChanged}" />
                                </Border>

                                <Border>
                                    <StackPanel
                                        Height="25"
                                        Margin="35,0,0,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="15"
                                            Text="连接状态：" />
                                        <Grid Width="15" Height="15">
                                            <Ellipse
                                                Width="15"
                                                Height="15"
                                                Stroke="#d1d5db"
                                                StrokeThickness="0.5" />
                                            <Ellipse
                                                Width="13"
                                                Height="13"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill">
                                                            <Setter.Value>
                                                                <RadialGradientBrush GradientOrigin="0.3,0.3">
                                                                    <GradientStop Offset="0" Color="#ff6b6b" />
                                                                    <GradientStop Offset="1" Color="#dc2626" />
                                                                </RadialGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                <Setter Property="Fill">
                                                                    <Setter.Value>
                                                                        <RadialGradientBrush GradientOrigin="0.3,0.3">
                                                                            <GradientStop Offset="0" Color="#4ade80" />
                                                                            <GradientStop Offset="1" Color="#16a34a" />
                                                                        </RadialGradientBrush>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="15"
                                            Text="{Binding ConnectionStatus}" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="20,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button
                                            Width="80"
                                            Height="30"
                                            VerticalAlignment="Center"
                                            BorderThickness="0"
                                            Command="{Binding ToggleDeviceCommand}"
                                            Style="{StaticResource ToggleDeviceButtonStyle}">

                                            <StackPanel Orientation="Horizontal">
                                                <Image
                                                    Width="15"
                                                    Height="15"
                                                    Margin="5,0,5,0"
                                                    Source="/Resources/Logo/export.png" />
                                                <TextBlock
                                                    Margin="0,0,5,0"
                                                    FontSize="12"
                                                    Foreground="White">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="打开板卡" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                    <Setter Property="Text" Value="关闭板卡" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>


                                        </Button>
                                        <Button
                                            Width="60"
                                            Height="30"
                                            Margin="15,0,0,0"
                                            Background="#3b82f6"
                                            BorderThickness="0"
                                            Command="{Binding NavigateToCalibrationCommand}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border
                                                        x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image
                                                                Width="15"
                                                                Height="15"
                                                                Margin="5,0,5,0"
                                                                Source="/Resources/Logo/calibration.png" />
                                                            <TextBlock
                                                                Margin="0,0,5,0"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Foreground="White"
                                                                Text="标定" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ToggleButton
                                    Grid.Column="0"
                                    Width="120"
                                    Height="32"
                                    Margin="0,0,10,0"
                                    Content="通道配置"
                                    IsChecked="{Binding IsChannelListVisible}"
                                    Style="{StaticResource CustomToggleButtonStyle}" />

                                <ItemsControl
                                    Grid.Column="1"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{Binding TopChannelButtons}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                Height="32"
                                                Margin="2,0,2,0"
                                                Padding="8,6"
                                                Command="{Binding DataContext.SelectChannelCommand, RelativeSource={RelativeSource AncestorType={x:Type views:LvdtSimulatorConfigPanel}}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding ChannelName}">
                                                <Button.Style>
                                                    <Style BasedOn="{StaticResource CustomButtonStyle}" TargetType="Button">
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <MultiBinding Converter="{StaticResource ObjectEqualsMultiConverter}">
                                                                        <Binding />
                                                                        <Binding Path="DataContext.SelectedChannel" RelativeSource="{RelativeSource AncestorType={x:Type views:LvdtSimulatorConfigPanel}}" />
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                                <Setter Property="Background" Value="#1d4ed8" />
                                                                <Setter Property="BorderBrush" Value="#1d4ed8" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Border>

                    <ScrollViewer
                        Grid.Row="1"
                        Margin="15,0,15,15"
                        Style="{StaticResource SimpleScrollViewerStyle}"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding IsChannelListVisible, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemTemplate="{StaticResource ChannelConfigTemplate}" ItemsSource="{Binding ChannelConfigs}" />
                    </ScrollViewer>

                    <!--  单通道详情视图  -->
                    <ScrollViewer
                        Grid.Row="1"
                        Margin="15,0,15,15"
                        Style="{StaticResource SimpleScrollViewerStyle}"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding ShowChannelDetail, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel
                                Margin="0,0,0,10"
                                HorizontalAlignment="Left"
                                Orientation="Horizontal">
                                <Button
                                    Width="120"
                                    Height="32"
                                    Margin="0,0,10,0"
                                    Command="{Binding OpenSimulateOutputCommand}"
                                    Content="仿真输出"
                                    Style="{StaticResource CustomButtonStyle}" />
                                <Button
                                    Width="120"
                                    Height="32"
                                    Command="{Binding OpenTestInputCommand}"
                                    Content="测试输入"
                                    Style="{StaticResource CustomButtonStyle}" />
                            </StackPanel>

                            <!--  仿真输出面板  -->
                            <ContentControl
                                x:Name="SimulateContentControl"
                                Content="{Binding SelectedChannel}"
                                ContentTemplate="{StaticResource ChannelSimulateTemplate}"
                                Visibility="{Binding ActiveChannelViewMode, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Simulate}" />

                            <!--  测试输入面板  -->
                            <ContentControl
                                Content="{Binding SelectedChannel}"
                                ContentTemplate="{StaticResource ChannelTestTemplate}"
                                Visibility="{Binding ActiveChannelViewMode, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Test}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

