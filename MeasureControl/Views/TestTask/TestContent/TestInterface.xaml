<UserControl
    x:Class="MeasureControl.Views.TestContent.TestInterface"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MeasureControl.Views.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:MeasureControl.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="800"
    d:DesignWidth="1500"
    Focusable="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ComboBoxStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#eaeaea" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#d0d0d0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <helpers:LevelToIndentConverter x:Key="LevelToIndentConverter" />
            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <helpers:BoolToExpansionIconConverter x:Key="BoolToExpansionIconConverter" />
            <helpers:StringToBrushConverter x:Key="StringToBrushConverter" />
            <helpers:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <helpers:ModelDisplayConverter x:Key="ModelDisplayConverter" />
            <helpers:DeviceTypeToBackgroundConverter x:Key="DeviceTypeToBackgroundConverter" />
            <helpers:DeviceTypeToHoverBackgroundConverter x:Key="DeviceTypeToHoverBackgroundConverter" />
            <helpers:DisplayNameToGridLengthConverter x:Key="DisplayNameToGridLengthConverter" DefaultWidth="100" />
            <helpers:DisplayNameAndMapToGridLengthConverter x:Key="DisplayNameAndMapToGridLengthConverter" DefaultWidth="100" />
            <helpers:ObjectEqualityConverter x:Key="ObjectEqualityConverter" />

            <Style x:Key="PaginationButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="#DADDE2" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#e0e0e0" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#c0c0c0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ActivePaginationButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#3b82f6" />
                <Setter Property="BorderBrush" Value="#3b82f6" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#2563eb" />
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#2563eb" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#1d4ed8" />
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#1d4ed8" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SimpleScrollBarStyle" TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="8" />
                <Setter Property="MinWidth" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="Transparent" BorderThickness="0">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Style>
                                                <Style TargetType="Thumb">
                                                    <Setter Property="Background" Value="#CCCCCC" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderThickness="0"
                                                                    CornerRadius="4" />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#999999" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter Property="Background" Value="#666666" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Thumb.Style>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SimpleScrollViewerStyle" TargetType="ScrollViewer">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="8" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ScrollContentPresenter
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="{TemplateBinding Padding}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />

                                <ScrollBar
                                    x:Name="PART_VerticalScrollBar"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Maximum="{TemplateBinding ScrollableHeight}"
                                    Orientation="Vertical"
                                    Style="{StaticResource SimpleScrollBarStyle}"
                                    ViewportSize="{TemplateBinding ViewportHeight}"
                                    Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                    Value="{TemplateBinding VerticalOffset}" />

                                <ScrollBar
                                    x:Name="PART_HorizontalScrollBar"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Maximum="{TemplateBinding ScrollableWidth}"
                                    Orientation="Horizontal"
                                    Style="{StaticResource SimpleScrollBarStyle}"
                                    ViewportSize="{TemplateBinding ViewportWidth}"
                                    Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                    Value="{TemplateBinding HorizontalOffset}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80*" />
                <ColumnDefinition Width="15*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70*" />
                        <RowDefinition Height="29*" />
                    </Grid.RowDefinitions>
                    <Border x:Name="CenterRegion" Grid.Row="0">
                        <Border.Resources>
                            <Style x:Key="TitleBarButtonStyle" TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="Border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#3d455d" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#4d556d" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Border.Resources>
                        <Grid Background="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="5*" />
                                <RowDefinition Height="97*" />
                            </Grid.RowDefinitions>
                            <Border
                                x:Name="line"
                                Grid.Row="0"
                                Background="#2d354d"
                                Cursor="Hand"
                                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                                <Grid>
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="White"
                                        Text="{Binding DisplayPath}" />
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Button Click="OnMinimizeButtonClick" Style="{StaticResource TitleBarButtonStyle}">
                                            <Image
                                                Width="30"
                                                Margin="0,0,5,0"
                                                Source="/Resources/Logo/min.png" />
                                        </Button>
                                        <Border Width="30" Margin="0,0,5,0">
                                            <Button Click="OnFloatButtonClick" Style="{StaticResource TitleBarButtonStyle}">
                                                <Image
                                                    x:Name="FloatImage"
                                                    Width="15"
                                                    Source="/Resources/Logo/float.png" />
                                            </Button>
                                        </Border>
                                        <Button Click="OnCloseButtonClick" Style="{StaticResource TitleBarButtonStyle}">
                                            <Image Margin="0,0,5,0" Source="/Resources/Logo/close.png" />
                                        </Button>
                                    </StackPanel>

                                </Grid>
                            </Border>

                            <Border Grid.Row="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="{Binding ElementName=line, Path=ActualHeight}" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#cccccc">
                                        <StackPanel
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <!--  Start/Pause 按钮  -->
                                            <Button
                                                Width="30"
                                                Height="25"
                                                Command="{Binding StartPauseTestCommand}">
                                                <Button.ToolTip>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="开始测试" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTestRunning}" Value="True">
                                                                        <Setter Property="Text" Value="暂停测试" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsTestPaused}" Value="True">
                                                                        <Setter Property="Text" Value="继续测试" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button.ToolTip>
                                                <Image
                                                    Width="20"
                                                    Height="18"
                                                    Stretch="Uniform">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Source" Value="/Resources/Logo/start.png" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTestRunning}" Value="True">
                                                                    <Setter Property="Source" Value="/Resources/Logo/pause.png" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsTestPaused}" Value="True">
                                                                    <Setter Property="Source" Value="/Resources/Logo/start.png" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </Button>
                                            <!--  Stop 按钮  -->
                                            <Button
                                                Width="30"
                                                Height="25"
                                                Margin="5,0,0,0"
                                                Command="{Binding StopTestCommand}"
                                                ToolTip="停止测试">
                                                <Image
                                                    Width="20"
                                                    Height="18"
                                                    Source="/Resources/Logo/over.png"
                                                    Stretch="Uniform" />
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        x:Name="CanvasBorder"
                                        Grid.Row="1"
                                        AllowDrop="True"
                                        Background="White"
                                        DragEnter="DesignCanvas_DragEnter"
                                        DragLeave="DesignCanvas_DragLeave"
                                        DragOver="DesignCanvas_DragOver"
                                        Drop="DesignCanvas_Drop">
                                        <Canvas x:Name="DesignCanvas" ClipToBounds="True">
                                            <!--  拖放预览控件  -->
                                            <Border
                                                x:Name="DragPreview"
                                                Background="White"
                                                BorderBrush="#3b82f6"
                                                BorderThickness="2"
                                                CornerRadius="4"
                                                IsHitTestVisible="False"
                                                Opacity="0.7"
                                                Visibility="Collapsed">
                                                <Border.Effect>
                                                    <DropShadowEffect
                                                        BlurRadius="10"
                                                        Opacity="0.3"
                                                        ShadowDepth="3" />
                                                </Border.Effect>
                                            </Border>
                                        </Canvas>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                    </Border>

                    <GridSplitter
                        Grid.Row="0"
                        Height="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Background="#1c1c1c"
                        ShowsPreview="True" />

                    <Border x:Name="ControlConfigPanel" Grid.Row="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="15*" />
                            </Grid.RowDefinitions>
                            <Border Background="#b2b2b2">
                                <TextBlock
                                    Grid.Row="0"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="控件配置" />
                            </Border>
                            <Border
                                Grid.Row="1"
                                Background="#ffffff"
                                BorderBrush="#1c1c1c"
                                BorderThickness="0,1.5,0,0">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!--  标题栏：显示选中控件类型  -->
                                    <StackPanel
                                        Grid.Row="0"
                                        Margin="10,8,0,8"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Image
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Source="/Resources/Logo/warning.png" />
                                        <TextBlock
                                            x:Name="SelectedControlTitle"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Text="{Binding SelectedControlTitle, FallbackValue='暂无信息'}" />
                                    </StackPanel>

                                    <!--  控件参数配置区域 - 使用 ItemsControl 动态生成 5列x4行  -->
                                    <ItemsControl
                                        x:Name="ConfigItemsControl"
                                        Grid.Row="1"
                                        Margin="10,0,10,10"
                                        ItemsSource="{Binding ControlConfigItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <!--  5列4行，从上到下从左到右填充  -->
                                                <controls:ColumnFirstUniformGrid Columns="5" Rows="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="5,3" IsEnabled="{Binding IsEnabled}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" MinWidth="50" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <!--  左侧标签（靠左）  -->
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Margin="0,0,8,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="14"
                                                        Foreground="Black"
                                                        Text="{Binding Label}" />
                                                    <!--  右侧设置项：根据类型显示不同控件（靠右）  -->
                                                    <ContentControl
                                                        Grid.Column="1"
                                                        HorizontalAlignment="Right"
                                                        HorizontalContentAlignment="Stretch"
                                                        Content="{Binding}">
                                                        <ContentControl.Resources>
                                                            <!--  文本输入框（TDM风格）  -->
                                                            <DataTemplate x:Key="TextBoxTemplate">
                                                                <Border
                                                                    Height="26"
                                                                    MinWidth="150"
                                                                    Background="White"
                                                                    BorderBrush="#D9D9D9"
                                                                    BorderThickness="1"
                                                                    CornerRadius="3">
                                                                    <TextBox
                                                                        Margin="8,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        BorderThickness="0"
                                                                        FontSize="14"
                                                                        LostFocus="ConfigTextBox_LostFocus"
                                                                        Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                                                </Border>
                                                            </DataTemplate>
                                                            <!--  颜色选择器  -->
                                                            <DataTemplate x:Key="ColorPickerTemplate">
                                                                <Border
                                                                    Height="26"
                                                                    MinWidth="150"
                                                                    Background="{Binding Value, Converter={StaticResource StringToBrushConverter}}"
                                                                    BorderBrush="#D9D9D9"
                                                                    BorderThickness="1"
                                                                    CornerRadius="3"
                                                                    Cursor="Hand"
                                                                    MouseLeftButtonDown="ConfigColorPicker_Click"
                                                                    Tag="{Binding}">
                                                                    <TextBlock
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="11"
                                                                        Foreground="#666"
                                                                        Text="{Binding Value}" />
                                                                </Border>
                                                            </DataTemplate>
                                                            <!--  下拉框（变量选择）  -->
                                                            <DataTemplate x:Key="ComboBoxTemplate">
                                                                <ComboBox
                                                                    Height="26"
                                                                    MinWidth="150"
                                                                    FontSize="14"
                                                                    ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                                                                    ItemsSource="{Binding SimpleOptions}"
                                                                    SelectedItem="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    SelectionChanged="ConfigComboBox_SelectionChanged"
                                                                    Style="{StaticResource CustomComboBoxStyle}" />
                                                            </DataTemplate>
                                                            <!--  简单下拉框（固定选项如刷新频率）  -->
                                                            <DataTemplate x:Key="SimpleComboBoxTemplate">
                                                                <ComboBox
                                                                    Height="26"
                                                                    MinWidth="150"
                                                                    FontSize="14"
                                                                    ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                                                                    ItemsSource="{Binding SimpleOptions}"
                                                                    SelectedItem="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    SelectionChanged="ConfigSimpleComboBox_SelectionChanged"
                                                                    Style="{StaticResource CustomComboBoxStyle}" />
                                                            </DataTemplate>
                                                        </ContentControl.Resources>
                                                        <ContentControl.Style>
                                                            <Style TargetType="ContentControl">
                                                                <Setter Property="ContentTemplate" Value="{StaticResource TextBoxTemplate}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ConfigType}" Value="ColorPicker">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource ColorPickerTemplate}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ConfigType}" Value="ComboBox">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource ComboBoxTemplate}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ConfigType}" Value="SimpleComboBox">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource SimpleComboBoxTemplate}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentControl.Style>
                                                    </ContentControl>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter
                Grid.Column="0"
                Width="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="#1c1c1c"
                ShowsPreview="True" />


            <!--  右侧控件工具箱  -->
            <Border
                Grid.Row="0"
                Grid.Column="1"
                Background="#eaeaea">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  标题栏  -->
                    <Border
                        Grid.Row="0"
                        Height="{Binding ElementName=line, Path=ActualHeight}"
                        Background="#2d354d">
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="控件工具箱" />
                    </Border>

                    <!--  控件列表  -->
                    <ScrollViewer
                        Grid.Row="1"
                        Style="{StaticResource SimpleScrollViewerStyle}"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <!--  按钮控件  -->
                            <Border
                                x:Name="ToolButton"
                                Margin="0,4"
                                Padding="10,8"
                                Background="White"
                                BorderBrush="#ddd"
                                BorderThickness="1"
                                CornerRadius="4"
                                Cursor="Hand"
                                MouseLeftButtonDown="ToolItem_MouseLeftButtonDown"
                                Tag="Button">
                                <StackPanel Orientation="Horizontal">
                                    <Border
                                        Width="24"
                                        Height="24"
                                        Background="#3b82f6"
                                        CornerRadius="4">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            Text="B" />
                                    </Border>
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="按钮" />
                                </StackPanel>
                            </Border>

                            <!--  开关控件  -->
                            <Border
                                x:Name="ToolSwitch"
                                Margin="0,4"
                                Padding="10,8"
                                Background="White"
                                BorderBrush="#ddd"
                                BorderThickness="1"
                                CornerRadius="4"
                                Cursor="Hand"
                                MouseLeftButtonDown="ToolItem_MouseLeftButtonDown"
                                Tag="Switch">
                                <StackPanel Orientation="Horizontal">
                                    <Border
                                        Width="24"
                                        Height="24"
                                        Background="#22c55e"
                                        CornerRadius="4">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            Text="S" />
                                    </Border>
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="开关" />
                                </StackPanel>
                            </Border>

                            <!--  指示灯控件  -->
                            <Border
                                x:Name="ToolIndicator"
                                Margin="0,4"
                                Padding="10,8"
                                Background="White"
                                BorderBrush="#ddd"
                                BorderThickness="1"
                                CornerRadius="4"
                                Cursor="Hand"
                                MouseLeftButtonDown="ToolItem_MouseLeftButtonDown"
                                Tag="Indicator">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse
                                        Width="24"
                                        Height="24"
                                        Fill="#ef4444" />
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="指示灯" />
                                </StackPanel>
                            </Border>

                            <!--  标签控件（纯文本）  -->
                            <Border
                                x:Name="ToolTextLabel"
                                Margin="0,4"
                                Padding="10,8"
                                Background="White"
                                BorderBrush="#ddd"
                                BorderThickness="1"
                                CornerRadius="4"
                                Cursor="Hand"
                                MouseLeftButtonDown="ToolItem_MouseLeftButtonDown"
                                Tag="TextLabel">
                                <StackPanel Orientation="Horizontal">
                                    <Border
