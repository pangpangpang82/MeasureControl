<UserControl
    x:Class="MeasureControl.Views.TestContent.ReportConfigTabel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:MeasureControl.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:MeasureControl.Views"
    d:DesignHeight="800"
    d:DesignWidth="1500"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <helpers:GridPositionToVisibilityConverter x:Key="GridPositionToVisibilityConverter" />
                    <helpers:GridPositionToChassisConverter x:Key="GridPositionToChassisConverter" />
                    <helpers:GridPositionToVisibilitySimpleConverter x:Key="GridPositionToVisibilitySimpleConverter" />
                    <helpers:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
                    <helpers:DeviceOrConnectionTitleConverter x:Key="DeviceOrConnectionTitleConverter" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#eaeaea" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#d0d0d0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>




            <!--  网格单元格样式  -->
            <Style x:Key="GridCellStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="#e0e0e0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="AllowDrop" Value="True" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="Transparent" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--  PXI机箱数据模板  -->
            <DataTemplate x:Key="PxiChassisTemplate">
                <Border
                    Margin="5"
                    Background="Transparent"
                    Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding
                            Command="{Binding DataContext.PxiChassisDoubleClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            MouseAction="LeftDoubleClick" />
                        <MouseBinding
                            Command="{Binding DataContext.PxiChassisClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            MouseAction="LeftClick" />
                    </Border.InputBindings>
                    <Border.ContextMenu>
                        <ContextMenu Style="{DynamicResource CustomContextMenuStyle}">
                            <MenuItem
                                Command="{Binding PlacementTarget.DataContext.RenamePxiChassisCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                CommandParameter="{Binding}"
                                Header="重命名"
                                Style="{DynamicResource CustomMenuItemStyle}" />
                            <MenuItem
                                Command="{Binding PlacementTarget.DataContext.DeletePxiChassisCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                CommandParameter="{Binding}"
                                Header="删除"
                                Style="{DynamicResource CustomMenuItemStyle}" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1E6496C8" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                        <TextBlock
                             Margin="0,0,0,5"
                            HorizontalAlignment="Center"
                            FontSize="14"
                            Foreground="#2d354d"
                            Text="{Binding Name}" />
                        <Grid>
                            <Image
                                Width="200"
                                Height="140"
                                Source="/Resources/Hardware/PXI-2722.png"
                                Stretch="Uniform" />

                        </Grid>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="66*" />
                <ColumnDefinition Width="14*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="75*" />
                        <RowDefinition Height="29*" />
                    </Grid.RowDefinitions>
                    <Border x:Name="CenterRegion" Grid.Row="0">
                        <Border.Resources>
                            <!--  按钮样式定义在这里，这样浮动时也能保持样式  -->
                            <Style x:Key="TitleBarButtonStyle" TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="Border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#3d455d" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#4d556d" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Border.Resources>
                        <Grid Background="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="5*" />
                                <RowDefinition Height="5*" />
                                <RowDefinition Height="88*" />
                                <RowDefinition Height="5*" />
                            </Grid.RowDefinitions>
                            <Border
                                x:Name="line1"
                                Grid.Row="0"
                                Background="#2d354d"
                                Cursor="Hand"
                                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                                <Grid>
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="White"
                                        Text="{Binding DisplayPath}" />
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Button Click="OnMinimizeButtonClick" Style="{StaticResource TitleBarButtonStyle}">
                                            <Image
                                                Width="30"
                                                Margin="0,0,5,0"
                                                Source="/Resources/Logo/min.png" />
                                        </Button>
                                        <Border Width="30" Margin="0,0,5,0">
                                            <Button Click="OnFloatButtonClick" Style="{StaticResource TitleBarButtonStyle}">
                                                <Image
                                                    x:Name="FloatImage"
                                                    Width="15"
                                                    Source="/Resources/Logo/float.png" />
                                            </Button>
                                        </Border>
                                        <Button Click="OnCloseButtonClick" Style="{StaticResource TitleBarButtonStyle}">
                                            <Image Margin="0,0,5,0" Source="/Resources/Logo/close.png" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Background="#cccccc">
                                <Grid>
                                    <StackPanel
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">

                                        <Button>
                                            <StackPanel Orientation="Horizontal">
                                                <Border
                                                    Width="18"
                                                    Height="14"
                                                    VerticalAlignment="Center"
                                                    Background="#2d354d">
                                                    <Image
                                                        x:Name="logo"
                                                        VerticalAlignment="Center"
                                                        Source="/Resources/Logo/revoke.png" />
                                                </Border>
                                                <TextBlock
                                                    Margin="5,0,10,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="撤回" />
                                            </StackPanel>
                                        </Button>

                                        <Button>
                                            <StackPanel Orientation="Horizontal">
                                                <Border
                                                    Width="18"
                                                    Height="14"
                                                    VerticalAlignment="Center"
                                                    Background="#2d354d">
                                                    <Image VerticalAlignment="Center" Source="/Resources/Logo/redo.png" />
                                                </Border>
                                                <TextBlock
                                                    Margin="5,0,10,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="重做" />
                                            </StackPanel>
                                        </Button>

                                        <Button>
                                            <StackPanel Orientation="Horizontal">
                                                <Border
                                                    Width="18"
                                                    Height="14"
                                                    VerticalAlignment="Center"
                                                    Background="#2d354d">
                                                    <Image
                                                        Height="12"
                                                        VerticalAlignment="Center"
                                                        Source="/Resources/Logo/cp.png" />
                                                </Border>
                                                <TextBlock
                                                    Margin="5,0,10,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="复制" />
                                            </StackPanel>
                                        </Button>

                                        <Button>
                                            <StackPanel Orientation="Horizontal">
                                                <Border
                                                    Width="18"
                                                    Height="14"
                                                    VerticalAlignment="Center"
                                                    Background="#2d354d">
                                                    <Image
                                                        Height="13"
                                                        VerticalAlignment="Center"
                                                        Source="/Resources/Logo/chart.png" />
                                                </Border>
                                                <TextBlock
                                                    Margin="5,0,10,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="图表" />
                                            </StackPanel>
                                        </Button>

                                        <Button>
                                            <StackPanel Orientation="Horizontal">
                                                <Border
                                                    Width="18"
                                                    Height="14"
                                                    VerticalAlignment="Center"
                                                    Background="#2d354d">
                                                    <Image
                                                        Height="12"
                                                        VerticalAlignment="Center"
                                                        Source="/Resources/Logo/tabel.png" />
                                                </Border>
                                                <TextBlock
                                                    Margin="5,0,10,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="表格" />
                                            </StackPanel>
                                        </Button>

                                        <Button>
                                            <StackPanel Orientation="Horizontal">
                                                <Border
                                                    Width="18"
                                                    Height="14"
                                                    VerticalAlignment="Center"
                                                    Background="#2d354d">
                                                    <Image VerticalAlignment="Center" Source="/Resources/Logo/indicator.png" />
                                                </Border>
                                                <TextBlock
                                                    Margin="5,0,10,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="指标" />
                                            </StackPanel>
                                        </Button>

                                        <Button>
                                            <StackPanel Orientation="Horizontal">
                                                <Border
                                                    Width="18"
                                                    Height="14"
                                                    VerticalAlignment="Center"
                                                    Background="#2d354d">
                                                    <Image VerticalAlignment="Center" Source="/Resources/Logo/text.png" />
                                                </Border>
                                                <TextBlock
                                                    Margin="5,0,10,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="文本" />
                                            </StackPanel>
                                        </Button>

                                    </StackPanel>


                                    <StackPanel
                                        Margin="0,0,10,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Button>
                                            <StackPanel Orientation="Horizontal">
                                                <Border
                                                    Width="18"
                                                    Height="14"
                                                    VerticalAlignment="Center"
                                                    Background="#2d354d">
                                                    <Image
                                                        Height="10"
                                                        VerticalAlignment="Center"
                                                        Source="/Resources/Logo/help.png" />
                                                </Border>
                                                <TextBlock
                                                    Margin="5,0,10,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="帮助" />
                                            </StackPanel>
                                        </Button>

                                        <Button>
                                            <StackPanel Orientation="Horizontal">
                                                <Border
                                                    Width="18"
                                                    Height="14"
                                                    VerticalAlignment="Center"
                                                    Background="#2d354d">
                                                    <Image
                                                        Height="12"
                                                        VerticalAlignment="Center"
                                                        Source="/Resources/Logo/preview.png" />
                                                </Border>
                                                <TextBlock
                                                    Margin="5,0,10,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="保持并预览" />
                                            </StackPanel>
                                        </Button>
                                        <Button>
                                            <StackPanel Orientation="Horizontal">
                                                <Border
                                                    Width="18"
                                                    Height="14"
                                                    VerticalAlignment="Center"
                                                    Background="#2d354d">
                                                    <Image VerticalAlignment="Center" Source="/Resources/Logo/sv.png" />
                                                </Border>
                                                <TextBlock
                                                    Margin="5,0,10,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="保存" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <StackPanel HorizontalAlignment="Right" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="2">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="报表详细" />
                            </Border>

                            <Border Grid.Row="3" Background="#1c1c1c">

                                <Grid>
                                    <StackPanel
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Image
                                            Width="13"
                                            VerticalAlignment="Center"
                                            Source="/Resources/Logo/resolution.png" />
                                        <TextBlock
                                            Margin="2,0,10,0"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Foreground="White"
                                            Text="1916x976" />
                                        <Image VerticalAlignment="Center" Source="/Resources/Logo/memory.png" />
                                        <TextBlock
                                            Margin="2,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Foreground="White"
                                            Text="467.4KB" />
                                    </StackPanel>

                                    <StackPanel
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Button Margin="0,0,10,0">
                                            <Image Height="16" Source="/Resources/Logo/width.png" />
                                        </Button>

                                        <Button>
                                            <Image Height="16" Source="/Resources/Logo/height.png" />
                                        </Button>
                                    </StackPanel>

                                    <StackPanel
                                        Margin="0,0,10,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Button Margin="0,0,5,0">
                                            <Image Height="16" Source="/Resources/Logo/oneH.png" />
                                        </Button>
                                        <ComboBox
                                            Width="65"
                                            Height="16"
                                            Margin="0,0,10,0">
                                            <ComboBox.Resources>
                                                <Style TargetType="ComboBox">
                                                    <Setter Property="Background" Value="#363636" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ComboBox">
                                                                <Grid>
                                                                    <Border
                                                                        x:Name="Border"
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="#363636"
                                                                        BorderThickness="0"
                                                                        CornerRadius="3">
                                                                        <ToggleButton
                                                                            x:Name="ToggleButton"
                                                                            Background="Transparent"
                                                                            BorderThickness="0">
                                                                            <ContentPresenter />
                                                                        </ToggleButton>
                                                                    </Border>

                                                                    <!--  下拉列表弹出框  -->
                                                                    <Popup
                                                                        x:Name="Popup"
                                                                        AllowsTransparency="True"
                                                                        Focusable="False"
                                                                        IsOpen="{TemplateBinding IsDropDownOpen}"
                                                                        Placement="Bottom"
                                                                        PopupAnimation="None">
                                                                        <Grid
                                                                            x:Name="DropDown"
                                                                            MinWidth="{TemplateBinding ActualWidth}"
                                                                            MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                                            SnapsToDevicePixels="True">
                                                                            <Border
                                                                                Margin="0,2,0,0"
                                                                                Background="#363636"
                                                                                BorderBrush="#555555"
                                                                                BorderThickness="1"
                                                                                CornerRadius="6">
                                                                                <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                                                                    <ScrollViewer.Template>
                                                                                        <ControlTemplate TargetType="ScrollViewer">
                                                                                            <Grid>
                                                                                                <Grid.ColumnDefinitions>
                                                                                                    <ColumnDefinition />
                                                                                                    <ColumnDefinition Width="Auto" />
                                                                                                </Grid.ColumnDefinitions>
                                                                                                <Grid.RowDefinitions>
                                                                                                    <RowDefinition />
                                                                                                    <RowDefinition Height="Auto" />
                                                                                                </Grid.RowDefinitions>

                                                                                                <ScrollContentPresenter
                                                                                                    Grid.Row="0"
                                                                                                    Grid.Column="0"
                                                                                                    Margin="{TemplateBinding Padding}"
                                                                                                    Content="{TemplateBinding Content}"
                                                                                                    ContentTemplate="{TemplateBinding ContentTemplate}" />

                                                                                                <ScrollBar
                                                                                                    x:Name="PART_VerticalScrollBar"
                                                                                                    Grid.Row="0"
                                                                                                    Grid.Column="1"
                                                                                                    Maximum="{TemplateBinding ScrollableHeight}"
                                                                                                    Orientation="Vertical"
                                                                                                    Style="{StaticResource SimpleScrollBarStyle}"
                                                                                                    ViewportSize="{TemplateBinding ViewportHeight}"
                                                                                                    Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                                                                                    Value="{TemplateBinding VerticalOffset}" />

                                                                                                <ScrollBar
                                                                                                    x:Name="PART_HorizontalScrollBar"
                                                                                                    Grid.Row="1"
                                                                                                    Grid.Column="0"
                                                                                                    Maximum="{TemplateBinding ScrollableWidth}"
                                                                                                    Orientation="Horizontal"
                                                                                                    Style="{StaticResource SimpleScrollBarStyle}"
                                                                                                    ViewportSize="{TemplateBinding ViewportWidth}"
                                                                                                    Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                                                                                    Value="{TemplateBinding HorizontalOffset}" />
                                                                                            </Grid>
                                                                                        </ControlTemplate>
                                                                                    </ScrollViewer.Template>
                                                                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                                                                </ScrollViewer>
                                                                            </Border>
                                                                        </Grid>
                                                                    </Popup>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Border" Property="Background" Value="#333333" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                                <Style TargetType="ComboBoxItem">
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="Background" Value="#363636" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ComboBoxItem">
                                                                <Border
                                                                    x:Name="Border"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="2">
                                                                    <ContentPresenter />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Border" Property="Background" Value="#555555" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ComboBox.Resources>
                                            <ComboBoxItem>50%</ComboBoxItem>
                                            <ComboBoxItem>75%</ComboBoxItem>
                                            <ComboBoxItem>100%</ComboBoxItem>
                                            <ComboBoxItem>125%</ComboBoxItem>
                                            <ComboBoxItem>150%</ComboBoxItem>
                                            <ComboBoxItem>175%</ComboBoxItem>
                                            <ComboBoxItem>200%</ComboBoxItem>
                                        </ComboBox>

                                        <Button Margin="0,0,5,0">
                                            <Image Height="14" Source="/Resources/Logo/reduce.png" />
                                        </Button>


                                        <Slider
                                            Width="100"
                                            Margin="0,0,5,0"
                                            Maximum="100"
                                            Minimum="0"
                                            Value="0">
                                            <Slider.Resources>
                                                <Style x:Key="SliderRepeatButtonStyle" TargetType="RepeatButton">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="RepeatButton">
                                                                <Border
                                                                    Height="4"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="2" />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>

                                                <Style x:Key="SliderThumbStyle" TargetType="Thumb">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Grid>
                                                                    <Ellipse
                                                                        Width="12"
                                                                        Height="12"
                                                                        Fill="#363636" />
                                                                    <Ellipse
                                                                        Width="8"
                                                                        Height="8"
                                                                        Fill="#0B84E1" />
                                                                </Grid>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Slider.Resources>

                                            <Slider.Template>
                                                <ControlTemplate TargetType="Slider">
                                                    <Grid>
                                                        <Border
                                                            Height="4"
                                                            VerticalAlignment="Center"
                                                            Background="#8C8C8C"
                                                            CornerRadius="2" />

                                                        <Track x:Name="PART_Track">
                                                            <Track.DecreaseRepeatButton>
                                                                <RepeatButton
                                                                    Background="#0B84E1"
                                                                    Command="Slider.DecreaseLarge"
                                                                    Style="{StaticResource SliderRepeatButtonStyle}" />
                                                            </Track.DecreaseRepeatButton>
                                                            <Track.IncreaseRepeatButton>
                                                                <RepeatButton
                                                                    Background="Transparent"
                                                                    Command="Slider.IncreaseLarge"
                                                                    Style="{StaticResource SliderRepeatButtonStyle}" />
                                                            </Track.IncreaseRepeatButton>
                                                            <Track.Thumb>
                                                                <Thumb Style="{StaticResource SliderThumbStyle}" />
                                                            </Track.Thumb>
                                                        </Track>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Slider.Template>
                                        </Slider>

                                        <Button Margin="0,0,40,0">
                                            <Image Height="14" Source="/Resources/Logo/magnify.png" />
                                        </Button>

                                        <Button>
                                            <Image Height="14" Source="/Resources/Logo/stretch.png" />
                                        </Button>


                                    </StackPanel>

                                </Grid>
                            </Border>

                        </Grid>
                    </Border>

                    <GridSplitter
                        Grid.Row="0"
                        Height="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Background="#1c1c1c"
                        ShowsPreview="True" />
                    <Border Grid.Row="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="15*" />
                            </Grid.RowDefinitions>
                            <Border
                                Background="#b2b2b2"
                                BorderBrush="#1c1c1c"
                                BorderThickness="0,0,0,1.5">
                                <TextBlock
                                    Grid.Row="0"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="常规" />
                            </Border>
                            <Border Grid.Row="1" Background="#ffffff">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="4*" />
                                        <RowDefinition Height="12*" />
                                        <RowDefinition Height="10*" />
                                        <RowDefinition Height="5*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel
                                        Grid.Row="0"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Image
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Source="/Resources/Logo/warning.png" />
                                        <TextBlock
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="Black"
                                            Text="暂无信息" />
                                    </StackPanel>




                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter
                Grid.Column="0"
                Width="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="#1c1c1c"
                ShowsPreview="True" />

            <!--  右侧工具树  -->
