<UserControl
    x:Class="MeasureControl.Views.TestTask.ART4229ConfigPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:drivers="clr-namespace:MeasureControl.Drivers.ART4229"
    xmlns:helpers="clr-namespace:MeasureControl.Helpers"
    xmlns:local="clr-namespace:MeasureControl.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:MeasureControl.ViewModels"
    d:DesignHeight="550"
    d:DesignWidth="970"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="#FFFFFF"
    mc:Ignorable="d">

    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
        <helpers:BoolToGreenRedConverter x:Key="BoolToGreenRedConverter" />

        <!--  圆角按钮样式  -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#c5e0f7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#a8d4f5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#e5e7eb" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#d1d5db" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  指示灯样式  -->
        <Style x:Key="ChannelIndicatorStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="#9ca3af" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Fill">
                        <Setter.Value>
                            <RadialGradientBrush GradientOrigin="0.3,0.3">
                                <GradientStop Offset="0" Color="#4ade80" />
                                <GradientStop Offset="1" Color="#16a34a" />
                            </RadialGradientBrush>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter Property="Fill" Value="#9ca3af" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  统一按钮样式（灰白风格）  -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#F3F5F7" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E5E7EB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D9D9D9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#F0F0F0" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#CCCCCC" />
                                <Setter Property="Foreground" Value="#999999" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  通道选项卡样式  -->
        <Style x:Key="ChannelTabStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="bd"
                            Margin="1"
                            Padding="2,1"
                            Background="White"
                            BorderBrush="#D9D9D9"
                            BorderThickness="0.8"
                            CornerRadius="4">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <!--  通道指示灯  -->
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    Margin="3,0,4,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#9ca3af" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Fill">
                                                        <Setter.Value>
                                                            <RadialGradientBrush GradientOrigin="0.3,0.3">
                                                                <GradientStop Offset="0" Color="#4ade80" />
                                                                <GradientStop Offset="1" Color="#16a34a" />
                                                            </RadialGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Text="{Binding ChannelName}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EAF2F7" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#d6ebfc" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  标题栏  -->
        <Border
            Grid.Row="0"
            Margin="5"
            Background="White"
            BorderBrush="#D9D9D9"
            BorderThickness="1.5"
            CornerRadius="8">
            <DockPanel Margin="10,5,10,5">
                <TextBlock
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    FontSize="16"
                    FontWeight="Bold"
                    Text="ART4229 配置" />
                <StackPanel
                    Margin="50,0,0,0"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    Orientation="Horizontal">
                    <TextBlock
                        Width="62"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="连接状态：" />
                    <Grid
                        Width="18"
                        Height="18"
                        Margin="5,0,5,0">
                        <Ellipse
                            Width="18"
                            Height="18"
                            Stroke="#d1d5db"
                            StrokeThickness="0.5" />
                        <Ellipse
                            Width="16"
                            Height="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill">
                                        <Setter.Value>
                                            <RadialGradientBrush GradientOrigin="0.3,0.3">
                                                <GradientStop Offset="0" Color="#ff6b6b" />
                                                <GradientStop Offset="1" Color="#dc2626" />
                                            </RadialGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill">
                                                <Setter.Value>
                                                    <RadialGradientBrush GradientOrigin="0.3,0.3">
                                                        <GradientStop Offset="0" Color="#4ade80" />
                                                        <GradientStop Offset="1" Color="#16a34a" />
                                                    </RadialGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                    <TextBlock
                        Margin="4,0"
                        VerticalAlignment="Center"
                        FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Text" Value="在线" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                        <Setter Property="Text" Value="离线" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <Button
                    Width="90"
                    Height="30"
                    Margin="20,0,5,0"
                    BorderThickness="0.5"
                    Command="{Binding ToggleDeviceCommand}"
                    Cursor="Hand"
                    DockPanel.Dock="Left">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="border"
                                Background="#3b82f6"
                                CornerRadius="4">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Image
                                        x:Name="DeviceImage"
                                        Width="15"
                                        Height="15"
                                        Margin="0,0,5,0"
                                        Source="/Resources/Logo/export.png" />
                                    <TextBlock
                                        x:Name="DeviceAction"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="White">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="打开板卡" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Text" Value="关闭板卡" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsConnected}" Value="False" />
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel
                    Margin="5,0,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Width="100"
                        Height="30"
                        Margin="6,0"
                        BorderBrush="#2a2a2a"
                        BorderThickness="1"
                        Command="{Binding OpenAllChannelsCommand}"
                        Content="打开所有通道"
                        FontSize="14"
                        IsEnabled="{Binding IsConnected}" />
                    <Button
                        Width="100"
                        Height="30"
                        Margin="6,0"
                        BorderBrush="#2a2a2a"
                        BorderThickness="1"
                        Command="{Binding CloseAllChannelsCommand}"
                        Content="关闭所有通道"
                        FontSize="14"
                        IsEnabled="{Binding IsConnected}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  主内容区  -->
        <Grid Grid.Row="1" Margin="5,0,5,5">
            <Border
                Padding="1"
                Background="White"
                BorderBrush="#E5EEF6"
                BorderThickness="1.5"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  通道选项卡  -->
                    <Grid
                        Grid.Row="0"
                        Height="32"
                        Margin="1,2,1,2">
                        <ItemsControl ItemsSource="{Binding Channels}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="16" Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton
                                        Command="{Binding DataContext.SelectChannelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        IsChecked="{Binding IsSelected}"
                                        Style="{StaticResource ChannelTabStyle}">
                                        <RadioButton.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Click="MenuOpenChannel_Click" Header="打开通道" />
                                                <MenuItem Click="MenuCloseChannel_Click" Header="关闭通道" />
                                            </ContextMenu>
                                        </RadioButton.ContextMenu>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>



                    <!--  通道配置区域  -->
                    <Border
                        Grid.Row="2"
                        Margin="5"
                        BorderBrush="#E5EEF6"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="7*" />
                            </Grid.ColumnDefinitions>

                            <!--  通道操作行  -->
                            <Grid
                                Grid.Row="0"
                                Grid.ColumnSpan="2"
                                Margin="4,6,4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    Grid.Column="0"
                                    Margin="4,0,20,0"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        Margin="4,0,4,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Text="当前通道方向为：" />
                                    <TextBlock
                                        Margin="4,0,8,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Text="{Binding SelectedChannel.DirectionText, FallbackValue=未选择}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedChannel.IsTx}" Value="True">
                                                        <Setter Property="Foreground" Value="#2563eb" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedChannel.IsTx}" Value="False">
                                                        <Setter Property="Foreground" Value="#16a34a" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Button
                                        Width="100"
                                        Height="26"
                                        Margin="8,0"
                                        Background="#d6ebfc"
                                        BorderBrush="#62b5e6"
                                        BorderThickness="1"
                                        Command="{Binding SwitchChannelDirectionCommand}"
                                        Content="切换通道方向"
                                        IsEnabled="{Binding IsConnected}" />

                                    <!--  垂直分隔线（通过旋转实现）  -->
                                    <Separator
                                        Width="20"
                                        Height="1"
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="#E5E7EB">
                                        <Separator.LayoutTransform>
                                            <RotateTransform Angle="90" />
                                        </Separator.LayoutTransform>
                                    </Separator>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    Margin="2,0,0,0"
                                    Orientation="Horizontal">
                                    <!--  发送通道：开始发送/停止发送  -->
                                    <Button
                                        Width="60"
                                        Height="26"
                                        Margin="4,0"
                                        Background="#d6ebfc"
                                        BorderBrush="#62b5e6"
                                        BorderThickness="1"
                                        Command="{Binding StartSendCommand}"
                                        Content="开始发送"
                                        IsEnabled="{Binding IsConnected}">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource RoundedButtonStyle}" TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedChannel.IsTx}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button
                                        Width="60"
                                        Height="26"
                                        Margin="4,0"
                                        Background="#d6ebfc"
                                        BorderBrush="#62b5e6"
                                        BorderThickness="1"
                                        Command="{Binding StopSendCommand}"
                                        Content="停止发送"
                                        IsEnabled="{Binding IsConnected}">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource RoundedButtonStyle}" TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedChannel.IsTx}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <!--  接收通道：开始接收/停止接收  -->
                                    <Button
                                        Width="60"
                                        Height="26"
                                        Margin="4,0"
                                        Background="#d6ebfc"
                                        BorderBrush="#62b5e6"
                                        BorderThickness="1"
                                        Command="{Binding StartReceiveCommand}"
                                        Content="开始接收"
                                        IsEnabled="{Binding IsConnected}">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource RoundedButtonStyle}" TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedChannel.IsTx}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button
                                        Width="60"
                                        Height="26"
                                        Margin="4,0"
                                        Background="#d6ebfc"
                                        BorderBrush="#62b5e6"
                                        BorderThickness="1"
                                        Command="{Binding StopReceiveCommand}"
                                        Content="停止接收"
                                        IsEnabled="{Binding IsConnected}">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource RoundedButtonStyle}" TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedChannel.IsTx}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button
                                        Width="60"
                                        Height="26"
                                        Margin="4,0"
                                        Background="#d6ebfc"
                                        BorderBrush="#62b5e6"
                                        BorderThickness="1"
                                        Command="{Binding ClearRxDataCommand}"
                                        Content="清空列表" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    Margin="0,0,10,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,3,0"
                                        VerticalAlignment="Center"
                                        FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="接收状态：" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedChannel.IsTx}" Value="True">
                                                        <Setter Property="Text" Value="发送状态：" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        CornerRadius="8">
                                        <Ellipse
                                            Width="12"
                                            Height="12"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill">
                                                        <Setter.Value>
                                                            <RadialGradientBrush GradientOrigin="0.3,0.3">
                                                                <GradientStop Offset="0" Color="#9ca3af" />
                                                                <GradientStop Offset="1" Color="#6b7280" />
                                                            </RadialGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedChannel.CurrentConfig.IsRunning}" Value="True">
                                                            <Setter Property="Fill">
                                                                <Setter.Value>
                                                                    <RadialGradientBrush GradientOrigin="0.3,0.3">
                                                                        <GradientStop Offset="0" Color="#4ade80" />
                                                                        <GradientStop Offset="1" Color="#16a34a" />
                                                                    </RadialGradientBrush>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Border>
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="未接收" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedChannel.IsTx}" Value="True">
                                                        <Setter Property="Text" Value="未发送" />
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding SelectedChannel.CurrentConfig.IsRunning}" Value="True" />
                                                            <Condition Binding="{Binding SelectedChannel.IsTx}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Text" Value="正在发送" />
                                                        <Setter Property="Foreground" Value="#16a34a" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding SelectedChannel.CurrentConfig.IsRunning}" Value="True" />
                                                            <Condition Binding="{Binding SelectedChannel.IsTx}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Text" Value="正在接收" />
                                                        <Setter Property="Foreground" Value="#16a34a" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <!--  通道配置面板  -->
                            <!--  接收配置面板  -->
                            <Border
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="4"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="4"
                                DataContext="{Binding SelectedChannel}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.SelectedChannel.IsTx, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Margin="8">
                                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Text="通 道 配 置 - " />
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Foreground="#3b82f6"
                                            Text="{Binding ChannelName, FallbackValue=未选择}" />
                                    </StackPanel>

                                    <StackPanel DataContext="{Binding CurrentConfig}">
                                        <StackPanel Margin="0,4" Orientation="Horizontal">
                                            <TextBlock
                                                Width="60"
                                                VerticalAlignment="Center"
                                                Text="通道中断：" />
                                            <ComboBox
                                                Width="80"
                                                Height="22"
                                                ItemsSource="{Binding InterruptOptions}"
                                                SelectedIndex="{Binding InterruptIndex, Mode=TwoWay}" />
                                        </StackPanel>

                                        <StackPanel Margin="0,4" Orientation="Horizontal">
                                            <TextBlock
                                                Width="60"
                                                VerticalAlignment="Center"
                                                Text="中断深度：" />
                                            <ComboBox
                                                Width="80"
                                                Height="22"
                                                IsEnabled="{Binding EnableInterrupt}"
                                                ItemsSource="{Binding InterruptDepthOptions}"
                                                SelectedItem="{Binding InterruptDepth, Mode=TwoWay}" />
                                        </StackPanel>

                                        <StackPanel Margin="0,4" Orientation="Horizontal">
                                            <TextBlock
                                                Width="60"
                                                VerticalAlignment="Center"
                                                Text="码  率：" />
                                            <ComboBox
                                                x:Name="cmbRate"
                                                Width="80"
                                                Height="22">
                                                <ComboBoxItem Content="100000" IsSelected="True" />
                                                <ComboBoxItem Content="50000" />
                                                <ComboBoxItem Content="12500" />
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Margin="0,4" Orientation="Horizontal">
                                            <TextBlock
                                                Width="60"
                                                VerticalAlignment="Center"
                                                Text="时  标：" />
                                            <CheckBox VerticalAlignment="Center" IsChecked="{Binding EnableTimeTag, Mode=TwoWay}" />
                                        </StackPanel>

                                        <Border
                                            Height="1"
                                            Margin="0,8"
                                            Background="#E5E7EB" />

                                        <StackPanel Margin="0,4" Orientation="Horizontal">
                                            <TextBlock
                                                Width="60"
                                                VerticalAlignment="Center"
                                                Text="字格式：" />
                                            <ComboBox
                                                Width="80"
                                                Height="22"
                                                SelectedIndex="{Binding WordFormat, Mode=TwoWay}">
                                                <ComboBoxItem Content="标准429" IsSelected="True" />
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Margin="0,4" Orientation="Horizontal">
                                            <TextBlock
                                                Width="60"
                                                VerticalAlignment="Center"
                                                Text="校  验：" />
                                            <ComboBox
                                                Width="80"
                                                Height="22"
                                                SelectedIndex="{Binding Parity, Mode=TwoWay}">
                                                <ComboBoxItem Content="None" IsSelected="True" />
                                                <ComboBoxItem Content="ODD" />
                                                <ComboBoxItem Content="EVEN" />
                                            </ComboBox>
                                        </StackPanel>
                                        <Button
                                            Width="50"
                                            Height="24"
                                            Margin="0,12,10,0"
                                            HorizontalAlignment="Right"
                                            Background="#d6ebfc"
                                            BorderBrush="#62b5e6"
                                            BorderThickness="1"
                                            Command="{Binding DataContext.ConfigureChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Content="配 置"
                                            IsEnabled="{Binding DataContext.IsConnected, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </StackPanel>

                                </StackPanel>
                            </Border>

                            <!--  发送配置面板  -->
                            <Border
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="4"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="4"
                                DataContext="{Binding SelectedChannel}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.SelectedChannel.IsTx, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel Margin="8">
                                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Text="通 道 配 置 - " />
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Foreground="#3b82f6"
                                            Text="{Binding ChannelName, FallbackValue=未选择}" />
                                    </StackPanel>

                                    <StackPanel DataContext="{Binding CurrentConfig}">
                                        <StackPanel Margin="0,4" Orientation="Horizontal">
                                            <TextBlock
                                                Width="60"
                                                VerticalAlignment="Center"
                                                Text="发送模式：" />
                                            <ComboBox
                                                Width="80"
                                                Height="22"
                                                SelectedIndex="{Binding SendMode, Mode=TwoWay}">
                                                <ComboBoxItem Content="Single" />
                                                <ComboBoxItem Content="Period" />
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Margin="0,4" Orientation="Horizontal">
                                            <TextBlock
                                                Width="60"
                                                VerticalAlignment="Center"
                                                Text="码  率：" />
                                            <ComboBox
                                                Width="80"
                                                Height="22"
                                                SelectedIndex="{Binding RateIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="100000" />
                                                <ComboBoxItem Content="50000" />
                                                <ComboBoxItem Content="12500" />
                                            </ComboBox>
                                        </StackPanel>

                                        <Button
                                            Width="50"
                                            Height="24"
                                            Margin="0,2,10,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Background="#d6ebfc"
                                            BorderBrush="#62b5e6"
                                            BorderThickness="1"
                                            Command="{Binding DataContext.ConfigureChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Content="配 置"
                                            IsEnabled="{Binding DataContext.IsConnected, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                                        <Separator
                                            Height="1"
                                            Margin="0,5"
                                            Background="#E5E7EB" />

                                        <StackPanel
                                            Margin="0,4,0,4"
                                            IsEnabled="{Binding IsPeriodMode}"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                Width="60"
                                                VerticalAlignment="Center"
                                                Text="发送周期：" />
                                            <ComboBox
                                                Width="80"
                                                Height="22"
                                                SelectedIndex="{Binding SendPeriodIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="100" />
                                                <ComboBoxItem Content="200" />
                                                <ComboBoxItem Content="500" />
                                                <ComboBoxItem Content="1000" />
                                            </ComboBox>
                                            <TextBlock
                                                Width="30"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Text="(ms)" />
                                        </StackPanel>

                                        <StackPanel
                                            Margin="0,4,0,4"
                                            IsEnabled="{Binding IsPeriodMode}"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                Width="60"
                                                VerticalAlignment="Center"
                                                Text="发送次数：" />
                                            <TextBox
                                                Width="60"
                                                Height="18"
                                                Margin="0,0,8,0"
                                                Text="{Binding SendCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <StackPanel
                                            Margin="0,4,0,4"
                                            IsEnabled="{Binding IsPeriodMode}"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                Width="60"
                                                VerticalAlignment="Center"
                                                Text="字间隔：" />
                                            <TextBox
                                                Width="60"
                                                Height="18"
                                                Margin="0,0,8,0"
                                                Text="{Binding WordInterval, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock
                                                Width="60"
                                                VerticalAlignment="Center"
                                                Text="范围[4,64]" />
                                        </StackPanel>

                                        <StackPanel Margin="0,4,0,4" Orientation="Horizontal">
                                            <TextBlock
                                                Width="60"
                                                VerticalAlignment="Center"
                                                Text="校  验：" />
                                            <ComboBox
                                                Width="80"
                                                Height="22"
                                                SelectedIndex="{Binding Parity, Mode=TwoWay}">
                                                <ComboBoxItem Content="None" IsSelected="True" />
                                                <ComboBoxItem Content="ODD" />
                                                <ComboBoxItem Content="EVEN" />
                                            </ComboBox>
                                        </StackPanel>

                                        <Border
                                            Margin="0,16,0,0"
                                            Background="#F8FAFC"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="50" />
                                                    <RowDefinition Height="40" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock
                                                    Grid.Row="0"
                                                    Width="44"
                                                    Margin="8,-8,0,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Background="#F8FAFC"
                                                    FontSize="12"
                                                    Text=" 字结构 " />

                                                <StackPanel
                                                    Grid.Row="1"
                                                    Margin="36,10,0,-6"
                                                    Orientation="Horizontal">
                                                    <TextBlock
                                                        Width="76"
                                                        Margin="2,0,4,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        Text="SSM/Data/SDI" />
                                                    <TextBlock
                                                        Width="50"
                                                        Margin="4,0,4,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        Text="八进制标签" />
                                                </StackPanel>

                                                <StackPanel
                                                    Grid.Row="2"
                                                    Margin="0,0,0,0"
                                                    Orientation="Horizontal">
                                                    <TextBlock
                                                        Width="36"
                                                        Margin="2,0,4,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Text="Label:" />
                                                    <TextBox
                                                        Width="65"
                                                        Height="22"
                                                        Margin="0,0,8,0"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Text="{Binding DataContext.LabelSsmDataSdi, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <ComboBox
                                                        Width="65"
                                                        Height="22"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        ItemsSource="{Binding DataContext.OctalLabelOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        SelectedIndex="{Binding DataContext.LabelOctalIndex, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                                                </StackPanel>

                                                <StackPanel
                                                    Grid.Row="3"
                                                    Margin="0,0,0,0"
                                                    Orientation="Horizontal">
                                                    <TextBlock
                                                        Width="108"
                                                        Margin="0,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Text="=&gt; 429数据(Hex):" />
                                                    <TextBox
                                                        Width="70"
                                                        Height="22"
                                                        Margin="0,0,8,0"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        IsReadOnly="True"
                                                        Text="{Binding DataContext.Data429Hex, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Row="4"
                                                    Margin="0,4,0,8"
                                                    HorizontalAlignment="Right"
                                                    Orientation="Horizontal">
                                                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding DataContext.IsDataIncrement, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                                                    <TextBlock
                                                        Width="60"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Text="数据递增" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!--  通道数据列表  -->
                            <!--  接收数据列表  -->
                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="4"
                                Background="White"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedChannel.IsTx}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Margin="8">
                                    <TextBlock
                                        Margin="0,0,0,10"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Text="接 收 数 据 列 表" />
                                    <DataGrid
                                        x:Name="rxDataGrid"
                                        Grid.Row="1"
                                        MinHeight="380"
                                        AlternatingRowBackground="#F3FAFF"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        CanUserDeleteRows="False"
                                        GridLinesVisibility="Horizontal"
                                        HeadersVisibility="Column"
                                        IsReadOnly="True"
                                        ItemsSource="{Binding SelectedChannel.RxDataList}"
                                        RowHeaderWidth="28"
                                        SelectedItem="{Binding SelectedRxDataItem, Mode=TwoWay}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn
                                                Width="40"
                                                Binding="{Binding Index}"
                                                Header="#" />
                                            <DataGridTextColumn
                                                Width="90"
                                                Binding="{Binding TimeStamp}"
                                                Header="时标"
                                                Visibility="{Binding DataContext.SelectedChannel.CurrentConfig.EnableTimeTag, ElementName=rxDataGrid, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <DataGridTextColumn
                                                Width="60"
                                                Binding="{Binding Rate, StringFormat=F0}"
                                                Header="码率" />
                                            <DataGridTextColumn
                                                Width="80"
                                                Binding="{Binding Data429Hex}"
                                                Header="原始数据" />
                                            <DataGridTextColumn
                                                Width="50"
                                                Binding="{Binding Label}"
                                                Header="Label" />
                                            <DataGridTextColumn
                                                Width="40"
                                                Binding="{Binding SDI}"
                                                Header="SDI" />
                                            <DataGridTextColumn
                                                Width="*"
                                                Binding="{Binding Data}"
                                                Header="Data" />
                                            <DataGridTextColumn
                                                Width="40"
                                                Binding="{Binding SSM}"
                                                Header="SSM" />
                                            <DataGridTextColumn
                                                Width="50"
                                                Binding="{Binding ParityBit}"
                                                Header="校验位" />
                                            <DataGridTextColumn
                                                Width="70"
                                                Binding="{Binding ParityCheck}"
                                                Header="校验状态" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!--  发送数据列表  -->
                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="4"
                                Background="White"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedChannel.IsTx}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Margin="8">
                                    <TextBlock
                                        Margin="0,0,0,10"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Text="数 据 列 表" />
                                    <!--  Single模式数据列表  -->
                                    <DataGrid
                                        MinHeight="350"
                                        AlternatingRowBackground="#F3FAFF"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        CanUserDeleteRows="False"
                                        GridLinesVisibility="Horizontal"
                                        HeadersVisibility="Column"
                                        IsReadOnly="True"
                                        ItemsSource="{Binding SelectedChannel.TxDataList}"
                                        RowHeaderWidth="28"
                                        SelectedItem="{Binding SelectedTxDataItem, Mode=TwoWay}">
                                        <DataGrid.Style>
                                            <Style TargetType="DataGrid">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedChannel.CurrentConfig.IsPeriodMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.Style>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn
                                                Width="60"
                                                Binding="{Binding Index}"
                                                Header="#" />
                                            <DataGridTextColumn
                                                Width="*"
                                                Binding="{Binding Data429Hex}"
                                                Header="429数据" />
                                            <DataGridTextColumn
                                                Width="100"
                                                Binding="{Binding Label}"
                                                Header="Label" />
                                            <DataGridTextColumn
                                                Width="100"
                                                Binding="{Binding ParityText}"
                                                Header="校验" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!--  Period模式数据列表  -->
                                    <DataGrid
                                        MinHeight="350"
                                        AlternatingRowBackground="#F3FAFF"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        CanUserDeleteRows="False"
                                        GridLinesVisibility="Horizontal"
                                        HeadersVisibility="Column"
                                        IsReadOnly="True"
                                        ItemsSource="{Binding SelectedChannel.TxDataList}"
                                        RowHeaderWidth="28"
                                        SelectedItem="{Binding SelectedTxDataItem, Mode=TwoWay}">
                                        <DataGrid.Style>
                                            <Style TargetType="DataGrid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedChannel.CurrentConfig.IsPeriodMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.Style>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn
                                                Width="60"
                                                Binding="{Binding Index}"
                                                Header="#" />
                                            <DataGridTextColumn
                                                Width="*"
                                                Binding="{Binding Data429Hex}"
                                                Header="429数据" />
                                            <DataGridTextColumn
                                                Width="100"
                                                Binding="{Binding Label}"
                                                Header="Label" />
                                            <DataGridTextColumn
                                                Width="60"
                                                Binding="{Binding SendPeriod}"
                                                Header="发送周期" />
                                            <DataGridTextColumn
                                                Width="60"
                                                Binding="{Binding SendCount}"
                                                Header="发送次数" />
                                            <DataGridTextColumn
                                                Width="60"
                                                Binding="{Binding WordInterval}"
                                                Header="字间隔" />
                                            <DataGridTextColumn
                                                Width="60"
                                                Binding="{Binding ParityText}"
                                                Header="校验" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                        <Button
                                            Width="70"
                                            Height="28"
                                            Margin="6,0"
                                            Background="#d6ebfc"
                                            BorderBrush="#62b5e6"
                                            BorderThickness="1"
                                            Command="{Binding AddTxDataCommand}"
                                            Content="添加数据" />
                                        <Button
                                            Width="70"
                                            Height="28"
                                            Margin="6,0"
                                            Background="#d6ebfc"
                                            BorderBrush="#62b5e6"
                                            BorderThickness="1"
                                            Command="{Binding ModifyTxDataCommand}"
                                            Content="修改数据" />
                                        <Button
                                            Width="90"
                                            Height="28"
                                            Margin="6,0"
                                            Background="#d6ebfc"
                                            BorderBrush="#62b5e6"
                                            BorderThickness="1"
                                            Command="{Binding DeleteTxDataCommand}"
                                            Content="删除选定数据" />
                                        <Button
                                            Width="90"
                                            Height="28"
                                            Margin="6,0"
                                            Background="#d6ebfc"
                                            BorderBrush="#62b5e6"
                                            BorderThickness="1"
                                            Content="保存发送数据" />
                                        <Button
                                            Width="90"
                                            Height="28"
                                            Margin="6,0"
                                            Background="#d6ebfc"
                                            BorderBrush="#62b5e6"
                                            BorderThickness="1"
                                            Content="导入发送数据" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

