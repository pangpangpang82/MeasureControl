<UserControl

    x:Class="MeasureControl.Views.MatrixSwitchConfigTable"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

    xmlns:helpers="clr-namespace:MeasureControl.Helpers"

    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    xmlns:views="clr-namespace:MeasureControl.Views"

    d:DesignHeight="800"

    d:DesignWidth="1000"

    mc:Ignorable="d">



    <UserControl.Resources>

        <helpers:MethodCallConverter x:Key="MethodCallConverter" />

        <Style TargetType="Button">

            <Setter Property="Background" Value="Transparent" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border

                            x:Name="Border"

                            Background="{TemplateBinding Background}"

                            BorderBrush="{TemplateBinding BorderBrush}"

                            BorderThickness="{TemplateBinding BorderThickness}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="Border" Property="Background" Value="#eaeaea" />

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="Border" Property="Background" Value="#d0d0d0" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <helpers:LevelToIndentConverter x:Key="LevelToIndentConverter" />

        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <helpers:BoolToExpansionIconConverter x:Key="BoolToExpansionIconConverter" />

        <helpers:BoolToTreeArrowConverter x:Key="BoolToTreeArrowConverter" />

        <helpers:StringToBrushConverter x:Key="StringToBrushConverter" />

        <helpers:ModelDisplayConverter x:Key="ModelDisplayConverter" />

        <helpers:DeviceTypeToBackgroundConverter x:Key="DeviceTypeToBackgroundConverter" />

        <helpers:DeviceTypeToHoverBackgroundConverter x:Key="DeviceTypeToHoverBackgroundConverter" />

        <helpers:SignalIndexDisplayConverter x:Key="SignalIndexDisplayConverter" />

        <helpers:EmptyValueConverter x:Key="EmptyValueConverter" />

        <helpers:ValueWithUnitConverter x:Key="ValueWithUnitConverter" />



        <!--  分页按钮样式  -->

        <Style x:Key="PaginationButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="White" />

            <Setter Property="BorderBrush" Value="#DADDE2" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border

                            x:Name="ButtonBorder"

                            Background="{TemplateBinding Background}"

                            BorderBrush="{TemplateBinding BorderBrush}"

                            BorderThickness="{TemplateBinding BorderThickness}"

                            CornerRadius="3">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <!--  鼠标悬停效果  -->

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="ButtonBorder" Property="Background" Value="#e0e0e0" />

                            </Trigger>

                            <!--  按下效果  -->

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="ButtonBorder" Property="Background" Value="#c0c0c0" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!--  激活状态的分页按钮样式（蓝色）  -->

        <Style x:Key="ActivePaginationButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="#3b82f6" />

            <Setter Property="BorderBrush" Value="#3b82f6" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border

                            x:Name="ButtonBorder"

                            Background="{TemplateBinding Background}"

                            BorderBrush="{TemplateBinding BorderBrush}"

                            BorderThickness="{TemplateBinding BorderThickness}"

                            CornerRadius="3">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <!--  鼠标悬停效果 - 蓝色变深  -->

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2563eb" />

                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#2563eb" />

                            </Trigger>

                            <!--  按下效果 - 更深的蓝色  -->

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1d4ed8" />

                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#1d4ed8" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!--  操作列按钮样式（无边框，高亮灰色）  -->

        <Style x:Key="ActionButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="Transparent" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="BorderBrush" Value="Transparent" />

            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border

                            x:Name="ActionButtonBorder"

                            Width="25"

                            Height="25"

                            Background="{TemplateBinding Background}"

                            BorderBrush="Transparent"

                            BorderThickness="0"

                            CornerRadius="3">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <!--  鼠标悬停效果  -->

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="ActionButtonBorder" Property="Background" Value="#e0e0e0" />

                            </Trigger>

                            <!--  按下效果  -->

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="ActionButtonBorder" Property="Background" Value="#c0c0c0" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!--  导航按钮样式（上一页/下一页）  -->

        <Style x:Key="NavigationButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="White" />

            <Setter Property="BorderBrush" Value="#DADDE2" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border

                            x:Name="NavButtonBorder"

                            Background="{TemplateBinding Background}"

                            BorderBrush="{TemplateBinding BorderBrush}"

                            BorderThickness="{TemplateBinding BorderThickness}"

                            CornerRadius="3">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <!--  鼠标悬停效果 - 稍浅灰色  -->

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="NavButtonBorder" Property="Background" Value="#e0e0e0" />

                            </Trigger>

                            <!--  按下效果 - 稍浅灰色  -->

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="NavButtonBorder" Property="Background" Value="#c0c0c0" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!--  简洁的滚动条样式  -->

        <Style x:Key="SimpleScrollBarStyle" TargetType="ScrollBar">

            <Setter Property="Background" Value="Transparent" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="Width" Value="8" />

            <Setter Property="MinWidth" Value="8" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ScrollBar">

                        <Border Background="Transparent" BorderThickness="0">

                            <Track x:Name="PART_Track" IsDirectionReversed="True">

                                <Track.Thumb>

                                    <Thumb>

                                        <Thumb.Style>

                                            <Style TargetType="Thumb">

                                                <Setter Property="Background" Value="#CCCCCC" />

                                                <Setter Property="BorderThickness" Value="0" />

                                                <Setter Property="Template">

                                                    <Setter.Value>

                                                        <ControlTemplate TargetType="Thumb">

                                                            <Border

                                                                Background="{TemplateBinding Background}"

                                                                BorderThickness="0"

                                                                CornerRadius="4" />

                                                        </ControlTemplate>

                                                    </Setter.Value>

                                                </Setter>

                                                <Style.Triggers>

                                                    <Trigger Property="IsMouseOver" Value="True">

                                                        <Setter Property="Background" Value="#999999" />

                                                    </Trigger>

                                                    <Trigger Property="IsDragging" Value="True">

                                                        <Setter Property="Background" Value="#666666" />

                                                    </Trigger>

                                                </Style.Triggers>

                                            </Style>

                                        </Thumb.Style>

                                    </Thumb>

                                </Track.Thumb>

                            </Track>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!--  简洁的ScrollViewer样式  -->

        <Style x:Key="SimpleScrollViewerStyle" TargetType="ScrollViewer">

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ScrollViewer">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition />

                                <ColumnDefinition Width="8" />

                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>

                                <RowDefinition />

                                <RowDefinition Height="Auto" />

                            </Grid.RowDefinitions>



                            <ScrollContentPresenter

                                Grid.Row="0"

                                Grid.Column="0"

                                Margin="{TemplateBinding Padding}"

                                Content="{TemplateBinding Content}"

                                ContentTemplate="{TemplateBinding ContentTemplate}" />



                            <ScrollBar

                                x:Name="PART_VerticalScrollBar"

                                Grid.Row="0"

                                Grid.Column="1"

                                Maximum="{TemplateBinding ScrollableHeight}"

                                Orientation="Vertical"

                                Style="{StaticResource SimpleScrollBarStyle}"

                                ViewportSize="{TemplateBinding ViewportHeight}"

                                Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"

                                Value="{TemplateBinding VerticalOffset}" />



                            <ScrollBar

                                x:Name="PART_HorizontalScrollBar"

                                Grid.Row="1"

                                Grid.Column="0"

                                Maximum="{TemplateBinding ScrollableWidth}"

                                Orientation="Horizontal"

                                Style="{StaticResource SimpleScrollBarStyle}"

                                ViewportSize="{TemplateBinding ViewportWidth}"

                                Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"

                                Value="{TemplateBinding HorizontalOffset}" />

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!--  ComboBox 样式 - 添加圆角和与表格背景一致  -->

        <Style TargetType="ComboBox">

            <Setter Property="Background" Value="White" />

            <Setter Property="BorderBrush" Value="#DADDE2" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="Padding" Value="8,5" />

            <Setter Property="HorizontalContentAlignment" Value="Left" />

            <Setter Property="VerticalContentAlignment" Value="Center" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <ToggleButton

                                x:Name="ToggleButton"

                                Grid.Column="0"

                                Background="{TemplateBinding Background}"

                                BorderBrush="{TemplateBinding BorderBrush}"

                                BorderThickness="{TemplateBinding BorderThickness}"

                                ClickMode="Press"

                                Focusable="False"

                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">

                                <ToggleButton.Template>

                                    <ControlTemplate TargetType="ToggleButton">

                                        <Border

                                            x:Name="Border"

                                            Background="{TemplateBinding Background}"

                                            BorderBrush="{TemplateBinding BorderBrush}"

                                            BorderThickness="{TemplateBinding BorderThickness}"

                                            CornerRadius="4">

                                            <Grid>

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition />

                                                    <ColumnDefinition Width="20" />

                                                </Grid.ColumnDefinitions>

                                                <Path

                                                    x:Name="Arrow"

                                                    Grid.Column="1"

                                                    HorizontalAlignment="Center"

                                                    VerticalAlignment="Center"

                                                    Data="M 0 0 L 4 4 L 8 0 Z"

                                                    Fill="#666666" />

                                            </Grid>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">

                                                <Setter TargetName="Border" Property="Background" Value="#f5f5f5" />

                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </ToggleButton.Template>

                            </ToggleButton>

                            <ContentPresenter

                                Margin="8,0,25,0"

                                HorizontalAlignment="Left"

                                VerticalAlignment="Center"

                                Content="{TemplateBinding SelectionBoxItem}"

                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"

                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"

                                IsHitTestVisible="False" />

                            <Popup

                                x:Name="Popup"

                                AllowsTransparency="True"

                                Focusable="False"

                                IsOpen="{TemplateBinding IsDropDownOpen}"

                                Placement="Bottom"

                                PopupAnimation="Slide">

                                <Grid

                                    MinWidth="{TemplateBinding ActualWidth}"

                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"

                                    SnapsToDevicePixels="True">

                                    <Border

                                        Background="White"

                                        BorderBrush="#DADDE2"

                                        BorderThickness="1"

                                        CornerRadius="4">

                                        <ScrollViewer Margin="0,2" SnapsToDevicePixels="True">

                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />

                                        </ScrollViewer>

                                    </Border>

                                </Grid>

                            </Popup>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <Style x:Key="BlueActionToggleButtonStyle" TargetType="ToggleButton">

            <Setter Property="Background" Value="#3b82f6" />

            <Setter Property="Foreground" Value="White" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="Padding" Value="12,4" />

            <Setter Property="MinWidth" Value="90" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ToggleButton">

                        <Border

                            x:Name="border"

                            Background="{TemplateBinding Background}"

                            CornerRadius="4">

                            <ContentPresenter

                                HorizontalAlignment="Center"

                                VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#ef4444" />

                            </Trigger>



                            <MultiTrigger>

                                <MultiTrigger.Conditions>

                                    <Condition Property="IsChecked" Value="False" />

                                    <Condition Property="IsMouseOver" Value="True" />

                                </MultiTrigger.Conditions>

                                <Setter TargetName="border" Property="Background" Value="#2563eb" />

                            </MultiTrigger>



                            <MultiTrigger>

                                <MultiTrigger.Conditions>

                                    <Condition Property="IsChecked" Value="False" />

                                    <Condition Property="IsPressed" Value="True" />

                                </MultiTrigger.Conditions>

                                <Setter TargetName="border" Property="Background" Value="#1d4ed8" />

                            </MultiTrigger>



                            <MultiTrigger>

                                <MultiTrigger.Conditions>

                                    <Condition Property="IsChecked" Value="True" />

                                    <Condition Property="IsMouseOver" Value="True" />

                                </MultiTrigger.Conditions>

                                <Setter TargetName="border" Property="Background" Value="#b91c1c" />

                            </MultiTrigger>



                            <MultiTrigger>

                                <MultiTrigger.Conditions>

                                    <Condition Property="IsChecked" Value="True" />

                                    <Condition Property="IsPressed" Value="True" />

                                </MultiTrigger.Conditions>

                                <Setter TargetName="border" Property="Background" Value="#b91c1c" />

                            </MultiTrigger>

                            <Trigger Property="IsEnabled" Value="False">

                                <Setter TargetName="border" Property="Background" Value="#9ca3af" />

                                <Setter TargetName="border" Property="Opacity" Value="0.6" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>



    <Border>

        <Grid>

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="80*" />

                <ColumnDefinition Width="15*" />

            </Grid.ColumnDefinitions>



            <Border

                x:Name="Channel_info_"

                Grid.Column="1"

                Background="#eaeaea" />

            <Border Grid.Column="0">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="70*" />

                        <RowDefinition Height="29*" />

                    </Grid.RowDefinitions>



                    <Border x:Name="CenterRegion" Grid.Row="0">

                        <Border.Resources>

                            <!--  按钮样式定义在这里，这样浮动时也能保持样式  -->

                            <Style x:Key="TitleBarButtonStyle" TargetType="Button">

                                <Setter Property="Background" Value="Transparent" />

                                <Setter Property="BorderThickness" Value="0" />

                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="Button">

                                            <Border

                                                x:Name="Border"

                                                Background="{TemplateBinding Background}"

                                                BorderBrush="{TemplateBinding BorderBrush}"

                                                BorderThickness="{TemplateBinding BorderThickness}">

                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                                            </Border>

                                            <ControlTemplate.Triggers>

                                                <Trigger Property="IsMouseOver" Value="True">

                                                    <Setter TargetName="Border" Property="Background" Value="#3d455d" />

                                                </Trigger>

                                                <Trigger Property="IsPressed" Value="True">

                                                    <Setter TargetName="Border" Property="Background" Value="#4d556d" />

                                                </Trigger>

                                                <Trigger Property="IsEnabled" Value="False">

                                                    <Setter Property="Opacity" Value="0.5" />

                                                </Trigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                            </Style>

                        </Border.Resources>



                        <Grid Background="Transparent">

                            <Grid.RowDefinitions>

                                <RowDefinition Height="5*" />

                                <RowDefinition Height="97*" />

                            </Grid.RowDefinitions>



                            <Border

                                x:Name="line"

                                Grid.Row="0"

                                Background="#2d354d"

                                Cursor="Hand"

                                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                                <Grid>

                                    <TextBlock

                                        Margin="10,0,0,0"

                                        VerticalAlignment="Center"

                                        FontSize="14"

                                        Foreground="White"

                                        Text="{Binding DisplayPath}" />

                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">

                                        <Button Click="OnMinimizeButtonClick" Style="{StaticResource TitleBarButtonStyle}">

                                            <Image

                                                Width="30"

                                                Margin="0,0,5,0"

                                                Source="/Resources/Logo/min.png" />

                                        </Button>

                                        <Border Width="30" Margin="0,0,5,0">

                                            <Button Click="OnFloatButtonClick" Style="{StaticResource TitleBarButtonStyle}">

                                                <Image

                                                    x:Name="FloatImage"

                                                    Width="15"

                                                    Source="/Resources/Logo/float.png" />

                                            </Button>

                                        </Border>

                                        <Button Click="OnCloseButtonClick" Style="{StaticResource TitleBarButtonStyle}">

                                            <Image Margin="0,0,5,0" Source="/Resources/Logo/close.png" />

                                        </Button>

                                    </StackPanel>

                                </Grid>

                            </Border>



                            <Grid Grid.Row="1" Margin="10,9,0,0" VerticalAlignment="Top">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto" />

                                    <ColumnDefinition Width="220" />

                                    <ColumnDefinition Width="220" />

                                    <ColumnDefinition Width="Auto" />

                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                </Grid.RowDefinitions>



                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontSize="15" ><Run Language="zh-cn" Text="20路"/><Run Text="电阻采集："/></TextBlock>

                                <ComboBox

                                    Grid.Row="0"

                                    Grid.Column="1"

                                    Height="30"

                                    Margin="10,0,0,0"

                                    FontSize="15"

                                    ItemsSource="{Binding ResistanceRoutes}"

                                    SelectedItem="{Binding SelectedResistanceRoute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <Border Grid.Row="0" Grid.Column="2" Height="30" Margin="10,-15,100,15" Background="Transparent" Grid.ColumnSpan="2" />

                                <ToggleButton

                                    Grid.Row="0"

                                    Grid.Column="3"

                                    Height="30"

                                    Margin="10,0,0,0"

                                    Command="{Binding ToggleSelectedResistanceCommand}"

                                    CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"

                                    IsChecked="{Binding IsSelectedResistanceConnected, Mode=OneWay}"

                                    Style="{StaticResource BlueActionToggleButtonStyle}">

                                    <TextBlock>

                                        <TextBlock.Style>

                                            <Style TargetType="TextBlock">

                                                <Setter Property="Text" Value="连接" />

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">

                                                        <Setter Property="Text" Value="断开" />

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </TextBlock.Style>

                                    </TextBlock>

                                </ToggleButton>



                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" VerticalAlignment="Center" FontSize="15" Text="32通道离散量输入回采测试：" />

                                <ComboBox

                                    Grid.Row="1"

                                    Grid.Column="1"

                                    Height="30"

                                    Margin="10,8,0,0"

                                    FontSize="15"

                                    ItemsSource="{Binding DiscreteInputLoopbackRoutes}"

                                    SelectedItem="{Binding SelectedDiscreteInputLoopbackRoute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <ComboBox

                                    Grid.Row="1"

                                    Grid.Column="2"

                                    Height="30"

                                    Margin="10,8,0,0"

                                    FontSize="15"

                                    ItemsSource="{Binding DiscreteInputLoopbackMeasureOptions}"

                                    SelectedItem="{Binding SelectedDiscreteInputLoopbackMeasureOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <ToggleButton

                                    Grid.Row="1"

                                    Grid.Column="3"

                                    Height="30"

                                    Margin="10,8,0,0"

                                    Command="{Binding ToggleDiscreteInputLoopbackCommand}"

                                    CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"

                                    IsChecked="{Binding IsDiscreteInputLoopbackConnected, Mode=OneWay}"

                                    Style="{StaticResource BlueActionToggleButtonStyle}">

                                    <TextBlock>

                                        <TextBlock.Style>

                                            <Style TargetType="TextBlock">

                                                <Setter Property="Text" Value="连接" />

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">

                                                        <Setter Property="Text" Value="断开" />

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </TextBlock.Style>

                                    </TextBlock>

                                </ToggleButton>



                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" VerticalAlignment="Center" FontSize="15" Text="32通道离散量输出回采测试：" />

                                <ComboBox

                                    Grid.Row="2"

                                    Grid.Column="1"

                                    Height="30"

                                    Margin="10,8,0,0"

                                    FontSize="15"

                                    ItemsSource="{Binding DiscreteOutputLoopbackRoutes}"

                                    SelectedItem="{Binding SelectedDiscreteOutputLoopbackRoute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <ComboBox

                                    Grid.Row="2"

                                    Grid.Column="2"

                                    Height="30"

                                    Margin="10,8,0,0"

                                    FontSize="15"

                                    ItemsSource="{Binding DiscreteOutputLoopbackMeasureOptions}"

                                    SelectedItem="{Binding SelectedDiscreteOutputLoopbackMeasureOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <ToggleButton

                                    Grid.Row="2"

                                    Grid.Column="3"

                                    Height="30"

                                    Margin="10,8,0,0"

                                    Command="{Binding ToggleDiscreteOutputLoopbackCommand}"

                                    CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"

                                    IsChecked="{Binding IsDiscreteOutputLoopbackConnected, Mode=OneWay}"

                                    Style="{StaticResource BlueActionToggleButtonStyle}">

                                    <TextBlock>

                                        <TextBlock.Style>

                                            <Style TargetType="TextBlock">

                                                <Setter Property="Text" Value="连接" />

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">

                                                        <Setter Property="Text" Value="断开" />

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </TextBlock.Style>

                                    </TextBlock>

                                </ToggleButton>



                                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8,0,0" VerticalAlignment="Center" FontSize="15" Text="32通道AD回采测试：" />

