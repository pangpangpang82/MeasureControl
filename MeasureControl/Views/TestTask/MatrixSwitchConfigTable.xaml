<UserControl
    x:Class="MeasureControl.Views.MatrixSwitchConfigTable"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:MeasureControl.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:MeasureControl.Views"
    d:DesignHeight="800"
    d:DesignWidth="1500"
    mc:Ignorable="d">

    <UserControl.Resources>
        <helpers:MethodCallConverter x:Key="MethodCallConverter" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#eaeaea" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#d0d0d0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <helpers:LevelToIndentConverter x:Key="LevelToIndentConverter" />
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <helpers:BoolToExpansionIconConverter x:Key="BoolToExpansionIconConverter" />
        <helpers:BoolToTreeArrowConverter x:Key="BoolToTreeArrowConverter" />
        <helpers:StringToBrushConverter x:Key="StringToBrushConverter" />
        <helpers:ModelDisplayConverter x:Key="ModelDisplayConverter" />
        <helpers:DeviceTypeToBackgroundConverter x:Key="DeviceTypeToBackgroundConverter" />
        <helpers:DeviceTypeToHoverBackgroundConverter x:Key="DeviceTypeToHoverBackgroundConverter" />
        <helpers:SignalIndexDisplayConverter x:Key="SignalIndexDisplayConverter" />
        <helpers:EmptyValueConverter x:Key="EmptyValueConverter" />
        <helpers:ValueWithUnitConverter x:Key="ValueWithUnitConverter" />

        <!--  分页按钮样式  -->
        <Style x:Key="PaginationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DADDE2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--  鼠标悬停效果  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#e0e0e0" />
                            </Trigger>
                            <!--  按下效果  -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#c0c0c0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  激活状态的分页按钮样式（蓝色）  -->
        <Style x:Key="ActivePaginationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3b82f6" />
            <Setter Property="BorderBrush" Value="#3b82f6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--  鼠标悬停效果 - 蓝色变深  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2563eb" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#2563eb" />
                            </Trigger>
                            <!--  按下效果 - 更深的蓝色  -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1d4ed8" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#1d4ed8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  操作列按钮样式（无边框，高亮灰色）  -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ActionButtonBorder"
                            Width="25"
                            Height="25"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--  鼠标悬停效果  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionButtonBorder" Property="Background" Value="#e0e0e0" />
                            </Trigger>
                            <!--  按下效果  -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionButtonBorder" Property="Background" Value="#c0c0c0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  导航按钮样式（上一页/下一页）  -->
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DADDE2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="NavButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--  鼠标悬停效果 - 稍浅灰色  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavButtonBorder" Property="Background" Value="#e0e0e0" />
                            </Trigger>
                            <!--  按下效果 - 稍浅灰色  -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavButtonBorder" Property="Background" Value="#c0c0c0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  简洁的滚动条样式  -->
        <Style x:Key="SimpleScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="Transparent" BorderThickness="0">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Background" Value="#CCCCCC" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border
                                                                Background="{TemplateBinding Background}"
                                                                BorderThickness="0"
                                                                CornerRadius="4" />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#999999" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter Property="Background" Value="#666666" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  简洁的ScrollViewer样式  -->
        <Style x:Key="SimpleScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="8" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />

                            <ScrollBar
                                x:Name="PART_VerticalScrollBar"
                                Grid.Row="0"
                                Grid.Column="1"
                                Maximum="{TemplateBinding ScrollableHeight}"
                                Orientation="Vertical"
                                Style="{StaticResource SimpleScrollBarStyle}"
                                ViewportSize="{TemplateBinding ViewportHeight}"
                                Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                Value="{TemplateBinding VerticalOffset}" />

                            <ScrollBar
                                x:Name="PART_HorizontalScrollBar"
                                Grid.Row="1"
                                Grid.Column="0"
                                Maximum="{TemplateBinding ScrollableWidth}"
                                Orientation="Horizontal"
                                Style="{StaticResource SimpleScrollBarStyle}"
                                ViewportSize="{TemplateBinding ViewportWidth}"
                                Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                Value="{TemplateBinding HorizontalOffset}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ComboBox 样式 - 添加圆角和与表格背景一致  -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DADDE2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton
                                x:Name="ToggleButton"
                                Grid.Column="0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                ClickMode="Press"
                                Focusable="False"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border
                                            x:Name="Border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="20" />
                                                </Grid.ColumnDefinitions>
                                                <Path
                                                    x:Name="Arrow"
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Data="M 0 0 L 4 4 L 8 0 Z"
                                                    Fill="#666666" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#f5f5f5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter
                                Margin="8,0,25,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                IsHitTestVisible="False" />
                            <Popup
                                x:Name="Popup"
                                AllowsTransparency="True"
                                Focusable="False"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                PopupAnimation="Slide">
                                <Grid
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    SnapsToDevicePixels="True">
                                    <Border
                                        Background="White"
                                        BorderBrush="#DADDE2"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <ScrollViewer Margin="0,2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80*" />
                <ColumnDefinition Width="15*" />
            </Grid.ColumnDefinitions>


            <Border
                x:Name="Channel_info_"
                Grid.Column="1"
                Background="#eaeaea" />
            <Border Grid.Column="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70*" />
                        <RowDefinition Height="29*" />
                    </Grid.RowDefinitions>

                    <Border x:Name="CenterRegion" Grid.Row="0">
                        <Border.Resources>
                            <!--  按钮样式定义在这里，这样浮动时也能保持样式  -->
                            <Style x:Key="TitleBarButtonStyle" TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="Border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#3d455d" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#4d556d" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Border.Resources>

                        <Grid Background="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="5*" />
                                <RowDefinition Height="97*" />
                            </Grid.RowDefinitions>

                            <Border
                                x:Name="line"
                                Grid.Row="0"
                                Background="#2d354d"
                                Cursor="Hand"
                                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                                <Grid>
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="White"
                                        Text="{Binding DisplayPath}" />
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Button Click="OnMinimizeButtonClick" Style="{StaticResource TitleBarButtonStyle}">
                                            <Image
                                                Width="30"
                                                Margin="0,0,5,0"
                                                Source="/Resources/Logo/min.png" />
                                        </Button>
                                        <Border Width="30" Margin="0,0,5,0">
                                            <Button Click="OnFloatButtonClick" Style="{StaticResource TitleBarButtonStyle}">
                                                <Image
                                                    x:Name="FloatImage"
                                                    Width="15"
                                                    Source="/Resources/Logo/float.png" />
                                            </Button>
                                        </Border>
                                        <Button Click="OnCloseButtonClick" Style="{StaticResource TitleBarButtonStyle}">
                                            <Image Margin="0,0,5,0" Source="/Resources/Logo/close.png" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1">
                                <Grid Background="White">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="{Binding ElementName=line, Path=ActualHeight}" />
                                        <RowDefinition Height="15*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border
                                        Grid.Row="0"
                                        Background="#cccccc"
                                        BorderBrush="Black"
                                        BorderThickness="0,0,0,1">
                                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                            <Button Margin="15,0,0,0" Command="{Binding AddMatrixSwitchCommand}">
                                                <Border Padding="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition />
                                                            <ColumnDefinition />
                                                        </Grid.ColumnDefinitions>
                                                        <Image
                                                            Width="15"
                                                            VerticalAlignment="Center"
                                                            Source="/Resources/Logo/add_b.png" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="5,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="14"
                                                            Text="添加测量变量" />
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="valueinfo" Grid.Row="1">
                                        <Border
                                            Background="Black"
                                            BorderBrush="#D9D9D9"
                                            BorderThickness="1.5">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="16*" />
                                                </Grid.RowDefinitions>

                                                <Border
                                                    Grid.Row="0"
                                                    Background="#f5f5f5"
                                                    BorderBrush="#D9D9D9"
                                                    BorderThickness="0,0,0,1.5">
                                                    <Grid x:Name="HeaderGrid">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition
                                                                x:Name="HeaderCol0"
                                                                Width="*"
                                                                MinWidth="50" />
                                                            <ColumnDefinition
                                                                x:Name="HeaderCol1"
                                                                Width="2.0*"
                                                                MinWidth="120" />
                                                            <ColumnDefinition
                                                                x:Name="HeaderCol2"
                                                                Width="2.0*"
                                                                MinWidth="120" />
                                                            <ColumnDefinition
                                                                x:Name="HeaderCol3"
                                                                Width="1.5*"
                                                                MinWidth="100" />
                                                            <ColumnDefinition
                                                                x:Name="HeaderCol4"
                                                                Width="1.5*"
                                                                MinWidth="120" />
                                                            <ColumnDefinition
                                                                x:Name="HeaderCol5"
                                                                Width="1.5*"
                                                                MinWidth="120" />
                                                            <ColumnDefinition
                                                                x:Name="HeaderCol6"
                                                                Width="3.0*"
                                                                MinWidth="150" />
                                                            <ColumnDefinition
                                                                x:Name="HeaderCol7"
                                                                Width="1.4*"
                                                                MinWidth="100" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border BorderBrush="#D9D9D9" BorderThickness="0,0,1.5,0">
                                                            <TextBlock
                                                                Grid.Column="0"
                                                                Margin="15,0,0,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="14"
                                                                Foreground="black"
                                                                Text="序号" />
                                                        </Border>

                                                        <GridSplitter
                                                            Grid.Column="0"
                                                            Width="3"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Stretch"
                                                            Background="Transparent"
                                                            DragCompleted="GridSplitter_DragCompleted"
                                                            ResizeDirection="Columns"
                                                            ShowsPreview="True" />

                                                        <Border
                                                            Grid.Column="1"
                                                            BorderBrush="#D9D9D9"
                                                            BorderThickness="0,0,1.5,0">
                                                            <TextBlock
                                                                Margin="15,0,0,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="14"
                                                                Foreground="Black"
                                                                Text="矩阵开关名称" />
                                                        </Border>

                                                        <GridSplitter
                                                            Grid.Column="1"
                                                            Width="3"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Stretch"
                                                            Background="Transparent"
                                                            DragCompleted="GridSplitter_DragCompleted"
                                                            ResizeDirection="Columns"
                                                            ShowsPreview="True" />

                                                        <Border
                                                            Grid.Column="2"
                                                            BorderBrush="#D9D9D9"
                                                            BorderThickness="0,0,1.5,0">
                                                            <TextBlock
                                                                Margin="15,0,0,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="14"
                                                                Foreground="Black"
                                                                Text="变量名称" />
                                                        </Border>

                                                        <GridSplitter
                                                            Grid.Column="2"
                                                            Width="3"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Stretch"
                                                            Background="Transparent"
                                                            DragCompleted="GridSplitter_DragCompleted"
                                                            ResizeDirection="Columns"
                                                            ShowsPreview="True" />

                                                        <Border
                                                            Grid.Column="3"
                                                            BorderBrush="#D9D9D9"
                                                            BorderThickness="0,0,1.5,0">
                                                            <TextBlock
                                                                Margin="15,0,0,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="14"
                                                                Foreground="Black"
                                                                Text="拓扑" />
                                                        </Border>

                                                        <GridSplitter
                                                            Grid.Column="3"
                                                            Width="3"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Stretch"
                                                            Background="Transparent"
                                                            DragCompleted="GridSplitter_DragCompleted"
                                                            ResizeDirection="Columns"
                                                            ShowsPreview="True" />

                                                        <Border
                                                            Grid.Column="4"
                                                            BorderBrush="#D9D9D9"
                                                            BorderThickness="0,0,1.5,0">
                                                            <TextBlock
                                                                Margin="15,0,0,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="14"
                                                                Foreground="Black"
                                                                Text="矩阵输入节点" />
                                                        </Border>

                                                        <GridSplitter
                                                            Grid.Column="4"
                                                            Width="3"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Stretch"
                                                            Background="Transparent"
                                                            DragCompleted="GridSplitter_DragCompleted"
                                                            ResizeDirection="Columns"
                                                            ShowsPreview="True" />

                                                        <Border
                                                            Grid.Column="5"
                                                            BorderBrush="#D9D9D9"
                                                            BorderThickness="0,0,1.5,0">
                                                            <TextBlock
                                                                Margin="15,0,0,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="14"
                                                                Foreground="Black"
                                                                Text="矩阵输出节点" />
                                                        </Border>

                                                        <GridSplitter
                                                            Grid.Column="5"
                                                            Width="3"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Stretch"
                                                            Background="Transparent"
                                                            DragCompleted="GridSplitter_DragCompleted"
                                                            ResizeDirection="Columns"
                                                            ShowsPreview="True" />

                                                        <Border
                                                            Grid.Column="6"
                                                            BorderBrush="#D9D9D9"
                                                            BorderThickness="0,0,1.5,0">
                                                            <TextBlock
                                                                Margin="20,0,0,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="14"
                                                                Foreground="black"
                                                                Text="备注" />
                                                        </Border>

                                                        <GridSplitter
                                                            Grid.Column="6"
                                                            Width="3"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Stretch"
                                                            Background="Transparent"
                                                            DragCompleted="GridSplitter_DragCompleted"
                                                            ResizeDirection="Columns"
                                                            ShowsPreview="True" />

                                                        <TextBlock
                                                            Grid.Column="7"
                                                            Margin="15,0,5,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="14"
                                                            Foreground="Black"
                                                            Text="操作" />
                                                    </Grid>
                                                </Border>

                                                <ItemsControl
                                                    x:Name="MatrixSwitchesItemsControl"
                                                    Grid.Row="1"
                                                    AlternationCount="14"
                                                    Background="white"
                                                    ItemsSource="{Binding PagedMatrixSwitches}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="1.3*" />
                                                                    <RowDefinition Height="1.3*" />
                                                                    <RowDefinition Height="1.3*" />
                                                                    <RowDefinition Height="1.3*" />
                                                                    <RowDefinition Height="1.3*" />
                                                                    <RowDefinition Height="1.3*" />
                                                                    <RowDefinition Height="1.3*" />
                                                                    <RowDefinition Height="1.3*" />
                                                                    <RowDefinition Height="1.3*" />
                                                                    <RowDefinition Height="1.3*" />
                                                                    <RowDefinition Height="1.3*" />
                                                                    <RowDefinition Height="1.3*" />
                                                                    <RowDefinition Height="1.3*" />
                                                                    <RowDefinition Height="1.3*" />
                                                                </Grid.RowDefinitions>
                                                            </Grid>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Grid.Row" Value="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource Self}}" />
                                                            <Setter Property="Tag" Value="White" />
                                                            <Style.Triggers>
                                                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                                    <Setter Property="Tag" Value="#f5f5f5" />
                                                                </Trigger>
                                                                <Trigger Property="ItemsControl.AlternationIndex" Value="3">
                                                                    <Setter Property="Tag" Value="#f5f5f5" />
                                                                </Trigger>
                                                                <Trigger Property="ItemsControl.AlternationIndex" Value="5">
                                                                    <Setter Property="Tag" Value="#f5f5f5" />
                                                                </Trigger>
                                                                <Trigger Property="ItemsControl.AlternationIndex" Value="7">
                                                                    <Setter Property="Tag" Value="#f5f5f5" />
                                                                </Trigger>
                                                                <Trigger Property="ItemsControl.AlternationIndex" Value="9">
                                                                    <Setter Property="Tag" Value="#f5f5f5" />
                                                                </Trigger>
                                                                <Trigger Property="ItemsControl.AlternationIndex" Value="11">
                                                                    <Setter Property="Tag" Value="#f5f5f5" />
                                                                </Trigger>
                                                                <Trigger Property="ItemsControl.AlternationIndex" Value="13">
                                                                    <Setter Property="Tag" Value="#f5f5f5" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border
                                                                Background="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=Tag}"
                                                                BorderBrush="#D9D9D9"
                                                                BorderThickness="0,0,0,1.5">
                                                                <Grid TextElement.FontSize="13">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" MinWidth="50" />
                                                                        <ColumnDefinition Width="2.0*" MinWidth="120" />
                                                                        <ColumnDefinition Width="2.0*" MinWidth="120" />
                                                                        <ColumnDefinition Width="1.5*" MinWidth="100" />
                                                                        <ColumnDefinition Width="1.5*" MinWidth="120" />
                                                                        <ColumnDefinition Width="1.5*" MinWidth="120" />
                                                                        <ColumnDefinition Width="3.0*" MinWidth="150" />
                                                                        <ColumnDefinition Width="1.4*" MinWidth="100" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <Border
                                                                        Grid.Column="0"
                                                                        BorderBrush="#D9D9D9"
                                                                        BorderThickness="0,0,1.5,0">
                                                                        <TextBlock
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="14"
                                                                            Foreground="Black">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Text" Value="{Binding Index}" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                                            <Setter Property="Text" Value="" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Border>

                                                                    <Border
                                                                        Grid.Column="1"
                                                                        BorderBrush="#D9D9D9"
                                                                        BorderThickness="0,0,1.5,0">
                                                                        <ComboBox
                                                                            Width="Auto"
                                                                            MinWidth="100"
                                                                            Margin="10,5"
                                                                            HorizontalAlignment="Stretch"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="14"
                                                                            Foreground="Black"
                                                                            ItemsSource="{Binding DataContext.AvailableSwitchDevices, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                                            SelectedValue="{Binding MatrixSwitchName, Mode=TwoWay, TargetNullValue=''}">
                                                                            <ComboBox.Style>
                                                                                <Style TargetType="ComboBox">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </ComboBox.Style>
                                                                        </ComboBox>
                                                                    </Border>

                                                                    <Border
                                                                        Grid.Column="2"
                                                                        BorderBrush="#D9D9D9"
                                                                        BorderThickness="0,0,1.5,0">
                                                                        <TextBox
                                                                            Margin="15,0,0,0"
                                                                            VerticalAlignment="Center"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            FontSize="14"
                                                                            Foreground="Black"
                                                                            Text="{Binding InstrumentType, Mode=TwoWay, TargetNullValue=''}" />
                                                                    </Border>

                                                                    <Border
                                                                        Grid.Column="3"
                                                                        BorderBrush="#D9D9D9"
                                                                        BorderThickness="0,0,1.5,0">
                                                                        <ComboBox
                                                                            Width="Auto"
                                                                            MinWidth="90"
                                                                            Margin="10,5"
                                                                            HorizontalAlignment="Stretch"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="14"
                                                                            Foreground="Black"
                                                                            SelectedValue="{Binding Topology, Mode=TwoWay, TargetNullValue=''}">
                                                                            <ComboBox.ItemsSource>
                                                                                <MultiBinding Converter="{StaticResource MethodCallConverter}">
                                                                                    <Binding Path="DataContext" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type UserControl}}" />
                                                                                    <Binding Source="GetAvailableTopologies" />
                                                                                    <Binding Path="MatrixSwitchName" />
                                                                                </MultiBinding>
                                                                            </ComboBox.ItemsSource>
                                                                            <ComboBox.Style>
                                                                                <Style TargetType="ComboBox">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </ComboBox.Style>
                                                                        </ComboBox>
                                                                    </Border>

                                                                    <Border
                                                                        Grid.Column="4"
                                                                        BorderBrush="#D9D9D9"
                                                                        BorderThickness="0,0,1.5,0">
                                                                        <ComboBox
                                                                            Width="Auto"
                                                                            MinWidth="110"
                                                                            Margin="10,5"
                                                                            HorizontalAlignment="Stretch"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="14"
                                                                            Foreground="Black"
                                                                            SelectedValue="{Binding MatrixInput, Mode=TwoWay, TargetNullValue=''}">
                                                                            <ComboBox.ItemsSource>
                                                                                <MultiBinding Converter="{StaticResource MethodCallConverter}">
                                                                                    <Binding Path="DataContext" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type UserControl}}" />
                                                                                    <Binding Source="GetAvailableInputs" />
                                                                                    <Binding Path="Topology" />
                                                                                </MultiBinding>
                                                                            </ComboBox.ItemsSource>
                                                                            <ComboBox.Style>
                                                                                <Style TargetType="ComboBox">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </ComboBox.Style>
                                                                        </ComboBox>
                                                                    </Border>

                                                                    <Border
                                                                        Grid.Column="5"
                                                                        BorderBrush="#D9D9D9"
                                                                        BorderThickness="0,0,1.5,0">
                                                                        <ComboBox
                                                                            Width="Auto"
                                                                            MinWidth="110"
                                                                            Margin="10,5"
                                                                            HorizontalAlignment="Stretch"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="14"
                                                                            Foreground="Black"
                                                                            SelectedValue="{Binding MatrixOutput, Mode=TwoWay, TargetNullValue=''}">
                                                                            <ComboBox.ItemsSource>
                                                                                <MultiBinding Converter="{StaticResource MethodCallConverter}">
                                                                                    <Binding Path="DataContext" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type UserControl}}" />
                                                                                    <Binding Source="GetAvailableOutputs" />
                                                                                    <Binding Path="Topology" />
                                                                                </MultiBinding>
                                                                            </ComboBox.ItemsSource>
                                                                            <ComboBox.Style>
                                                                                <Style TargetType="ComboBox">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </ComboBox.Style>
                                                                        </ComboBox>
                                                                    </Border>

                                                                    <Border
                                                                        Grid.Column="6"
                                                                        BorderBrush="#D9D9D9"
                                                                        BorderThickness="0,0,1.5,0">
                                                                        <TextBox
                                                                            Margin="20,0,0,0"
                                                                            VerticalAlignment="Center"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            FontSize="14"
                                                                            Foreground="Black"
                                                                            Text="{Binding Remarks, Mode=TwoWay, TargetNullValue=''}" />
                                                                    </Border>

                                                                    <Border
                                                                        Grid.Column="7"
                                                                        BorderBrush="#D9D9D9"
                                                                        BorderThickness="0,0,1.5,0">
                                                                        <Button
                                                                            Width="60"
                                                                            Height="30"
                                                                            Margin="10,0,0,0"
                                                                            HorizontalAlignment="Left"
                                                                            VerticalAlignment="Center"
                                                                            Command="{Binding DataContext.DeleteMatrixSwitchCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                                            CommandParameter="{Binding}">
                                                                            <Button.Content>
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <Image
                                                                                        Width="16"
                                                                                        Height="16"
                                                                                        Source="/Resources/Logo/delete.png" />
                                                                                    <TextBlock
                                                                                        Margin="5,0,0,0"
                                                                                        VerticalAlignment="Center"
                                                                                        FontSize="14"
                                                                                        Text="删除" />
                                                                                </StackPanel>
                                                                            </Button.Content>
                                                                            <Button.Style>
                                                                                <Style BasedOn="{StaticResource PaginationButtonStyle}" TargetType="Button">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Hidden" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Button.Style>
                                                                        </Button>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </Border>

                                    <Border
                                        Grid.Row="2"
                                        Background="#f9fafb"
                                        BorderBrush="#f0f1f3"
                                        BorderThickness="1">
                                        <Grid>
                                            <TextBlock
                                                x:Name="matrix_switch_num"
                                                Width="180"
                                                Margin="20,0,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Foreground="#8C939C"
                                                Text="{Binding PaginationInfo}" />

                                            <StackPanel
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Button
                                                    Width="50"
                                                    Height="25"
                                                    Margin="0,0,5,0"
                                                    Command="{Binding PreviousPageCommand}"
                                                    Style="{StaticResource NavigationButtonStyle}">
                                                    <TextBlock Foreground="Black" Text="上一页" />
                                                </Button>

                                                <ItemsControl ItemsSource="{Binding PageNumbers}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button
                                                                Width="25"
                                                                Height="25"
                                                                Margin="0,0,5,0"
                                                                Command="{Binding Command}">
                                                                <Button.Style>
                                                                    <Style BasedOn="{StaticResource PaginationButtonStyle}" TargetType="Button">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCurrentPage}" Value="True">
                                                                                <Setter Property="Background" Value="#3b82f6" />
                                                                                <Setter Property="BorderBrush" Value="#3b82f6" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <TextBlock Text="{Binding PageNumber}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="Black" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCurrentPage}" Value="True">
                                                                                    <Setter Property="Foreground" Value="White" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Button
                                                    Width="50"
                                                    Height="25"
                                                    Margin="0,0,50,0"
                                                    Command="{Binding NextPageCommand}"
                                                    Style="{StaticResource NavigationButtonStyle}">
                                                    <TextBlock Foreground="Black" Text="下一页" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="2*" />

                                <RowDefinition Height="15*" />

                            </Grid.RowDefinitions>

                            <Border Background="#b2b2b2">

                                <TextBlock
                                    Grid.Row="0"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="常规" />

                            </Border>

                            <Border
                                Grid.Row="1"
                                Background="#ffffff"
                                BorderBrush="#1c1c1c"
                                BorderThickness="0,1.5,0,0">



                                <Grid>

                                    <Grid.RowDefinitions>

                                        <RowDefinition Height="4*" />

                                        <RowDefinition Height="12*" />

                                        <RowDefinition Height="10*" />

                                        <RowDefinition Height="5*" />

                                    </Grid.RowDefinitions>



                                    <StackPanel
                                        Grid.Row="0"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">

                                        <Image
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Source="/Resources/Logo/warning.png" />

                                        <TextBlock
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="Black"
                                            Text="暂无信息" />

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </Grid>

                    </Border>
                </Grid>
            </Border>


        </Grid>
    </Border>
</UserControl>