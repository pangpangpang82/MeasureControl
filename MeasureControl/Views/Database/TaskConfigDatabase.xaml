<UserControl
    x:Class="MeasureControl.Views.Database.TaskConfigDatabase"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MeasureControl.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="500"
    d:DesignWidth="1300"
    mc:Ignorable="d">

    <Border Background="White">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="19*" />
                <ColumnDefinition Width="67*" />
            </Grid.ColumnDefinitions>

            <Border BorderBrush="#D9D9D9" BorderThickness="0,0,1,0" />



            <Border Grid.Column="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="8*" />
                        <RowDefinition Height="6*" />
                        <RowDefinition Height="7*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Image
                                Width="20"
                                Margin="10,0,0,0"
                                Source="/Resources/Logo/tasks_g.png" />
                            <TextBlock
                                Margin="5,0,0,0"
                                FontSize="20"
                                Text="任务配置详细信息" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Margin="10,0,10,10"
                        BorderBrush="#D9D9D9"
                        BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="8*" />
                                <ColumnDefinition Width="25*" />
                                <ColumnDefinition Width="7*" />
                                <ColumnDefinition Width="25*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="2"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="#666666"
                                Text="创建人" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="2"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="#666666"
                                Text="最后创建人" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="2"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="#666666"
                                Text="版本信息" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Margin="2"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="#666666"
                                Text="最后保存时间" />

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                Margin="2"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="#666666"
                                Text="任务名称" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="2"
                                Margin="2"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="#666666"
                                Text="任务类型" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="2"
                                Margin="2"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="#666666"
                                Text="优先级" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="2"
                                Margin="2"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="#666666"
                                Text="状态" />

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="2"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="#666666"
                                Text="xxx" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="2"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="#666666"
                                Text="xxx" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="2"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="#666666"
                                Text="xxx" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                Margin="2"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="#666666"
                                Text="xxx" />

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="3"
                                Margin="2"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="#666666"
                                Text="xxx" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="3"
                                Margin="2"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="#666666"
                                Text="xxx" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="3"
                                Margin="2"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="#666666"
                                Text="xxx" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="3"
                                Margin="2"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="#666666"
                                Text="xxx" />

                        </Grid>

                    </Border>

                    <Border Grid.Row="2">
                        <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                            <TextBlock
                                Margin="10,10,0,0"
                                FontSize="16"
                                Text="任务描述" />
                            <Border
                                Height="70"
                                Margin="10,10,10,3"
                                BorderBrush="#D9D9D9"
                                BorderThickness="1"
                                CornerRadius="3">
                                <TextBox Background="#f9fafb" BorderThickness="0" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3">
                        <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                            <TextBlock
                                Margin="10,3,10,0"
                                FontSize="16"
                                Text="关联配置" />
                            <Grid Margin="10,10,10,10" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Height="35"
                                    Margin="0,0,10,0"
                                    Background="#f9fafb"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <StackPanel Margin="5,3,5,3" Orientation="Horizontal">
                                        <Image Width="22" Source="/Resources/Logo/chip_p.png" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Text="通道配置(8个)" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Height="35"
                                    Margin="0,0,10,0"
                                    Background="#f9fafb"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <StackPanel Margin="5,3,5,3" Orientation="Horizontal">
                                        <Image Width="22" Source="/Resources/Logo/signal.png" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Text="信号配置(24个)" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Height="35"
                                    Margin="0,0,0,0"
                                    Background="#f9fafb"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <StackPanel Margin="5,3,5,3" Orientation="Horizontal">
                                        <Image Width="22" Source="/Resources/Logo/test.png" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Text="序列配置(3组)" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Height="35"
                                    Margin="0,10,10,0"
                                    Background="#f9fafb"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <StackPanel Margin="5,3,5,3" Orientation="Horizontal">
                                        <Image Width="22" Source="/Resources/Logo/tabel.png" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Text="变量表(56页)" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Height="35"
                                    Margin="0,10,10,0"
                                    Background="#f9fafb"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <StackPanel Margin="5,3,5,3" Orientation="Horizontal">
                                        <Image Width="22" Source="/Resources/Logo/tasks_g.png" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Text="ICD配置表(2份)" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Height="35"
                                    Margin="0,10,0,0"
                                    Background="#f9fafb"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <StackPanel Margin="5,3,5,3" Orientation="Horizontal">
                                        <Image Width="22" Source="/Resources/Logo/test_script.png" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Text="脚本配置(5个)" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
