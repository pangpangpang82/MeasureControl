<Window
    x:Class="MeasureControl.Views.ScriptTest.ScriptTestDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="脚本测试"
    Width="720"
    Height="520"
    Background="#FAFAFA"
    BorderBrush="#1c1c1c"
    BorderThickness="1"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1c1c1c" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="buttonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#4F5C87" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#4F5C87" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#4F5C87" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  自定义标题栏（与 TestProgressDialog 一致风格）  -->
        <Border
            Grid.Row="0"
            Background="#1c1c1c"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="TitleText"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="White"
                    Text="脚本测试" />
                <Button
                    Grid.Column="1"
                    Width="30"
                    Height="30"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="TitleCloseButton_Click"
                    Content="✖"
                    FontSize="14"
                    Foreground="White"
                    Style="{StaticResource DialogButtonStyle}" />
            </Grid>
        </Border>

        <!--  脚本路径  -->
        <StackPanel Grid.Row="1" Margin="12,10,12,6">
            <TextBlock
                x:Name="ScriptPathText"
                Foreground="#555"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  进度  -->
        <Grid Grid.Row="2" Margin="12,0,4,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar
                x:Name="OverallProgress"
                Height="18"
                Maximum="100"
                Minimum="0"
                Value="0" />
            <TextBlock
                x:Name="ProgressText"
                Grid.Column="1"
                Margin="8,0,0,0"
                VerticalAlignment="Center" />
        </Grid>

        <!--  日志  -->
        <Border
            Grid.Row="3"
            Margin="12,0,12,0"
            Background="White"
            BorderBrush="#DDD"
            BorderThickness="1">
            <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
                <TextBox
                    x:Name="LogText"
                    Padding="6"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="12"
                    IsReadOnly="True"
                    TextWrapping="NoWrap" />
            </ScrollViewer>
        </Border>

        <!--  底部按钮  -->
        <StackPanel
            Grid.Row="4"
            Margin="12,10,12,12"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="OpenResultButton"
                Width="120"
                Margin="0,0,8,0"
                Click="OpenResultButton_Click"
                Content="打开结果副本"
                IsEnabled="False"
                Style="{StaticResource DialogButtonStyle}" />
            <Button
                x:Name="CancelButton"
                Width="90"
                Margin="0,0,8,0"
                Click="CancelButton_Click"
                Content="取消"
                Style="{StaticResource DialogButtonStyle}" />
            <Button
                x:Name="CloseButton"
                Width="90"
                Click="CloseButton_Click"
                Content="关闭"
                IsEnabled="False"
                Style="{StaticResource DialogButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
