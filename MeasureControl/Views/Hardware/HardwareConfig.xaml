<UserControl
    x:Class="MeasureControl.Views.Hardware.HardwareConfig"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Hardware="clr-namespace:MeasureControl.Views.Hardware"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:MeasureControl.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="800"
    d:DesignWidth="1500"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <helpers:GridPositionToVisibilityConverter x:Key="GridPositionToVisibilityConverter" />
                    <helpers:GridPositionToChassisConverter x:Key="GridPositionToChassisConverter" />
                    <helpers:GridPositionToVisibilitySimpleConverter x:Key="GridPositionToVisibilitySimpleConverter" />
                    <helpers:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
                    <helpers:DeviceOrConnectionTitleConverter x:Key="DeviceOrConnectionTitleConverter" />
                    <helpers:ChassisTypeToImageConverter x:Key="ChassisTypeToImageConverter" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#eaeaea" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#d0d0d0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!--  网格单元格样式  -->
            <Style x:Key="GridCellStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="#e0e0e0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="AllowDrop" Value="False" />
                <Setter Property="Panel.ZIndex" Value="1" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="Transparent" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--  PXI机箱数据模板  -->
            <DataTemplate x:Key="PxiChassisTemplate">
                <Border
                    Margin="5"
                    Background="Transparent"
                    ContextMenuService.IsEnabled="False"
                    Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding
                            Command="{Binding DataContext.PxiChassisDoubleClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            MouseAction="LeftDoubleClick" />
                    </Border.InputBindings>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#4D9ED9F2" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Background" Value="#809ED9F2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                        <TextBlock
                            Margin="0,0,0,5"
                            HorizontalAlignment="Center"
                            FontSize="14"
                            Foreground="#2d354d"
                            Text="{Binding Name}" />
                        <Grid>
                            <Image
                                Width="200"
                                Height="140"
                                Source="{Binding ChassisType, Converter={StaticResource ChassisTypeToImageConverter}}"
                                Stretch="Uniform" />

                        </Grid>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70*" />
                <ColumnDefinition Width="10*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="75*" />
                        <RowDefinition Height="29*" />
                    </Grid.RowDefinitions>
                    <Border x:Name="CenterRegion" Grid.Row="0">
                        <Border.Resources>
                            <!--  按钮样式定义在这里，这样浮动时也能保持样式  -->
                            <Style x:Key="TitleBarButtonStyle" TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="Border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#3d455d" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#4d556d" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Border.Resources>
                        <Grid Background="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="5*" />
                                <RowDefinition Height="5*" />
                                <RowDefinition Height="92*" />
                            </Grid.RowDefinitions>
                            <Border
                                x:Name="line"
                                Grid.Row="0"
                                Background="#2d354d"
                                Cursor="Hand"
                                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                                <Grid>
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="White"
                                        Text="硬件配置/设备与网络" />
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Button Click="OnMinimizeButtonClick" Style="{StaticResource TitleBarButtonStyle}">
                                            <Image
                                                Width="30"
                                                Margin="0,0,5,0"
                                                Source="/Resources/Logo/min.png" />
                                        </Button>
                                        <Button Click="OnFloatButtonClick" Style="{StaticResource TitleBarButtonStyle}">
                                            <Image
                                                x:Name="FloatImage"
                                                Width="15"
                                                Margin="0,0,5,0"
                                                Source="/Resources/Logo/float.png" />
                                        </Button>
                                        <Button Click="OnCloseButtonClick" Style="{StaticResource TitleBarButtonStyle}">
                                            <Image Margin="0,0,5,0" Source="/Resources/Logo/close.png" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Background="#cccccc">
                                <StackPanel
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Button Margin="15,0,0,0" Command="{Binding ConnectChassisCommand}">
                                        <Border Padding="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <Image
                                                    Grid.Column="0"
                                                    Width="24"
                                                    VerticalAlignment="Center"
                                                    Source="/Resources/Hardware/connect.png" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="5,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="链接" />
                                            </Grid>
                                        </Border>
                                    </Button>

                                    <Button Margin="15,0,0,0" Command="{Binding DisconnectChassisCommand}">
                                        <Border Padding="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <Image
                                                    Grid.Column="0"
                                                    Height="28"
                                                    VerticalAlignment="Center"
                                                    Source="/Resources/Hardware/disconnect.png" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="5,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="断开链接" />
                                            </Grid>
                                        </Border>
                                    </Button>

                                    <Button Margin="15,0,0,0" Command="{Binding EthernetConnectCommand}">
                                        <Border Padding="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <Image
                                                    Grid.Column="0"
                                                    Height="24"
                                                    VerticalAlignment="Center"
                                                    Source="/Resources/Hardware/ethernet.png" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="5,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="以太网链接" />
                                            </Grid>
                                        </Border>
                                    </Button>

                                    <Button Margin="15,0,0,0" Command="{Binding UsbConnectCommand}">
                                        <Border Padding="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <Image
                                                    Grid.Column="0"
                                                    Height="24"
                                                    VerticalAlignment="Center"
                                                    Source="/Resources/Hardware/usb.png" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="5,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="USB链接" />
                                            </Grid>
                                        </Border>
                                    </Button>

                                    <Button Margin="15,0,0,0" Command="{Binding SerialConnectCommand}">
                                        <Border Padding="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <Image
                                                    Grid.Column="0"
                                                    Height="24"
                                                    VerticalAlignment="bottom"
                                                    Source="/Resources/Hardware/serialport.png" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="5,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="串口链接" />
                                            </Grid>
                                        </Border>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border x:Name="MainCanvasContainer" Grid.Row="2">
                                <Canvas x:Name="MainCanvas" MouseLeftButtonDown="MainCanvas_MouseLeftButtonDown">
                                    <!--  2*5网格布局的拖放区域  -->
                                    <!--  第一行  -->
                                    <Border
                                        x:Name="Cell_0_0"
                                        Canvas.Left="0"
                                        Canvas.Top="0"
                                        DragEnter="CanvasCell_DragEnter"
                                        DragLeave="CanvasCell_DragLeave"
                                        Drop="CanvasCell_Drop"
                                        Style="{StaticResource GridCellStyle}" />
                                    <Border
                                        x:Name="Cell_0_1"
                                        Canvas.Left="0"
                                        Canvas.Top="0"
                                        DragEnter="CanvasCell_DragEnter"
                                        DragLeave="CanvasCell_DragLeave"
                                        Drop="CanvasCell_Drop"
                                        Style="{StaticResource GridCellStyle}" />
                                    <Border
                                        x:Name="Cell_0_2"
                                        Canvas.Left="0"
                                        Canvas.Top="0"
                                        DragEnter="CanvasCell_DragEnter"
                                        DragLeave="CanvasCell_DragLeave"
                                        Drop="CanvasCell_Drop"
                                        Style="{StaticResource GridCellStyle}" />
                                    <Border
                                        x:Name="Cell_0_3"
                                        Canvas.Left="0"
                                        Canvas.Top="0"
                                        DragEnter="CanvasCell_DragEnter"
                                        DragLeave="CanvasCell_DragLeave"
                                        Drop="CanvasCell_Drop"
                                        Style="{StaticResource GridCellStyle}" />
                                    <Border
                                        x:Name="Cell_0_4"
                                        Canvas.Left="0"
                                        Canvas.Top="0"
                                        DragEnter="CanvasCell_DragEnter"
                                        DragLeave="CanvasCell_DragLeave"
                                        Drop="CanvasCell_Drop"
                                        Style="{StaticResource GridCellStyle}" />

                                    <!--  第二行  -->
                                    <Border
                                        x:Name="Cell_1_0"
                                        Canvas.Left="0"
                                        Canvas.Top="0"
                                        DragEnter="CanvasCell_DragEnter"
                                        DragLeave="CanvasCell_DragLeave"
                                        Drop="CanvasCell_Drop"
                                        Style="{StaticResource GridCellStyle}" />
                                    <Border
                                        x:Name="Cell_1_1"
                                        Canvas.Left="0"
                                        Canvas.Top="0"
                                        DragEnter="CanvasCell_DragEnter"
                                        DragLeave="CanvasCell_DragLeave"
                                        Drop="CanvasCell_Drop"
                                        Style="{StaticResource GridCellStyle}" />
                                    <Border
                                        x:Name="Cell_1_2"
                                        Canvas.Left="0"
                                        Canvas.Top="0"
                                        DragEnter="CanvasCell_DragEnter"
                                        DragLeave="CanvasCell_DragLeave"
                                        Drop="CanvasCell_Drop"
                                        Style="{StaticResource GridCellStyle}" />
                                    <Border
                                        x:Name="Cell_1_3"
                                        Canvas.Left="0"
                                        Canvas.Top="0"
                                        DragEnter="CanvasCell_DragEnter"
                                        DragLeave="CanvasCell_DragLeave"
                                        Drop="CanvasCell_Drop"
                                        Style="{StaticResource GridCellStyle}" />
                                    <Border
                                        x:Name="Cell_1_4"
                                        Canvas.Left="0"
                                        Canvas.Top="0"
                                        DragEnter="CanvasCell_DragEnter"
                                        DragLeave="CanvasCell_DragLeave"
                                        Drop="CanvasCell_Drop"
                                        Style="{StaticResource GridCellStyle}" />

                                    <!--  连接线绘制Canvas - ZIndex设置为高于机箱，便于选中  -->
                                    <Hardware:ChassisConnectionCanvas
                                        x:Name="ConnectionCanvas"
                                        Canvas.Left="0"
                                        Canvas.Top="0"
                                        Width="{Binding ElementName=MainCanvas, Path=ActualWidth}"
                                        Height="{Binding ElementName=MainCanvas, Path=ActualHeight}"
                                        Panel.ZIndex="99"
                                        Background="Transparent"
                                        IsHitTestVisible="True" />
                                </Canvas>
                            </Border>
                        </Grid>
                    </Border>

                    <GridSplitter
                        Grid.Row="0"
                        Height="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Background="#1c1c1c"
                        ShowsPreview="True" />
                    <Border Grid.Row="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="15*" />
                            </Grid.RowDefinitions>
                            <Border Background="#b2b2b2">
                                <TextBlock
                                    Grid.Row="0"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="常规" />
                            </Border>
                            <Border
                                Grid.Row="1"
                                Background="#ffffff"
                                BorderBrush="#1c1c1c"
                                BorderThickness="0,2,0,0">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="4*" />
                                        <RowDefinition Height="12*" />
                                        <RowDefinition Height="10*" />
                                        <RowDefinition Height="5*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel
                                        Grid.Row="0"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Image
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Source="/Resources/Logo/warning.png" />
                                        <TextBlock
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="Black"
                                            Text="{Binding DeviceInfoTitle}" />
                                    </StackPanel>

                                    <Grid Grid.Row="1" Grid.RowSpan="3">
                                        <!--  设备属性面板  -->
                                        <Border Margin="10,5,0,0" Visibility="{Binding IsDetailsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <TextBlock
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="{Binding DeviceField1}" />

                                                <TextBlock
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="{Binding DeviceField2}" />

                                                <TextBlock
                                                    Grid.Row="2"
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="{Binding DeviceField3}" />

                                                <TextBlock
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="{Binding DeviceField4}" />

                                                <TextBlock
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="{Binding DeviceField5}" />
                                                <TextBlock
                                                    Grid.Row="2"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="{Binding DeviceField6}" />
                                                <TextBlock
                                                    Grid.Row="3"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="{Binding DeviceField7}" />
                                            </Grid>
                                        </Border>

                                        <!--  连接信息面板  -->
                                        <Grid Margin="10,5,10,10" Visibility="{Binding IsConnectionDetailsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border
                                                    Grid.Column="0"
                                                    Margin="0,0,10,0"
                                                    Padding="15"
                                                    BorderBrush="#E5E7EB"
                                                    BorderThickness="1"
                                                    CornerRadius="5">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            Grid.ColumnSpan="2"
                                                            FontSize="15"
                                                            FontWeight="Bold"
                                                            Text="{Binding SourceChassisName, TargetNullValue='源端'}" />

                                                        <Grid
                                                            Grid.Row="1"
                                                            Grid.ColumnSpan="2"
                                                            Margin="0,8,0,0">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel
                                                                Grid.Row="0"
                                                                Grid.Column="0"
                                                                VerticalAlignment="Center"
                                                                Orientation="Horizontal">
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontSize="13"
                                                                    Foreground="Black"
                                                                    Text="IP地址：" />
                                                                <TextBlock
                                                                    Margin="8,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="13"
                                                                    Text="{Binding SourceIpAddress, TargetNullValue='--'}" />
                                                            </StackPanel>

                                                            <StackPanel
                                                                Grid.Row="0"
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                Orientation="Horizontal">
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontSize="13"
                                                                    Foreground="Black"
                                                                    Text="端口：" />
                                                                <Border
                                                                    Width="120"
                                                                    Height="30"
                                                                    Margin="8,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    BorderBrush="#D9D9D9"
                                                                    BorderThickness="1"
                                                                    CornerRadius="3">
                                                                    <TextBox
                                                                        Margin="10,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        BorderThickness="0"
                                                                        Text="{Binding SourcePort, UpdateSourceTrigger=PropertyChanged}" />
                                                                </Border>
                                                            </StackPanel>

                                                            <StackPanel
                                                                Grid.Row="1"
                                                                Grid.Column="0"
                                                                Margin="0,8,0,0"
                                                                VerticalAlignment="Center"
                                                                Orientation="Horizontal">
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontSize="13"
                                                                    Foreground="Black"
                                                                    Text="链路速率：" />
                                                                <TextBlock
                                                                    Margin="8,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="13"
                                                                    Text="{Binding SourceLinkSpeed, TargetNullValue='--'}" />
                                                            </StackPanel>

                                                            <StackPanel
                                                                Grid.Row="1"
                                                                Grid.Column="1"
                                                                Margin="0,8,0,0"
                                                                VerticalAlignment="Center"
                                                                Orientation="Horizontal">
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontSize="13"
                                                                    Foreground="Black"
                                                                    Text="通信变量表：" />
                                                                <ComboBox
                                                                    Width="180"
                                                                    Margin="8,0,0,0"
                                                                    IsEnabled="{Binding HasSourceCommunicatingTabels}"
                                                                    ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                                                                    ItemsSource="{Binding SourceCommunicatingTabels}"
                                                                    SelectedItem="{Binding SelectedSourceCommunicatingTabel}"
                                                                    Style="{StaticResource CustomComboBoxStyle}" />
                                                            </StackPanel>
                                                        </Grid>

                                                    </Grid>
                                                </Border>

                                                <Border
                                                    Grid.Column="1"
                                                    Padding="15"
                                                    BorderBrush="#E5E7EB"
                                                    BorderThickness="1"
                                                    CornerRadius="5">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            Grid.ColumnSpan="2"
                                                            FontSize="15"
                                                            FontWeight="Bold"
                                                            Text="{Binding TargetChassisName, TargetNullValue='目标端'}" />

                                                        <Grid
                                                            Grid.Row="1"
                                                            Grid.ColumnSpan="2"
                                                            Margin="0,8,0,0">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel
                                                                Grid.Row="0"
                                                                Grid.Column="0"
                                                                VerticalAlignment="Center"
                                                                Orientation="Horizontal">
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontSize="13"
                                                                    Foreground="Black"
                                                                    Text="IP地址：" />
                                                                <TextBlock
                                                                    Margin="8,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="13"
                                                                    Text="{Binding TargetIpAddress, TargetNullValue='--'}" />
                                                            </StackPanel>

                                                            <StackPanel
                                                                Grid.Row="0"
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                Orientation="Horizontal">
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontSize="13"
                                                                    Foreground="Black"
                                                                    Text="端口：" />
                                                                <Border
                                                                    Width="120"
                                                                    Height="30"
                                                                    Margin="8,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    BorderBrush="#D9D9D9"
                                                                    BorderThickness="1"
                                                                    CornerRadius="3">
                                                                    <TextBox
                                                                        Margin="10,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        BorderThickness="0"
                                                                        Text="{Binding TargetPort, UpdateSourceTrigger=PropertyChanged}" />
                                                                </Border>
                                                            </StackPanel>

                                                            <StackPanel
                                                                Grid.Row="1"
                                                                Grid.Column="0"
                                                                Margin="0,8,0,0"
                                                                VerticalAlignment="Center"
                                                                Orientation="Horizontal">
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontSize="13"
                                                                    Foreground="Black"
                                                                    Text="链路速率：" />
                                                                <TextBlock
                                                                    Margin="8,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="13"
                                                                    Text="{Binding TargetLinkSpeed, TargetNullValue='--'}" />
                                                            </StackPanel>

                                                            <StackPanel
                                                                Grid.Row="1"
                                                                Grid.Column="1"
                                                                Margin="0,8,0,0"
                                                                VerticalAlignment="Center"
                                                                Orientation="Horizontal">
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontSize="13"
                                                                    Foreground="Black"
                                                                    Text="通信变量表：" />
                                                                <ComboBox
                                                                    Width="180"
                                                                    Margin="8,0,0,0"
                                                                    IsEnabled="{Binding HasTargetCommunicatingTabels}"
                                                                    ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                                                                    ItemsSource="{Binding TargetCommunicatingTabels}"
                                                                    SelectedItem="{Binding SelectedTargetCommunicatingTabel}"
                                                                    Style="{StaticResource CustomComboBoxStyle}" />
                                                            </StackPanel>

                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter
                Grid.Column="0"
                Width="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="#1c1c1c"
                ShowsPreview="True" />

            <!--  右侧工具树  -->
            <Border Grid.Column="1" Background="#eaeaea">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Border
                        x:Name="PxiSourceBorder2722"
                        Grid.Row="0"
                        Padding="10"
                        Background="Transparent"
                        Cursor="Hand"
                        MouseDown="PxiSource_MouseDown"
                        MouseEnter="PxiSource_MouseEnter"
                        MouseLeave="PxiSource_MouseLeave"
                        MouseLeftButtonDown="PxiSource_MouseLeftButtonDown"
                        Tag="PXIe-2722G2">
                        <StackPanel x:Name="Pxi_2722" Orientation="Vertical">
                            <Image
                                Width="120"
                                Height="70"
                                Margin="0,10,0,0"
                                Source="/Resources/Hardware/PXI-2722.png" />
                            <TextBlock HorizontalAlignment="Center" Text="PXI-2722G2" />
                        </StackPanel>
                    </Border>
                    <Border
                        x:Name="PxiSourceBorder2519"
                        Grid.Row="1"
                        Padding="10"
                        Background="Transparent"
                        Cursor="Hand"
                        MouseDown="PxiSource_MouseDown"
                        MouseEnter="PxiSource_MouseEnter"
                        MouseLeave="PxiSource_MouseLeave"
                        MouseLeftButtonDown="PxiSource_MouseLeftButtonDown"
                        Tag="PXIe-2519G2">
                        <StackPanel x:Name="Pxi_2519" Orientation="Vertical">
                            <Image
                                Width="150"
                                Height="80"
                                Margin="0,10,0,0"
                                Source="/Resources/Hardware/PXI-2519.png" />
                            <TextBlock HorizontalAlignment="Center" Text="PXI-2519G2" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
