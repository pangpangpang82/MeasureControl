<UserControl
    x:Class="MeasureControl.Views.Hardware.PxiChassis"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:MeasureControl.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="800"
    d:DesignWidth="1500"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#eaeaea" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#d0d0d0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <helpers:LevelToIndentConverter x:Key="LevelToIndentConverter" />
        <helpers:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <helpers:EmptyStringToVisibilityConverter x:Key="EmptyToVisibility" />
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <helpers:BoolToExpansionIconConverter x:Key="BoolToExpansionIconConverter" />
        <helpers:StringToBrushConverter x:Key="StringToBrushConverter" />
        <helpers:ModelDisplayConverter x:Key="ModelDisplayConverter" />
        <helpers:DeviceTypeToBackgroundConverter x:Key="DeviceTypeToBackgroundConverter" />
        <helpers:DeviceTypeToHoverBackgroundConverter x:Key="DeviceTypeToHoverBackgroundConverter" />
        <helpers:ObjectEqualityConverter x:Key="ObjectEqualityConverter" />
        <helpers:StringToDoubleConverter x:Key="StringToDoubleConverter" />

        <!--  简洁的滚动条样式  -->
        <Style x:Key="SimpleScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="Transparent" BorderThickness="0">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Background" Value="#CCCCCC" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border
                                                                Background="{TemplateBinding Background}"
                                                                BorderThickness="0"
                                                                CornerRadius="4" />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#999999" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter Property="Background" Value="#666666" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  简洁的ScrollViewer样式  -->
        <Style x:Key="SimpleScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="8" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />

                            <ScrollBar
                                x:Name="PART_VerticalScrollBar"
                                Grid.Row="0"
                                Grid.Column="1"
                                Maximum="{TemplateBinding ScrollableHeight}"
                                Orientation="Vertical"
                                Style="{StaticResource SimpleScrollBarStyle}"
                                ViewportSize="{TemplateBinding ViewportHeight}"
                                Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                Value="{TemplateBinding VerticalOffset}" />

                            <ScrollBar
                                x:Name="PART_HorizontalScrollBar"
                                Grid.Row="1"
                                Grid.Column="0"
                                Maximum="{TemplateBinding ScrollableWidth}"
                                Orientation="Horizontal"
                                Style="{StaticResource SimpleScrollBarStyle}"
                                ViewportSize="{TemplateBinding ViewportWidth}"
                                Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                Value="{TemplateBinding HorizontalOffset}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80*" />
                <ColumnDefinition Width="15*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70*" />
                        <RowDefinition Height="29*" />
                    </Grid.RowDefinitions>
                    <Border x:Name="CenterRegion" Grid.Row="0">
                        <Border.Resources>
                            <!--  按钮样式定义在这里，这样浮动时也能保持样式  -->
                            <Style x:Key="TitleBarButtonStyle" TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="Border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#3d455d" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#4d556d" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Border.Resources>
                        <Grid Background="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="5*" />
                                <RowDefinition Height="97*" />
                            </Grid.RowDefinitions>
                            <Border
                                x:Name="line"
                                Grid.Row="0"
                                Background="#2d354d"
                                Cursor="Hand"
                                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                                <Grid>
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="White"
                                        Text="{Binding ChassisName}" />
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Button Click="OnMinimizeButtonClick" Style="{StaticResource TitleBarButtonStyle}">
                                            <Image
                                                Width="30"
                                                Margin="0,0,5,0"
                                                Source="/Resources/Logo/min.png" />
                                        </Button>
                                        <Border Width="30" Margin="0,0,5,0">
                                            <Button Click="OnFloatButtonClick" Style="{StaticResource TitleBarButtonStyle}">
                                                <Image
                                                    x:Name="FloatImage"
                                                    Width="15"
                                                    Source="/Resources/Logo/float.png" />
                                            </Button>
                                        </Border>
                                        <Button Click="OnCloseButtonClick" Style="{StaticResource TitleBarButtonStyle}">
                                            <Image Margin="0,0,5,0" Source="/Resources/Logo/close.png" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="center_info" Grid.Row="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="35*" />
                                        <RowDefinition Height="550*" />
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30*" />
                                        <ColumnDefinition Width="2" />
                                        <ColumnDefinition Width="87*" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Background="#cccccc"
                                        BorderBrush="#6e8de6"
                                        BorderThickness="0,0,0,2">
                                        <TextBlock
                                            Margin="20,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Text="设备序列" />
                                    </Border>

                                    <Border
                                        x:Name="deviceListBorder"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        AllowDrop="True"
                                        Background="Transparent"
                                        DragLeave="DeviceListBorder_DragLeave"
                                        DragOver="DeviceListBorder_DragOver"
                                        Drop="DeviceListBorder_Drop">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#f0f8ff" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ScrollViewer
                                            HorizontalScrollBarVisibility="Disabled"
                                            Style="{StaticResource SimpleScrollViewerStyle}"
                                            VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding ChassisDevices}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <!--  主设备行  -->
                                                            <Border
                                                                Grid.Row="0"
                                                                Padding="0,6,0,6"
                                                                BorderBrush="#6e8de6"
                                                                BorderThickness="0,0,0,2"
                                                                Cursor="Hand"
                                                                MouseLeftButtonDown="DeviceBorder_MouseLeftButtonDownForTripleClick"
                                                                MouseRightButtonDown="DeviceBorder_MouseRightButtonDown"
                                                                Tag="{Binding}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{Binding Converter={StaticResource DeviceTypeToBackgroundConverter}}" />
                                                                        <Setter Property="MinHeight" Value="44" />
                                                                        <Setter Property="Margin" Value="0,0,0,0" />
                                                                        <Style.Triggers>
                                                                            <!--  选中状态高亮 - 优先级最高  -->
                                                                            <DataTrigger Value="True">
                                                                                <DataTrigger.Binding>
                                                                                    <MultiBinding Converter="{StaticResource ObjectEqualityConverter}">
                                                                                        <Binding Path="DataContext.SelectedDevice" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                                        <Binding />
                                                                                    </MultiBinding>
                                                                                </DataTrigger.Binding>
                                                                                <Setter Property="Background" Value="#d3d3d3" />
                                                                                <Setter Property="BorderBrush" Value="#4a90e2" />
                                                                                <Setter Property="BorderThickness" Value="2" />
                                                                            </DataTrigger>
                                                                            <!--  鼠标悬停状态  -->
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="{Binding Converter={StaticResource DeviceTypeToHoverBackgroundConverter}}" />
                                                                            </Trigger>
                                                                            <!--  9槽机箱高度比例  -->
                                                                            <DataTrigger Binding="{Binding DeviceType}" Value="Chassis">
                                                                                <Setter Property="MinHeight" Value="46" />
                                                                            </DataTrigger>
                                                                            <!--  板卡高度比例11，无margin  -->
                                                                            <DataTrigger Binding="{Binding DeviceType}" Value="Card">
                                                                                <Setter Property="MinHeight" Value="44" />
                                                                            </DataTrigger>
                                                                            <!--  同级别设备高度比例  -->
                                                                            <DataTrigger Binding="{Binding DeviceType}" Value="Instrument">
                                                                                <Setter Property="MinHeight" Value="46" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <!--  InputBindings 已移除，点击逻辑统一在 MouseLeftButtonDown 中处理  -->
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <!--  展开/收起图标  -->
                                                                    <TextBlock
                                                                        Grid.Column="0"
                                                                        Width="16"
                                                                        Height="16"
                                                                        Margin="0,0,8,0"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        FontFamily="Segoe UI Symbol"
                                                                        FontSize="12"
                                                                        Text="{Binding IsExpanded, Converter={StaticResource BoolToExpansionIconConverter}}">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Children.Count}" Value="0">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>

                                                                    <!--  三段文字显示：父节点/设备名称、型号、LAN连接方式  -->
                                                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="1*" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <!--  第一段：机箱显示"{SlotCount}槽机箱"，控制器/板卡显示设备名称  -->
                                                                        <TextBlock
                                                                            Grid.Column="0"
                                                                            Margin="20,0,8,0"
                                                                            HorizontalAlignment="Left"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="14"
                                                                            FontWeight="Bold"
                                                                            TextTrimming="CharacterEllipsis">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <!--  默认显示设备名称（PrimaryDisplayName）  -->
                                                                                    <Setter Property="Text" Value="{Binding PrimaryDisplayName}" />
                                                                                    <Style.Triggers>
                                                                                        <!--  机箱设备显示 DeviceTypeName（如"18槽机箱"）  -->
                                                                                        <DataTrigger Binding="{Binding DeviceType}" Value="Chassis">
                                                                                            <Setter Property="Text" Value="{Binding DeviceTypeName}" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>

                                                                        <!--  第二段：型号（应用转换器）  -->
                                                                        <TextBlock
                                                                            Grid.Column="1"
                                                                            Margin="0,0,8,0"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="14"
                                                                            Text="{Binding Model, Converter={StaticResource ModelDisplayConverter}}"
                                                                            TextTrimming="CharacterEllipsis" />

                                                                        <!--  第三段：机箱设备显示详细信息，板卡设备显示插槽位置，程控设备显示连接方式  -->
                                                                        <TextBlock
                                                                            Grid.Column="2"
                                                                            Margin="0,0,8,0"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="14"
                                                                            Foreground="#666666"
                                                                            TextTrimming="CharacterEllipsis">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Text" Value="{Binding ConnectionMethod}" />
                                                                                    <Style.Triggers>
                                                                                        <!--  机箱设备第三段显示详细信息  -->
                                                                                        <DataTrigger Binding="{Binding DeviceType}" Value="Chassis">
                                                                                            <Setter Property="Text" Value="{Binding Details}" />
                                                                                        </DataTrigger>
                                                                                        <!--  板卡设备第三段显示插槽位置  -->
                                                                                        <DataTrigger Binding="{Binding DeviceType}" Value="Card">
                                                                                            <Setter Property="Text" Value="{Binding SlotPosition}" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Grid>

                                                                </Grid>
                                                            </Border>

                                                            <!--  子设备列表（如果是机箱设备）  -->
                                                            <ItemsControl
                                                                Grid.Row="1"
                                                                Margin="0,0,0,0"
                                                                ItemsSource="{Binding Children}"
                                                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <!--  板卡主行（板卡不显示子节点，子节点信息在右侧详细信息区域显示）  -->
                                                                        <Border
                                                                            Margin="0,1,0,0"
                                                                            Padding="0,6,0,6"
                                                                            AllowDrop="True"
                                                                            BorderBrush="#6e8de6"
                                                                            BorderThickness="0,0,0,2"
                                                                            Cursor="Hand"
                                                                            DragLeave="CardRow_DragLeave"
                                                                            DragOver="CardRow_DragOver"
                                                                            Drop="CardRow_Drop"
                                                                            MouseMove="CardRow_MouseMove"
                                                                            MouseRightButtonDown="DeviceBorder_MouseRightButtonDown"
                                                                            PreviewMouseLeftButtonDown="CardRow_PreviewMouseLeftButtonDown"
                                                                            Tag="{Binding}">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Background" Value="{Binding Converter={StaticResource DeviceTypeToBackgroundConverter}}" />
                                                                                    <Setter Property="MinHeight" Value="40" />
                                                                                    <Style.Triggers>
                                                                                        <!--  选中状态高亮 - 优先级最高  -->
                                                                                        <DataTrigger Value="True">
                                                                                            <DataTrigger.Binding>
                                                                                                <MultiBinding Converter="{StaticResource ObjectEqualityConverter}">
                                                                                                    <Binding Path="DataContext.SelectedDevice" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                                                    <Binding />
                                                                                                </MultiBinding>
                                                                                            </DataTrigger.Binding>
                                                                                            <Setter Property="Background" Value="#d3d3d3" />
                                                                                            <Setter Property="BorderBrush" Value="#4a90e2" />
                                                                                            <Setter Property="BorderThickness" Value="2" />
                                                                                        </DataTrigger>
                                                                                        <!--  鼠标悬停状态  -->
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter Property="Background" Value="{Binding Converter={StaticResource DeviceTypeToHoverBackgroundConverter}}" />
                                                                                        </Trigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <!--  InputBindings 已移除，点击逻辑统一在 MouseLeftButtonDown 中处理  -->
                                                                            <Grid IsHitTestVisible="False">
                                                                                <!--  板卡设备三段文字显示：设备名称、型号、插槽位置  -->
                                                                                <Grid VerticalAlignment="Center">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="2*" />
                                                                                        <ColumnDefinition Width="2*" />
                                                                                        <ColumnDefinition Width="1*" />
                                                                                    </Grid.ColumnDefinitions>

                                                                                    <!--  第一段：板卡名称（优先显示CardName，否则显示ParentNode）  -->
                                                                                    <TextBlock
                                                                                        Grid.Column="0"
                                                                                        Margin="40,0,8,0"
                                                                                        HorizontalAlignment="Left"
                                                                                        VerticalAlignment="Center"
                                                                                        FontSize="14"
                                                                                        FontWeight="Bold"
                                                                                        TextTrimming="CharacterEllipsis">
                                                                                        <TextBlock.Style>
                                                                                            <Style TargetType="TextBlock">
                                                                                                <!--  默认显示 ParentNode  -->
                                                                                                <Setter Property="Text" Value="{Binding ParentNode}" />
                                                                                                <Style.Triggers>
                                                                                                    <!--  如果 CardName 不为空，显示 CardName  -->
                                                                                                    <DataTrigger Binding="{Binding CardName, Converter={StaticResource StringToVisibilityConverter}}" Value="Visible">
                                                                                                        <Setter Property="Text" Value="{Binding CardName}" />
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </TextBlock.Style>
                                                                                    </TextBlock>
                                                                                    <!--  第二段：型号（应用转换器）  -->
                                                                                    <TextBlock
                                                                                        Grid.Column="1"
                                                                                        Margin="0,0,8,0"
                                                                                        HorizontalAlignment="Center"
                                                                                        VerticalAlignment="Center"
                                                                                        FontSize="14"
                                                                                        Text="{Binding Model, Converter={StaticResource ModelDisplayConverter}}"
                                                                                        TextTrimming="CharacterEllipsis" />
                                                                                    <!--  第三段：插槽位置  -->
                                                                                    <TextBlock
                                                                                        Grid.Column="2"
                                                                                        Margin="0,0,8,0"
                                                                                        HorizontalAlignment="Center"
                                                                                        VerticalAlignment="Center"
                                                                                        FontSize="14"
                                                                                        Foreground="#666666"
                                                                                        Text="{Binding SlotPosition}"
                                                                                        TextTrimming="CharacterEllipsis" />
                                                                                </Grid>

                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>

                                    <!--  GridSplitter for resizing  -->
                                    <GridSplitter
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="1"
                                        Width="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Stretch"
                                        Background="#6e8de6"
                                        ShowsPreview="True" />

                                    <Border
                                        x:Name="rightinfo"
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <!--  RightPanelContent 为空时隐藏  -->
                                                    <DataTrigger Binding="{Binding RightPanelContent}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ContentControl Content="{Binding RightPanelContent}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <GridSplitter
                        Grid.Row="0"
                        Height="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Background="#1c1c1c"
                        ShowsPreview="True" />

                    <Border x:Name="information" Grid.Row="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="15*" />
                            </Grid.RowDefinitions>
                            <Border
                                Background="#b2b2b2"
                                BorderBrush="#1c1c1c"
                                BorderThickness="0,0,0,1.5">
                                <TextBlock
                                    Grid.Row="0"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="常规" />
                            </Border>
                            <Border
                                Grid.Row="1"
                                Background="#ffffff"
                                BorderBrush="#1c1c1c"
                                BorderThickness="0,1.5,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDevice.Name}" Value="空槽">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="4*" />
                                        <RowDefinition Height="12*" />
                                        <RowDefinition Height="10*" />
                                        <RowDefinition Height="5*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel
                                        Grid.Row="0"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Image
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Source="/Resources/Logo/warning.png" />
                                        <TextBlock
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="Black"
                                            Text="{Binding DeviceInfoTitle}" />
                                    </StackPanel>

                                    <Border Grid.Row="1" Margin="10,5,0,0">
                                        <Grid>
                                            <!--  暂无信息提示  -->
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Foreground="#999999">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedDevice}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!--  设备详细信息：根据 SelectedDeviceDisplayFields 动态生成  -->
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <ItemsControl Grid.Row="0" ItemsSource="{Binding SelectedDeviceDisplayFields}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="2" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock
                                                                Margin="0,4,30,4"
                                                                FontSize="14"
                                                                Text="{Binding DisplayText}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                    <ItemsControl.Style>
                                                        <Style TargetType="ItemsControl">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedDevice}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ItemsControl.Style>
                                                </ItemsControl>

                                                <!--  机箱IP地址显示（仅当选中机箱设备时显示）  -->
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Grid.ColumnSpan="2"
                                                    Margin="0,8,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="{Binding ChassisIpAddress, StringFormat='IP地址:  {0}', FallbackValue='IP地址:  '}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedDevice.DeviceType}" Value="Chassis">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="2" Margin="10,5,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                Grid.Row="0"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                FontWeight="Black"
                                                Text="设备描述" />
                                            <TextBlock
                                                Grid.Row="1"
                                                FontSize="14"
                                                Text="{Binding SelectedDevice.Description, FallbackValue='请选择设备查看详细信息'}"
                                                TextWrapping="Wrap" />
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedDevice}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="3" Margin="10,0,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!--  设备手册按钮  -->
                                            <Button
                                                Grid.Row="1"
                                                Width="80"
                                                Height="20"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="#2563eb"
                                                Command="{Binding OpenDeviceManualCommand}">
                                                <TextBlock
                                                    FontSize="14"
                                                    Foreground="White"
                                                    Text="设备手册" />
                                                <Button.ToolTip>
                                                    <TextBlock
                                                        Width="220"
                                                        Text="{Binding SelectedDeviceManualInfo}"
                                                        TextWrapping="Wrap" />
                                                </Button.ToolTip>
                                            </Button>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedDevice}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                        </Grid>
                                    </Border>

                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter
                Grid.Column="0"
                Width="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="#1c1c1c"
                ShowsPreview="True" />

            <!--  右侧工具树  -->
            <Border
                Grid.Row="0"
                Grid.Column="1"
                Background="#eaeaea">

                <!--  工具树内容  -->
                <Border Grid.Row="1">
                    <TreeView
                        x:Name="PxiToolsTreeView"
                        AllowDrop="False"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding Tools}">
                        <TreeView.Style>
                            <Style TargetType="TreeView">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TreeView">
                                            <Border
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                <ScrollViewer
                                                    Focusable="False"
                                                    HorizontalScrollBarVisibility="Disabled"
                                                    Style="{StaticResource SimpleScrollViewerStyle}"
                                                    VerticalScrollBarVisibility="Auto">
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.Style>
                        <TreeView.Resources>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <EventSetter Event="Selected" Handler="TreeViewItem_Selected" />
                                <Setter Property="Padding" Value="10,4,5,4" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="IsExpanded" Value="True" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type TreeViewItem}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition />
                                                </Grid.RowDefinitions>
                                                <Border
                                                    x:Name="Bd"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    MouseLeftButtonDown="Border_MouseLeftButtonDown"
                                                    MouseLeftButtonUp="Border_MouseLeftButtonUp">
                                                    <ContentPresenter
                                                        x:Name="PART_Header"
                                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                        ContentSource="Header"
                                                        MouseLeftButtonUp="Header_MouseLeftButtonUp" />
                                                </Border>
                                                <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger SourceName="PART_Header" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#d3e0ea" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#a8c6df" />
                                                </Trigger>
                                                <Trigger Property="IsExpanded" Value="True">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <Trigger Property="IsExpanded" Value="False">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.Resources>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Border Background="Transparent" HorizontalAlignment="Stretch">
                                    <Border.Padding>
                                        <MultiBinding Converter="{StaticResource LevelToIndentConverter}">
                                            <Binding RelativeSource="{RelativeSource AncestorType={x:Type TreeViewItem}}" />
                                            <Binding Source="20" />
                                        </MultiBinding>
                                    </Border.Padding>
                                    <StackPanel Orientation="Horizontal">
                                        <Image
                                            Width="20"
                                            Height="20"
                                            Margin="0,0,8,0"
                                            Source="{Binding Icon}">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Icon}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <TextBlock FontSize="13" Text="{Binding Name}" />
                                    </StackPanel>
                                </Border>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Border>
            </Border>
        </Grid>
    </Border>
</UserControl>
