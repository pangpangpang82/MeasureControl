<UserControl

    x:Class="MeasureControl.Views.SingleBoardTest.AirController.A_C_6_9_2_1View"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

    xmlns:local="clr-namespace:MeasureControl.Views.SingleBoardTest.AirController"

    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    xmlns:sys="clr-namespace:System;assembly=mscorlib"

    d:DesignHeight="550"

    d:DesignWidth="970"

    mc:Ignorable="d">

    <UserControl.Resources>

        <x:Array x:Key="Arinc429Channels" Type="sys:String">

            <sys:String>CH0</sys:String>

            <sys:String>CH1</sys:String>

            <sys:String>CH2</sys:String>

            <sys:String>CH3</sys:String>

            <sys:String>CH4</sys:String>

            <sys:String>CH5</sys:String>

            <sys:String>CH6</sys:String>

            <sys:String>CH7</sys:String>

            <sys:String>CH8</sys:String>

            <sys:String>CH9</sys:String>

            <sys:String>CH10</sys:String>

            <sys:String>CH11</sys:String>

            <sys:String>CH12</sys:String>

            <sys:String>CH13</sys:String>

            <sys:String>CH14</sys:String>

            <sys:String>CH15</sys:String>

        </x:Array>



        <Style x:Key="EnableCheckBoxStyle" TargetType="CheckBox">

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="CheckBox">

                        <Grid>

                            <Border

                                x:Name="checkBoxBorder"

                                Width="16"

                                Height="16"

                                Background="White"

                                BorderBrush="#D9D9D9"

                                BorderThickness="1"

                                CornerRadius="2">

                                <Path

                                    x:Name="checkMark"

                                    Data="M 2 8 L 6 12 L 14 4"

                                    Stroke="White"

                                    StrokeThickness="2"

                                    Visibility="Collapsed" />

                            </Border>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked" Value="True">

                                <Setter TargetName="checkBoxBorder" Property="Background" Value="#3b82f6" />

                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#3b82f6" />

                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible" />

                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#3b82f6" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>



    <Grid

        x:Name="RootGrid"

        Background="White"

        Focusable="True"

        PreviewMouseDown="RootGrid_PreviewMouseDown">

        <Grid.RowDefinitions>

            <RowDefinition Height="0.8*" />

            <RowDefinition Height="6*" />

            <RowDefinition Height="1.2*" />

        </Grid.RowDefinitions>



        <Border

            Grid.Row="0"

            Margin="8,8,8,4"

            Background="White"

            BorderBrush="#D9D9D9"

            BorderThickness="1.5"

            CornerRadius="8">

            <Grid>

                <TextBlock

                    Width="514"

                    Margin="10,0,0,0"

                    HorizontalAlignment="Left"

                    VerticalAlignment="Center"

                    FontSize="24"

                    FontWeight="Bold"

                    ><Run Language="zh-cn" Text="6.9.2控制通道CAB_VENTS传感器测试"/></TextBlock>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">

                    <Button

                        Width="100"

                        Height="32"

                        Margin="0,0,20,0"

                        VerticalAlignment="Center"

                        BorderThickness="0"

                        Command="{Binding ManualTestCommand}">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border

                                    x:Name="border"

                                    Background="#3b82f6"

                                    CornerRadius="6">

                                    <StackPanel Orientation="Horizontal">

                                        <Image

                                            x:Name="DeviceImage"

                                            Width="15"

                                            Height="15"

                                            Margin="5,0,5,0"

                                            Source="/Resources/Logo/hand_w.png" />

                                        <TextBlock

                                            x:Name="DeviceAction"

                                            Margin="0,0,5,0"

                                            VerticalAlignment="Center"

                                            FontSize="16"

                                            Foreground="White"

                                            Text="手动测试" />

                                    </StackPanel>

                                </Border>

                                <ControlTemplate.Triggers>

                                    <DataTrigger Binding="{Binding IsManualTestRunning}" Value="True">

                                        <Setter Property="Tag" Value="True" />

                                        <Setter TargetName="border" Property="Background" Value="#ef4444" />

                                        <Setter TargetName="DeviceAction" Property="Text" Value="停止测试" />

                                    </DataTrigger>



                                    <DataTrigger Binding="{Binding IsManualTestRunning}" Value="False">

                                        <Setter Property="Tag" Value="False" />

                                    </DataTrigger>



                                    <MultiTrigger>

                                        <MultiTrigger.Conditions>

                                            <Condition Property="Tag" Value="False" />

                                            <Condition Property="IsMouseOver" Value="True" />

                                        </MultiTrigger.Conditions>

                                        <Setter TargetName="border" Property="Background" Value="#2563eb" />

                                    </MultiTrigger>



                                    <MultiTrigger>

                                        <MultiTrigger.Conditions>

                                            <Condition Property="Tag" Value="False" />

                                            <Condition Property="IsPressed" Value="True" />

                                        </MultiTrigger.Conditions>

                                        <Setter TargetName="border" Property="Background" Value="#2563eb" />

                                    </MultiTrigger>



                                    <MultiTrigger>

                                        <MultiTrigger.Conditions>

                                            <Condition Property="Tag" Value="True" />

                                            <Condition Property="IsMouseOver" Value="True" />

                                        </MultiTrigger.Conditions>

                                        <Setter TargetName="border" Property="Background" Value="#b91c1c" />

                                    </MultiTrigger>



                                    <MultiTrigger>

                                        <MultiTrigger.Conditions>

                                            <Condition Property="Tag" Value="True" />

                                            <Condition Property="IsPressed" Value="True" />

                                        </MultiTrigger.Conditions>

                                        <Setter TargetName="border" Property="Background" Value="#b91c1c" />

                                    </MultiTrigger>



                                    <Trigger Property="IsEnabled" Value="False">

                                        <Setter TargetName="border" Property="Background" Value="#9ca3af" />

                                        <Setter Property="Cursor" Value="Arrow" />

                                    </Trigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                    <Button

                        Width="100"

                        Height="32"

                        Margin="0,0,30,0"

                        VerticalAlignment="Center"

                        BorderThickness="0"

                        Command="{Binding AutoTestCommand}">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border

                                    x:Name="border"

                                    Background="#22c55e"

                                    CornerRadius="6">

                                    <StackPanel Orientation="Horizontal">

                                        <Image

                                            x:Name="DeviceImage"

                                            Width="15"

                                            Height="15"

                                            Margin="5,0,5,0"

                                            Source="/Resources/Logo/auto.png" />

                                        <TextBlock

                                            x:Name="DeviceAction"

                                            Margin="0,0,5,0"

                                            VerticalAlignment="Center"

                                            FontSize="16"

                                            Foreground="White"

                                            Text="自动测试" />

                                    </StackPanel>

                                </Border>

                                <ControlTemplate.Triggers>

                                    <DataTrigger Binding="{Binding IsAutoTestRunning}" Value="True">

                                        <Setter Property="Tag" Value="True" />

                                        <Setter TargetName="border" Property="Background" Value="#ef4444" />

                                        <Setter TargetName="DeviceAction" Property="Text" Value="停止测试" />

                                    </DataTrigger>



                                    <DataTrigger Binding="{Binding IsAutoTestRunning}" Value="False">

                                        <Setter Property="Tag" Value="False" />

                                    </DataTrigger>



                                    <MultiTrigger>

                                        <MultiTrigger.Conditions>

                                            <Condition Property="Tag" Value="False" />

                                            <Condition Property="IsMouseOver" Value="True" />

                                        </MultiTrigger.Conditions>

                                        <Setter TargetName="border" Property="Background" Value="#15803d" />

                                    </MultiTrigger>



                                    <MultiTrigger>

                                        <MultiTrigger.Conditions>

                                            <Condition Property="Tag" Value="False" />

                                            <Condition Property="IsPressed" Value="True" />

                                        </MultiTrigger.Conditions>

                                        <Setter TargetName="border" Property="Background" Value="#15803d" />

                                    </MultiTrigger>



                                    <MultiTrigger>

                                        <MultiTrigger.Conditions>

                                            <Condition Property="Tag" Value="True" />

                                            <Condition Property="IsMouseOver" Value="True" />

                                        </MultiTrigger.Conditions>

                                        <Setter TargetName="border" Property="Background" Value="#b91c1c" />

                                    </MultiTrigger>



                                    <MultiTrigger>

                                        <MultiTrigger.Conditions>

                                            <Condition Property="Tag" Value="True" />

                                            <Condition Property="IsPressed" Value="True" />

                                        </MultiTrigger.Conditions>

                                        <Setter TargetName="border" Property="Background" Value="#b91c1c" />

                                    </MultiTrigger>



                                    <Trigger Property="IsEnabled" Value="False">

                                        <Setter TargetName="border" Property="Background" Value="#9ca3af" />

                                        <Setter Property="Cursor" Value="Arrow" />

                                    </Trigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                </StackPanel>

            </Grid>

        </Border>



