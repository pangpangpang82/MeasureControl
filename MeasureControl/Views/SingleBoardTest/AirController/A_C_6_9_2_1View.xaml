                                HorizontalAlignment="Center"

                                VerticalAlignment="Center"

                                FontSize="12"

                                Text="{Binding EnterAtpRxDataText}" />

                        </Border>

                    </StackPanel>

                </Grid>



                <StackPanel Grid.Row="2" Orientation="Horizontal" Grid.ColumnSpan="2">

                    <TextBlock

                        Margin="10,0,0,0"

                        VerticalAlignment="Center"

                        FontSize="16"

                        ><Run Text="2.接入电"/><Run Language="zh-cn" Text="压"/><Run Text="："/></TextBlock>

                    <ComboBox

                        Width="100"

                        Height="28"

                        Margin="0,0,0,0"

                        HorizontalAlignment="Left"

                        FontSize="12"

                        ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"

