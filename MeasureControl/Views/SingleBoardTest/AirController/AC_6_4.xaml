<UserControl
    x:Class="MeasureControl.Views.SingleBoardTest.AirController.AC_6_4"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MeasureControl.Views.SingleBoardTest.AirController"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="550"
    d:DesignWidth="970"
    mc:Ignorable="d">
    <UserControl.Resources>
        <x:Array x:Key="Arinc429Channels" Type="sys:String">
            <sys:String>ARINC429_0</sys:String>
            <sys:String>ARINC429_1</sys:String>
            <sys:String>ARINC429_2</sys:String>
            <sys:String>ARINC429_3</sys:String>
            <sys:String>ARINC429_4</sys:String>
            <sys:String>ARINC429_5</sys:String>
            <sys:String>ARINC429_6</sys:String>
            <sys:String>ARINC429_7</sys:String>
            <sys:String>ARINC429_8</sys:String>
            <sys:String>ARINC429_9</sys:String>
            <sys:String>ARINC429_10</sys:String>
            <sys:String>ARINC429_11</sys:String>
            <sys:String>ARINC429_12</sys:String>
            <sys:String>ARINC429_13</sys:String>
            <sys:String>ARINC429_14</sys:String>
            <sys:String>ARINC429_15</sys:String>
        </x:Array>
        <x:Array x:Key="DmmChannels" Type="sys:String">
            <sys:String>Port1</sys:String>
            <sys:String>Port2</sys:String>
        </x:Array>
    </UserControl.Resources>
    <Grid
        x:Name="RootGrid"
        Background="White"
        Focusable="True"
        PreviewMouseDown="RootGrid_PreviewMouseDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="5*" />
                <RowDefinition Height="1.8*" />
            </Grid.RowDefinitions>
            <Border
                x:Name="Test_name"
                Grid.Row="0"
                Margin="8,8,8,4"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">
                <Grid>
                    <TextBlock
                        Width="300"
                        Margin="20,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="30"
                        FontWeight="Bold"
                        Text="控制通道光耦供电测试" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            Width="110"
                            Height="40"
                            Margin="0,0,20,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding ManualTestCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="#3b82f6"
                                        CornerRadius="6">
                                        <StackPanel Orientation="Horizontal">
                                            <Image
                                                x:Name="DeviceImage"
                                                Width="20"
                                                Height="20"
                                                Margin="5,0,5,0"
                                                Source="/Resources/Logo/hand_w.png" />
                                            <TextBlock
                                                x:Name="DeviceAction"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                FontSize="18"
                                                Foreground="White"
                                                Text="手动测试" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsManualTestRunning}" Value="True">
                                            <Setter Property="Tag" Value="True" />
                                            <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                            <Setter TargetName="DeviceAction" Property="Text" Value="停止测试" />
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding IsManualTestRunning}" Value="False">
                                            <Setter Property="Tag" Value="False" />
                                        </DataTrigger>

                                        <!--  2. 未连接 + 悬停  -->
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="False" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                        </MultiTrigger>

                                        <!--  3. 未连接 + 按下  -->
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="False" />
                                                <Condition Property="IsPressed" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                        </MultiTrigger>

                                        <!--  4. 已连接 + 悬停（优先级更高，放在后面）  -->
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="True" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                        </MultiTrigger>

                                        <!--  5. 已连接 + 按下  -->
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="True" />
                                                <Condition Property="IsPressed" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                        </MultiTrigger>

                                        <!--  6. 禁用状态（最高优先级）  -->
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                            <Setter Property="Cursor" Value="Arrow" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button
                            Width="110"
                            Height="40"
                            Margin="0,0,30,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding AutoTestCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="#22c55e"
                                        CornerRadius="6">
                                        <StackPanel Orientation="Horizontal">
                                            <Image
                                                x:Name="DeviceImage"
                                                Width="20"
                                                Height="20"
                                                Margin="5,0,5,0"
                                                Source="/Resources/Logo/auto.png" />
                                            <TextBlock
                                                x:Name="DeviceAction"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                FontSize="18"
                                                Foreground="White"
                                                Text="自动测试" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsAutoTestRunning}" Value="True">
                                            <Setter Property="Tag" Value="True" />
                                            <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                            <Setter TargetName="DeviceAction" Property="Text" Value="停止测试" />
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding IsAutoTestRunning}" Value="False">
                                            <Setter Property="Tag" Value="False" />
                                        </DataTrigger>

                                        <!--  2. 未连接 + 悬停  -->
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="False" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#15803d" />
                                        </MultiTrigger>

                                        <!--  3. 未连接 + 按下  -->
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="False" />
                                                <Condition Property="IsPressed" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#15803d" />
                                        </MultiTrigger>

                                        <!--  4. 已连接 + 悬停（优先级更高，放在后面）  -->
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="True" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                        </MultiTrigger>

                                        <!--  5. 已连接 + 按下  -->
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="True" />
                                                <Condition Property="IsPressed" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                        </MultiTrigger>

                                        <!--  6. 禁用状态（最高优先级）  -->
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                            <Setter Property="Cursor" Value="Arrow" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                </Grid>
            </Border>
            <Border
                Grid.Row="1"
                Margin="8,4,8,8"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.5*" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="2*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Margin="20,10,0,0"
                        VerticalAlignment="Center"
                        FontSize="30"
                        FontWeight="Bold"
                        Text="测试步骤" />
                    <StackPanel
                        Grid.Row="1"
                        Margin="10"
                        Orientation="Horizontal">
                        <TextBlock
                            Grid.Column="0"
                            Margin="30,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="18"
                            Text="进入ATP模式：" />
                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="TX" />
                        <ComboBox
                            Width="140"
                            Height="36"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            FontSize="16"
                            ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                            ItemsSource="{StaticResource Arinc429Channels}"
                            SelectedItem="{Binding EnterAtpTxChannel, Mode=TwoWay}">
                            <ComboBox.Style>
                                <Style BasedOn="{StaticResource CustomComboBoxStyle}" TargetType="ComboBox">
                                    <Setter Property="Opacity" Value="1" />
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <TextBlock
                            Grid.Column="0"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="RX" />
                        <ComboBox
                            Width="140"
                            Height="36"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            FontSize="16"
                            ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                            ItemsSource="{StaticResource Arinc429Channels}"
                            SelectedItem="{Binding EnterAtpRxChannel, Mode=TwoWay}">
                            <ComboBox.Style>
                                <Style BasedOn="{StaticResource CustomComboBoxStyle}" TargetType="ComboBox">
                                    <Setter Property="Opacity" Value="1" />
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <Button
                            Width="80"
                            Height="36"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding SendEnterAtpCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="#3b82f6"
                                        CornerRadius="4">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock
                                                x:Name="DeviceAction"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="18"
                                                Foreground="White"
                                                Text="发送" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                            <Setter Property="Cursor" Value="Arrow" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                    </StackPanel>
                    <StackPanel
                        Grid.Row="2"
                        Margin="10,5,5,5"
                        Orientation="Horizontal">
                        <TextBlock
                            Grid.Column="0"
                            Margin="30,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="18"
                            Text="控制器输出电压：" />
                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="TX" />
                        <ComboBox
                            Width="140"
                            Height="36"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            FontSize="16"
                            ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                            ItemsSource="{StaticResource Arinc429Channels}"
                            SelectedItem="{Binding SetVoltageTxChannel, Mode=TwoWay}">
                            <ComboBox.Style>
                                <Style BasedOn="{StaticResource CustomComboBoxStyle}" TargetType="ComboBox">
                                    <Setter Property="Opacity" Value="1" />
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <TextBlock
                            Grid.Column="0"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="RX" />
                        <ComboBox
                            Width="140"
                            Height="36"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            FontSize="16"
                            ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                            ItemsSource="{StaticResource Arinc429Channels}"
                            SelectedItem="{Binding SetVoltageRxChannel, Mode=TwoWay}">
                            <ComboBox.Style>
                                <Style BasedOn="{StaticResource CustomComboBoxStyle}" TargetType="ComboBox">
                                    <Setter Property="Opacity" Value="1" />
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <Button
                            Width="80"
                            Height="36"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding SendSetVoltageCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="#3b82f6"
                                        CornerRadius="4">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock
                                                x:Name="DeviceAction"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="18"
                                                Foreground="White"
                                                Text="发送" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                            <Setter Property="Cursor" Value="Arrow" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    <StackPanel
                        Grid.Row="3"
                        Margin="10"
                        Orientation="Horizontal">
                        <TextBlock
                            Grid.Column="0"
                            Margin="30,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Text="供电模块输出电压：" />
                        <ComboBox
                            Width="140"
                            Height="36"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            FontSize="16"
                            ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                            ItemsSource="{StaticResource DmmChannels}"
                            SelectedItem="{Binding DmmChannel, Mode=TwoWay}">
                            <ComboBox.Style>
                                <Style BasedOn="{StaticResource CustomComboBoxStyle}" TargetType="ComboBox">
                                    <Setter Property="Opacity" Value="1" />
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <Border
                            Width="140"
                            Height="36"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            BorderBrush="#D9D9D9"
                            BorderThickness="1"
                            CornerRadius="3">
                            <TextBlock Margin="1" FontSize="16" Text="{Binding DmmVoltageText}" />
                        </Border>

                    </StackPanel>
                    <StackPanel
                        Grid.Row="4"
                        Margin="10"
                        Orientation="Horizontal">
                        <TextBlock
                            Grid.Column="0"
                            Margin="30,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Text="供电电压回采值：" />
                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="RX" />

                        <ComboBox
                            Width="140"
                            Height="36"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            FontSize="16"
                            ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                            ItemsSource="{StaticResource Arinc429Channels}"
                            SelectedItem="{Binding TelemetryRxChannel, Mode=TwoWay}">
                            <ComboBox.Style>
                                <Style BasedOn="{StaticResource CustomComboBoxStyle}" TargetType="ComboBox">
                                    <Setter Property="Opacity" Value="1" />
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <Border
                            Width="140"
                            Height="38"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            BorderBrush="#D9D9D9"
                            BorderThickness="1"
                            CornerRadius="3">
                            <TextBlock Margin="1" FontSize="16" Text="{Binding TelemetryVoltageText}" />
                        </Border>

                    </StackPanel>
                    <StackPanel
                        Grid.Row="5"
                        Margin="10"
                        Orientation="Horizontal">
                        <TextBlock
                            Grid.Column="0"
                            Margin="30,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="18"
                            Text="退出ATP模式：" />
                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="TX" />
                        <ComboBox
                            Width="140"
                            Height="38"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            FontSize="16"
                            ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                            ItemsSource="{StaticResource Arinc429Channels}"
                            SelectedItem="{Binding ExitAtpTxChannel, Mode=TwoWay}">
                            <ComboBox.Style>
                                <Style BasedOn="{StaticResource CustomComboBoxStyle}" TargetType="ComboBox">
                                    <Setter Property="Opacity" Value="1" />
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <TextBlock
                            Grid.Column="0"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="RX" />
                        <ComboBox
                            Width="140"
                            Height="38"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            FontSize="16"
                            ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                            ItemsSource="{StaticResource Arinc429Channels}"
                            SelectedItem="{Binding ExitAtpRxChannel, Mode=TwoWay}">
                            <ComboBox.Style>
                                <Style BasedOn="{StaticResource CustomComboBoxStyle}" TargetType="ComboBox">
                                    <Setter Property="Opacity" Value="1" />
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <Button
                            Width="80"
                            Height="38"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding SendExitAtpCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="#3b82f6"
                                        CornerRadius="4">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock
                                                x:Name="DeviceAction"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="18"
                                                Foreground="White"
                                                Text="发送" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                            <Setter Property="Cursor" Value="Arrow" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                    </StackPanel>
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="10,10,0,0"
                        Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="30"
                            FontWeight="Bold"
                            Text="测试信息" />
                        <Button
                            Width="80"
                            Height="32"
                            Margin="80,0,0,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding ClearLogCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="#3b82f6"
                                        CornerRadius="4">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock
                                                x:Name="DeviceAction"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="18"
                                                Foreground="White"
                                                Text="清除内容" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                            <Setter Property="Cursor" Value="Arrow" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    <Border
                        Grid.Row="1"
                        Grid.RowSpan="5"
                        Grid.Column="1"
                        Width="300"
                        Height="280"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BorderBrush="#D9D9D9"
                        BorderThickness="1.5"
                        CornerRadius="4">
                        <ListBox
                            Margin="6"
                            BorderThickness="0"
                            ItemsSource="{Binding Logs}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.Resources>
                                <Style TargetType="ScrollViewer" BasedOn="{StaticResource SimpleScrollViewerStyle}" />
                            </ListBox.Resources>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        FontSize="16"
                                        Text="{Binding}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>
            <Border
                Grid.Row="2"
                Margin="8,4,8,8"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.5*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="30"
                        FontWeight="Bold">
                        <Run Text="测试结果：" />
                        <Run Text=" " />
                        <Run Text="{Binding LastTestResult, TargetNullValue=--, FallbackValue=--}" />
                    </TextBlock>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold">
                            <Run Text="上次测试时间：" />
                            <Run Text="{Binding LastTestTime, TargetNullValue=--, FallbackValue=--}" />
                        </TextBlock>
                        <TextBlock
                            Grid.Column="1"
                            Margin="30,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold">
                            <Run Text="上次测试结果：" />
                            <Run Text="{Binding LastTestResult, TargetNullValue=--, FallbackValue=--}" />
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
