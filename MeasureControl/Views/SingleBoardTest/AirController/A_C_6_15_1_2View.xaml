<UserControl
    x:Class="MeasureControl.Views.SingleBoardTest.AirController.A_C_6_15_1_2View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="550"
    d:DesignWidth="970"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ScrollBarStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        x:Name="RootGrid"
        Background="White"
        Focusable="True"
        PreviewMouseDown="RootGrid_PreviewMouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.8*" />
            <RowDefinition Height="6*" />
            <RowDefinition Height="1.2*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="8,8,8,4"
            Background="White"
            BorderBrush="#D9D9D9"
            BorderThickness="1.5"
            CornerRadius="8">
            <Grid>
                <TextBlock
                    Width="650"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="24"
                    FontWeight="Bold"
                    Text="6.15.1.2 A控制通道功率板RAIA直流电机驱动模块方向控制测试" />

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Width="100"
                        Height="32"
                        Margin="0,0,20,0"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        Command="{Binding ManualTestCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="border"
                                    Background="#3b82f6"
                                    CornerRadius="6">
                                    <StackPanel Orientation="Horizontal">
                                        <Image
                                            x:Name="DeviceImage"
                                            Width="15"
                                            Height="15"
                                            Margin="5,0,5,0"
                                            Source="/Resources/Logo/hand_w.png" />
                                        <TextBlock
                                            x:Name="DeviceAction"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="White"
                                            Text="手动测试" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsManualTestRunning}" Value="True">
                                        <Setter Property="Tag" Value="True" />
                                        <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                        <Setter TargetName="DeviceAction" Property="Text" Value="停止测试" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding IsManualTestRunning}" Value="False">
                                        <Setter Property="Tag" Value="False" />
                                    </DataTrigger>

                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="False" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                    </MultiTrigger>

                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="False" />
                                            <Condition Property="IsPressed" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                    </MultiTrigger>

                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="True" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                    </MultiTrigger>

                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="True" />
                                            <Condition Property="IsPressed" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                    </MultiTrigger>

                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                        <Setter Property="Cursor" Value="Arrow" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button
                        Width="100"
                        Height="32"
                        Margin="0,0,30,0"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        Command="{Binding AutoTestCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="border"
                                    Background="#22c55e"
                                    CornerRadius="6">
                                    <StackPanel Orientation="Horizontal">
                                        <Image
                                            x:Name="DeviceImage"
                                            Width="15"
                                            Height="15"
                                            Margin="5,0,5,0"
                                            Source="/Resources/Logo/auto.png" />
                                        <TextBlock
                                            x:Name="DeviceAction"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="White"
                                            Text="自动测试" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsAutoTestRunning}" Value="True">
                                        <Setter Property="Tag" Value="True" />
                                        <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                        <Setter TargetName="DeviceAction" Property="Text" Value="停止测试" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding IsAutoTestRunning}" Value="False">
                                        <Setter Property="Tag" Value="False" />
                                    </DataTrigger>

                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="False" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#15803d" />
                                    </MultiTrigger>

                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="False" />
                                            <Condition Property="IsPressed" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#15803d" />
                                    </MultiTrigger>

                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="True" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                    </MultiTrigger>

                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="True" />
                                            <Condition Property="IsPressed" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                    </MultiTrigger>

                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                        <Setter Property="Cursor" Value="Arrow" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Margin="8,4,8,4"
            Background="White"
            BorderBrush="#D9D9D9"
            BorderThickness="1.5"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="2.2*" />
                    <RowDefinition Height="4.4*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="20"
                    FontWeight="Bold"
                    Text="测试步骤" />

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="10,5,0,0"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="22"
                        FontWeight="Bold"
                        Text="测试信息" />
                    <Button
                        Width="80"
                        Height="32"
                        Margin="80,0,0,0"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        Command="{Binding ClearLogCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="border"
                                    Background="#3b82f6"
                                    CornerRadius="4">
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock
                                            x:Name="DeviceAction"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="White"
                                            Text="清除内容" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                        <Setter Property="Cursor" Value="Arrow" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <Border
                    Grid.Row="1"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Width="350"
                    Height="350"
                    Margin="0,0,5,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="#D9D9D9"
                    BorderThickness="1.5"
                    CornerRadius="4">
                    <Grid>
                        <ListBox
                            Margin="5"
                            BorderThickness="0"
                            ItemsSource="{Binding Logs}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.Resources>
                                <Style BasedOn="{StaticResource SimpleScrollViewerStyle}" TargetType="ScrollViewer" />
                            </ListBox.Resources>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        FontSize="12"
                                        Text="{Binding}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Grid
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="10,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="5" Orientation="Horizontal">
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="16" Text="进入ATP模式：" />
                        <TextBlock Margin="0,0,0,0" VerticalAlignment="Center" FontSize="14" Text="TX" />
                        <Border Width="80" Height="28" Margin="5,0,0,0" VerticalAlignment="Center" Background="AliceBlue" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                            <TextBlock Margin="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" Text="{Binding TestTxChannel}" />
                        </Border>

                        <Border
                            Width="220"
                            Height="28"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Background="AliceBlue"
                            BorderBrush="#D9D9D9"
                            BorderThickness="1"
                            CornerRadius="3">
                            <TextBlock
                                Margin="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="0x00 01 00 01 00 00 00 00" />
                        </Border>

                        <Button
                            Width="50"
                            Height="28"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding SendEnterAtpCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="#3b82f6"
                                        CornerRadius="4">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock
                                                x:Name="DeviceAction"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Foreground="White"
                                                Text="发送" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                            <Setter Property="Cursor" Value="Arrow" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="115,5,5,5" Orientation="Horizontal">
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" Text="RX" />
                        <Border Width="80" Height="28" Margin="5,0,0,0" VerticalAlignment="Center" Background="AliceBlue" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                            <TextBlock Margin="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" Text="{Binding TestRxChannel}" />
                        </Border>

                        <Border
                            Width="220"
                            Height="28"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Background="LightYellow"
                            BorderBrush="#D9D9D9"
                            BorderThickness="1"
                            CornerRadius="3">
                            <TextBlock
                                Margin="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{Binding EnterAtpRxDataText}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="10,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="5" Orientation="Horizontal">
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="16" Text="PH引脚高电平：" />
                        <TextBlock Margin="0,0,0,0" VerticalAlignment="Center" FontSize="14" Text="TX" />
                        <Border Width="80" Height="28" Margin="5,0,0,0" VerticalAlignment="Center" Background="AliceBlue" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                            <TextBlock Margin="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" Text="{Binding TestTxChannel}" />
                        </Border>

                        <Border
                            Width="220"
                            Height="28"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Background="AliceBlue"
                            BorderBrush="#D9D9D9"
                            BorderThickness="1"
                            CornerRadius="3">
                            <TextBlock
                                Margin="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="0x21 03 02 01 00 00 00 00" />
                        </Border>
                        <Button
                            Width="90"
                            Height="28"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding RunPhHighAndMeasureCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="#3b82f6"
                                        CornerRadius="4">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock
                                                x:Name="DeviceAction"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Foreground="White"
                                                Text="发送测量" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                            <Setter Property="Cursor" Value="Arrow" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <StackPanel
                        Grid.Row="1"
                        Margin="115,5,5,5"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="电压" />
                        <Border
                            Width="140"
                            Height="28"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Background="LightYellow"
                            BorderBrush="#D9D9D9"
                            BorderThickness="1"
                            CornerRadius="3">
                            <TextBlock
                                Margin="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{Binding PhHighVoltageText}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="5" Orientation="Horizontal">
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="16" Text="PH引脚低电平：" />
                        <TextBlock Margin="0,0,0,0" VerticalAlignment="Center" FontSize="14" Text="TX" />
                        <Border Width="80" Height="28" Margin="5,0,0,0" VerticalAlignment="Center" Background="AliceBlue" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                            <TextBlock Margin="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" Text="{Binding TestTxChannel}" />
                        </Border>

                        <Border
                            Width="220"
                            Height="28"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Background="AliceBlue"
                            BorderBrush="#D9D9D9"
                            BorderThickness="1"
                            CornerRadius="3">
                            <TextBlock
                                Margin="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="0x21 03 02 02 00 00 00 00" />
                        </Border>
                        <Button
                            Width="90"
                            Height="28"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding RunPhLowAndMeasureCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="#3b82f6"
                                        CornerRadius="4">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock
                                                x:Name="DeviceAction"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Foreground="White"
                                                Text="发送测量" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                            <Setter Property="Cursor" Value="Arrow" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <StackPanel
                        Grid.Row="3"
                        Margin="115,5,5,5"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="电压" />
                        <Border
                            Width="140"
                            Height="28"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Background="LightYellow"
                            BorderBrush="#D9D9D9"
                            BorderThickness="1"
                            CornerRadius="3">
                            <TextBlock
                                Margin="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{Binding PhLowVoltageText}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Margin="5" Orientation="Horizontal">
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="16" Text="退出ATP模式：" />
                        <TextBlock Margin="0,0,0,0" VerticalAlignment="Center" FontSize="14" Text="TX" />
                        <Border Width="80" Height="28" Margin="5,0,0,0" VerticalAlignment="Center" Background="AliceBlue" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                            <TextBlock Margin="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" Text="{Binding TestTxChannel}" />
                        </Border>

                        <Border
                            Width="220"
                            Height="28"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Background="AliceBlue"
                            BorderBrush="#D9D9D9"
                            BorderThickness="1"
                            CornerRadius="3">
                            <TextBlock
                                Margin="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="0x00 02 00 01 00 00 00 01" />
                        </Border>
                        <Button
                            Width="50"
                            Height="28"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding SendExitAtpCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="#3b82f6"
                                        CornerRadius="4">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock
                                                x:Name="DeviceAction"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Foreground="White"
                                                Text="发送" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                            <Setter Property="Cursor" Value="Arrow" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Margin="115,5,5,5" Orientation="Horizontal">
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" Text="RX" />
                        <Border Width="80" Height="28" Margin="5,0,0,0" VerticalAlignment="Center" Background="AliceBlue" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                            <TextBlock Margin="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" Text="{Binding TestRxChannel}" />
                        </Border>

                        <Border
                            Width="220"
                            Height="28"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Background="LightYellow"
                            BorderBrush="#D9D9D9"
                            BorderThickness="1"
                            CornerRadius="3">
                            <TextBlock
                                Margin="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{Binding ExitAtpRxDataText}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Margin="8,4,8,8"
            Background="White"
            BorderBrush="#D9D9D9"
            BorderThickness="1.5"
            CornerRadius="8">
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.5*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold">
                    <Run Text="测试结果：" />
                    <Run Text=" " />
                    <Run Text="{Binding LastTestResult, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />
                    <Run Text=" " />
                    <Run Text="{Binding LastTestTime, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />
                </TextBlock>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Bold">
                        <Run Text="上次测试时间：" />
                        <Run Text="{Binding PreviousTestTime, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />
                    </TextBlock>
                    <TextBlock
                        Grid.Column="1"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Bold">
                        <Run Text="上次测试结果：" />
                        <Run Text="{Binding PreviousTestResult, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
