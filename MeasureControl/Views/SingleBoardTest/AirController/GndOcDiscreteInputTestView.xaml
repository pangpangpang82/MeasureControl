                                <Border
                                    x:Name="border"
                                    Background="#22c55e"
                                    CornerRadius="6">
                                    <StackPanel Orientation="Horizontal">
                                        <Image
                                            Width="15"
                                            Height="15"
                                            Margin="5,0,5,0"
