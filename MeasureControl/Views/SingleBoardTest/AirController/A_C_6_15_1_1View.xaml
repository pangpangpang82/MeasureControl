                                    </Button.Template>
                                </Button>

                            </Grid>

                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="16" Text="0%PWM：" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" FontSize="14" Text="TX" />
                                <Border Width="100" Height="28" Margin="5,0,0,0" VerticalAlignment="Center" Background="AliceBlue" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock Margin="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="{Binding TestTxChannel}" />
                                </Border>
                                <Border Width="180" Height="28" Margin="10,0,0,0" VerticalAlignment="Center" Background="AliceBlue" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock Margin="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="0x21 03 04 01 00 00 00 00" />
                                </Border>
                                <Button Width="50" Height="28" Margin="15,0,0,0" VerticalAlignment="Center" BorderThickness="0" Command="{Binding SendPwm0Command}" IsEnabled="{Binding IsManualTestRunning}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="#3b82f6" CornerRadius="4">
                                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="White" Text="发送" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.RowSpan="3" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="16" Text="输出波形：" />
                            <Grid Grid.Row="1" Grid.Column="1" Grid.RowSpan="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width=" auto"/>
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" FontSize="14" Text="有效值(V)" />
                                        <Border Width="90" Height="28" Margin="8,0,0,0" VerticalAlignment="Center" Background="LightYellow" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                            <TextBlock Margin="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="{Binding Pwm0VrmsText, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock VerticalAlignment="Center" FontSize="14" Text="电压(V)" />
                                        <Border Width="90" Height="28" Margin="8,0,0,0" VerticalAlignment="Center" Background="LightYellow" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                            <TextBlock Margin="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="{Binding Pwm0VmaxText, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="1" Width="50" Height="28" Margin="15,0,0,0" VerticalAlignment="Center" BorderThickness="0" Command="{Binding MeasurePwm0Command}" IsEnabled="{Binding IsManualTestRunning}" >
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="#22c55e" CornerRadius="4">
                                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="White" Text="测量" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#15803d" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#15803d" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                            </Grid>

                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="16" Text="退出ATP模式：" />

                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" FontSize="14" Text="TX" />
                                <Border Width="100" Height="28" Margin="5,0,0,0" VerticalAlignment="Center" Background="AliceBlue" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock Margin="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="{Binding TestTxChannel}" />
                                </Border>
                                <Border Width="180" Height="28" Margin="10,0,0,0" VerticalAlignment="Center" Background="AliceBlue" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock Margin="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="0x00 02 00 01 00 00 00 01" />
                                </Border>
                                <Button Width="50" Height="28" Margin="15,0,0,0" VerticalAlignment="Center" BorderThickness="0" Command="{Binding SendExitAtpCommand}" IsEnabled="{Binding IsManualTestRunning}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="#3b82f6" CornerRadius="4">
                                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                    <TextBlock x:Name="DeviceAction" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="White" Text="发送" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" FontSize="14" Text="RX" />
                                <Border Width="100" Height="28" Margin="5,0,0,0" VerticalAlignment="Center" Background="AliceBlue" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock Margin="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="{Binding TestRxChannel}" />
                                </Border>
                                <Border Width="180" Height="28" Margin="10,0,0,0" VerticalAlignment="Center" Background="AliceBlue" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock Margin="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="{Binding ExitAtpRxDataText, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />
                                </Border>
                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </ScrollViewer>



                <StackPanel

                    Grid.Row="0"

                    Grid.Column="2"

                    Margin="0,0,0,69"

                    Orientation="Horizontal"

                    Grid.RowSpan="2">

                    <TextBlock

                        VerticalAlignment="Center"

                        FontSize="22"

                        FontWeight="Bold"

                        Text="测试信息" />

                    <Button

                        Width="80"

                        Height="32"

                        Margin="80,0,0,0"

                        VerticalAlignment="Center"

                        BorderThickness="0"

                        Command="{Binding ClearLogCommand}">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border

                                    x:Name="border"

                                    Background="#3b82f6"

                                    CornerRadius="4">

                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                                        <TextBlock

                                            x:Name="DeviceAction"

                                            HorizontalAlignment="Center"

                                            VerticalAlignment="Center"

                                            FontSize="16"

                                            Foreground="White"

                                            Text="清除内容" />

                                    </StackPanel>

                                </Border>

                                <ControlTemplate.Triggers>

                                    <Trigger Property="IsMouseOver" Value="True">

                                        <Setter TargetName="border" Property="Background" Value="#1d4ed8" />

                                    </Trigger>

                                    <Trigger Property="IsPressed" Value="True">

                                        <Setter TargetName="border" Property="Background" Value="#1d4ed8" />

                                    </Trigger>

                                    <Trigger Property="IsEnabled" Value="False">

                                        <Setter TargetName="border" Property="Background" Value="#9ca3af" />

                                        <Setter Property="Cursor" Value="Arrow" />

                                    </Trigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                </StackPanel>



                <Border

                    Grid.Row="1"

                    Grid.Column="2"

                    Grid.RowSpan="5"

                    Width="350"

                    Height="350"

                    HorizontalAlignment="Center"

                    VerticalAlignment="Center"

                    BorderBrush="#D9D9D9"

                    BorderThickness="1.5"

                    CornerRadius="4">

                    <ListBox

                        Margin="0"

                        BorderThickness="0"

                        ItemsSource="{Binding Logs}"

                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"

                        ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListBox.Resources>

                            <Style TargetType="ScrollViewer" BasedOn="{StaticResource SimpleScrollViewerStyle}" />

                        </ListBox.Resources>

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <TextBlock

                                    FontSize="12"

                                    Text="{Binding}"

                                    TextWrapping="Wrap" />

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </Border>

            </Grid>

        </Border>



        <Border

            Grid.Row="2"

            Margin="8,4,8,8"

            Background="White"

            BorderBrush="#D9D9D9"

            BorderThickness="1.5"

            CornerRadius="8">

            <Grid Grid.Row="2">

                <Grid.RowDefinitions>

                    <RowDefinition Height="1.5*" />

                    <RowDefinition Height="*" />

                </Grid.RowDefinitions>

                <TextBlock

                    Grid.Row="0"

                    Margin="10,0,0,0"

                    VerticalAlignment="Center"

                    FontSize="18"

                    FontWeight="Bold">

                    <Run Text="测试结果：" />

                    <Run Text=" " />

                    <Run Text="{Binding LastTestResult, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />

                    <Run Text=" " />

                    <Run Text="{Binding LastTestTime, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />

                </TextBlock>

                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition />

                        <ColumnDefinition />

                    </Grid.ColumnDefinitions>

                    <TextBlock

                        Grid.Column="0"

                        Margin="20,0,0,0"

                        VerticalAlignment="Center"

                        FontSize="14"

                        FontWeight="Bold">

                        <Run Text="上次测试时间：" />

                        <Run Text="{Binding PreviousTestTime, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />

                    </TextBlock>

                    <TextBlock

                        Grid.Column="1"

                        Margin="20,0,0,0"

                        VerticalAlignment="Center"

                        FontSize="14"

                        FontWeight="Bold">

                        <Run Text="上次测试结果：" />

                        <Run Text="{Binding PreviousTestResult, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />

                    </TextBlock>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</UserControl>
