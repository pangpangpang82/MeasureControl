                                </Border>
                                <Border Width="180" Height="28" Margin="10,0,0,0" VerticalAlignment="Center" Background="AliceBlue" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock Margin="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="0x21 03 04 03 00 00 00 00" />
                                </Border>
                                <Button Width="50" Height="28" Margin="15,0,0,0" VerticalAlignment="Center" BorderThickness="0" Command="{Binding SendPwm100Command}" IsEnabled="{Binding IsManualTestRunning}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="#3b82f6" CornerRadius="4">
                                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="White" Text="发送" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.RowSpan="3" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="16" Text="输出波形：" />
                            <Grid Grid.Row="1" Grid.Column="1" Grid.RowSpan="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width=" auto"/>
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" FontSize="14" Text="有效值(V)" />
                                        <Border Width="90" Height="28" Margin="8,0,0,0" VerticalAlignment="Center" Background="LightYellow" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                            <TextBlock Margin="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="{Binding Pwm100VrmsText, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock VerticalAlignment="Center" FontSize="14" Text="电压(V)" />
                                        <Border Width="90" Height="28" Margin="8,0,0,0" VerticalAlignment="Center" Background="LightYellow" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                            <TextBlock Margin="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="{Binding Pwm100VmaxText, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="1" Width="50" Height="28" Margin="15,0,0,0" VerticalAlignment="Center" BorderThickness="0" Command="{Binding MeasurePwm100Command}" IsEnabled="{Binding IsManualTestRunning}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="#22c55e" CornerRadius="4">
                                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="White" Text="测量" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#15803d" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#15803d" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                            </Grid>

                        </Grid>

                        <Grid Margin="0,6,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="16" Text="50%PWM：" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" FontSize="14" Text="TX" />
                                <Border Width="100" Height="28" Margin="5,0,0,0" VerticalAlignment="Center" Background="AliceBlue" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock Margin="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="{Binding TestTxChannel}" />
                                </Border>
                                <Border Width="180" Height="28" Margin="10,0,0,0" VerticalAlignment="Center" Background="AliceBlue" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock Margin="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="0x21 03 04 02 00 00 00 00" />
                                </Border>
                                <Button Width="50" Height="28" Margin="15,0,0,0" VerticalAlignment="Center" BorderThickness="0" Command="{Binding SendPwm50Command}" IsEnabled="{Binding IsManualTestRunning}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="#3b82f6" CornerRadius="4">
                                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="White" Text="发送" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.RowSpan="4" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="16" Text="输出波形：" />
                            <Grid Grid.Row="1" Grid.Column="1" Grid.RowSpan="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width=" auto"/>
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" FontSize="14" Text="有效值(V)" />
                                        <Border Width="90" Height="28" Margin="8,0,0,0" VerticalAlignment="Center" Background="LightYellow" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                            <TextBlock Margin="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="{Binding Pwm50VrmsText, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock VerticalAlignment="Center" FontSize="14" Text="电压(V)" />
                                        <Border Width="90" Height="28" Margin="8,0,0,0" VerticalAlignment="Center" Background="LightYellow" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                            <TextBlock Margin="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="{Binding Pwm50VmaxText, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock VerticalAlignment="Center" FontSize="14" Text="占空比(%)" />
                                        <Border Width="90" Height="28" Margin="8,0,0,0" VerticalAlignment="Center" Background="LightYellow" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                            <TextBlock Margin="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="{Binding Pwm50DutyPctText, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="1" Width="50" Height="28" Margin="15,0,0,0" VerticalAlignment="Center" BorderThickness="0" Command="{Binding MeasurePwm50Command}" IsEnabled="{Binding IsManualTestRunning}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="#22c55e" CornerRadius="4">
                                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="White" Text="测量" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#15803d" />
