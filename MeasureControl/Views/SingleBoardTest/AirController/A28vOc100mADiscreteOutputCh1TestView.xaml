<UserControl
    x:Class="MeasureControl.Views.SingleBoardTest.AirController.A28vOc100mADiscreteOutputCh1TestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    mc:Ignorable="d">

    <UserControl.Resources>
        <x:Array x:Key="Arinc429Channels" Type="sys:String">
            <sys:String>CH0</sys:String>
            <sys:String>CH1</sys:String>
            <sys:String>CH2</sys:String>
            <sys:String>CH3</sys:String>
            <sys:String>CH4</sys:String>
            <sys:String>CH5</sys:String>
            <sys:String>CH6</sys:String>
            <sys:String>CH7</sys:String>
            <sys:String>CH8</sys:String>
            <sys:String>CH9</sys:String>
            <sys:String>CH10</sys:String>
            <sys:String>CH11</sys:String>
            <sys:String>CH12</sys:String>
            <sys:String>CH13</sys:String>
            <sys:String>CH14</sys:String>
            <sys:String>CH15</sys:String>
        </x:Array>

        <Style x:Key="PrimaryBlueButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3b82f6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563eb" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="8,8,8,4"
            Background="White"
            BorderBrush="#D9D9D9"
            BorderThickness="1.5"
            CornerRadius="8">
            <Grid>
                <TextBlock
                    Width="520"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="24"
                    FontWeight="Bold"
                    Text="{Binding PageTitle}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Width="100"
                        Height="32"
                        Margin="0,0,20,0"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        Command="{Binding ManualTestCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#3b82f6" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsManualTestRunning}" Value="True">
                                        <Setter Property="Background" Value="#ef4444" />
                                        <Setter Property="Content" Value="停止测试" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsManualTestRunning}" Value="False">
                                        <Setter Property="Content" Value="手动测试" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button
                        Width="100"
                        Height="32"
                        Margin="0,0,30,0"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        Command="{Binding AutoTestCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#22c55e" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAutoTestRunning}" Value="True">
                                        <Setter Property="Background" Value="#ef4444" />
                                        <Setter Property="Content" Value="停止测试" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAutoTestRunning}" Value="False">
                                        <Setter Property="Content" Value="自动测试" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Margin="10" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" FontSize="20" FontWeight="Bold" Text="测试步骤" />

                        <Grid Grid.Row="1" Margin="0,14,0,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="16" Text="1.进入ATP模式：" />

                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Width="22" VerticalAlignment="Center" FontSize="14" Text="TX" />
                                    <ComboBox
                                        Width="90"
                                        Height="28"
                                        Margin="5,0,0,0"
                                        IsEnabled="False"
                                        ItemsSource="{StaticResource Arinc429Channels}"
                                        SelectedItem="{Binding EnterAtpTxChannelDisplay, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Margin="0,6,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Width="22" VerticalAlignment="Center" FontSize="14" Text="RX" />
                                    <ComboBox
                                        Width="90"
                                        Height="28"
                                        Margin="5,0,0,0"
                                        IsEnabled="False"
                                        ItemsSource="{StaticResource Arinc429Channels}"
                                        SelectedItem="{Binding EnterAtpRxChannelDisplay, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Column="3" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Height="28" VerticalAlignment="Center" Background="AliceBlue" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="0x00 01 00 01 00 00 00 00" />
                                </Border>

                                <Border Grid.Row="1" Height="28" Margin="0,6,0,0" VerticalAlignment="Center" Background="White" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="{Binding EnterAtpRxDataText}" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </Grid>

                            <Button
                                Grid.Column="5"
                                Width="90"
                                Height="28"
                                VerticalAlignment="Center"
                                Command="{Binding SendEnterAtpCommand}"
                                Content="发送"
                                Style="{StaticResource PrimaryBlueButtonStyle}" />
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,14,0,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="16" Text="2.输出28V信号(ACK)：" />

                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Width="22" VerticalAlignment="Center" FontSize="14" Text="TX" />
                                    <ComboBox
                                        Width="90"
                                        Height="28"
                                        Margin="5,0,0,0"
                                        IsEnabled="False"
                                        ItemsSource="{StaticResource Arinc429Channels}"
                                        SelectedItem="{Binding TestTxChannelDisplay, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Margin="0,6,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Width="22" VerticalAlignment="Center" FontSize="14" Text="RX" />
                                    <ComboBox
                                        Width="90"
                                        Height="28"
                                        Margin="5,0,0,0"
                                        IsEnabled="False"
                                        ItemsSource="{StaticResource Arinc429Channels}"
                                        SelectedItem="{Binding TestRxChannelDisplay, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Column="3" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Height="28" VerticalAlignment="Center" Background="AliceBlue" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="0x09 03 01 01 00 00 00 00" />
                                </Border>

                                <Border Grid.Row="1" Height="28" Margin="0,6,0,0" VerticalAlignment="Center" Background="White" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="{Binding Out28vAckRxDataText}" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </Grid>

                            <Button
                                Grid.Column="5"
                                Width="90"
                                Height="28"
                                VerticalAlignment="Center"
                                Command="{Binding SendOut28vCommand}"
                                Content="发送"
                                Style="{StaticResource PrimaryBlueButtonStyle}" />
                        </Grid>

                        <Grid Grid.Row="3" Margin="0,14,0,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="16" Text="3.上传离散和AD回采：" />

                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Width="22" VerticalAlignment="Center" FontSize="14" Text="TX" />
                                    <ComboBox
                                        Width="90"
                                        Height="28"
                                        Margin="5,0,0,0"
                                        IsEnabled="False"
                                        ItemsSource="{StaticResource Arinc429Channels}"
                                        SelectedItem="{Binding TestTxChannelDisplay, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Margin="0,6,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Width="22" VerticalAlignment="Center" FontSize="14" Text="RX" />
                                    <ComboBox
                                        Width="90"
                                        Height="28"
                                        Margin="5,0,0,0"
                                        IsEnabled="False"
                                        ItemsSource="{StaticResource Arinc429Channels}"
                                        SelectedItem="{Binding TestRxChannelDisplay, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Column="3" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Height="28" VerticalAlignment="Center" Background="AliceBlue" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="0x09 03 01 03 00 00 00 00" />
                                </Border>

                                <Border Grid.Row="1" Height="28" Margin="0,6,0,0" VerticalAlignment="Center" Background="White" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="{Binding Upload28vRxDataText}" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </Grid>

                            <Button
                                Grid.Column="5"
                                Width="90"
                                Height="28"
                                VerticalAlignment="Center"
                                Command="{Binding SendUpload28vCommand}"
                                Content="发送"
                                Style="{StaticResource PrimaryBlueButtonStyle}" />
                        </Grid>

                        <Grid Grid.Row="4" Margin="0,14,0,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="16" Text="4.输出OC信号(ACK)：" />

                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Width="22" VerticalAlignment="Center" FontSize="14" Text="TX" />
                                    <ComboBox
                                        Width="90"
                                        Height="28"
                                        Margin="5,0,0,0"
                                        IsEnabled="False"
                                        ItemsSource="{StaticResource Arinc429Channels}"
                                        SelectedItem="{Binding TestTxChannelDisplay, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Margin="0,6,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Width="22" VerticalAlignment="Center" FontSize="14" Text="RX" />
                                    <ComboBox
                                        Width="90"
                                        Height="28"
                                        Margin="5,0,0,0"
                                        IsEnabled="False"
                                        ItemsSource="{StaticResource Arinc429Channels}"
                                        SelectedItem="{Binding TestRxChannelDisplay, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Column="3" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Height="28" VerticalAlignment="Center" Background="AliceBlue" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="0x09 03 01 06 00 00 00 00" />
                                </Border>

                                <Border Grid.Row="1" Height="28" Margin="0,6,0,0" VerticalAlignment="Center" Background="White" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="{Binding OutOcAckRxDataText}" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </Grid>

                            <Button
                                Grid.Column="5"
                                Width="90"
                                Height="28"
                                VerticalAlignment="Center"
                                Command="{Binding SendOutOcCommand}"
                                Content="发送"
                                Style="{StaticResource PrimaryBlueButtonStyle}" />
                        </Grid>

                        <Grid Grid.Row="5" Margin="0,14,0,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="16" Text="5.上传离散回采：" />

                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Width="22" VerticalAlignment="Center" FontSize="14" Text="TX" />
                                    <ComboBox
                                        Width="90"
                                        Height="28"
                                        Margin="5,0,0,0"
                                        IsEnabled="False"
                                        ItemsSource="{StaticResource Arinc429Channels}"
                                        SelectedItem="{Binding TestTxChannelDisplay, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Margin="0,6,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Width="22" VerticalAlignment="Center" FontSize="14" Text="RX" />
                                    <ComboBox
                                        Width="90"
                                        Height="28"
                                        Margin="5,0,0,0"
                                        IsEnabled="False"
                                        ItemsSource="{StaticResource Arinc429Channels}"
                                        SelectedItem="{Binding TestRxChannelDisplay, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Column="3" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Height="28" VerticalAlignment="Center" Background="AliceBlue" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="0x09 03 01 08 00 00 00 00" />
                                </Border>

                                <Border Grid.Row="1" Height="28" Margin="0,6,0,0" VerticalAlignment="Center" Background="White" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="{Binding UploadOcRxDataText}" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </Grid>

                            <Button
                                Grid.Column="5"
                                Width="90"
                                Height="28"
                                VerticalAlignment="Center"
                                Command="{Binding SendUploadOcCommand}"
                                Content="发送"
                                Style="{StaticResource PrimaryBlueButtonStyle}" />
                        </Grid>

                        <Grid Grid.Row="6" Margin="0,14,0,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="16" Text="6.退出ATP模式：" />

                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Width="22" VerticalAlignment="Center" FontSize="14" Text="TX" />
                                    <ComboBox
                                        Width="90"
                                        Height="28"
                                        Margin="5,0,0,0"
                                        IsEnabled="False"
                                        ItemsSource="{StaticResource Arinc429Channels}"
                                        SelectedItem="{Binding ExitAtpTxChannelDisplay, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Margin="0,6,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Width="22" VerticalAlignment="Center" FontSize="14" Text="RX" />
                                    <ComboBox
                                        Width="90"
                                        Height="28"
                                        Margin="5,0,0,0"
                                        IsEnabled="False"
                                        ItemsSource="{StaticResource Arinc429Channels}"
                                        SelectedItem="{Binding ExitAtpRxChannelDisplay, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Column="3" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Height="28" VerticalAlignment="Center" Background="AliceBlue" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="0x00 02 00 01 00 00 00 01" />
                                </Border>

                                <Border Grid.Row="1" Height="28" Margin="0,6,0,0" VerticalAlignment="Center" Background="White" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="{Binding ExitAtpRxDataText}" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </Grid>

                            <Button
                                Grid.Column="5"
                                Width="90"
                                Height="28"
                                VerticalAlignment="Center"
                                Command="{Binding SendExitAtpCommand}"
                                Content="发送"
                                Style="{StaticResource PrimaryBlueButtonStyle}" />
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" Margin="10" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="16" FontWeight="Bold" Text="测试信息" />
                        <Button Width="90" Height="28" Margin="10,0,0,0" Command="{Binding ClearContentCommand}" Content="清除内容" />
                    </StackPanel>

                    <ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Logs}" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="10,0,10,10" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Text="测试结果：" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="16" Text="{Binding LastTestResult}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Text="上次测试时间：" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" Text="{Binding LastTestTime}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="Bold" Text="上次测试结果：" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" Text="{Binding LastTestResult}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
