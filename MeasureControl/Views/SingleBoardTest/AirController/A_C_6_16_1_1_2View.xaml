                                            <TextBlock
                                                Margin="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Text="{Binding FreqHzText, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                        <TextBlock
