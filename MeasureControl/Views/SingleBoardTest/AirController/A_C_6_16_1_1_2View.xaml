                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{Binding EnterAtpRxDataText, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />
                                </Border>
                            </StackPanel>

                        </Grid>

                        <Border
