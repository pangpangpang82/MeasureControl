                                        <Border
                                            Width="120"
                                            Height="28"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Background="LightYellow"
                                            BorderBrush="#D9D9D9"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                            <TextBlock
                                                Margin="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="12"
