                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Text="{Binding DutyPctText, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
