<UserControl
    x:Class="MeasureControl.Views.SingleBoardTest.AirController.S_C_8_11_3View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="550"
    d:DesignWidth="970"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ScrollBarStyles.xaml" />
                <ResourceDictionary Source="/Styles/ComboBoxStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        x:Name="RootGrid"
        Background="White"
        Focusable="True"
        PreviewMouseDown="RootGrid_PreviewMouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.9*" />
            <RowDefinition Height="6*" />
            <RowDefinition Height="1.2*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="8,8,8,4"
            Background="White"
            BorderBrush="#D9D9D9"
            BorderThickness="1.5"
            CornerRadius="8">
            <Grid>
                <TextBlock
                    Width="660"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="24"
                    FontWeight="Bold"
                    Text="8.11.3 S通道OFV/TRV直流电机驱动优先级控制测试" />

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Width="100"
                        Height="32"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        Command="{Binding ManualTestCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="#3b82f6" CornerRadius="6">
                                    <TextBlock
                                        x:Name="DeviceAction"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Foreground="White"
                                        Text="手动测试" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsManualTestRunning}" Value="True">
                                        <Setter Property="Tag" Value="True" />
                                        <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                        <Setter TargetName="DeviceAction" Property="Text" Value="停止测试" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsManualTestRunning}" Value="False">
                                        <Setter Property="Tag" Value="False" />
                                    </DataTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="False" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                    </MultiTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="False" />
                                            <Condition Property="IsPressed" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                    </MultiTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="True" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                    </MultiTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="True" />
                                            <Condition Property="IsPressed" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                    </MultiTrigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                        <Setter Property="Cursor" Value="Arrow" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button
                        Width="100"
                        Height="32"
                        Margin="0,0,20,0"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        Command="{Binding AutoTestCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="#22c55e" CornerRadius="6">
                                    <TextBlock
                                        x:Name="DeviceAction"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Foreground="White"
                                        Text="自动测试" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsAutoTestRunning}" Value="True">
                                        <Setter Property="Tag" Value="True" />
                                        <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                        <Setter TargetName="DeviceAction" Property="Text" Value="停止测试" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAutoTestRunning}" Value="False">
                                        <Setter Property="Tag" Value="False" />
                                    </DataTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="False" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#15803d" />
                                    </MultiTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="False" />
                                            <Condition Property="IsPressed" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#15803d" />
                                    </MultiTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="True" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                    </MultiTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="True" />
                                            <Condition Property="IsPressed" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                    </MultiTrigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                        <Setter Property="Cursor" Value="Arrow" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Margin="8,4,8,4"
            Background="White"
            BorderBrush="#D9D9D9"
            BorderThickness="1.5"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <ScrollViewer
                    Grid.Column="0"
                    Margin="10"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Margin="0,0,0,8" FontSize="20" FontWeight="Bold" Text="测试步骤" />

                        <Border
                            x:Name="StepsPanel"
                            Margin="0,0,0,10"
                            Background="White"
                            BorderBrush="#D9D9D9"
                            BorderThickness="1.5"
                            CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="223" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="30" />
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Border Grid.Row="0" Grid.ColumnSpan="4" Background="#f3f4f6" CornerRadius="8,8,0,0" />
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Text="序号" Height="18" Width="28" />
                                <TextBlock Grid.Column="1" Margin="20,0,0,0" HorizontalAlignment="Center"  VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Text="测试步骤" Height="18" Width="56" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Text="操作" Height="18" Width="28" />
                                <TextBlock Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Text="结果" Height="18" Width="28" />

                                <!-- Step 1 -->
                                <Border Grid.Row="1" Grid.ColumnSpan="4" Background="White" />
                                <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Text="(1)" Height="18" Width="18" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" FontSize="14" Text="手动开测试（EN为1，PH为0）" Height="18" />
                                <Button Grid.Row="1" Grid.Column="2" Width="70" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="0" Command="{Binding Step1TestCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="#3b82f6" CornerRadius="6">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="White" Text="测试" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock Grid.Row="1" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Text="{Binding Step1Result, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" Height="18" Width="50" />

                                <!-- Step 1 Details -->
                                <Border Grid.Row="2" Grid.ColumnSpan="4" Background="#fdfdfd" BorderBrush="#f3f4f6" BorderThickness="0,1,0,0" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0" Height="22">
                                    <TextBlock Text="J8:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" Foreground="#666"/>
                                    <Border Width="60" Height="22" Background="#f3f4f6" CornerRadius="4" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding J8Voltage}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                                    </Border>

                                    <TextBlock Text="J9:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" Foreground="#666"/>
                                    <Border Width="60" Height="22" Background="#f3f4f6" CornerRadius="4" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding J9Voltage}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                                    </Border>

                                    <TextBlock Text="输出:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" Foreground="#666"/>
                                    <Border Width="60" Height="22" Background="#f3f4f6" CornerRadius="4" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding OutVoltage}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                                    </Border>

                                    <TextBlock Text="EN:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" Foreground="#666"/>
                                    <Border Width="30" Height="25" Background="#f3f4f6" CornerRadius="4" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding EnValue}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                                    </Border>

                                    <TextBlock Text="PH:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" Foreground="#666"/>
                                    <Border Width="30" Height="25" Background="#f3f4f6" CornerRadius="4" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding PhValue}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                                    </Border>
                                </StackPanel>

                                <!-- Step 2 -->
                                <Border Grid.Row="3" Grid.ColumnSpan="4" Background="#f9fafb" />
                                <TextBlock Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Text="(2)" Height="18" Width="18" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" FontSize="14" Text="制动测试（EN为0，PH为1）" Height="18" />
                                <Button Grid.Row="3" Grid.Column="2" Width="70" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="0" Command="{Binding Step2TestCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="#3b82f6" CornerRadius="6">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="White" Text="测试" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock Grid.Row="3" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Text="{Binding Step2Result, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" Height="18" Width="50" />

                                <!-- Step 2 Details -->
                                <Border Grid.Row="4" Grid.ColumnSpan="4" Background="#fdfdfd" BorderBrush="#f3f4f6" BorderThickness="0,1,0,0" />
                                <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0" Height="22">
                                    <TextBlock Text="J8:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" Foreground="#666"/>
                                    <Border Width="60" Height="22" Background="#f3f4f6" CornerRadius="4" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Step2J8Voltage}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                                    </Border>

                                    <TextBlock Text="J9:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" Foreground="#666"/>
                                    <Border Width="60" Height="22" Background="#f3f4f6" CornerRadius="4" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Step2J9Voltage}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                                    </Border>

                                    <TextBlock Text="输出:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" Foreground="#666"/>
                                    <Border Width="60" Height="22" Background="#f3f4f6" CornerRadius="4" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Step2OutVoltage}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                                    </Border>

                                    <TextBlock Text="EN:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" Foreground="#666"/>
                                    <Border Width="30" Height="25" Background="#f3f4f6" CornerRadius="4" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Step2EnValue}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                                    </Border>

                                    <TextBlock Text="PH:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" Foreground="#666"/>
                                    <Border Width="30" Height="25" Background="#f3f4f6" CornerRadius="4" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Step2PhValue}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                                    </Border>
                                </StackPanel>

                                <!-- Step 3 -->
                                <Border Grid.Row="5" Grid.ColumnSpan="4" Background="White" />
                                <TextBlock Grid.Row="5" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Text="(3)" Height="18" Width="18" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" FontSize="14" Text="闭合强开测试（闭合DO3）" Height="18" />
                                <Button Grid.Row="5" Grid.Column="2" Width="70" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="0" Command="{Binding Step3TestCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="#3b82f6" CornerRadius="6">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="White" Text="测试" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock Grid.Row="5" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Text="{Binding Step3Result, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" Height="18" Width="50" />

                                <!-- Step 3 Details -->
                                <Border Grid.Row="6" Grid.ColumnSpan="4" Background="#fdfdfd" BorderBrush="#f3f4f6" BorderThickness="0,1,0,0" />
                                <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0" Height="22">
                                    <TextBlock Text="J8:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" Foreground="#666"/>
                                    <Border Width="60" Height="22" Background="#f3f4f6" CornerRadius="4" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Step3J8Voltage}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                                    </Border>

                                    <TextBlock Text="J9:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" Foreground="#666"/>
                                    <Border Width="60" Height="22" Background="#f3f4f6" CornerRadius="4" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Step3J9Voltage}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                                    </Border>

                                    <TextBlock Text="输出:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" Foreground="#666"/>
                                    <Border Width="60" Height="22" Background="#f3f4f6" CornerRadius="4" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Step3OutVoltage}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                                    </Border>

                                    <TextBlock Text="离散回采:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" Foreground="#666"/>
                                    <Border Width="60" Height="25" Background="#f3f4f6" CornerRadius="4" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Step3DiscreteFb}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                                    </Border>
                                </StackPanel>

                                <!-- Step 4 -->
                                <Border Grid.Row="7" Grid.ColumnSpan="4" Background="#f9fafb" />
                                <TextBlock Grid.Row="7" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Text="(4)" Height="18" Width="18" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" FontSize="14" Text="强关测试（发送强关指令）" Height="18" />
                                <Button Grid.Row="7" Grid.Column="2" Width="70" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="0" Command="{Binding Step4TestCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="#3b82f6" CornerRadius="6">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="White" Text="测试" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock Grid.Row="7" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Text="{Binding Step4Result, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" Height="18" Width="50" />

                                <!-- Step 4 Details -->
                                <Border Grid.Row="8" Grid.ColumnSpan="4" Background="#fdfdfd" BorderBrush="#f3f4f6" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" />
                                <StackPanel Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0" Height="22">
                                    <TextBlock Text="J8:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" Foreground="#666"/>
                                    <Border Width="60" Height="22" Background="#f3f4f6" CornerRadius="4" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Step4J8Voltage}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                                    </Border>

                                    <TextBlock Text="J9:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" Foreground="#666"/>
                                    <Border Width="60" Height="22" Background="#f3f4f6" CornerRadius="4" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Step4J9Voltage}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                                    </Border>

                                    <TextBlock Text="输出:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" Foreground="#666"/>
                                    <Border Width="60" Height="22" Background="#f3f4f6" CornerRadius="4" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Step4OutVoltage}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Margin="10,10,10,0"
                        Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="22"
                            FontWeight="Bold"
                            Text="测试信息" />
                        <Button
                            Width="80"
                            Height="32"
                            Margin="80,0,0,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding ClearLogCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="#3b82f6" CornerRadius="4">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="White"
                                            Text="清除内容" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                            <Setter Property="Cursor" Value="Arrow" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <Border
                        Grid.Row="1"
                        Width="350"
                        Height="350"
                        Margin="0,0,5,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BorderBrush="#D9D9D9"
                        BorderThickness="1.5"
                        CornerRadius="4">
                        <ListBox
                            Margin="5"
                            BorderThickness="0"
                            ItemsSource="{Binding Logs}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Margin="8,4,8,8"
            Background="White"
            BorderBrush="#D9D9D9"
            BorderThickness="1.5"
            CornerRadius="8">
            <Grid>
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold">
                    <Run Text="测试结果：" />
                    <Run Text=" " />
                    <Run Text="{Binding OverallResult, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />
                    <Run Text=" " />
                    <Run Text="{Binding LastTestTime, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
