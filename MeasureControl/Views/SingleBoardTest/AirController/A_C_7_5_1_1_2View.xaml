<UserControl
    x:Class="MeasureControl.Views.SingleBoardTest.AirController.A_C_7_5_1_1_2View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="550"
    d:DesignWidth="970"
    mc:Ignorable="d">

	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Styles/ScrollBarStyles.xaml" />
				<ResourceDictionary Source="/Styles/ComboBoxStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>

	<Grid
        x:Name="RootGrid"
        Background="White"
        Focusable="True"
        PreviewMouseDown="RootGrid_PreviewMouseDown">
		<Grid.RowDefinitions>
			<RowDefinition Height="0.9*" />
			<RowDefinition Height="6*" />
			<RowDefinition Height="1.2*" />
		</Grid.RowDefinitions>

		<Border
            Grid.Row="0"
            Margin="8,8,8,4"
            Background="White"
            BorderBrush="#D9D9D9"
            BorderThickness="1.5"
            CornerRadius="8">
			<Grid>
				<TextBlock
                    Width="720"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="24"
                    FontWeight="Bold"
                    Text="7.5.1.1.2 A控制通道功率板FAV力矩电机驱动模块测试" />

				<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
					<Button
                        Width="100"
                        Height="32"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        Command="{Binding ManualTestCommand}">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Border x:Name="border" Background="#3b82f6" CornerRadius="6">
									<TextBlock
                                        x:Name="DeviceAction"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Foreground="White"
                                        Text="手动测试" />
								</Border>
								<ControlTemplate.Triggers>
									<DataTrigger Binding="{Binding IsManualTestRunning}" Value="True">
										<Setter Property="Tag" Value="True" />
										<Setter TargetName="border" Property="Background" Value="#ef4444" />
										<Setter TargetName="DeviceAction" Property="Text" Value="停止测试" />
									</DataTrigger>
									<DataTrigger Binding="{Binding IsManualTestRunning}" Value="False">
										<Setter Property="Tag" Value="False" />
									</DataTrigger>
									<MultiTrigger>
										<MultiTrigger.Conditions>
											<Condition Property="Tag" Value="False" />
											<Condition Property="IsMouseOver" Value="True" />
										</MultiTrigger.Conditions>
										<Setter TargetName="border" Property="Background" Value="#2563eb" />
									</MultiTrigger>
									<MultiTrigger>
										<MultiTrigger.Conditions>
											<Condition Property="Tag" Value="False" />
											<Condition Property="IsPressed" Value="True" />
										</MultiTrigger.Conditions>
										<Setter TargetName="border" Property="Background" Value="#2563eb" />
									</MultiTrigger>
									<MultiTrigger>
										<MultiTrigger.Conditions>
											<Condition Property="Tag" Value="True" />
											<Condition Property="IsMouseOver" Value="True" />
										</MultiTrigger.Conditions>
										<Setter TargetName="border" Property="Background" Value="#b91c1c" />
									</MultiTrigger>
									<MultiTrigger>
										<MultiTrigger.Conditions>
											<Condition Property="Tag" Value="True" />
											<Condition Property="IsPressed" Value="True" />
										</MultiTrigger.Conditions>
										<Setter TargetName="border" Property="Background" Value="#b91c1c" />
									</MultiTrigger>
									<Trigger Property="IsEnabled" Value="False">
										<Setter TargetName="border" Property="Background" Value="#9ca3af" />
										<Setter Property="Cursor" Value="Arrow" />
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Button.Template>
					</Button>

					<Button
                        Width="100"
                        Height="32"
                        Margin="0,0,20,0"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        Command="{Binding AutoTestCommand}">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Border x:Name="border" Background="#22c55e" CornerRadius="6">
									<TextBlock
                                        x:Name="DeviceAction"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Foreground="White"
                                        Text="自动测试" />
								</Border>
								<ControlTemplate.Triggers>
									<DataTrigger Binding="{Binding IsAutoTestRunning}" Value="True">
										<Setter Property="Tag" Value="True" />
										<Setter TargetName="border" Property="Background" Value="#ef4444" />
										<Setter TargetName="DeviceAction" Property="Text" Value="停止测试" />
									</DataTrigger>
									<DataTrigger Binding="{Binding IsAutoTestRunning}" Value="False">
										<Setter Property="Tag" Value="False" />
									</DataTrigger>
									<MultiTrigger>
										<MultiTrigger.Conditions>
											<Condition Property="Tag" Value="False" />
											<Condition Property="IsMouseOver" Value="True" />
										</MultiTrigger.Conditions>
										<Setter TargetName="border" Property="Background" Value="#15803d" />
									</MultiTrigger>
									<MultiTrigger>
										<MultiTrigger.Conditions>
											<Condition Property="Tag" Value="False" />
											<Condition Property="IsPressed" Value="True" />
										</MultiTrigger.Conditions>
										<Setter TargetName="border" Property="Background" Value="#15803d" />
									</MultiTrigger>
									<MultiTrigger>
										<MultiTrigger.Conditions>
											<Condition Property="Tag" Value="True" />
											<Condition Property="IsMouseOver" Value="True" />
										</MultiTrigger.Conditions>
										<Setter TargetName="border" Property="Background" Value="#b91c1c" />
									</MultiTrigger>
									<MultiTrigger>
										<MultiTrigger.Conditions>
											<Condition Property="Tag" Value="True" />
											<Condition Property="IsPressed" Value="True" />
										</MultiTrigger.Conditions>
										<Setter TargetName="border" Property="Background" Value="#b91c1c" />
									</MultiTrigger>
									<Trigger Property="IsEnabled" Value="False">
										<Setter TargetName="border" Property="Background" Value="#9ca3af" />
										<Setter Property="Cursor" Value="Arrow" />
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Button.Template>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<Border
            Grid.Row="1"
            Margin="8,4,8,4"
            Background="White"
            BorderBrush="#D9D9D9"
            BorderThickness="1.5"
            CornerRadius="8">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="1.4*" />
					<ColumnDefinition Width="1*" />
				</Grid.ColumnDefinitions>

				<ScrollViewer
                    Grid.Column="0"
                    Margin="10"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
					<StackPanel>
						<TextBlock Margin="0,0,0,8" FontSize="20" FontWeight="Bold" Text="测试步骤" />

						<Border
                            Margin="0,0,0,10"
                            Background="White"
                            BorderBrush="#D9D9D9"
                            BorderThickness="1.5"
                            CornerRadius="8">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="60" />
									<ColumnDefinition Width="230" />
									<ColumnDefinition Width="240" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="40" />
									<RowDefinition Height="40" />
									<RowDefinition Height="40" />
									<RowDefinition Height="40" />
									<RowDefinition Height="40" />
									<RowDefinition Height="40" />
									<RowDefinition Height="40" />
									<RowDefinition Height="40" />
								</Grid.RowDefinitions>

								<Border Grid.Row="0" Grid.ColumnSpan="3" Background="#f3f4f6" CornerRadius="8,8,0,0" />
								<TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" FontWeight="Bold" Text="序号" />
								<TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14" FontWeight="Bold" Text="测试步骤" Margin="67,0,0,0" />
								<TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" FontWeight="Bold" Text="操作/结果" />

								<Border Grid.Row="1" Grid.ColumnSpan="3" Background="White" />
								<TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Text="(1)" />
								<TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="40,0,0,0" FontSize="14" Text="外部接入40±1Ω负载" />


								<Border Grid.Row="2" Grid.ColumnSpan="3" Background="#f9fafb" />
								<TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Text="(2)" />
								<TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="40,0,0,0" FontSize="14" Text="输出0mA电流" />
								<Grid Grid.Row="2" Grid.Column="2">
									<Button Width="70" Height="30" VerticalAlignment="Center" HorizontalAlignment="Center" BorderThickness="0" Command="{Binding Step2Set0mACommand}">
										<Button.Template>
											<ControlTemplate TargetType="Button">
												<Border x:Name="border" Background="#3b82f6" CornerRadius="6">
													<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="White" Text="发送" />
												</Border>
												<ControlTemplate.Triggers>
													<Trigger Property="IsMouseOver" Value="True">
														<Setter TargetName="border" Property="Background" Value="#2563eb" />
													</Trigger>
													<Trigger Property="IsPressed" Value="True">
														<Setter TargetName="border" Property="Background" Value="#2563eb" />
													</Trigger>
												</ControlTemplate.Triggers>
											</ControlTemplate>
										</Button.Template>
									</Button>
								</Grid>

								<Border Grid.Row="3" Grid.ColumnSpan="3" Background="White" />
								<TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Text="(3)" />
								<TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="40,0,0,0" FontSize="14" Text="测量负载两端电压" />
								<Grid Grid.Row="3" Grid.Column="2">
									<Button Width="70" Height="30" VerticalAlignment="Center" HorizontalAlignment="Left" BorderThickness="0" Command="{Binding Step3Measure0mACommand}" Margin="37,0,0,0">
										<Button.Template>
											<ControlTemplate TargetType="Button">
												<Border x:Name="border" Background="#22c55e" CornerRadius="6">
													<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="White" Text="测量" />
												</Border>
												<ControlTemplate.Triggers>
													<DataTrigger Binding="{Binding IsMeasuringStep3}" Value="True">
														<Setter TargetName="border" Property="Background" Value="#ef4444" />
													</DataTrigger>
													<MultiDataTrigger>
														<MultiDataTrigger.Conditions>
															<Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
															<Condition Binding="{Binding IsMeasuringStep3}" Value="False" />
														</MultiDataTrigger.Conditions>
														<Setter TargetName="border" Property="Background" Value="#15803d" />
													</MultiDataTrigger>
												</ControlTemplate.Triggers>
											</ControlTemplate>
										</Button.Template>
									</Button>
									<Border Width="90" Height="30" Margin="129,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Background="#f3f4f6" CornerRadius="4">
										<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="{Binding Step3Voltage, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />
									</Border>
								</Grid>

								<Border Grid.Row="4" Grid.ColumnSpan="3" Background="#f9fafb" />
								<TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Text="(4)" />
								<TextBlock Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Margin="40,0,0,0" FontSize="14" Text="读取回采电流" />
								<Grid Grid.Row="4" Grid.Column="2">
									<Button Width="70" Height="30" VerticalAlignment="Center" HorizontalAlignment="Left" BorderThickness="0" Command="{Binding Step4Readback0mACommand}" Margin="36,0,0,0">
										<Button.Template>
											<ControlTemplate TargetType="Button">
												<Border x:Name="border" Background="#3b82f6" CornerRadius="6">
													<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="White" Text="回采" />
												</Border>
												<ControlTemplate.Triggers>
													<Trigger Property="IsMouseOver" Value="True">
														<Setter TargetName="border" Property="Background" Value="#2563eb" />
													</Trigger>
													<Trigger Property="IsPressed" Value="True">
														<Setter TargetName="border" Property="Background" Value="#2563eb" />
													</Trigger>
												</ControlTemplate.Triggers>
											</ControlTemplate>
										</Button.Template>
									</Button>
									<Border Width="90" Height="30" Margin="130,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Background="#f3f4f6" CornerRadius="4">
										<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="{Binding Step4Current, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />
									</Border>
								</Grid>

								<Border Grid.Row="5" Grid.ColumnSpan="3" Background="White" />
								<TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Text="(5)" />
								<TextBlock Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" Margin="40,0,0,0" FontSize="14" Text="输出400mA电流" />
								<Grid Grid.Row="5" Grid.Column="2">
									<Button Width="70" Height="30" VerticalAlignment="Center" HorizontalAlignment="Left" BorderThickness="0" Command="{Binding Step6Set400mACommand}" Margin="83,0,0,0">
										<Button.Template>
											<ControlTemplate TargetType="Button">
												<Border x:Name="border" Background="#3b82f6" CornerRadius="6">
													<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="White" Text="发送" />
												</Border>
												<ControlTemplate.Triggers>
													<Trigger Property="IsMouseOver" Value="True">
														<Setter TargetName="border" Property="Background" Value="#2563eb" />
													</Trigger>
													<Trigger Property="IsPressed" Value="True">
														<Setter TargetName="border" Property="Background" Value="#2563eb" />
													</Trigger>
												</ControlTemplate.Triggers>
											</ControlTemplate>
										</Button.Template>
									</Button>
								</Grid>

								<Border Grid.Row="6" Grid.ColumnSpan="3" Background="#f9fafb" />
								<TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Text="(6)" />
								<TextBlock Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" Margin="40,0,0,0" FontSize="14" Text="测量负载两端电压" />
								<Grid Grid.Row="6" Grid.Column="2">
									<Button Width="70" Height="30" VerticalAlignment="Center" HorizontalAlignment="Left" BorderThickness="0" Command="{Binding Step7Measure400mACommand}" Margin="38,0,0,0">
										<Button.Template>
											<ControlTemplate TargetType="Button">
												<Border x:Name="border" Background="#22c55e" CornerRadius="6">
													<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="White" Text="测量" />
												</Border>
												<ControlTemplate.Triggers>
													<DataTrigger Binding="{Binding IsMeasuringStep7}" Value="True">
														<Setter TargetName="border" Property="Background" Value="#ef4444" />
													</DataTrigger>
													<MultiDataTrigger>
														<MultiDataTrigger.Conditions>
															<Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
															<Condition Binding="{Binding IsMeasuringStep7}" Value="False" />
														</MultiDataTrigger.Conditions>
														<Setter TargetName="border" Property="Background" Value="#15803d" />
													</MultiDataTrigger>
												</ControlTemplate.Triggers>
											</ControlTemplate>
										</Button.Template>
									</Button>
									<Border Width="90" Height="30" Margin="131,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Background="#f3f4f6" CornerRadius="4">
										<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="{Binding Step7Voltage, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />
									</Border>
								</Grid>

								<Border Grid.Row="7" Grid.ColumnSpan="3" Background="White" CornerRadius="0,0,8,8" />
								<TextBlock Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Text="(7)" />
								<TextBlock Grid.Row="7" Grid.Column="1" VerticalAlignment="Center" Margin="40,0,0,0" FontSize="14" Text="读取回采电流" />
								<Grid Grid.Row="7" Grid.Column="2">
									<Button Width="70" Height="30" VerticalAlignment="Center" HorizontalAlignment="Left" BorderThickness="0" Command="{Binding Step8Readback400mACommand}" Margin="40,0,0,0">
										<Button.Template>
											<ControlTemplate TargetType="Button">
												<Border x:Name="border" Background="#3b82f6" CornerRadius="6">
													<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="White" Text="回采" />
												</Border>
												<ControlTemplate.Triggers>
													<Trigger Property="IsMouseOver" Value="True">
														<Setter TargetName="border" Property="Background" Value="#2563eb" />
													</Trigger>
													<Trigger Property="IsPressed" Value="True">
														<Setter TargetName="border" Property="Background" Value="#2563eb" />
													</Trigger>
												</ControlTemplate.Triggers>
											</ControlTemplate>
										</Button.Template>
									</Button>
									<Border Width="90" Height="30" Margin="132,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Background="#f3f4f6" CornerRadius="4">
										<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="{Binding Step8Current, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />
									</Border>
								</Grid>
							</Grid>
						</Border>
					</StackPanel>
				</ScrollViewer>

				<Grid Grid.Column="1">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<StackPanel
                        Grid.Row="0"
                        Margin="10,10,10,0"
                        Orientation="Horizontal">
						<TextBlock
                            VerticalAlignment="Center"
                            FontSize="22"
                            FontWeight="Bold"
                            Text="测试信息" />
						<Button
                            Width="80"
                            Height="32"
                            Margin="80,0,0,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding ClearLogCommand}">
							<Button.Template>
								<ControlTemplate TargetType="Button">
									<Border x:Name="border" Background="#3b82f6" CornerRadius="4">
										<TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="White"
                                            Text="清除内容" />
									</Border>
									<ControlTemplate.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter TargetName="border" Property="Background" Value="#1d4ed8" />
										</Trigger>
										<Trigger Property="IsPressed" Value="True">
											<Setter TargetName="border" Property="Background" Value="#1d4ed8" />
										</Trigger>
										<Trigger Property="IsEnabled" Value="False">
											<Setter TargetName="border" Property="Background" Value="#9ca3af" />
											<Setter Property="Cursor" Value="Arrow" />
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Button.Template>
						</Button>
					</StackPanel>

					<Border
                        Grid.Row="1"
                        Width="350"
                        Height="350"
                        Margin="0,0,5,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BorderBrush="#D9D9D9"
                        BorderThickness="1.5"
                        CornerRadius="4">
						<ListBox
                            Margin="5"
                            BorderThickness="0"
                            ItemsSource="{Binding Logs}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" />
					</Border>
				</Grid>
			</Grid>
		</Border>

		<Border
            Grid.Row="2"
            Margin="8,4,8,8"
            Background="White"
            BorderBrush="#D9D9D9"
            BorderThickness="1.5"
            CornerRadius="8">
			<Grid>
				<TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold">
                    <Run Text="测试结果：" />
                    <Run Text=" " />
                    <Run Text="{Binding OverallResult, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />
                    <Run Text=" " />
                    <Run Text="{Binding LastTestTime, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />
				</TextBlock>
			</Grid>
		</Border>
	</Grid>
</UserControl>
