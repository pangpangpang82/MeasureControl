<UserControl
    x:Class="MeasureControl.Views.SingleBoardTest.AirController.PT500TemperatureSensorTestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MeasureControl.Views.SingleBoardTest.AirController"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="550"
    d:DesignWidth="970"
    mc:Ignorable="d">
    <UserControl.Resources>
        <x:Array x:Key="DmmChannels" Type="sys:String">
            <sys:String>Port1</sys:String>
            <sys:String>Port2</sys:String>
        </x:Array>
    </UserControl.Resources>
    <Grid
        x:Name="RootGrid"
        Background="White"
        Focusable="True"
        PreviewMouseDown="RootGrid_PreviewMouseDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="4.5*" />
                <RowDefinition Height="1.8*" />
            </Grid.RowDefinitions>
            <Border
                x:Name="Test_name"
                Grid.Row="0"
                Margin="8,8,8,4"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">
                <Grid>
                    <TextBlock
                        Width="320"
                        Margin="20,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="30"
                        FontWeight="Bold"
                        Text="6.8.1控制通道PDTS传感器测试" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            Width="110"
                            Height="45"
                            Margin="0,0,20,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="#3b82f6"
                                        CornerRadius="6">
                                        <StackPanel Orientation="Horizontal">
                                            <Image
                                                x:Name="DeviceImage"
                                                Width="20"
                                                Height="20"
                                                Margin="5,0,5,0"
                                                Source="/Resources/Logo/hand_w.png" />
                                            <TextBlock
                                                x:Name="DeviceAction"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                FontSize="18"
                                                Foreground="White"
                                                Text="手动测试" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="True">
                                            <Setter Property="Tag" Value="True" />
                                            <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                            <Setter TargetName="DeviceAction" Property="Text" Value="停止测试" />
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding}" Value="False">
                                            <Setter Property="Tag" Value="False" />
                                        </DataTrigger>

                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="False" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                        </MultiTrigger>

                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="False" />
                                                <Condition Property="IsPressed" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                        </MultiTrigger>

                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="True" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                        </MultiTrigger>

                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="True" />
                                                <Condition Property="IsPressed" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                        </MultiTrigger>

                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button
                            Width="110"
                            Height="45"
                            Margin="0,0,30,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="#22c55e"
                                        CornerRadius="6">
                                        <StackPanel Orientation="Horizontal">
                                            <Image
                                                x:Name="DeviceImage"
                                                Width="20"
                                                Height="20"
                                                Margin="5,0,5,0"
                                                Source="/Resources/Logo/auto.png" />
                                            <TextBlock
                                                x:Name="DeviceAction"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                FontSize="18"
                                                Foreground="White"
                                                Text="自动测试" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="True">
                                            <Setter Property="Tag" Value="True" />
                                            <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                            <Setter TargetName="DeviceAction" Property="Text" Value="停止测试" />
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding}" Value="False">
                                            <Setter Property="Tag" Value="False" />
                                        </DataTrigger>

                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="False" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#15803d" />
                                        </MultiTrigger>

                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="False" />
                                                <Condition Property="IsPressed" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#15803d" />
                                        </MultiTrigger>

                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="True" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                        </MultiTrigger>

                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="True" />
                                                <Condition Property="IsPressed" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                        </MultiTrigger>

                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                </Grid>
            </Border>
            <Border
                Grid.Row="1"
                Margin="8,4,8,8"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="2*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Margin="20,10,0,0"
                        VerticalAlignment="Center"
                        FontSize="30"
                        FontWeight="Bold"
                        Text="测试步骤" />
                    <StackPanel
                        Grid.Row="1"
                        Margin="10"
                        Orientation="Horizontal">
                        <TextBlock
                            Grid.Column="0"
                            Margin="30,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Text="进入ATP模式" />
                        <Border
                            Width="170"
                            Height="30"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"
                            Background="AliceBlue"
                            BorderBrush="#D9D9D9"
                            BorderThickness="1"
                            CornerRadius="3">
                            <TextBlock
                                Margin="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Text="429_CH0" />
                        </Border>
                        <Button
                            Width="80"
                            Height="30"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="#3b82f6"
                                        CornerRadius="4">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock
                                                x:Name="DeviceAction"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="15"
                                                Foreground="White"
                                                Text="发送" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock
                            Grid.Column="0"
                            Margin="30,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Text="控制器接入电阻" />
                        <Border
                            Width="170"
                            Height="30"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"
                            Background="AliceBlue"
                            BorderBrush="#D9D9D9"
                            BorderThickness="1"
                            CornerRadius="3">
                            <TextBlock
                                Margin="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Text="429_CH0" />
                        </Border>
                        <Button
                            Width="80"
                            Height="30"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="#3b82f6"
                                        CornerRadius="4">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock
                                                x:Name="DeviceAction"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="15"
                                                Foreground="White"
                                                Text="发送" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    <StackPanel
                        Grid.Row="2"
                        Margin="10"
                        Orientation="Horizontal">
                        <TextBlock
                            Grid.Column="0"
                            Margin="30,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Text="控制器接入电阻值" />
                        <ComboBox
                            Width="140"
                            Height="30"
                            Margin="15,0,0,0"
                            HorizontalAlignment="Left"
                            FontSize="16"
                            ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                            ItemsSource="{StaticResource DmmChannels}"
                            SelectedIndex="0">
                            <ComboBox.Style>
                                <Style BasedOn="{StaticResource CustomComboBoxStyle}" TargetType="ComboBox">
                                    <Setter Property="Opacity" Value="1" />
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <Border
                            Width="140"
                            Height="30"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            BorderBrush="#D9D9D9"
                            BorderThickness="1"
                            CornerRadius="3">
                            <TextBlock Margin="1" FontSize="16" />
                        </Border>

                        <Button
                            Width="80"
                            Height="30"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="#3b82f6"
                                        CornerRadius="4">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock
                                                x:Name="DeviceAction"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="15"
                                                Foreground="White"
                                                Text="测量" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                    </StackPanel>
                    <StackPanel
                        Grid.Row="3"
                        Margin="10"
                        Orientation="Horizontal">
                        <TextBlock
                            Grid.Column="0"
                            Margin="30,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Text="电阻回采值" />
                        <Border
                            Width="170"
                            Height="30"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"
                            Background="AliceBlue"
                            BorderBrush="#D9D9D9"
                            BorderThickness="1"
                            CornerRadius="3">
                            <TextBlock
                                Margin="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Text="429_CH2" />
                        </Border>
                        <Border
                            Width="140"
                            Height="30"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            BorderBrush="#D9D9D9"
                            BorderThickness="1"
                            CornerRadius="3">
                            <TextBlock Margin="1" FontSize="16" />
                        </Border>
                        <TextBlock
                            Grid.Column="0"
                            Margin="30,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Text="PDTS温度" />
                        <Border
                            Width="140"
                            Height="30"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            BorderBrush="#D9D9D9"
                            BorderThickness="1"
                            CornerRadius="3">
                            <TextBlock Margin="1" FontSize="16" />
                        </Border>
                        <Button
                            Width="80"
                            Height="30"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="#3b82f6"
                                        CornerRadius="4">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock
                                                x:Name="DeviceAction"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="15"
                                                Foreground="White"
                                                Text="测量" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Border
                Grid.Row="2"
                Margin="8,4,8,8"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.5*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="30"
                        FontWeight="Bold"
                        Text="测试结果：" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold">
                            <Run Text="上次测试时间：" />
                            <Run Text="{Binding LastTestTime, TargetNullValue=--, FallbackValue=--}" />
                        </TextBlock>
                        <TextBlock
                            Grid.Column="1"
                            Margin="30,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold">
                            <Run Text="上次测试结果：" />
                            <Run Text="{Binding LastTestResult, TargetNullValue=--, FallbackValue=--}" />
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
