                                                    <Setter Property="Background" Value="#9ca3af" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <TextBlock Grid.Row="5" Text="e)" HorizontalAlignment="Center" VerticalAlignment="Center" Height="15" Width="10" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="+3.3V 对地阻抗" HorizontalAlignment="Center" VerticalAlignment="Center" Height="15" Width="84" />
                                <Border Grid.Row="5" Grid.Column="2" Background="White" BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="4" Margin="5,5,5,5" Padding="5,3">
                                    <TextBlock Text="{Binding ImpedanceE, StringFormat={}{0:F1}}" HorizontalAlignment="Center" />
                                </Border>
                                <Border Grid.Row="5" Grid.Column="3" CornerRadius="4" Margin="5,5,5,5" Padding="5,3">
                                    <Border.Style>
