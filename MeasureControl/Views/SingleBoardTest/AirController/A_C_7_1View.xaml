                                                    <Setter Property="Background" Value="#9ca3af" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <TextBlock Grid.Row="4" Text="d)" HorizontalAlignment="Center" VerticalAlignment="Center" Height="15" Width="12" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="+5V 对地阻抗" HorizontalAlignment="Center" VerticalAlignment="Center" Height="15" Width="76" />
                                <Border Grid.Row="4" Grid.Column="2" Background="White" BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="4" Margin="5,5,5,5" Padding="5,3">
                                    <TextBlock Text="{Binding ImpedanceD, StringFormat={}{0:F1}}" HorizontalAlignment="Center" />
                                </Border>
                                <Border Grid.Row="4" Grid.Column="3" CornerRadius="4" Margin="5,5,5,5" Padding="5,3">
