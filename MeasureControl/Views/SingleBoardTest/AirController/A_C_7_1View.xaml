                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ResultB}" Value="FAIL">
                                                        <Setter Property="Foreground" Value="#dc2626" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Button Grid.Row="2" Grid.Column="4" Content="测量" Margin="5,5,5,5" Command="{Binding MeasureBCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#3b82f6" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="10,3">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#2563eb" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="#9ca3af" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <TextBlock Grid.Row="3" Text="c)" HorizontalAlignment="Center" VerticalAlignment="Center" Height="15" Width="10" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="+18V 对地阻抗" HorizontalAlignment="Center" VerticalAlignment="Center" Height="15" Width="84" />
                                <Border Grid.Row="3" Grid.Column="2" Background="White" BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="4" Margin="5,5,5,5" Padding="5,3">
                                    <TextBlock Text="{Binding ImpedanceC, StringFormat={}{0:F1}}" HorizontalAlignment="Center" />
                                </Border>
                                <Border Grid.Row="3" Grid.Column="3" CornerRadius="4" Margin="5,5,5,5" Padding="5,3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#f3f4f6" />
