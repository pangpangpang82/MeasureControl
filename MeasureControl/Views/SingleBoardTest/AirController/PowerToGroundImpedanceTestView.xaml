<UserControl
    x:Class="MeasureControl.Views.SingleBoardTest.AirController.PowerToGroundImpedanceTestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="550"
    d:DesignWidth="970"
    mc:Ignorable="d">
    <Grid
        x:Name="RootGrid"
        Background="White"
        Focusable="True"
        PreviewMouseDown="RootGrid_PreviewMouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.8*" />
            <RowDefinition Height="6*" />
            <RowDefinition Height="1.2*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="8,8,8,4"
            Background="White"
            BorderBrush="#D9D9D9"
            BorderThickness="1.5"
            CornerRadius="8">
            <Grid>
                <TextBlock
                    Width="380"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="24"
                    FontWeight="Bold"
                    Text="6.1电源对地阻抗检查" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Width="100"
                        Height="32"
                        Margin="0,0,20,0"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        Command="{Binding ManualTestCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="border"
                                    Background="#3b82f6"
                                    CornerRadius="6">
                                    <StackPanel Orientation="Horizontal">
                                        <Image
                                            x:Name="DeviceImage"
                                            Width="15"
                                            Height="15"
                                            Margin="5,0,5,0"
                                            Source="/Resources/Logo/hand_w.png" />
                                        <TextBlock
                                            x:Name="DeviceAction"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="White"
                                            Text="手动测试" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsManualTestRunning}" Value="True">
                                        <Setter Property="Tag" Value="True" />
                                        <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                        <Setter TargetName="DeviceAction" Property="Text" Value="停止测试" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsManualTestRunning}" Value="False">
                                        <Setter Property="Tag" Value="False" />
                                    </DataTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="False" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                    </MultiTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="True" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                    </MultiTrigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button
                        Width="100"
                        Height="32"
                        Margin="0,0,30,0"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        Command="{Binding AutoTestCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="border"
                                    Background="#22c55e"
                                    CornerRadius="6">
                                    <StackPanel Orientation="Horizontal">
                                        <Image
                                            x:Name="DeviceImage"
                                            Width="15"
                                            Height="15"
                                            Margin="5,0,5,0"
                                            Source="/Resources/Logo/auto.png" />
                                        <TextBlock
                                            x:Name="DeviceAction"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="White"
                                            Text="自动测试" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsAutoTestRunning}" Value="True">
                                        <Setter Property="Tag" Value="True" />
                                        <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                        <Setter TargetName="DeviceAction" Property="Text" Value="停止测试" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAutoTestRunning}" Value="False">
                                        <Setter Property="Tag" Value="False" />
                                    </DataTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="False" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#15803d" />
                                    </MultiTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="True" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                    </MultiTrigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Margin="8,4,8,4"
            Background="White"
            BorderBrush="#D9D9D9"
            BorderThickness="1.5"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="10,10,10,10">
                    <TextBlock FontSize="18" FontWeight="Bold" Text="表 6 电源对地阻抗测试结果" Margin="0,0,0,8" />

                    <Border Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Padding="6">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontWeight="Bold" HorizontalAlignment="Center" Text="板上电源（V）" Margin="5" />
                                <TextBlock Grid.Column="1" FontWeight="Bold" HorizontalAlignment="Center" Text="信号类型" Margin="5" />
                                <TextBlock Grid.Column="2" FontWeight="Bold" HorizontalAlignment="Center" Text="信号针脚" Margin="5" />
                                <TextBlock Grid.Column="3" FontWeight="Bold" HorizontalAlignment="Center" Text="地信号针脚" Margin="5" />
                                <TextBlock Grid.Column="4" FontWeight="Bold" HorizontalAlignment="Center" Text="对地阻抗（kΩ）" Margin="5" />
                                <TextBlock Grid.Column="5" FontWeight="Bold" HorizontalAlignment="Center" Text="结果" Margin="5" />
                                <TextBlock Grid.Column="6" FontWeight="Bold" HorizontalAlignment="Center" Text="操作" Margin="5" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding PowerName}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding SignalType}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding SignalPin}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding GroundPin}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                            <Border Grid.Column="4" Background="White" BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="4" Margin="5" Padding="5,3">
                                                <TextBlock Text="{Binding ImpedanceKohmText}" HorizontalAlignment="Center" />
                                            </Border>

                                            <Border Grid.Column="5" CornerRadius="4" Margin="5" Padding="5,3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#f3f4f6" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Result}" Value="PASS">
                                                                <Setter Property="Background" Value="#dcfce7" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Result}" Value="FAIL">
                                                                <Setter Property="Background" Value="#fee2e2" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Result}" HorizontalAlignment="Center" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#6b7280" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Result}" Value="PASS">
                                                                    <Setter Property="Foreground" Value="#16a34a" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Result}" Value="FAIL">
                                                                    <Setter Property="Foreground" Value="#dc2626" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <Button Grid.Column="6" Command="{Binding MeasureCommand}" Height="26" Margin="5">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="border" Background="#3b82f6" CornerRadius="4" Padding="10,3">
                                                            <TextBlock Text="测量" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,10,0,0" Background="#f0fdf4" BorderBrush="#22c55e" BorderThickness="1" CornerRadius="6" Padding="6">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" Foreground="#166534" Text="测试判据：" />
                            <TextBlock Margin="0,5,0,0" Foreground="#166534" Text="电源的对地阻抗应不小于200Ω。" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border
                    Grid.Column="1"
                    Margin="5"
                    Background="#f8fafc"
                    BorderBrush="#e2e8f0"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="10,10,0,5" FontSize="16" FontWeight="Bold" Text="测试日志" />
                            <Button
                                Grid.Column="1"
                                Width="80"
                                Height="28"
                                Margin="0,5,10,5"
                                VerticalAlignment="Center"
                                BorderThickness="0"
                                Command="{Binding ClearLogCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="#3b82f6" CornerRadius="4">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Foreground="White"
                                                Text="清除内容" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                        <Border Grid.Row="1" Margin="5" Background="White" BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Logs}" Margin="5">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Margin="8,4,8,8"
            Background="White"
            BorderBrush="#D9D9D9"
            BorderThickness="1.5"
            CornerRadius="8">
            <StackPanel Orientation="Horizontal" Margin="10,5">
                <TextBlock Text="综合结果：" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding OverallResult}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#6b7280" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OverallResult}" Value="PASS">
                                    <Setter Property="Foreground" Value="#16a34a" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding OverallResult}" Value="FAIL">
                                    <Setter Property="Foreground" Value="#dc2626" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="上次测试时间：" FontSize="14" VerticalAlignment="Center" Margin="20,0,5,0" />
                <TextBlock Text="{Binding LastTestTime}" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
