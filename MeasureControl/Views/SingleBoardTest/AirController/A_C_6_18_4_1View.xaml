                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="TX" />
                            <ComboBox
                                Width="100"
                                Height="28"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Left"
                                FontSize="12"
                                ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                                ItemsSource="{StaticResource Arinc429Channels}"
                                SelectedItem="{Binding ExitAtpTxChannel, Mode=TwoWay}">
                                <ComboBox.Style>
                                    <Style BasedOn="{StaticResource CustomComboBoxStyle}" TargetType="ComboBox">
                                        <Setter Property="Opacity" Value="1" />
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>

                            <Border
                                Width="220"
                                Height="28"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                BorderBrush="#D9D9D9"
                                BorderThickness="1"
                                Background="AliceBlue"
                                CornerRadius="3">
                                <TextBlock
                                    Margin="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Text="0x00 02 00 01 00 00 00 01" />
                            </Border>

                            <Button
                                Width="50"
                                Height="28"
                                Margin="15,0,0,0"
                                VerticalAlignment="Center"
                                BorderThickness="0"
                                Command="{Binding SendExitAtpCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="border"
                                            Background="#3b82f6"
                                            CornerRadius="4">
                                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                <TextBlock
                                                    x:Name="DeviceAction"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Foreground="White"
                                                    Text="发送" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="115,5,5,5" Orientation="Horizontal">
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="RX" />
                            <ComboBox
                                Width="100"
                                Height="28"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Left"
                                FontSize="12"
                                ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                                ItemsSource="{StaticResource Arinc429Channels}"
                                SelectedItem="{Binding ExitAtpRxChannel, Mode=TwoWay}">
                                <ComboBox.Style>
                                    <Style BasedOn="{StaticResource CustomComboBoxStyle}" TargetType="ComboBox">
                                        <Setter Property="Opacity" Value="1" />
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>

                            <Border
                                Width="220"
                                Height="28"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                BorderBrush="#D9D9D9"
                                BorderThickness="1"
                                Background="AliceBlue"
                                CornerRadius="3">
                                <TextBlock
                                    Margin="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Text="{Binding ExitAtpRxDataText}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="10,5,0,0"
                        Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="22"
                            FontWeight="Bold"
                            Text="测试信息" />
                        <Button
                            Width="80"
                            Height="32"
                            Margin="80,0,0,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding ClearLogCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="#3b82f6"
                                        CornerRadius="4">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock
                                                x:Name="DeviceAction"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Foreground="White"
                                                Text="清除内容" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                            <Setter Property="Cursor" Value="Arrow" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <Border
                        Grid.Row="1"
                        Grid.RowSpan="4"
                        Grid.Column="1"
                        Margin="0,0,5,0"
                        Width="350"
                        Height="350"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BorderBrush="#D9D9D9"
                        BorderThickness="1.5"
                        CornerRadius="4">
                        <Grid>
                            <ListBox
                                Margin="5"
                                BorderThickness="0"
                                ItemsSource="{Binding Logs}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.Resources>
                                    <Style BasedOn="{StaticResource SimpleScrollViewerStyle}" TargetType="ScrollViewer" />
                                </ListBox.Resources>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            FontSize="12"
                                            Text="{Binding}"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border
                Grid.Row="2"
                Margin="8,4,8,8"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.5*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold">
                        <Run Text="测试结果：" />
                        <Run Text=" " />
                        <Run Text="{Binding LastTestResult, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />
                        <Run Text=" " />
                        <Run Text="{Binding LastTestTime, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />
                    </TextBlock>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="Bold">
                            <Run Text="上次测试时间：" />
                            <Run Text="{Binding PreviousTestTime, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />
                        </TextBlock>
                        <TextBlock
                            Grid.Column="1"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="Bold">
                            <Run Text="上次测试结果：" />
                            <Run Text="{Binding PreviousTestResult, Mode=OneWay, TargetNullValue=--, FallbackValue=--}" />
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
