<UserControl
    x:Class="MeasureControl.Views.SingleBoardTest.InertController.OxygenSensorSignalAcquisitionTestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="550"
    d:DesignWidth="970"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid x:Name="RootGrid" Background="White" Focusable="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.8*" />
                <RowDefinition Height="6*" />
                <RowDefinition Height="1.2*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Margin="8,8,8,4"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">
                <Grid>
                    <TextBlock
                        Width="460"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="24"
                        FontWeight="Bold"
                        Text="氧气传感器信号采集" />

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            Width="100"
                            Height="32"
                            Margin="0,0,20,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding ManualTestCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="#3b82f6" CornerRadius="6">
                                        <StackPanel Orientation="Horizontal">
                                            <Image
                                                x:Name="DeviceImage"
                                                Width="15"
                                                Height="15"
                                                Margin="5,0,5,0"
                                                Source="/Resources/Logo/hand_w.png" />
                                            <TextBlock
                                                x:Name="DeviceAction"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Foreground="White"
                                                Text="手动测试" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsManualTestRunning}" Value="True">
                                            <Setter Property="Tag" Value="True" />
                                            <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                            <Setter TargetName="DeviceAction" Property="Text" Value="停止测试" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsManualTestRunning}" Value="False">
                                            <Setter Property="Tag" Value="False" />
                                        </DataTrigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="False" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                        </MultiTrigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="True" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                        </MultiTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button
                            Width="100"
                            Height="32"
                            Margin="0,0,30,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding AutoTestCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="#22c55e" CornerRadius="6">
                                        <StackPanel Orientation="Horizontal">
                                            <Image
                                                x:Name="DeviceImage"
                                                Width="15"
                                                Height="15"
                                                Margin="5,0,5,0"
                                                Source="/Resources/Logo/auto.png" />
                                            <TextBlock
                                                x:Name="DeviceAction"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Foreground="White"
                                                Text="自动测试" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsAutoTestRunning}" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#f59e0b" />
                                            <Setter TargetName="DeviceAction" Property="Text" Value="测试中" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsAutoTestRunning}" Value="False" />
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#16a34a" />
                                        </MultiDataTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Grid.Row="1"
                Margin="8,4,8,4"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="10" Background="White" BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="8" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" FontSize="20" FontWeight="Bold" Text="测试步骤" />

                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                        <TextBlock VerticalAlignment="Center" FontSize="13" Text="最后测试时间：" />
                                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Text="{Binding LastTestTime}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" FontSize="13" Text="最后结果：" />
                                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Text="{Binding LastTestResult}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Margin="0,8,0,0" Padding="6" Background="#fef3c7" BorderBrush="#f59e0b" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Foreground="#92400e" Text="通过引脚J23、J24和引脚J59、J60将“氧气浓度传感器”、“氧气压力传感器”的模拟电流按表7-7进行设置，通过通讯读取“氧气浓度”、“氧气压力”的数值。" />
                                    <TextBlock Margin="0,4,0,0" Foreground="#92400e" Text="电流输出与通讯采集设置：待补充。" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Margin="0,8,0,0" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Text="板卡状态：" />
                                        <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Text="{Binding ConnectionText}" />

                                        <TextBlock Grid.Column="2" Margin="10,0,6,0" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Text="供电：" />
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Text="{Binding PowerStatus}" />
                                    </Grid>

                                    <Border Grid.Row="1" Margin="0,10,0,0" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Padding="3">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,18,0">
                                            <ItemsControl ItemsSource="{Binding Items}" Margin="6">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,2" Padding="4" Background="White" BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="6">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="28" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="44" />
                                                                    <ColumnDefinition Width="46" />
                                                                    <ColumnDefinition Width="52" />
                                                                    <ColumnDefinition Width="84" />
                                                                    <ColumnDefinition Width="60" />
                                                                    <ColumnDefinition Width="72" />
                                                                    <ColumnDefinition Width="40" />
                                                                    <ColumnDefinition Width="52" />
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Row="0" Grid.Column="0" FontSize="11" FontWeight="Bold" Text="{Binding IndexText}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                                <TextBlock Grid.Row="0" Grid.Column="1" FontSize="11" FontWeight="Bold" Text="{Binding SensorShortName}" VerticalAlignment="Center" Margin="2,0" />

                                                                <TextBlock Grid.Row="0" Grid.Column="2" FontSize="10" Text="通道：" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                                <TextBlock Grid.Row="0" Grid.Column="3" FontSize="10" FontWeight="Bold" Text="{Binding AoChannel}" VerticalAlignment="Center" />

                                                                <TextBlock Grid.Row="0" Grid.Column="4" FontSize="10" Text="电流：" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                                <TextBlock Grid.Row="0" Grid.Column="5" FontSize="10" FontWeight="Bold" Text="{Binding CurrentText}" VerticalAlignment="Center" />

                                                                <TextBlock Grid.Row="1" Grid.Column="2" FontSize="10" Text="电压：" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                                <TextBlock Grid.Row="1" Grid.Column="3" FontSize="10" FontWeight="Bold" Text="{Binding TargetVoltageText, StringFormat={}{0} V}" VerticalAlignment="Center" />

                                                                <TextBlock Grid.Row="1" Grid.Column="4" FontSize="10" Text="预期：" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="{Binding ShowExpectedValue, Converter={StaticResource BoolToVis}}" />
                                                                <TextBlock Grid.Row="1" Grid.Column="5" FontSize="10" FontWeight="Bold" Text="{Binding ExpectedValueDisplay}" VerticalAlignment="Center" Visibility="{Binding ShowExpectedValue, Converter={StaticResource BoolToVis}}" />

                                                                <TextBlock Grid.Row="0" Grid.Column="6" FontSize="10" Text="电流回读：" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                                <TextBlock Grid.Row="0" Grid.Column="7" FontSize="10" FontWeight="Bold" Text="{Binding MeasuredCurrentText}" VerticalAlignment="Center" />

                                                                <TextBlock Grid.Row="1" Grid.Column="6" FontSize="10" Text="值回读：" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="{Binding ShowValueReadback, Converter={StaticResource BoolToVis}}" />
                                                                <TextBlock Grid.Row="1" Grid.Column="7" FontSize="10" FontWeight="Bold" Text="{Binding MeasuredValueText}" VerticalAlignment="Center" Visibility="{Binding ShowValueReadback, Converter={StaticResource BoolToVis}}" />

                                                                <TextBlock Grid.RowSpan="2" Grid.Column="8" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Text="{Binding Result}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="#6b7280" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Result}" Value="PASS">
                                                                                    <Setter Property="Foreground" Value="#16a34a" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Result}" Value="FAIL">
                                                                                    <Setter Property="Foreground" Value="#dc2626" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>

                                                                <Button Grid.RowSpan="2" Grid.Column="9" Width="44" Height="24" Margin="0,0,0,0" Padding="0" BorderThickness="0" HorizontalAlignment="Center" Command="{Binding MeasureCommand}">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="border" Background="#3b82f6" CornerRadius="4">
                                                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="White" Text="采集" />
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                                                                </Trigger>
                                                                                <Trigger Property="IsPressed" Value="True">
                                                                                    <Setter TargetName="border" Property="Background" Value="#1e40af" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>

                                    <Grid Grid.Row="2" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Text="浓度电流(mA)：" />
                                        <TextBox Grid.Column="1" Height="24" VerticalContentAlignment="Center" Text="{Binding ManualConcentrationCurrentMaText, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Text="压力电流(mA)：" />
                                        <TextBox Grid.Column="4" Height="24" VerticalContentAlignment="Center" Text="{Binding ManualPressureCurrentMaText, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Margin="10,10,10,10" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="6">
                        <Grid VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="10,6,10,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Text="测试信息" />
                                <Button Grid.Column="1" Width="80" Height="30" Margin="0,3,0,0" VerticalAlignment="Center" BorderThickness="0" Command="{Binding ClearLogCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="#3b82f6" CornerRadius="4">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Foreground="White" Text="清除内容" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <Border
                                Grid.Row="1"
                                MinWidth="240"
                                MinHeight="300"
                                MaxWidth="350"
                                MaxHeight="420"
                                Margin="10,0,10,10"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="6">
                                <Border Background="White" BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Logs}" Margin="8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="0,1" FontSize="12" TextWrapping="Wrap" Text="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border
                Grid.Row="2"
                Margin="8,4,8,8"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Text="判据" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="上位机读取的“氧气浓度”、“氧气压力”显示的值满足表7-8为合格。" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
