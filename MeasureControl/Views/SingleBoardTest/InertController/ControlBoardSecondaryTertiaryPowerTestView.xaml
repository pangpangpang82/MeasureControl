<UserControl
    x:Class="MeasureControl.Views.SingleBoardTest.InertController.ControlBoardSecondaryTertiaryPowerTestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="550"
    d:DesignWidth="970"
    mc:Ignorable="d">
    <Grid Background="White" Focusable="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.8*" />
            <RowDefinition Height="6*" />
            <RowDefinition Height="1.2*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="8,8,8,4"
            Background="White"
            BorderBrush="#D9D9D9"
            BorderThickness="1.5"
            CornerRadius="8">
            <Grid>
                <TextBlock
                    Width="420"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="24"
                    FontWeight="Bold"
                    Text="控制板二、三次电源测试" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Width="100"
                        Height="32"
                        Margin="0,0,20,0"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        Command="{Binding ManualTestCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="#3b82f6" CornerRadius="6">
                                    <StackPanel Orientation="Horizontal">
                                        <Image
                                            Width="15"
                                            Height="15"
                                            Margin="5,0,5,0"
                                            Source="/Resources/Logo/hand_w.png" />
                                        <TextBlock
                                            x:Name="DeviceAction"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="White"
                                            Text="手动测试" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsManualTestRunning}" Value="True">
                                        <Setter Property="Tag" Value="True" />
                                        <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                        <Setter TargetName="DeviceAction" Property="Text" Value="停止测试" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsManualTestRunning}" Value="False">
                                        <Setter Property="Tag" Value="False" />
                                    </DataTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="False" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                    </MultiTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="True" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                    </MultiTrigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button
                        Width="100"
                        Height="32"
                        Margin="0,0,30,0"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        Command="{Binding AutoTestCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="#22c55e" CornerRadius="6">
                                    <StackPanel Orientation="Horizontal">
                                        <Image
                                            Width="15"
                                            Height="15"
                                            Margin="5,0,5,0"
                                            Source="/Resources/Logo/auto.png" />
                                        <TextBlock
                                            x:Name="DeviceAction"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="White"
                                            Text="自动测试" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsAutoTestRunning}" Value="True">
                                        <Setter Property="Tag" Value="True" />
                                        <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                        <Setter TargetName="DeviceAction" Property="Text" Value="停止测试" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAutoTestRunning}" Value="False">
                                        <Setter Property="Tag" Value="False" />
                                    </DataTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="False" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#15803d" />
                                    </MultiTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="True" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                    </MultiTrigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Margin="8,4,8,4"
            Background="White"
            BorderBrush="#D9D9D9"
            BorderThickness="1.5"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="10,5,0,5"
                    VerticalAlignment="Center"
                    FontSize="20"
                    FontWeight="Bold"
                    Text="测试步骤（先上电，再进入ATP模式，通过429采集）" />

                <StackPanel Grid.Row="1" Margin="10,5,10,5">
                    <Border Margin="0,0,0,10" Padding="8" Background="#fef3c7" BorderBrush="#f59e0b" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="电源状态：" FontWeight="Bold" Foreground="#92400e" />
                                <TextBlock Text="{Binding PowerStatus}" Foreground="#92400e" />
                            </StackPanel>
                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                <TextBlock Text="429状态：" FontWeight="Bold" Foreground="#92400e" />
                                <TextBlock Text="{Binding ArincStatus}" Foreground="#92400e" />
                            </StackPanel>
                            <TextBlock Margin="0,4,0,0" Text="点击手动测试后：CH1输出28V，等待1秒，再通过429发送进入ATP命令。" Foreground="#92400e" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,0,0" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Padding="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="序号" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="测试项目" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Margin="3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Label" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Margin="3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="判据(V)" />
                            <TextBlock Grid.Row="0" Grid.Column="4" Margin="3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="采集值(V)" />
                            <TextBlock Grid.Row="0" Grid.Column="5" Margin="3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="结果" />
                            <TextBlock Grid.Row="0" Grid.Column="6" Margin="3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="操作" />

                            <ItemsControl Grid.Row="1" Grid.ColumnSpan="7" ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Margin="3" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding IndexText}" />
                                            <TextBlock Grid.Column="1" Margin="3" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Name}" />
                                            <TextBlock Grid.Column="2" Margin="3" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding ProtocolLabelText}" />
                                            <TextBlock Grid.Column="3" Margin="3" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding CriteriaText}" />

                                            <Border Grid.Column="4" Margin="3" Padding="4,2" Background="White" BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="4">
                                                <TextBlock HorizontalAlignment="Center" Text="{Binding ValueText}" />
                                            </Border>

                                            <Border Grid.Column="5" Margin="3" Padding="4,2" CornerRadius="4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#f3f4f6" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Result}" Value="PASS">
                                                                <Setter Property="Background" Value="#dcfce7" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Result}" Value="FAIL">
                                                                <Setter Property="Background" Value="#fee2e2" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="{Binding Result}" />
                                            </Border>

                                            <Button Grid.Column="6" Height="24" Margin="3" Command="{Binding CollectCommand}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="border" Background="#3b82f6" CornerRadius="4" Padding="8,2">
                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="White" Text="采集" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Border Margin="0,10,0,0" Padding="8" Background="#f0fdf4" BorderBrush="#22c55e" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" Foreground="#166534" Text="测试判据：" />
                            <TextBlock Margin="0,5,0,0" Foreground="#166534" Text="控制板-15V：-15±0.75V" />
                            <TextBlock Margin="0,2,0,0" Foreground="#166534" Text="控制板+15V：15±0.75V" />
                            <TextBlock Margin="0,2,0,0" Foreground="#166534" Text="控制板5V：5±0.25V" />
                            <TextBlock Margin="0,2,0,0" Foreground="#166534" Text="控制板3.3V：3.3±0.165V" />
                            <TextBlock Margin="0,2,0,0" Foreground="#166534" Text="控制板1.5V：1.5±0.075V" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    Grid.Column="1"
                    Margin="5"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    CornerRadius="6">
                    <Grid VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="10,10,0,10" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Text="测试信息" />
                            <Button Width="80" Height="32" Margin="180,5,0,0" VerticalAlignment="Center" BorderThickness="0" Command="{Binding ClearLogCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="#3b82f6" CornerRadius="4">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Foreground="White" Text="清除内容" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <Border
                            Grid.Row="1"
                            MinWidth="240"
                            MinHeight="340"
                            MaxWidth="350"
                            MaxHeight="360"
                            Margin="10,0,10,10"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="6">
                            <Border Background="White" BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl Margin="8" ItemsSource="{Binding Logs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="0,1" FontSize="12" Text="{Binding}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="10,5" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Text="综合结果：" />
                    <Border Margin="10,0" Padding="15,5" CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#f3f4f6" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OverallResult}" Value="PASS">
                                        <Setter Property="Background" Value="#dcfce7" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OverallResult}" Value="FAIL">
                                        <Setter Property="Background" Value="#fee2e2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding OverallResult}" />
                    </Border>
                    <TextBlock Margin="20,0,5,0" VerticalAlignment="Center" FontSize="14" Text="上次测试时间：" />
                    <TextBlock VerticalAlignment="Center" FontSize="14" Text="{Binding LastTestTime}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Margin="8,4,8,8"
            Background="White"
            BorderBrush="#D9D9D9"
            BorderThickness="1.5"
            CornerRadius="8">
            <StackPanel Margin="10,5" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Text="测试说明：" />
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="#666"
                    Text="当前版本已完成界面、上电、ATP进入、按Label接收与结果判定；429具体数据编码规则可后续继续补充。" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
