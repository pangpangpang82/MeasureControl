<UserControl
    x:Class="MeasureControl.Views.SingleBoardTest.InertController.OverTemperatureCutoffTestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="550"
    d:DesignWidth="970"
    mc:Ignorable="d">

    <Grid Background="White" Focusable="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.8*" />
            <RowDefinition Height="6*" />
            <RowDefinition Height="1.2*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="8,8,8,4"
            Background="White"
            BorderBrush="#D9D9D9"
            BorderThickness="1.5"
            CornerRadius="8">
            <Grid>
                <TextBlock
                    Width="360"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="24"
                    FontWeight="Bold"
                    Text="超温切断模块电路测试" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Width="100"
                        Height="32"
                        Margin="0,0,20,0"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        Command="{Binding ManualTestCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="#3b82f6" CornerRadius="6">
                                    <StackPanel Orientation="Horizontal">
                                        <Image
                                            Width="15"
                                            Height="15"
                                            Margin="5,0,5,0"
                                            Source="/Resources/Logo/hand_w.png" />
                                        <TextBlock
                                            x:Name="DeviceAction"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="White"
                                            Text="手动测试" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsManualTestRunning}" Value="True">
                                        <Setter Property="Tag" Value="True" />
                                        <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                        <Setter TargetName="DeviceAction" Property="Text" Value="停止测试" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsManualTestRunning}" Value="False">
                                        <Setter Property="Tag" Value="False" />
                                    </DataTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="False" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                    </MultiTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="True" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                    </MultiTrigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button
                        Width="100"
                        Height="32"
                        Margin="0,0,30,0"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        Command="{Binding AutoTestCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="#22c55e" CornerRadius="6">
                                    <StackPanel Orientation="Horizontal">
                                        <Image
                                            Width="15"
                                            Height="15"
                                            Margin="5,0,5,0"
                                            Source="/Resources/Logo/auto.png" />
                                        <TextBlock
                                            x:Name="DeviceAction"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="White"
                                            Text="自动测试" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsAutoTestRunning}" Value="True">
                                        <Setter Property="Tag" Value="True" />
                                        <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                        <Setter TargetName="DeviceAction" Property="Text" Value="停止测试" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAutoTestRunning}" Value="False">
                                        <Setter Property="Tag" Value="False" />
                                    </DataTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="False" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#15803d" />
                                    </MultiTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Tag" Value="True" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                    </MultiTrigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Margin="8,4,8,4"
            Background="White"
            BorderBrush="#D9D9D9"
            BorderThickness="1.5"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,8">

                        <StackPanel Margin="0,0,0,10" Orientation="Vertical">
                            <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding Items[0].Title}" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Margin="10,0" FontSize="14" Text="输出电阻(Ω)：" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Width="150" Height="26" VerticalAlignment="Center" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock Margin="5,0,1,0" VerticalAlignment="Center" FontSize="13" Text="{Binding Items[0].ResistanceLabel}" />
                                </Border>
                                <Border Grid.Column="2" Width="100" Height="26" Margin="8,0,0,0" VerticalAlignment="Center" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock Margin="5,0,1,0" VerticalAlignment="Center" FontSize="13" Text="{Binding Items[0].MeasuredResistanceText, TargetNullValue=---, FallbackValue=---}" />
                                </Border>
                                <Border Grid.Column="3" Width="60" Height="26" Margin="8,0,0,0" VerticalAlignment="Center" CornerRadius="3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#f3f4f6" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Items[0].ResistanceResult}" Value="PASS">
                                                    <Setter Property="Background" Value="#dcfce7" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Items[0].ResistanceResult}" Value="FAIL">
                                                    <Setter Property="Background" Value="#fee2e2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Items[0].ResistanceResult}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button Grid.Column="4" Width="60" Height="26" Margin="10,0,0,0" VerticalAlignment="Center" BorderThickness="0" Command="{Binding Items[0].SweepCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="#3b82f6" CornerRadius="4">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="White" Text="输出" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Margin="10,0" FontSize="13" Text="首次超温触发(℃)：" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Width="100" Height="26" Margin="8,0,0,0" VerticalAlignment="Center" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock Margin="5,0,1,0" VerticalAlignment="Center" FontSize="13" Text="{Binding Items[0].FirstOverTempTemperatureText, TargetNullValue=--, FallbackValue=--}" />
                                </Border>
                            </Grid>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Margin="10,0" FontSize="13" Text="J31(T1_AWARN) 期望：高电平(3.3±0.33V)" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Border Grid.Column="1" Width="100" Height="26" Margin="8,0,0,0" VerticalAlignment="Center" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock Margin="5,0,1,0" VerticalAlignment="Center" FontSize="13" Text="{Binding Items[0].Checks[0].VoltageText, TargetNullValue=---, FallbackValue=---}" />
                                </Border>
                                <Border Grid.Column="2" Width="60" Height="26" Margin="8,0,0,0" VerticalAlignment="Center" CornerRadius="3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#f3f4f6" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Items[0].Checks[0].Result}" Value="PASS">
                                                    <Setter Property="Background" Value="#dcfce7" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Items[0].Checks[0].Result}" Value="FAIL">
                                                    <Setter Property="Background" Value="#fee2e2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Items[0].Checks[0].Result}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Margin="10,0" FontSize="13" Text="J11(IIV +28VDC PWR IN_FB) 期望：开路(≤16V)" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Border Grid.Column="1" Width="100" Height="26" Margin="8,0,0,0" VerticalAlignment="Center" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock Margin="5,0,1,0" VerticalAlignment="Center" FontSize="13" Text="{Binding Items[0].Checks[1].VoltageText, TargetNullValue=---, FallbackValue=---}" />
                                </Border>
                                <Border Grid.Column="2" Width="60" Height="26" Margin="8,0,0,0" VerticalAlignment="Center" CornerRadius="3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#f3f4f6" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Items[0].Checks[1].Result}" Value="PASS">
                                                    <Setter Property="Background" Value="#dcfce7" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Items[0].Checks[1].Result}" Value="FAIL">
                                                    <Setter Property="Background" Value="#fee2e2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Items[0].Checks[1].Result}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Margin="10,0" FontSize="13" Text="J12(IIV +28VDC PWR IN) 期望：开路(≤16V)" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Border Grid.Column="1" Width="100" Height="26" Margin="8,0,0,0" VerticalAlignment="Center" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock Margin="5,0,1,0" VerticalAlignment="Center" FontSize="13" Text="{Binding Items[0].Checks[2].VoltageText, TargetNullValue=---, FallbackValue=---}" />
                                </Border>
                                <Border Grid.Column="2" Width="60" Height="26" Margin="8,0,0,0" VerticalAlignment="Center" CornerRadius="3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#f3f4f6" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Items[0].Checks[2].Result}" Value="PASS">
                                                    <Setter Property="Background" Value="#dcfce7" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Items[0].Checks[2].Result}" Value="FAIL">
                                                    <Setter Property="Background" Value="#fee2e2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Items[0].Checks[2].Result}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </StackPanel>

                        <Separator Margin="0,10,0,10" />

                        <StackPanel Margin="0,0,0,10" Orientation="Vertical">
                            <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding Items[1].Title}" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Margin="10,0" FontSize="14" Text="输出电阻(Ω)：" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Width="150" Height="26" VerticalAlignment="Center" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock Margin="5,0,1,0" VerticalAlignment="Center" FontSize="13" Text="{Binding Items[1].ResistanceLabel}" />
                                </Border>
                                <Border Grid.Column="2" Width="100" Height="26" Margin="8,0,0,0" VerticalAlignment="Center" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock Margin="5,0,1,0" VerticalAlignment="Center" FontSize="13" Text="{Binding Items[1].MeasuredResistanceText, TargetNullValue=---, FallbackValue=---}" />
                                </Border>
                                <Border Grid.Column="3" Width="60" Height="26" Margin="8,0,0,0" VerticalAlignment="Center" CornerRadius="3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#f3f4f6" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Items[1].ResistanceResult}" Value="PASS">
                                                    <Setter Property="Background" Value="#dcfce7" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Items[1].ResistanceResult}" Value="FAIL">
                                                    <Setter Property="Background" Value="#fee2e2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Items[1].ResistanceResult}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button Grid.Column="4" Width="60" Height="26" Margin="10,0,0,0" VerticalAlignment="Center" BorderThickness="0" Command="{Binding Items[1].SweepCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="#3b82f6" CornerRadius="4">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="White" Text="输出" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Margin="10,0" FontSize="13" Text="首次超温触发(℃)：" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Width="100" Height="26" Margin="8,0,0,0" VerticalAlignment="Center" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock Margin="5,0,1,0" VerticalAlignment="Center" FontSize="13" Text="{Binding Items[1].FirstOverTempTemperatureText, TargetNullValue=--, FallbackValue=--}" />
                                </Border>
                            </Grid>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Margin="10,0" FontSize="13" Text="J32(T2_AWARN) 期望：高电平(3.3±0.33V)" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Border Grid.Column="1" Width="100" Height="26" Margin="8,0,0,0" VerticalAlignment="Center" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock Margin="5,0,1,0" VerticalAlignment="Center" FontSize="13" Text="{Binding Items[1].Checks[0].VoltageText, TargetNullValue=---, FallbackValue=---}" />
                                </Border>
                                <Border Grid.Column="2" Width="60" Height="26" Margin="8,0,0,0" VerticalAlignment="Center" CornerRadius="3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#f3f4f6" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Items[1].Checks[0].Result}" Value="PASS">
                                                    <Setter Property="Background" Value="#dcfce7" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Items[1].Checks[0].Result}" Value="FAIL">
                                                    <Setter Property="Background" Value="#fee2e2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Items[1].Checks[0].Result}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Margin="10,0" FontSize="13" Text="J13(TIV +28VDC PWR IN_FB) 期望：开路(≤16V)" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Border Grid.Column="1" Width="100" Height="26" Margin="8,0,0,0" VerticalAlignment="Center" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock Margin="5,0,1,0" VerticalAlignment="Center" FontSize="13" Text="{Binding Items[1].Checks[1].VoltageText, TargetNullValue=---, FallbackValue=---}" />
                                </Border>
                                <Border Grid.Column="2" Width="60" Height="26" Margin="8,0,0,0" VerticalAlignment="Center" CornerRadius="3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#f3f4f6" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Items[1].Checks[1].Result}" Value="PASS">
                                                    <Setter Property="Background" Value="#dcfce7" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Items[1].Checks[1].Result}" Value="FAIL">
                                                    <Setter Property="Background" Value="#fee2e2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Items[1].Checks[1].Result}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Margin="10,0" FontSize="13" Text="J14(TIV +28VDC PWR IN) 期望：开路(≤16V)" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Border Grid.Column="1" Width="100" Height="26" Margin="8,0,0,0" VerticalAlignment="Center" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
                                    <TextBlock Margin="5,0,1,0" VerticalAlignment="Center" FontSize="13" Text="{Binding Items[1].Checks[2].VoltageText, TargetNullValue=---, FallbackValue=---}" />
                                </Border>
                                <Border Grid.Column="2" Width="60" Height="26" Margin="8,0,0,0" VerticalAlignment="Center" CornerRadius="3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#f3f4f6" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Items[1].Checks[2].Result}" Value="PASS">
                                                    <Setter Property="Background" Value="#dcfce7" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Items[1].Checks[2].Result}" Value="FAIL">
                                                    <Setter Property="Background" Value="#fee2e2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Items[1].Checks[2].Result}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="10,10,0,10" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Text="测试信息" />
                        <Button Width="80" Height="32" Margin="180,5,0,0" VerticalAlignment="Center" BorderThickness="0" Command="{Binding ClearLogCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="#3b82f6" CornerRadius="4">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Foreground="White" Text="清除内容" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                            <Setter Property="Cursor" Value="Arrow" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <Border
                        Grid.Row="1"
                        Width="350"
                        Height="360"
                        Margin="10,0,10,10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="6">
                        <Border Background="White" BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Logs}" Margin="8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Margin="8,4,8,8"
            Background="White"
            BorderBrush="#D9D9D9"
            BorderThickness="1.5"
            CornerRadius="8">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="16" FontWeight="Bold" Text="供电状态：" />
                    <TextBlock FontSize="16" Text="{Binding PowerStatus}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock FontSize="16" FontWeight="Bold" Text="总体结果：" />
                    <TextBlock FontSize="16" Text="{Binding OverallResult}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock FontSize="16" FontWeight="Bold" Text="测试时间：" />
                    <TextBlock FontSize="16" Text="{Binding LastTestTime}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
