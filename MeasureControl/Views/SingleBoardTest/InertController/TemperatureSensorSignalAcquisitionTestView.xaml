<UserControl

    x:Class="MeasureControl.Views.SingleBoardTest.InertController.TemperatureSensorSignalAcquisitionTestView"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    xmlns:sys="clr-namespace:System;assembly=mscorlib"

    d:DesignHeight="550"

    d:DesignWidth="970"

    mc:Ignorable="d">

    <UserControl.Resources>

        <x:Array x:Key="PointIndexes" Type="sys:Int32">

            <sys:Int32>1</sys:Int32>

            <sys:Int32>2</sys:Int32>

            <sys:Int32>3</sys:Int32>

            <sys:Int32>4</sys:Int32>

        </x:Array>

    </UserControl.Resources>



    <Grid x:Name="RootGrid" Background="White" Focusable="True">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="0.8*" />

                <RowDefinition Height="6*" />

                <RowDefinition Height="1.2*" />

            </Grid.RowDefinitions>



            <Border

                Grid.Row="0"

                Margin="8,8,8,4"

                Background="White"

                BorderBrush="#D9D9D9"

                BorderThickness="1.5"

                CornerRadius="8">

                <Grid>

                    <TextBlock

                        Width="460"

                        Margin="10,0,0,0"

                        HorizontalAlignment="Left"

                        VerticalAlignment="Center"

                        FontSize="24"

                        FontWeight="Bold"

                        Text="温度传感器信号采集" />



                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">

                        <Button

                            Width="100"

                            Height="32"

                            Margin="0,0,20,0"

                            VerticalAlignment="Center"

                            BorderThickness="0"

                            Command="{Binding ManualTestCommand}">

                            <Button.Template>

                                <ControlTemplate TargetType="Button">

                                    <Border x:Name="border" Background="#3b82f6" CornerRadius="6">

                                        <StackPanel Orientation="Horizontal">

                                            <Image

                                                x:Name="DeviceImage"

                                                Width="15"

                                                Height="15"

                                                Margin="5,0,5,0"

                                                Source="/Resources/Logo/hand_w.png" />

                                            <TextBlock

                                                x:Name="DeviceAction"

                                                Margin="0,0,5,0"

                                                VerticalAlignment="Center"

                                                FontSize="16"

                                                Foreground="White"

                                                Text="手动测试" />

                                        </StackPanel>

                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <DataTrigger Binding="{Binding IsManualTestRunning}" Value="True">

                                            <Setter Property="Tag" Value="True" />

                                            <Setter TargetName="border" Property="Background" Value="#ef4444" />

                                            <Setter TargetName="DeviceAction" Property="Text" Value="停止测试" />

                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding IsManualTestRunning}" Value="False">

                                            <Setter Property="Tag" Value="False" />

                                        </DataTrigger>

                                        <MultiTrigger>

                                            <MultiTrigger.Conditions>

                                                <Condition Property="Tag" Value="False" />

                                                <Condition Property="IsMouseOver" Value="True" />

                                            </MultiTrigger.Conditions>

                                            <Setter TargetName="border" Property="Background" Value="#2563eb" />

                                        </MultiTrigger>

                                        <MultiTrigger>

                                            <MultiTrigger.Conditions>

                                                <Condition Property="Tag" Value="True" />

                                                <Condition Property="IsMouseOver" Value="True" />

                                            </MultiTrigger.Conditions>

                                            <Setter TargetName="border" Property="Background" Value="#b91c1c" />

                                        </MultiTrigger>

                                        <Trigger Property="IsEnabled" Value="False">

                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />

                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>

                            </Button.Template>

                        </Button>



                        <Button

                            Width="100"

                            Height="32"

                            Margin="0,0,30,0"

                            VerticalAlignment="Center"

                            BorderThickness="0"

                            Command="{Binding AutoTestCommand}">

                            <Button.Template>

                                <ControlTemplate TargetType="Button">

                                    <Border x:Name="border" Background="#22c55e" CornerRadius="6">

                                        <StackPanel Orientation="Horizontal">

                                            <Image

                                                x:Name="DeviceImage"

                                                Width="15"

                                                Height="15"

                                                Margin="5,0,5,0"

                                                Source="/Resources/Logo/auto.png" />

                                            <TextBlock

                                                x:Name="DeviceAction"

                                                Margin="0,0,5,0"

                                                VerticalAlignment="Center"

                                                FontSize="16"

                                                Foreground="White"

                                                Text="自动测试" />

                                        </StackPanel>

                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <DataTrigger Binding="{Binding IsAutoTestRunning}" Value="True">

                                            <Setter TargetName="border" Property="Background" Value="#f59e0b" />

                                            <Setter TargetName="DeviceAction" Property="Text" Value="测试中" />

                                        </DataTrigger>

                                        <MultiDataTrigger>

                                            <MultiDataTrigger.Conditions>

                                                <Condition Binding="{Binding IsAutoTestRunning}" Value="False" />

                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />

                                            </MultiDataTrigger.Conditions>

                                            <Setter TargetName="border" Property="Background" Value="#16a34a" />

                                        </MultiDataTrigger>

                                        <Trigger Property="IsEnabled" Value="False">

                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />

                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>

                            </Button.Template>

                        </Button>

                    </StackPanel>

                </Grid>

            </Border>



            <Border

                Grid.Row="1"

                Margin="8,4,8,4"

                Background="White"

                BorderBrush="#D9D9D9"

                BorderThickness="1.5"

                CornerRadius="8">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="1.6*" />

                        <ColumnDefinition Width="1*" />

                    </Grid.ColumnDefinitions>



                    <Border Grid.Column="0" Margin="10" Background="White" BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="8" Padding="10">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="*" />

                            </Grid.RowDefinitions>



                            <Grid Grid.Row="0" VerticalAlignment="Center">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto" />

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />

                                </Grid.ColumnDefinitions>



                                <TextBlock Grid.Column="0" FontSize="20" FontWeight="Bold" Text="测试步骤（控制板供电28V）" />



                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">

                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">

                                        <TextBlock VerticalAlignment="Center" FontSize="13" Text="最后测试时间：" />

                                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Text="{Binding LastTestTime}" />

                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock VerticalAlignment="Center" FontSize="13" Text="最后结果：" />

                                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Text="{Binding LastTestResult}" />

                                    </StackPanel>

                                </StackPanel>

                            </Grid>



                            <Border Grid.Row="1" Margin="0,8,0,0" Padding="6" Background="#fef3c7" BorderBrush="#f59e0b" BorderThickness="1" CornerRadius="6">

                                <StackPanel>

                                    <TextBlock FontWeight="Bold" Foreground="#92400e" Text="通过 J52/J53/J56 配置 PT500A；J61/J62/J63 配置 PT500B；J54/J55/J57 配置 PT1000A；J28/J29/J97 配置 PT1000B。" />

                                    <TextBlock Margin="0,4,0,0" Foreground="#92400e" Text="按表7-2设置模拟电阻值，通过通信读取换算温度（通讯采集部分暂未接入）。" />

                                </StackPanel>

                            </Border>



                            <Border Grid.Row="2" Margin="0,8,0,0" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Padding="8">

                                <Grid>

                                    <Grid.RowDefinitions>

                                        <RowDefinition Height="Auto" />

                                        <RowDefinition Height="Auto" />

                                        <RowDefinition Height="Auto" />

                                        <RowDefinition Height="*" />

                                    </Grid.RowDefinitions>



                                    <Grid Grid.Row="0">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="90" />

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>



                                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Text="点位选择" />

                                        <ComboBox

                                            Grid.Column="1"

                                            Height="26"

                                            Margin="10,0,0,0"

                                            FontSize="12"

                                            ItemsSource="{StaticResource PointIndexes}"

                                            SelectedItem="{Binding SelectedPointIndex, Mode=TwoWay}" />



                                        <TextBlock Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="13" Text="板卡状态：" />

                                        <TextBlock Grid.Column="3" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Text="{Binding ConnectionText}" />



                                        <TextBlock Grid.Column="4" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="13" Text="目标温度：" />

                                        <TextBlock Grid.Column="5" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Text="{Binding CurrentPointTargetTemperatureText}" />

                                        <TextBlock Grid.Column="6" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="13" Text="℃" />
                                    </Grid>



                                    <Border Grid.Row="1" Margin="0,10,0,0" Background="White" BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="6" Padding="4">

                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">

                                            <Grid>

                                                <Grid.RowDefinitions>

                                                    <RowDefinition Height="Auto" />

                                                    <RowDefinition Height="Auto" />

                                                </Grid.RowDefinitions>

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="100" />

                                                    <ColumnDefinition Width="140" />

                                                    <ColumnDefinition Width="70" />

                                                    <ColumnDefinition Width="70" />

                                                    <ColumnDefinition Width="95" />

                                                    <ColumnDefinition Width="95" />

                                                    <ColumnDefinition Width="95" />

                                                    <ColumnDefinition Width="95" />

                                                    <ColumnDefinition Width="80" />

                                                    <ColumnDefinition Width="80" />

                                                </Grid.ColumnDefinitions>



                                                <TextBlock Grid.Row="0" Grid.Column="0" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="传感器通道" Margin="2" />

                                                <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="引脚" Margin="2" />

                                                <TextBlock Grid.Row="0" Grid.Column="2" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="532通道" Margin="2" />

                                                <TextBlock Grid.Row="0" Grid.Column="3" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="7012通道" Margin="2" />

                                                <TextBlock Grid.Row="0" Grid.Column="4" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="目标电阻(Ω)" Margin="2" />

                                                <TextBlock Grid.Row="0" Grid.Column="5" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="回采电阻(Ω)" Margin="2" />

                                                <TextBlock Grid.Row="0" Grid.Column="6" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="目标温度(℃)" Margin="2" />

                                                <TextBlock Grid.Row="0" Grid.Column="7" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="回采温度(℃)" Margin="2" />

                                                <TextBlock Grid.Row="0" Grid.Column="8" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="电阻判定" Margin="2" />

                                                <TextBlock Grid.Row="0" Grid.Column="9" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="温度判定" Margin="2" />



                                                <ItemsControl Grid.Row="1" Grid.ColumnSpan="10" ItemsSource="{Binding SensorItems}">

                                                    <ItemsControl.ItemTemplate>

                                                        <DataTemplate>

                                                            <Grid Margin="0,2">

                                                                <Grid.ColumnDefinitions>

                                                                    <ColumnDefinition Width="100" />

                                                                    <ColumnDefinition Width="140" />

                                                                    <ColumnDefinition Width="70" />

                                                                    <ColumnDefinition Width="70" />

                                                                    <ColumnDefinition Width="95" />

                                                                    <ColumnDefinition Width="95" />

                                                                    <ColumnDefinition Width="95" />

                                                                    <ColumnDefinition Width="95" />

                                                                    <ColumnDefinition Width="80" />

                                                                    <ColumnDefinition Width="80" />

                                                                </Grid.ColumnDefinitions>



                                                                <TextBlock Grid.Column="0" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding SensorName}" />

                                                                <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis" Text="{Binding Pins}" />

                                                                <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding AoChannel}" />

                                                                <TextBlock Grid.Column="3" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding RoChannel}" />

                                                                <TextBlock Grid.Column="4" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding TargetResistanceOhm, StringFormat={}{0:F2}}" />

                                                                <TextBlock Grid.Column="5" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding MeasuredResistanceText}" />

                                                                <TextBlock Grid.Column="6" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding TargetTemperatureText}" />

                                                                <TextBlock Grid.Column="7" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding MeasuredTemperatureText}" />

                                                                <TextBlock Grid.Column="8" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding ResistanceResultText}" />

                                                                <TextBlock Grid.Column="9" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding TemperatureResultText}" />

                                                            </Grid>

                                                        </DataTemplate>

                                                    </ItemsControl.ItemTemplate>

                                                </ItemsControl>

                                            </Grid>

                                        </ScrollViewer>

                                    </Border>






                                    <Grid Grid.Row="3" Margin="0,10,0,0">

                                        <Grid.RowDefinitions>

                                            <RowDefinition Height="Auto" />

                                            <RowDefinition Height="Auto" />

                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,10,8">

                                            <Grid.RowDefinitions>

                                                <RowDefinition Height="Auto" />

                                                <RowDefinition Height="Auto" />

                                            </Grid.RowDefinitions>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="Auto" />

                                                <ColumnDefinition Width="90" />

                                                <ColumnDefinition Width="Auto" />

                                                <ColumnDefinition Width="90" />

                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontSize="12" Text="PT500A(Ω)" Margin="0,0,6,0" />

                                            <TextBox Grid.Row="0" Grid.Column="1" Height="24" VerticalContentAlignment="Center" FontSize="12" Text="{Binding ManualResistancePt500AText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="ResistanceTextBox_PreviewTextInput" DataObject.Pasting="ResistanceTextBox_Pasting" LostFocus="ResistanceTextBox_LostFocus" />

                                            <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" FontSize="12" Text="PT500B(Ω)" Margin="12,0,6,0" />

                                            <TextBox Grid.Row="0" Grid.Column="3" Height="24" VerticalContentAlignment="Center" FontSize="12" Text="{Binding ManualResistancePt500BText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="ResistanceTextBox_PreviewTextInput" DataObject.Pasting="ResistanceTextBox_Pasting" LostFocus="ResistanceTextBox_LostFocus" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontSize="12" Text="PT1000A(Ω)" Margin="0,6,6,0" />

                                            <TextBox Grid.Row="1" Grid.Column="1" Height="24" VerticalContentAlignment="Center" FontSize="12" Margin="0,6,0,0" Text="{Binding ManualResistancePt1000AText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="ResistanceTextBox_PreviewTextInput" DataObject.Pasting="ResistanceTextBox_Pasting" LostFocus="ResistanceTextBox_LostFocus" />

                                            <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" FontSize="12" Text="PT1000B(Ω)" Margin="12,6,6,0" />

                                            <TextBox Grid.Row="1" Grid.Column="3" Height="24" VerticalContentAlignment="Center" FontSize="12" Margin="0,6,0,0" Text="{Binding ManualResistancePt1000BText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="ResistanceTextBox_PreviewTextInput" DataObject.Pasting="ResistanceTextBox_Pasting" LostFocus="ResistanceTextBox_LostFocus" />

                                        </Grid>

                                        <Button Grid.Row="1" Grid.Column="1" Width="100" Height="32" Margin="0,0,10,0" VerticalAlignment="Bottom" BorderThickness="0" Command="{Binding ApplySelectedPointCommand}">

                                            <Button.Template>

                                                <ControlTemplate TargetType="Button">

                                                    <Border x:Name="border" Background="#3b82f6" CornerRadius="4">

                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="White" Text="采集" />

                                                    </Border>

                                                    <ControlTemplate.Triggers>

                                                        <Trigger Property="IsMouseOver" Value="True">

                                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />

                                                        </Trigger>

                                                        <Trigger Property="IsPressed" Value="True">

                                                            <Setter TargetName="border" Property="Background" Value="#1d4ed8" />

                                                        </Trigger>

                                                        <Trigger Property="IsEnabled" Value="False">

                                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />

                                                        </Trigger>

                                                    </ControlTemplate.Triggers>

                                                </ControlTemplate>

                                            </Button.Template>

                                        </Button>

                                    </Grid>

                                </Grid>

                            </Border>

                        </Grid>

                    </Border>



                    <Border Grid.Column="1" Margin="10,10,10,10" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="6">

                        <Grid VerticalAlignment="Center">

                            <Grid.RowDefinitions>

                                <RowDefinition Height="auto" />

                                <RowDefinition Height="*" />

                            </Grid.RowDefinitions>



                            <Grid Margin="10,6,10,6">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />

                                </Grid.ColumnDefinitions>



                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Text="测试信息" />

                                <Button Grid.Column="1" Width="80" Height="30" Margin="0,3,0,0" VerticalAlignment="Center" BorderThickness="0" Command="{Binding ClearLogCommand}">

                                    <Button.Template>

                                        <ControlTemplate TargetType="Button">

                                            <Border x:Name="border" Background="#3b82f6" CornerRadius="4">

                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Foreground="White" Text="清除内容" />

                                            </Border>

                                            <ControlTemplate.Triggers>

                                                <Trigger Property="IsMouseOver" Value="True">

                                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8" />

                                                </Trigger>

                                                <Trigger Property="IsPressed" Value="True">

                                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8" />

                                                </Trigger>

                                                <Trigger Property="IsEnabled" Value="False">

                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af" />

                                                    <Setter Property="Cursor" Value="Arrow" />

                                                </Trigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>

                                    </Button.Template>

                                </Button>

                            </Grid>



                            <Border

                                Grid.Row="1"

                                MinWidth="240"

                                MinHeight="300"

                                MaxWidth="350"

                                MaxHeight="420"

                                Margin="10,0,10,10"

                                HorizontalAlignment="Stretch"

                                VerticalAlignment="Stretch"

                                Background="Transparent"

                                BorderThickness="0"

                                CornerRadius="6">

                                <Border Background="White" BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="4">

                                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                                        <ItemsControl ItemsSource="{Binding Logs}" Margin="8">

                                            <ItemsControl.ItemTemplate>

                                                <DataTemplate>

                                                    <TextBlock Margin="0,1" FontSize="12" TextWrapping="Wrap" Text="{Binding}" />

                                                </DataTemplate>

                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                    </ScrollViewer>

                                </Border>

                            </Border>

                        </Grid>

                    </Border>

                </Grid>

            </Border>



            <Border

                Grid.Row="2"

                Margin="8,4,8,8"

                Background="White"

                BorderBrush="#D9D9D9"

                BorderThickness="1.5"

                CornerRadius="8">

                <Grid Margin="10">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="auto" />

                        <ColumnDefinition Width="*" />

                    </Grid.ColumnDefinitions>



                    <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Text="判据" />

                    <TextBlock

                        Grid.Column="1"

                        Margin="10,0,0,0"

                        VerticalAlignment="Center"

                        FontSize="14"

                        Text="上位机读取的每个传感器温度值满足表7-3和表7-4为合格（通讯采集与判定暂未接入）。" />

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>

