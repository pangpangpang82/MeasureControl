<UserControl
    x:Class="MeasureControl.Views.SingleBoardTest.FuelController.SecondaryPowerTestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MeasureControl.Views.SingleBoardTest.FuelController"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="550"
    d:DesignWidth="970"
    mc:Ignorable="d">
    <Grid
        x:Name="RootGrid"
        Background="White"
        Focusable="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.8*" />
                <RowDefinition Height="6*" />
                <RowDefinition Height="1.2*" />
            </Grid.RowDefinitions>
            
            <!-- 标题栏 -->
            <Border
                x:Name="Test_name"
                Grid.Row="0"
                Margin="8,8,8,4"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">
                <Grid>
                    <TextBlock
                        Width="300"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="24"
                        FontWeight="Bold"
                        Text="二次电源测试" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <!-- 手动测试按钮 -->
                        <Button
                            Width="100"
                            Height="32"
                            Margin="0,0,20,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding ManualTestCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="#3b82f6"
                                        CornerRadius="6">
                                        <StackPanel Orientation="Horizontal">
                                            <Image
                                                x:Name="DeviceImage"
                                                Width="15"
                                                Height="15"
                                                Margin="5,0,5,0"
                                                Source="/Resources/Logo/hand_w.png" />
                                            <TextBlock
                                                x:Name="DeviceAction"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Foreground="White"
                                                Text="手动测试" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsManualTestRunning}" Value="True">
                                            <Setter Property="Tag" Value="True" />
                                            <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                            <Setter TargetName="DeviceAction" Property="Text" Value="停止测试" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsManualTestRunning}" Value="False">
                                            <Setter Property="Tag" Value="False" />
                                        </DataTrigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="False" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                        </MultiTrigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="True" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                        </MultiTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- 自动测试按钮 -->
                        <Button
                            Width="100"
                            Height="32"
                            Margin="0,0,30,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding AutoTestCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="#22c55e"
                                        CornerRadius="6">
                                        <StackPanel Orientation="Horizontal">
                                            <Image
                                                x:Name="DeviceImage"
                                                Width="15"
                                                Height="15"
                                                Margin="5,0,5,0"
                                                Source="/Resources/Logo/auto.png" />
                                            <TextBlock
                                                x:Name="DeviceAction"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Foreground="White"
                                                Text="自动测试" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsAutoTestRunning}" Value="True">
                                            <Setter Property="Tag" Value="True" />
                                            <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                            <Setter TargetName="DeviceAction" Property="Text" Value="停止测试" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAutoTestRunning}" Value="False">
                                            <Setter Property="Tag" Value="False" />
                                        </DataTrigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="False" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#15803d" />
                                        </MultiTrigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="True" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                        </MultiTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- 主内容区 -->
            <Border
                Grid.Row="1"
                Margin="8,4,8,4"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock
                        Grid.Row="0"
                        Margin="10,5,0,5"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="测试步骤（组件28V供电状态）" />

                    <StackPanel Grid.Row="1" Margin="10,5,10,5">

                        <!-- 供电状态提示区域 -->
                        <Border Margin="0,10,0,0" Background="#fef3c7" BorderBrush="#f59e0b" BorderThickness="1" CornerRadius="6" Padding="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="前置条件：" FontWeight="Bold" VerticalAlignment="Center" Foreground="#92400e"/>
                                <TextBlock Grid.Column="1" Text="提供28V供电" VerticalAlignment="Center" Foreground="#92400e" Margin="5,0"/>
                                <Border Grid.Column="2" CornerRadius="4" Padding="8,3" Margin="5,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#fecaca"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPowerOn}" Value="True">
                                                    <Setter Property="Background" Value="#bbf7d0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding PowerStatus}" FontWeight="Bold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#dc2626"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPowerOn}" Value="True">
                                                        <Setter Property="Foreground" Value="#16a34a"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Border>
                        
                        <!-- 测试项目表格 -->
                        <Border Margin="0,10,0,0" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Padding="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>

                                <!-- 表头 -->
                                <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="序号" Margin="5"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="测试项目" Margin="5"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="测量值(V)" Margin="5"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="结果" Margin="5"/>
                                <TextBlock Grid.Row="0" Grid.Column="4" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="操作" Margin="5"/>

                                <!-- 测试项：CRM_PIN1对CRM_PIN18电压 -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="a)" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="CRM_PIN1-PIN18 电压（+5V电源）" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Grid.Row="1" Grid.Column="2" Background="White" BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="4" Margin="5" Padding="5,3">
                                    <TextBlock Text="{Binding VoltageValue, StringFormat={}{0:F3}}" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="3" CornerRadius="4" Margin="5" Padding="5,3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#f3f4f6"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TestResult}" Value="PASS">
                                                    <Setter Property="Background" Value="#dcfce7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TestResult}" Value="FAIL">
                                                    <Setter Property="Background" Value="#fee2e2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding TestResult}" HorizontalAlignment="Center" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#6b7280"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TestResult}" Value="PASS">
                                                        <Setter Property="Foreground" Value="#16a34a"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TestResult}" Value="FAIL">
                                                        <Setter Property="Foreground" Value="#dc2626"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Button Grid.Row="1" Grid.Column="4" Command="{Binding MeasureCommand}" Height="26" Margin="5">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="#3b82f6" CornerRadius="4" Padding="10,3">
                                                <TextBlock Text="测量" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#2563eb"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                    
                    <!-- 测试日志区域 -->
                    <Border
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Grid.Column="1"
                        Margin="5"
                        Background="#f8fafc"
                        BorderBrush="#e2e8f0"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="10,10,0,5" FontSize="16" FontWeight="Bold" Text="测试日志"/>
                                <Button Grid.Column="1" 
                                        Width="80" Height="28" 
                                        Margin="0,5,10,5" 
                                        VerticalAlignment="Center"
                                        BorderThickness="0"
                                        Command="{Binding ClearLogCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="#3b82f6" CornerRadius="4">
                                                <TextBlock x:Name="btnText" 
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center" 
                                                           FontSize="14" 
                                                           Foreground="White" 
                                                           Text="清除内容"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af"/>
                                                    <Setter Property="Cursor" Value="Arrow"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <Border Grid.Row="1" Margin="5" Background="White" BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Logs}" Margin="5">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,1"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="10,5">
                        <TextBlock Text="综合结果：" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Border CornerRadius="4" Padding="15,5" Margin="10,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#f3f4f6"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OverallResult}" Value="PASS">
                                            <Setter Property="Background" Value="#dcfce7"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OverallResult}" Value="FAIL">
                                            <Setter Property="Background" Value="#fee2e2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding OverallResult}" FontSize="16" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#6b7280"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OverallResult}" Value="PASS">
                                                <Setter Property="Foreground" Value="#16a34a"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OverallResult}" Value="FAIL">
                                                <Setter Property="Foreground" Value="#dc2626"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <TextBlock Text="上次测试时间：" FontSize="14" VerticalAlignment="Center" Margin="20,0,5,0"/>
                        <TextBlock Text="{Binding LastTestTime}" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <Border
                Grid.Row="2"
                Margin="8,4,8,8"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">
                <StackPanel Orientation="Horizontal" Margin="10,5">
                    <TextBlock Text="测试说明：" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="组件28V供电状态下，使用万用表直流电压档测量CRM_PIN1对CRM_PIN18之间的电压值。" 
                               FontSize="14" VerticalAlignment="Center" Foreground="#666" Margin="10,0,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
