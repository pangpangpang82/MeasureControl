<UserControl
    x:Class="MeasureControl.Views.SingleBoardTest.FuelController.DiscreteOutputTestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MeasureControl.Views.SingleBoardTest.FuelController"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="550"
    d:DesignWidth="970"
    mc:Ignorable="d">
    <Grid
        x:Name="RootGrid"
        Background="White"
        Focusable="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.8*" />
                <RowDefinition Height="6*" />
            </Grid.RowDefinitions>

            <Border
                x:Name="Test_name"
                Grid.Row="0"
                Margin="8,8,8,4"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">
                <Grid>
                    <TextBlock
                        Width="320"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="24"
                        FontWeight="Bold"
                        Text="离散量输出功能测试" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            Width="100"
                            Height="32"
                            Margin="0,0,20,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding ManualTestCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="#3b82f6"
                                        CornerRadius="6">
                                        <StackPanel Orientation="Horizontal">
                                            <Image
                                                x:Name="DeviceImage"
                                                Width="15"
                                                Height="15"
                                                Margin="5,0,5,0"
                                                Source="/Resources/Logo/hand_w.png" />
                                            <TextBlock
                                                x:Name="DeviceAction"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Foreground="White"
                                                Text="手动测试" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsManualTestRunning}" Value="True">
                                            <Setter Property="Tag" Value="True" />
                                            <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                            <Setter TargetName="DeviceAction" Property="Text" Value="停止测试" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsManualTestRunning}" Value="False">
                                            <Setter Property="Tag" Value="False" />
                                        </DataTrigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="False" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                        </MultiTrigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="True" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                        </MultiTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button
                            Width="100"
                            Height="32"
                            Margin="0,0,30,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding AutoTestCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="#22c55e"
                                        CornerRadius="6">
                                        <StackPanel Orientation="Horizontal">
                                            <Image
                                                x:Name="DeviceImage"
                                                Width="15"
                                                Height="15"
                                                Margin="5,0,5,0"
                                                Source="/Resources/Logo/auto.png" />
                                            <TextBlock
                                                x:Name="DeviceAction"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Foreground="White"
                                                Text="自动测试" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsAutoTestRunning}" Value="True">
                                            <Setter Property="Tag" Value="True" />
                                            <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                            <Setter TargetName="DeviceAction" Property="Text" Value="停止测试" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAutoTestRunning}" Value="False">
                                            <Setter Property="Tag" Value="False" />
                                        </DataTrigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="False" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#16a34a" />
                                        </MultiTrigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="True" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                        </MultiTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                            <Setter Property="Cursor" Value="Arrow" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Grid.Row="1"
                Margin="8,4,8,10"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="10,5,0,5"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="测试步骤" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,0,10,5">

                            <Border
                                Margin="0,5,0,0"
                                Padding="5"
                                Background="#fef3c7"
                                BorderBrush="#f59e0b"
                                BorderThickness="1"
                                CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Foreground="#92400e"
                                        Text="前置条件：" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        Foreground="#92400e"
                                        Text="组件下电"
                                        TextWrapping="Wrap" />
                                    <Border
                                        Grid.Column="2"
                                        Margin="5,0"
                                        Padding="8,3"
                                        CornerRadius="4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#fecaca" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPowerOn}" Value="False">
                                                        <Setter Property="Background" Value="#bbf7d0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Text="{Binding PowerStatus}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#dc2626" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPowerOn}" Value="False">
                                                            <Setter Property="Foreground" Value="#16a34a" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <!--  继电器激活/复位按钮  -->
                                    <Button
                                        Grid.Column="3"
                                        Height="28"
                                        Margin="5,0,0,0"
                                        Command="{Binding ToggleRelayCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Content" Value="激活" />
                                                <Setter Property="Background" Value="#f59e0b" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border
                                                                Padding="12,3"
                                                                Background="{TemplateBinding Background}"
                                                                CornerRadius="4">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRelayActivated}" Value="True">
                                                        <Setter Property="Content" Value="复位" />
                                                        <Setter Property="Background" Value="#6b7280" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#d97706" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="True">
                                                        <Setter Property="Background" Value="#9ca3af" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border
                                Margin="0,10,0,0"
                                Padding="10"
                                Background="#f8fafc"
                                BorderBrush="#e2e8f0"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Text="a) 接地测试" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="#666"
                                            Text="给接地信号[0-2V]，测J6-J13对地阻抗应&lt;10Ω"
                                            TextWrapping="Wrap" />
                                        <Border
                                            Grid.Column="2"
                                            Margin="10,0"
                                            Padding="10,3"
                                            CornerRadius="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#f3f4f6" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StepAResult}" Value="PASS">
                                                            <Setter Property="Background" Value="#dcfce7" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StepAResult}" Value="FAIL">
                                                            <Setter Property="Background" Value="#fee2e2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontWeight="Bold"
                                                Text="{Binding StepAResult}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#6b7280" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StepAResult}" Value="PASS">
                                                                <Setter Property="Foreground" Value="#16a34a" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StepAResult}" Value="FAIL">
                                                                <Setter Property="Foreground" Value="#dc2626" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <!--  接地信号按钮  -->
                                        <Button
                                            Grid.Column="3"
                                            Width="70"
                                            Height="26"
                                            Margin="0,0,5,0"
                                            Command="{Binding SetGroundedSignalCommand}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border
                                                        x:Name="border"
                                                        Padding="8,3"
                                                        Background="#f59e0b"
                                                        CornerRadius="4">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            Foreground="White"
                                                            Text="接地信号" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#d97706" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button
                                            Grid.Column="4"
                                            Width="70"
                                            Height="26"
                                            Command="{Binding StepACommand}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border
                                                        x:Name="border"
                                                        Padding="8,3"
                                                        Background="#3b82f6"
                                                        CornerRadius="4">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            Foreground="White"
                                                            Text="全部测量" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                    <!--  J6-J13测量表格  -->
                                    <Border
                                        Margin="0,8,0,0"
                                        Padding="5"
                                        Background="White"
                                        BorderBrush="#e2e8f0"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!--  J6  -->
                                            <StackPanel
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="2">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Text="J6" />
                                                <Border
                                                    Margin="0,2"
                                                    Padding="3,2"
                                                    Background="#f8fafc"
                                                    BorderBrush="#d1d5db"
                                                    BorderThickness="1"
                                                    CornerRadius="3">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        FontFamily="Consolas"
                                                        FontSize="10"
                                                        Text="{Binding ImpedanceJ6, StringFormat={}{0:F3}}" />
                                                </Border>
                                                <Button
                                                    Height="20"
                                                    Margin="0,2"
                                                    Command="{Binding MeasureJ6Command}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border
                                                                x:Name="border"
                                                                Padding="4,1"
                                                                Background="#3b82f6"
                                                                CornerRadius="3">
                                                                <TextBlock
                                                                    HorizontalAlignment="Center"
                                                                    FontSize="10"
                                                                    Foreground="White"
                                                                    Text="测量" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                            <!--  J7  -->
                                            <StackPanel
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="2">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Text="J7" />
                                                <Border
                                                    Margin="0,2"
                                                    Padding="3,2"
                                                    Background="#f8fafc"
                                                    BorderBrush="#d1d5db"
                                                    BorderThickness="1"
                                                    CornerRadius="3">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        FontFamily="Consolas"
                                                        FontSize="10"
                                                        Text="{Binding ImpedanceJ7, StringFormat={}{0:F3}}" />
                                                </Border>
                                                <Button
                                                    Height="20"
                                                    Margin="0,2"
                                                    Command="{Binding MeasureJ7Command}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border
                                                                x:Name="border"
                                                                Padding="4,1"
                                                                Background="#3b82f6"
                                                                CornerRadius="3">
                                                                <TextBlock
                                                                    HorizontalAlignment="Center"
                                                                    FontSize="10"
                                                                    Foreground="White"
                                                                    Text="测量" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                            <!--  J8  -->
                                            <StackPanel
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                Margin="2">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Text="J8" />
                                                <Border
                                                    Margin="0,2"
                                                    Padding="3,2"
                                                    Background="#f8fafc"
                                                    BorderBrush="#d1d5db"
                                                    BorderThickness="1"
                                                    CornerRadius="3">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        FontFamily="Consolas"
                                                        FontSize="10"
                                                        Text="{Binding ImpedanceJ8, StringFormat={}{0:F3}}" />
                                                </Border>
                                                <Button
                                                    Height="20"
                                                    Margin="0,2"
                                                    Command="{Binding MeasureJ8Command}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border
                                                                x:Name="border"
                                                                Padding="4,1"
                                                                Background="#3b82f6"
                                                                CornerRadius="3">
                                                                <TextBlock
                                                                    HorizontalAlignment="Center"
                                                                    FontSize="10"
                                                                    Foreground="White"
                                                                    Text="测量" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                            <!--  J9  -->
                                            <StackPanel
                                                Grid.Row="0"
                                                Grid.Column="3"
                                                Margin="2">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Text="J9" />
                                                <Border
                                                    Margin="0,2"
                                                    Padding="3,2"
                                                    Background="#f8fafc"
                                                    BorderBrush="#d1d5db"
                                                    BorderThickness="1"
                                                    CornerRadius="3">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        FontFamily="Consolas"
                                                        FontSize="10"
                                                        Text="{Binding ImpedanceJ9, StringFormat={}{0:F3}}" />
                                                </Border>
                                                <Button
                                                    Height="20"
                                                    Margin="0,2"
                                                    Command="{Binding MeasureJ9Command}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border
                                                                x:Name="border"
                                                                Padding="4,1"
                                                                Background="#3b82f6"
                                                                CornerRadius="3">
                                                                <TextBlock
                                                                    HorizontalAlignment="Center"
                                                                    FontSize="10"
                                                                    Foreground="White"
                                                                    Text="测量" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                            <!--  J10  -->
                                            <StackPanel
                                                Grid.Row="0"
                                                Grid.Column="4"
                                                Margin="2">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Text="J10" />
                                                <Border
                                                    Margin="0,2"
                                                    Padding="3,2"
                                                    Background="#f8fafc"
                                                    BorderBrush="#d1d5db"
                                                    BorderThickness="1"
                                                    CornerRadius="3">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        FontFamily="Consolas"
                                                        FontSize="10"
                                                        Text="{Binding ImpedanceJ10, StringFormat={}{0:F3}}" />
                                                </Border>
                                                <Button
                                                    Height="20"
                                                    Margin="0,2"
                                                    Command="{Binding MeasureJ10Command}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border
                                                                x:Name="border"
                                                                Padding="4,1"
                                                                Background="#3b82f6"
                                                                CornerRadius="3">
                                                                <TextBlock
                                                                    HorizontalAlignment="Center"
                                                                    FontSize="10"
                                                                    Foreground="White"
                                                                    Text="测量" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                            <!--  J11  -->
                                            <StackPanel
                                                Grid.Row="0"
                                                Grid.Column="5"
                                                Margin="2">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Text="J11" />
                                                <Border
                                                    Margin="0,2"
                                                    Padding="3,2"
                                                    Background="#f8fafc"
                                                    BorderBrush="#d1d5db"
                                                    BorderThickness="1"
                                                    CornerRadius="3">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        FontFamily="Consolas"
                                                        FontSize="10"
                                                        Text="{Binding ImpedanceJ11, StringFormat={}{0:F3}}" />
                                                </Border>
