<UserControl
    x:Class="MeasureControl.Views.SingleBoardTest.FuelController.DiscreteOutputTestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MeasureControl.Views.SingleBoardTest.FuelController"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="550"
    d:DesignWidth="970"
    mc:Ignorable="d">
    <Grid
        x:Name="RootGrid"
        Background="White"
        Focusable="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.8*" />
                <RowDefinition Height="6*" />
            </Grid.RowDefinitions>

            <Border
                x:Name="Test_name"
                Grid.Row="0"
                Margin="8,8,8,4"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">
                <Grid>
                    <TextBlock
                        Width="320"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="24"
                        FontWeight="Bold"
                        Text="离散量输出功能测试" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            Width="100"
                            Height="32"
                            Margin="0,0,20,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding ManualTestCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="#3b82f6"
                                        CornerRadius="6">
                                        <StackPanel Orientation="Horizontal">
                                            <Image
                                                x:Name="DeviceImage"
                                                Width="15"
                                                Height="15"
                                                Margin="5,0,5,0"
                                                Source="/Resources/Logo/hand_w.png" />
                                            <TextBlock
                                                x:Name="DeviceAction"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Foreground="White"
                                                Text="手动测试" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsManualTestRunning}" Value="True">
                                            <Setter Property="Tag" Value="True" />
                                            <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                            <Setter TargetName="DeviceAction" Property="Text" Value="停止测试" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsManualTestRunning}" Value="False">
                                            <Setter Property="Tag" Value="False" />
                                        </DataTrigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="False" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                        </MultiTrigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="True" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                        </MultiTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button
                            Width="100"
                            Height="32"
                            Margin="0,0,30,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding AutoTestCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="#22c55e"
                                        CornerRadius="6">
                                        <StackPanel Orientation="Horizontal">
                                            <Image
                                                x:Name="DeviceImage"
                                                Width="15"
                                                Height="15"
                                                Margin="5,0,5,0"
                                                Source="/Resources/Logo/auto.png" />
                                            <TextBlock
                                                x:Name="DeviceAction"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Foreground="White"
                                                Text="自动测试" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsAutoTestRunning}" Value="True">
                                            <Setter Property="Tag" Value="True" />
                                            <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                            <Setter TargetName="DeviceAction" Property="Text" Value="停止测试" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAutoTestRunning}" Value="False">
                                            <Setter Property="Tag" Value="False" />
                                        </DataTrigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="False" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#16a34a" />
                                        </MultiTrigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="True" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                        </MultiTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                            <Setter Property="Cursor" Value="Arrow" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Grid.Row="1"
                Margin="8,4,8,10"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="10,5,0,5"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="测试步骤" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,0,10,5">

                            <Border Margin="0,5,0,0" Background="#fef3c7" BorderBrush="#f59e0b" BorderThickness="1" CornerRadius="5" Padding="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="前置条件：" FontWeight="Bold" VerticalAlignment="Center" Foreground="#92400e"/>
                                    <TextBlock Grid.Column="1" Text="组件下电" VerticalAlignment="Center" Foreground="#92400e" Margin="5,0" TextWrapping="Wrap"/>
                                    <Border Grid.Column="2" CornerRadius="4" Padding="8,3" Margin="5,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#fecaca"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPowerOn}" Value="False">
                                                        <Setter Property="Background" Value="#bbf7d0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding PowerStatus}" FontWeight="Bold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#dc2626"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPowerOn}" Value="False">
                                                            <Setter Property="Foreground" Value="#16a34a"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <!-- 继电器激活/复位按钮 -->
                                    <Button Grid.Column="3" Command="{Binding ToggleRelayCommand}" Height="28" Margin="5,0,0,0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Content" Value="激活"/>
                                                <Setter Property="Background" Value="#f59e0b"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="12,3">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRelayActivated}" Value="True">
                                                        <Setter Property="Content" Value="复位"/>
                                                        <Setter Property="Background" Value="#6b7280"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#d97706"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="True">
                                                        <Setter Property="Background" Value="#9ca3af"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border Margin="0,10,0,0" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="a) 接地测试" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="给接地信号[0-2V]，测J6-J13对地阻抗应&lt;10Ω" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#666" TextWrapping="Wrap"/>
                                        <Border Grid.Column="2" CornerRadius="4" Margin="10,0" Padding="10,3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#f3f4f6"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StepAResult}" Value="PASS">
                                                            <Setter Property="Background" Value="#dcfce7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StepAResult}" Value="FAIL">
                                                            <Setter Property="Background" Value="#fee2e2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StepAResult}" HorizontalAlignment="Center" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#6b7280"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StepAResult}" Value="PASS">
                                                                <Setter Property="Foreground" Value="#16a34a"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StepAResult}" Value="FAIL">
                                                                <Setter Property="Foreground" Value="#dc2626"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <!-- 接地信号按钮 -->
                                        <Button Grid.Column="3" Command="{Binding SetGroundedSignalCommand}" Height="26" Width="70" Margin="0,0,5,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="#f59e0b" CornerRadius="4" Padding="8,3">
                                                        <TextBlock Text="接地信号" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#d97706"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="border" Property="Background" Value="#9ca3af"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Grid.Column="4" Command="{Binding StepACommand}" Height="26" Width="70">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="#3b82f6" CornerRadius="4" Padding="8,3">
                                                        <TextBlock Text="全部测量" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#2563eb"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="border" Property="Background" Value="#9ca3af"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                    <!-- J6-J13测量表格 -->
                                    <Border Margin="0,8,0,0" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="4" Padding="5">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- J6 -->
                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="2">
                                                <TextBlock Text="J6" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11"/>
                                                <Border Background="#f8fafc" BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="3" Padding="3,2" Margin="0,2">
                                                    <TextBlock Text="{Binding ImpedanceJ6, StringFormat={}{0:F3}}" HorizontalAlignment="Center" FontSize="10" FontFamily="Consolas"/>
                                                </Border>
                                                <Button Command="{Binding MeasureJ6Command}" Height="20" Margin="0,2">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="border" Background="#3b82f6" CornerRadius="3" Padding="4,1">
                                                                <TextBlock Text="测量" Foreground="White" HorizontalAlignment="Center" FontSize="10"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#2563eb"/>
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                            <!-- J7 -->
                                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="2">
                                                <TextBlock Text="J7" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11"/>
                                                <Border Background="#f8fafc" BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="3" Padding="3,2" Margin="0,2">
                                                    <TextBlock Text="{Binding ImpedanceJ7, StringFormat={}{0:F3}}" HorizontalAlignment="Center" FontSize="10" FontFamily="Consolas"/>
                                                </Border>
                                                <Button Command="{Binding MeasureJ7Command}" Height="20" Margin="0,2">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="border" Background="#3b82f6" CornerRadius="3" Padding="4,1">
                                                                <TextBlock Text="测量" Foreground="White" HorizontalAlignment="Center" FontSize="10"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#2563eb"/>
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                            <!-- J8 -->
                                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="2">
                                                <TextBlock Text="J8" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11"/>
                                                <Border Background="#f8fafc" BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="3" Padding="3,2" Margin="0,2">
                                                    <TextBlock Text="{Binding ImpedanceJ8, StringFormat={}{0:F3}}" HorizontalAlignment="Center" FontSize="10" FontFamily="Consolas"/>
                                                </Border>
                                                <Button Command="{Binding MeasureJ8Command}" Height="20" Margin="0,2">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="border" Background="#3b82f6" CornerRadius="3" Padding="4,1">
                                                                <TextBlock Text="测量" Foreground="White" HorizontalAlignment="Center" FontSize="10"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#2563eb"/>
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                            <!-- J9 -->
                                            <StackPanel Grid.Row="0" Grid.Column="3" Margin="2">
                                                <TextBlock Text="J9" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11"/>
                                                <Border Background="#f8fafc" BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="3" Padding="3,2" Margin="0,2">
                                                    <TextBlock Text="{Binding ImpedanceJ9, StringFormat={}{0:F3}}" HorizontalAlignment="Center" FontSize="10" FontFamily="Consolas"/>
                                                </Border>
                                                <Button Command="{Binding MeasureJ9Command}" Height="20" Margin="0,2">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="border" Background="#3b82f6" CornerRadius="3" Padding="4,1">
                                                                <TextBlock Text="测量" Foreground="White" HorizontalAlignment="Center" FontSize="10"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#2563eb"/>
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                            <!-- J10 -->
                                            <StackPanel Grid.Row="0" Grid.Column="4" Margin="2">
                                                <TextBlock Text="J10" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11"/>
                                                <Border Background="#f8fafc" BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="3" Padding="3,2" Margin="0,2">
                                                    <TextBlock Text="{Binding ImpedanceJ10, StringFormat={}{0:F3}}" HorizontalAlignment="Center" FontSize="10" FontFamily="Consolas"/>
                                                </Border>
                                                <Button Command="{Binding MeasureJ10Command}" Height="20" Margin="0,2">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="border" Background="#3b82f6" CornerRadius="3" Padding="4,1">
                                                                <TextBlock Text="测量" Foreground="White" HorizontalAlignment="Center" FontSize="10"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#2563eb"/>
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                            <!-- J11 -->
                                            <StackPanel Grid.Row="0" Grid.Column="5" Margin="2">
                                                <TextBlock Text="J11" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11"/>
                                                <Border Background="#f8fafc" BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="3" Padding="3,2" Margin="0,2">
                                                    <TextBlock Text="{Binding ImpedanceJ11, StringFormat={}{0:F3}}" HorizontalAlignment="Center" FontSize="10" FontFamily="Consolas"/>
                                                </Border>
                                                <Button Command="{Binding MeasureJ11Command}" Height="20" Margin="0,2">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="border" Background="#3b82f6" CornerRadius="3" Padding="4,1">
                                                                <TextBlock Text="测量" Foreground="White" HorizontalAlignment="Center" FontSize="10"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#2563eb"/>
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                            <!-- J12 -->
                                            <StackPanel Grid.Row="0" Grid.Column="6" Margin="2">
                                                <TextBlock Text="J12" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11"/>
                                                <Border Background="#f8fafc" BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="3" Padding="3,2" Margin="0,2">
                                                    <TextBlock Text="{Binding ImpedanceJ12, StringFormat={}{0:F3}}" HorizontalAlignment="Center" FontSize="10" FontFamily="Consolas"/>
                                                </Border>
                                                <Button Command="{Binding MeasureJ12Command}" Height="20" Margin="0,2">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="border" Background="#3b82f6" CornerRadius="3" Padding="4,1">
                                                                <TextBlock Text="测量" Foreground="White" HorizontalAlignment="Center" FontSize="10"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#2563eb"/>
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                            <!-- J13 -->
                                            <StackPanel Grid.Row="0" Grid.Column="7" Margin="2">
                                                <TextBlock Text="J13" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11"/>
                                                <Border Background="#f8fafc" BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="3" Padding="3,2" Margin="0,2">
                                                    <TextBlock Text="{Binding ImpedanceJ13, StringFormat={}{0:F3}}" HorizontalAlignment="Center" FontSize="10" FontFamily="Consolas"/>
                                                </Border>
                                                <Button Command="{Binding MeasureJ13Command}" Height="20" Margin="0,2">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="border" Background="#3b82f6" CornerRadius="3" Padding="4,1">
                                                                <TextBlock Text="测量" Foreground="White" HorizontalAlignment="Center" FontSize="10"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#2563eb"/>
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,5,0,0" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
