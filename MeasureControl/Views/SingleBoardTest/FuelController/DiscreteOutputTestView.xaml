<UserControl
    x:Class="MeasureControl.Views.SingleBoardTest.FuelController.DiscreteOutputTestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MeasureControl.Views.SingleBoardTest.FuelController"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="550"
    d:DesignWidth="970"
    mc:Ignorable="d">
    <Grid
        x:Name="RootGrid"
        Background="White"
        Focusable="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.8*" />
                <RowDefinition Height="6*" />
                <RowDefinition Height="1.2*" />
            </Grid.RowDefinitions>

            <Border
                x:Name="Test_name"
                Grid.Row="0"
                Margin="8,8,8,4"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">
                <Grid>
                    <TextBlock
                        Width="320"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="24"
                        FontWeight="Bold"
                        Text="离散量输出功能测试" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            Width="100"
                            Height="32"
                            Margin="0,0,20,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding ManualTestCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="#3b82f6"
                                        CornerRadius="6">
                                        <StackPanel Orientation="Horizontal">
                                            <Image
                                                x:Name="DeviceImage"
                                                Width="15"
                                                Height="15"
                                                Margin="5,0,5,0"
                                                Source="/Resources/Logo/hand_w.png" />
                                            <TextBlock
                                                x:Name="DeviceAction"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Foreground="White"
                                                Text="手动测试" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsManualTestRunning}" Value="True">
                                            <Setter Property="Tag" Value="True" />
                                            <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                            <Setter TargetName="DeviceAction" Property="Text" Value="停止测试" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsManualTestRunning}" Value="False">
                                            <Setter Property="Tag" Value="False" />
                                        </DataTrigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="False" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                        </MultiTrigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="True" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                        </MultiTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button
                            Width="100"
                            Height="32"
                            Margin="0,0,30,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding AutoTestCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="#22c55e"
                                        CornerRadius="6">
                                        <StackPanel Orientation="Horizontal">
                                            <Image
                                                x:Name="DeviceImage"
                                                Width="15"
                                                Height="15"
                                                Margin="5,0,5,0"
                                                Source="/Resources/Logo/auto.png" />
                                            <TextBlock
                                                x:Name="DeviceAction"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Foreground="White"
                                                Text="自动测试" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsAutoTestRunning}" Value="True">
                                            <Setter Property="Tag" Value="True" />
                                            <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                            <Setter TargetName="DeviceAction" Property="Text" Value="停止测试" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAutoTestRunning}" Value="False">
                                            <Setter Property="Tag" Value="False" />
                                        </DataTrigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="False" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#16a34a" />
                                        </MultiTrigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="True" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                        </MultiTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                            <Setter Property="Cursor" Value="Arrow" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Grid.Row="1"
                Margin="8,4,8,4"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="10,5,0,5"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="测试步骤" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,5,10,5">

                            <Border Margin="0,10,0,0" Background="#fef3c7" BorderBrush="#f59e0b" BorderThickness="1" CornerRadius="6" Padding="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="前置条件：" FontWeight="Bold" VerticalAlignment="Center" Foreground="#92400e"/>
                                    <TextBlock Grid.Column="1" Text="手动测试需先点击'手动测试'进入运行状态，再执行步骤a/b/c。" VerticalAlignment="Center" Foreground="#92400e" Margin="5,0" TextWrapping="Wrap"/>
                                    <Border Grid.Column="2" CornerRadius="4" Padding="8,3" Margin="5,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#fecaca"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPowerOn}" Value="True">
                                                        <Setter Property="Background" Value="#bbf7d0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding PowerStatus}" FontWeight="Bold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#dc2626"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPowerOn}" Value="True">
                                                            <Setter Property="Foreground" Value="#16a34a"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Margin="0,10,0,0" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="a) 接地测试" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="组件下电，DO输出接地开信号，测对地阻抗应&lt;10Ω" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="#666" TextWrapping="Wrap"/>
                                        <Border Grid.Column="2" CornerRadius="4" Margin="10,0" Padding="10,3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#f3f4f6"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StepAResult}" Value="PASS">
                                                            <Setter Property="Background" Value="#dcfce7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StepAResult}" Value="FAIL">
                                                            <Setter Property="Background" Value="#fee2e2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StepAResult}" HorizontalAlignment="Center" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#6b7280"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StepAResult}" Value="PASS">
                                                                <Setter Property="Foreground" Value="#16a34a"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StepAResult}" Value="FAIL">
                                                                <Setter Property="Foreground" Value="#dc2626"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <Button Grid.Column="3" Command="{Binding StepACommand}" Height="26" Width="80">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="#3b82f6" CornerRadius="4" Padding="10,3">
                                                        <TextBlock Text="接地测试" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#2563eb"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="border" Property="Background" Value="#9ca3af"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="测量值(Ω):" FontWeight="Bold" Margin="0,2"/>
                                        <Border Grid.Column="1" Background="White" BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="4" Margin="10,2" Padding="10,3">
                                            <TextBlock Text="{Binding ImpedanceGrounded}" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="b) 开路测试" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="组件下电，DO输出开路，测对地阻抗应>100kΩ" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="#666" TextWrapping="Wrap"/>
                                        <Border Grid.Column="2" CornerRadius="4" Margin="10,0" Padding="10,3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#f3f4f6"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StepBResult}" Value="PASS">
                                                            <Setter Property="Background" Value="#dcfce7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StepBResult}" Value="FAIL">
                                                            <Setter Property="Background" Value="#fee2e2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StepBResult}" HorizontalAlignment="Center" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#6b7280"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StepBResult}" Value="PASS">
                                                                <Setter Property="Foreground" Value="#16a34a"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StepBResult}" Value="FAIL">
                                                                <Setter Property="Foreground" Value="#dc2626"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <Button Grid.Column="3" Command="{Binding StepBCommand}" Height="26" Width="80">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="#3b82f6" CornerRadius="4" Padding="10,3">
                                                        <TextBlock Text="开路测试" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#2563eb"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="border" Property="Background" Value="#9ca3af"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="测量值(Ω):" FontWeight="Bold" Margin="0,2"/>
                                        <Border Grid.Column="1" Background="White" BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="4" Margin="10,2" Padding="10,3">
                                            <TextBlock Text="{Binding ImpedanceOpen}" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="c) 电压测试" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="组件28V供电，测J14电压应≥16V" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="#666" TextWrapping="Wrap"/>
                                        <Border Grid.Column="2" CornerRadius="4" Margin="10,0" Padding="10,3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#f3f4f6"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StepCResult}" Value="PASS">
                                                            <Setter Property="Background" Value="#dcfce7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StepCResult}" Value="FAIL">
                                                            <Setter Property="Background" Value="#fee2e2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StepCResult}" HorizontalAlignment="Center" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#6b7280"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StepCResult}" Value="PASS">
                                                                <Setter Property="Foreground" Value="#16a34a"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StepCResult}" Value="FAIL">
                                                                <Setter Property="Foreground" Value="#dc2626"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <Button Grid.Column="3" Command="{Binding StepCCommand}" Height="26" Width="80">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="#3b82f6" CornerRadius="4" Padding="10,3">
                                                        <TextBlock Text="电压测试" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#2563eb"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="border" Property="Background" Value="#9ca3af"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="测量值(V):" FontWeight="Bold" Margin="0,2"/>
                                        <Border Grid.Column="1" Background="White" BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="4" Margin="10,2" Padding="10,3">
                                            <TextBlock Text="{Binding J14Voltage}" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0" Background="#f0fdf4" BorderBrush="#22c55e" BorderThickness="1" CornerRadius="6" Padding="6">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Foreground="#166534" Text="测试判据："/>
                                    <TextBlock Margin="0,5,0,0" Foreground="#166534" Text="• a) 接地：对地阻抗&lt;10Ω"/>
                                    <TextBlock Margin="0,2,0,0" Foreground="#166534" Text="• b) 开路：对地阻抗>100kΩ"/>
                                    <TextBlock Margin="0,2,0,0" Foreground="#166534" Text="• c) 电压：J14电压≥16V"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Grid.Column="1"
                        Margin="5"
                        Background="#f8fafc"
                        BorderBrush="#e2e8f0"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="10,10,0,5" FontSize="16" FontWeight="Bold" Text="测试日志"/>
                                <Button Grid.Column="1"
                                        Width="80" Height="28"
                                        Margin="0,5,10,5"
                                        VerticalAlignment="Center"
                                        BorderThickness="0"
                                        Command="{Binding ClearLogCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="#3b82f6" CornerRadius="4">
                                                <TextBlock x:Name="btnText"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="14"
                                                           Foreground="White"
                                                           Text="清除内容"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af"/>
                                                    <Setter Property="Cursor" Value="Arrow"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <Border Grid.Row="1" Margin="5" Background="White" BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Logs}" Margin="5">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,1"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="10,5">
                        <TextBlock Text="综合结果：" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Border CornerRadius="4" Padding="15,5" Margin="10,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#f3f4f6"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OverallResult}" Value="PASS">
                                            <Setter Property="Background" Value="#dcfce7"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OverallResult}" Value="FAIL">
                                            <Setter Property="Background" Value="#fee2e2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding OverallResult}" FontSize="16" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#6b7280"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OverallResult}" Value="PASS">
                                                <Setter Property="Foreground" Value="#16a34a"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OverallResult}" Value="FAIL">
                                                <Setter Property="Foreground" Value="#dc2626"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <TextBlock Text="上次测试时间：" FontSize="14" VerticalAlignment="Center" Margin="20,0,5,0"/>
                        <TextBlock Text="{Binding LastTestTime}" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Grid.Row="2"
                Margin="8,4,8,8"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">
                <StackPanel Orientation="Horizontal" Margin="10,5">
                    <TextBlock Text="测试说明：" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock
                        Margin="10,0,0,0"
                        FontSize="14"
                        Foreground="#666"
                        TextWrapping="Wrap"
                        Text="a) 组件下电，DO输出接地开信号，测对地阻抗应&lt;10Ω；b) 组件下电，DO输出开路，测对地阻抗应>100kΩ；c) 组件28V供电，测J14电压应≥16V。" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
