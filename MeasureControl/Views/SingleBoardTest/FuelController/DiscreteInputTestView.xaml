<UserControl
    x:Class="MeasureControl.Views.SingleBoardTest.FuelController.DiscreteInputTestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MeasureControl.Views.SingleBoardTest.FuelController"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="1000"
    mc:Ignorable="d">
    <Grid
        x:Name="RootGrid"
        Background="White"
        Focusable="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.8*" />
                <RowDefinition Height="6*" />
                <RowDefinition Height="1.2*" />
            </Grid.RowDefinitions>

            <!--  标题栏  -->
            <Border
                x:Name="Test_name"
                Grid.Row="0"
                Margin="8,8,8,4"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">
                <Grid>
                    <TextBlock
                        Width="300"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="24"
                        FontWeight="Bold"
                        Text="离散量采集功能测试" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <!--  手动测试按钮  -->
                        <Button
                            Width="100"
                            Height="32"
                            Margin="0,0,20,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding ManualTestCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="#3b82f6"
                                        CornerRadius="6">
                                        <StackPanel Orientation="Horizontal">
                                            <Image
                                                x:Name="DeviceImage"
                                                Width="15"
                                                Height="15"
                                                Margin="5,0,5,0"
                                                Source="/Resources/Logo/hand_w.png" />
                                            <TextBlock
                                                x:Name="DeviceAction"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Foreground="White"
                                                Text="手动测试" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsManualTestRunning}" Value="True">
                                            <Setter Property="Tag" Value="True" />
                                            <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                            <Setter TargetName="DeviceAction" Property="Text" Value="停止测试" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsManualTestRunning}" Value="False">
                                            <Setter Property="Tag" Value="False" />
                                        </DataTrigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="False" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                        </MultiTrigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="True" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                        </MultiTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!--  自动测试按钮  -->
                        <Button
                            Width="100"
                            Height="32"
                            Margin="0,0,30,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{Binding AutoTestCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="#22c55e"
                                        CornerRadius="6">
                                        <StackPanel Orientation="Horizontal">
                                            <Image
                                                x:Name="DeviceImage"
                                                Width="15"
                                                Height="15"
                                                Margin="5,0,5,0"
                                                Source="/Resources/Logo/auto.png" />
                                            <TextBlock
                                                x:Name="DeviceAction"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Foreground="White"
                                                Text="自动测试" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsAutoTestRunning}" Value="True">
                                            <Setter Property="Tag" Value="True" />
                                            <Setter TargetName="border" Property="Background" Value="#ef4444" />
                                            <Setter TargetName="DeviceAction" Property="Text" Value="停止测试" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAutoTestRunning}" Value="False">
                                            <Setter Property="Tag" Value="False" />
                                        </DataTrigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="False" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#15803d" />
                                        </MultiTrigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="True" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#b91c1c" />
                                        </MultiTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  主内容区  -->
            <Border
                Grid.Row="1"
                Margin="8,4,8,4"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="10,5,0,5"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="测试步骤（组件28V供电状态）" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,5,10,5">

                            <!--  供电状态提示区域  -->
                            <Border
                                Margin="0,10,0,0"
                                Padding="6"
                                Background="#fef3c7"
                                BorderBrush="#f59e0b"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Foreground="#92400e"
                                        Text="前置条件：" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        Foreground="#92400e"
                                        Text="提供28V供电" />
                                    <Border
                                        Grid.Column="2"
                                        Margin="5,0"
                                        Padding="8,3"
                                        CornerRadius="4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#fecaca" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPowerOn}" Value="True">
                                                        <Setter Property="Background" Value="#bbf7d0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Text="{Binding PowerStatus}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#dc2626" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPowerOn}" Value="True">
                                                            <Setter Property="Foreground" Value="#16a34a" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>

                            <!--  测试项目a: 接地测试  -->
                            <Border
                                Margin="0,10,0,0"
                                Padding="10"
                                Background="#f8fafc"
                                BorderBrush="#e2e8f0"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Text="a) 接地测试" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="20,0,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="#666"
                                            Text="提供[0,2V]电压输入，所有采集通道结果均为1" />
                                        <Border
                                            Grid.Column="2"
                                            Margin="10,0"
                                            Padding="10,3"
                                            CornerRadius="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#f3f4f6" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding GroundedTestResult}" Value="PASS">
                                                            <Setter Property="Background" Value="#dcfce7" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding GroundedTestResult}" Value="FAIL">
                                                            <Setter Property="Background" Value="#fee2e2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontWeight="Bold"
                                                Text="{Binding GroundedTestResult}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#6b7280" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding GroundedTestResult}" Value="PASS">
                                                                <Setter Property="Foreground" Value="#16a34a" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding GroundedTestResult}" Value="FAIL">
                                                                <Setter Property="Foreground" Value="#dc2626" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <Button
                                            Grid.Column="3"
                                            Width="80"
                                            Height="26"
                                            Command="{Binding GroundedTestCommand}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border
                                                        x:Name="border"
                                                        Padding="10,3"
                                                        Background="#3b82f6"
                                                        CornerRadius="4">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            Foreground="White"
                                                            Text="接地测试" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                    <!--  Bank结果显示  -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0,2"
                                            FontWeight="Bold"
                                            Text="Bank0[0:6]:" />
                                        <Border
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="10,2"
                                            Padding="10,3"
                                            Background="White"
                                            BorderBrush="#d1d5db"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontFamily="Consolas"
                                                Text="{Binding Bank0GroundedResults}" />
                                        </Border>
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Margin="0,2"
                                            FontWeight="Bold"
                                            Text="Bank1[0:6]:" />
                                        <Border
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="10,2"
                                            Padding="10,3"
                                            Background="White"
                                            BorderBrush="#d1d5db"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontFamily="Consolas"
                                                Text="{Binding Bank1GroundedResults}" />
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!--  测试项目b: 开路测试  -->
                            <Border
                                Margin="0,10,0,0"
                                Padding="10"
                                Background="#f8fafc"
                                BorderBrush="#e2e8f0"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Text="b) 开路测试" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="20,0,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="#666"
                                            Text="置为开路时，所有采集通道结果均为0" />
                                        <Border
                                            Grid.Column="2"
                                            Margin="10,0"
                                            Padding="10,3"
                                            CornerRadius="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#f3f4f6" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OpenTestResult}" Value="PASS">
                                                            <Setter Property="Background" Value="#dcfce7" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding OpenTestResult}" Value="FAIL">
                                                            <Setter Property="Background" Value="#fee2e2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontWeight="Bold"
                                                Text="{Binding OpenTestResult}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#6b7280" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OpenTestResult}" Value="PASS">
                                                                <Setter Property="Foreground" Value="#16a34a" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding OpenTestResult}" Value="FAIL">
                                                                <Setter Property="Foreground" Value="#dc2626" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <Button
                                            Grid.Column="3"
                                            Width="80"
                                            Height="26"
                                            Command="{Binding OpenTestCommand}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border
                                                        x:Name="border"
                                                        Padding="10,3"
                                                        Background="#3b82f6"
                                                        CornerRadius="4">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            Foreground="White"
                                                            Text="开路测试" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#2563eb" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                    <!--  Bank结果显示  -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0,2"
                                            FontWeight="Bold"
                                            Text="Bank0[0:6]:" />
                                        <Border
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="10,2"
                                            Padding="10,3"
                                            Background="White"
                                            BorderBrush="#d1d5db"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontFamily="Consolas"
                                                Text="{Binding Bank0OpenResults}" />
                                        </Border>
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Margin="0,2"
                                            FontWeight="Bold"
                                            Text="Bank1[0:6]:" />
                                        <Border
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="10,2"
                                            Padding="10,3"
                                            Background="White"
                                            BorderBrush="#d1d5db"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontFamily="Consolas"
                                                Text="{Binding Bank1OpenResults}" />
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!--  判据说明  -->
                            <Border
                                Margin="0,10,0,0"
                                Padding="6"
                                Background="#f0fdf4"
                                BorderBrush="#22c55e"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel>
                                    <TextBlock
                                        FontWeight="Bold"
                                        Foreground="#166534"
                                        Text="测试判据：" />
                                    <TextBlock
                                        Margin="0,5,0,0"
                                        Foreground="#166534"
                                        Text="• a) 提供[0, 2V]电压输入时，所有采集通道结果均为1" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        Foreground="#166534"
                                        Text="• b) 置为开路时，所有采集通道结果均为0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  右侧：测试日志区域  -->
                    <Border
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Grid.Column="1"
                        Margin="5"
                        Background="#f8fafc"
                        BorderBrush="#e2e8f0"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Margin="10,10,0,5"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Text="测试日志" />
                                <Button
                                    Grid.Column="1"
                                    Width="80"
                                    Height="28"
                                    Margin="0,5,10,5"
                                    VerticalAlignment="Center"
                                    BorderThickness="0"
                                    Command="{Binding ClearLogCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="border"
                                                Background="#3b82f6"
                                                CornerRadius="4">
                                                <TextBlock
                                                    x:Name="btnText"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Foreground="White"
                                                    Text="清除内容" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <Border
                                Grid.Row="1"
                                Margin="5"
                                Background="White"
                                BorderBrush="#d1d5db"
                                BorderThickness="1"
                                CornerRadius="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl Margin="5" ItemsSource="{Binding Logs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Margin="0,1"
                                                    FontSize="12"
                                                    Text="{Binding}"
                                                    TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>

                    <!--  综合结果区域  -->
                    <StackPanel
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Margin="10,5"
                        Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Text="综合结果：" />
                        <Border
                            Margin="10,0"
                            Padding="15,5"
                            CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#f3f4f6" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OverallResult}" Value="PASS">
                                            <Setter Property="Background" Value="#dcfce7" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OverallResult}" Value="FAIL">
                                            <Setter Property="Background" Value="#fee2e2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="16"
                                FontWeight="Bold"
                                Text="{Binding OverallResult}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#6b7280" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OverallResult}" Value="PASS">
                                                <Setter Property="Foreground" Value="#16a34a" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OverallResult}" Value="FAIL">
                                                <Setter Property="Foreground" Value="#dc2626" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <TextBlock
                            Margin="20,0,5,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="上次测试时间：" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="{Binding LastTestTime}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  底部：测试说明  -->
            <Border
                Grid.Row="2"
                Margin="8,4,8,8"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">
                <StackPanel Margin="10,5" Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
