                                Grid.Row="1"
                                Grid.RowSpan="5"
                                Grid.Column="1"
                                Width="340"
                                Height="360"
                                Margin="5,0,5,5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BorderBrush="#D9D9D9"
                                BorderThickness="1.5"
                                CornerRadius="4">
                                <ListBox
                                    Margin="5"
                                    BorderThickness="0"
                                    ItemsSource="{Binding Logs}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.Resources>
                                        <Style BasedOn="{StaticResource SimpleScrollViewerStyle}" TargetType="ScrollViewer" />
                                    </ListBox.Resources>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontSize="12"
                                                Text="{Binding}"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <Border
                Grid.Row="2"
                Margin="8,4,8,8"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">
                <Grid Grid.Row="2">
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Row="0"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="Black"
                                Text="测试结果：" />
                            <TextBlock
                                FontSize="20"
                                FontWeight="Bold"
                                Text="{Binding CurrentTestResult, TargetNullValue=--, FallbackValue=--}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="Black" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentTestResult}" Value="PASS">
                                                <Setter Property="Foreground" Value="#16a34a" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentTestResult}" Value="FAIL">
                                                <Setter Property="Foreground" Value="#dc2626" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Text="{Binding PreviousTestTime, StringFormat=测试时间：{0}, TargetNullValue=测试时间：--, FallbackValue=测试时间：--}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
