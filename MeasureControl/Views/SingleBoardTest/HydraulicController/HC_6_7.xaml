                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        Text="{Binding PointLowSys1Text, TargetNullValue=---, FallbackValue=---}" />
                                </Border>
                                <TextBlock
                                    Margin="20,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Text="3号系统油量：" />
                                <Border
                                    Width="80"
                                    Height="28"
                                    VerticalAlignment="Center"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <TextBlock
                                        Margin="5,0,1,0"
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        Text="{Binding PointLowSys2Text, TargetNullValue=---, FallbackValue=---}" />
                                </Border>
                                <Button
                                    Width="50"
                                    Height="28"
                                    Margin="15,0,0,0"
                                    VerticalAlignment="Center"
                                    BorderThickness="0"
                                    Command="{Binding MeasureLowPointCommand}"
                                    IsEnabled="{Binding CanMeasureLowPoint, FallbackValue=False}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="border"
                                                Background="#3b82f6"
                                                CornerRadius="4">
                                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                    <TextBlock
                                                        x:Name="DeviceAction"
