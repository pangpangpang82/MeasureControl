                            <StackPanel Margin="20,20,0,0" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Text="(98, 100)% ：" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Text="2号系统油量：" />
                                <Border
                                    Width="80"
                                    Height="28"
                                    VerticalAlignment="Center"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="1"
                                    CornerRadius="3">
