                                        Padding="0,0,0,0"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        BorderThickness="0"
                                        FontSize="15"
                                        LostFocus="IntegerTextBox_LostFocus"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                        Tag="Low"
                                        Text="{Binding ManualRangeLowInput, UpdateSourceTrigger=PropertyChanged}"
                                        TextChanged="IntegerTextBox_TextChanged" />
                                </Border>
                                <TextBlock
                                    Margin="1,0,4,0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Text="," />
                                <Border
                                    Width="32"
                                    Height="24"
                                    VerticalAlignment="Center"
                                    BorderBrush="Black"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <TextBox
                                        Width="32"
                                        Height="20"
                                        Padding="0,0,0,0"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        BorderThickness="0"
                                        FontSize="15"
                                        LostFocus="IntegerTextBox_LostFocus"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                        Tag="High"
                                        Text="{Binding ManualRangeHighInput, UpdateSourceTrigger=PropertyChanged}"
                                        TextChanged="IntegerTextBox_TextChanged" />
                                </Border>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Text=")" />
                                <TextBlock
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Text="% ：" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Text="2号系统油量：" />
                                <Border
                                    Width="80"
                                    Height="28"
                                    VerticalAlignment="Center"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <TextBlock
                                        Margin="5,0,1,0"
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        Text="{Binding CustomRangeSys1Text, TargetNullValue=---, FallbackValue=---}" />
                                </Border>
                                <TextBlock
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Text="3号系统油量：" />
                                <Border
                                    Width="80"
                                    Height="28"
                                    VerticalAlignment="Center"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <TextBlock
                                        Margin="5,0,1,0"
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        Text="{Binding CustomRangeSys2Text, TargetNullValue=---, FallbackValue=---}" />
                                </Border>
                                <Button
                                    Width="50"
                                    Height="28"
                                    Margin="15,0,0,0"
                                    VerticalAlignment="Center"
                                    BorderThickness="0"
                                    Command="{Binding MeasureCustomRangeCommand}"
                                    IsEnabled="{Binding CanMeasureCustomRange, FallbackValue=False}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="border"
                                                Background="#3b82f6"
                                                CornerRadius="4">
                                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                    <TextBlock
                                                        x:Name="DeviceAction"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="14"
                                                        Foreground="White"
                                                        Text="测量" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Border
                        Grid.Column="1"
                        Margin="5"
                        Background="#f8fafc"
                        BorderBrush="#e2e8f0"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Grid VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <StackPanel
                                Grid.Column="1"
                                Margin="10,5,0,5"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,10,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Text="测试日志" />
                                <Button
                                    Width="80"
                                    Height="32"
                                    Margin="170,5,0,0"
                                    VerticalAlignment="Center"
                                    BorderThickness="0"
                                    Command="{Binding ClearLogCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="border"
                                                Background="#3b82f6"
                                                CornerRadius="4">
                                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                    <TextBlock
                                                        x:Name="DeviceAction"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="15"
                                                        Foreground="White"
                                                        Text="清除内容" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                            <Border
                                Grid.Row="1"
                                Grid.RowSpan="5"
                                Grid.Column="1"
                                Width="340"
                                Height="360"
                                Margin="5,0,5,5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BorderBrush="#D9D9D9"
                                BorderThickness="1.5"
                                CornerRadius="4">
                                <ListBox
                                    Margin="5"
                                    BorderThickness="0"
                                    ItemsSource="{Binding Logs}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.Resources>
                                        <Style BasedOn="{StaticResource SimpleScrollViewerStyle}" TargetType="ScrollViewer" />
                                    </ListBox.Resources>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontSize="12"
                                                Text="{Binding}"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <Border
                Grid.Row="2"
                Margin="8,4,8,8"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">
                <Grid Grid.Row="2">
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Text="{Binding CurrentTestResult, StringFormat=测试结果：{0}, TargetNullValue=测试结果：--, FallbackValue=测试结果：--}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="Black" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentTestResult}" Value="合格">
                                            <Setter Property="Foreground" Value="#16a34a" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentTestResult}" Value="不合格">
                                            <Setter Property="Foreground" Value="#dc2626" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock
                            Grid.Column="1"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Text="{Binding PreviousTestTime, StringFormat=测试时间：{0}, TargetNullValue=测试时间：--, FallbackValue=测试时间：--}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>