                                </StackPanel>
                                <StackPanel
                                    Grid.Row="8"
                                    Margin="0,6,0,6"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        Margin="20,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Text="针脚98：" />
                                    <Border
                                        Width="80"
                                        Height="28"
                                        VerticalAlignment="Top"
                                        BorderBrush="#D9D9D9"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <TextBlock
                                            Margin="5,0,1,0"
                                            VerticalAlignment="Center"
                                            FontSize="15"
                                            Text="{Binding Pin98Text, TargetNullValue=---, FallbackValue=---}" />
                                    </Border>
                                    <TextBlock
                                        Margin="20,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Text="针脚99：" />
                                    <Border
                                        Width="80"
                                        Height="28"
                                        VerticalAlignment="Center"
                                        BorderBrush="#D9D9D9"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <TextBlock
                                            Margin="5,0,1,0"
                                            VerticalAlignment="Center"
                                            FontSize="15"
                                            Text="{Binding Pin99Text, TargetNullValue=---, FallbackValue=---}" />
                                    </Border>
                                    <TextBlock
                                        Margin="20,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Text="针脚100：" />
                                    <Border
                                        Width="80"
                                        Height="28"
                                        VerticalAlignment="Top"
                                        BorderBrush="#D9D9D9"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <TextBlock
                                            Margin="5,0,1,0"
                                            VerticalAlignment="Center"
                                            FontSize="15"
                                            Text="{Binding Pin100Text, TargetNullValue=---, FallbackValue=---}" />
                                    </Border>
                                </StackPanel>

                                <Border
                                    Grid.RowSpan="9"
                                    Grid.Column="1"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <Button
                                        Width="50"
                                        Height="28"
                                        Margin="0,0,0,0"
                                        Visibility="Collapsed"
                                        VerticalAlignment="Center"
                                        BorderThickness="0"
                                        Command="{Binding Measure14Command}"
                                        IsEnabled="{Binding CanMeasure14, FallbackValue=False}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    x:Name="border"
                                                    Background="#3b82f6"
                                                    CornerRadius="4">
                                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                        <TextBlock
                                                            x:Name="DeviceAction"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="14"
                                                            Foreground="White"
                                                            Text="测量" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                        <Setter Property="Cursor" Value="Arrow" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Column="1"
                            Margin="10,10,0,10"
                            Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="20"
                                FontWeight="Bold"
                                Text="测试信息" />
                            <Button
                                Width="80"
                                Height="32"
                                Margin="140,5,0,0"
                                VerticalAlignment="Center"
                                BorderThickness="0"
                                Command="{Binding ClearLogCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="border"
                                            Background="#3b82f6"
                                            CornerRadius="4">
                                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                <TextBlock
                                                    x:Name="DeviceAction"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="15"
                                                    Foreground="White"
                                                    Text="清除内容" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="border" Property="Background" Value="#9ca3af" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                        <Border
                            Grid.Row="1"
                            Grid.RowSpan="5"
                            Grid.Column="1"
                            Width="320"
                            Height="360"
                            Margin="0,0,5,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            BorderBrush="#D9D9D9"
                            BorderThickness="1.5"
                            CornerRadius="4">
                            <ListBox
                                Margin="5"
                                BorderThickness="0"
                                ItemsSource="{Binding Logs}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.Resources>
                                    <Style BasedOn="{StaticResource SimpleScrollViewerStyle}" TargetType="ScrollViewer" />
                                </ListBox.Resources>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            FontSize="12"
                                            Text="{Binding}"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                    </Grid>

                </Grid>
            </Border>
            <Border
                Grid.Row="2"
                Margin="8,4,8,8"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1.5"
                CornerRadius="8">
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.5*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="{Binding CurrentTestResult, StringFormat=测试结果：{0}, TargetNullValue=测试结果：--, FallbackValue=测试结果：--}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="Black" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTestResult}" Value="合格">
                                        <Setter Property="Foreground" Value="#16a34a" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentTestResult}" Value="不合格">
                                        <Setter Property="Foreground" Value="#dc2626" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="Bold"
                            Text="{Binding PreviousTestTime, StringFormat=上次测试时间：{0}, TargetNullValue=上次测试时间：--, FallbackValue=上次测试时间：--}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="30,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="Bold"
                            Text="{Binding PreviousTestResult, StringFormat=上次测试结果：{0}, TargetNullValue=上次测试结果：--, FallbackValue=上次测试结果：--}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
