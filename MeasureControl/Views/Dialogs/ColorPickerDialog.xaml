<Window
    x:Class="MeasureControl.Views.Dialogs.ColorPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="选择颜色"
    Width="450"
    Height="320"
    BorderBrush="#1c1c1c"
    BorderThickness="1"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ComboBoxStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="DialogButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#1c1c1c" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Width" Value="70" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#4F5C87" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#4F5C87" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  标题栏  -->
        <Border
            Grid.Row="0"
            Background="#1c1c1c"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="White"
                    Text="选择颜色" />
                <Button
                    Width="30"
                    Height="30"
                    HorizontalAlignment="Right"
                    Click="CloseButton_Click"
                    Content="✖"
                    FontSize="14"
                    Style="{StaticResource DialogButtonStyle}" />
            </Grid>
        </Border>

        <!--  内容区域：2x2布局  -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  左上：HSV色板  -->
            <Border
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,15,0"
                BorderBrush="#d0d3d6"
                BorderThickness="1">
                <Canvas
                    x:Name="ColorCanvas"
                    Background="White"
                    ClipToBounds="True"
                    Cursor="Cross"
                    MouseLeftButtonDown="ColorCanvas_MouseLeftButtonDown"
                    MouseLeftButtonUp="ColorCanvas_MouseLeftButtonUp"
                    MouseMove="ColorCanvas_MouseMove">
                    <!--  色板背景会在代码中绘制  -->
                    <Image x:Name="ColorBoardImage" Stretch="Fill" />
                    <!--  选择指示器  -->
                    <Ellipse
                        x:Name="ColorSelector"
                        Canvas.Left="0"
                        Canvas.Top="0"
                        Width="12"
                        Height="12"
                        IsHitTestVisible="False"
                        Stroke="White"
                        StrokeThickness="2">
                        <Ellipse.Effect>
                            <DropShadowEffect
                                BlurRadius="3"
                                Opacity="0.5"
                                ShadowDepth="1" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Border>

            <!--  左下：颜色预览  -->
            <StackPanel
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,10,15,0">
                <TextBlock
                    Margin="0,0,0,5"
                    FontSize="12"
                    Foreground="#666"
                    Text="颜色预览" />
                <Border
                    x:Name="ColorPreview"
                    Height="40"
                    Background="#e8ebed"
                    BorderBrush="#d0d3d6"
                    BorderThickness="1"
                    CornerRadius="4" />
            </StackPanel>

            <!--  右上：RGB/Hex输入  -->
            <StackPanel
                Grid.Row="0"
                Grid.Column="1"
                Width="130">
                <!--  颜色模式  -->
                <TextBlock
                    Margin="0,0,0,4"
                    FontSize="12"
                    Foreground="#666"
                    Text="颜色模式" />
                <ComboBox
                    Height="26"
                    Margin="0,0,0,10"
                    Padding="6,4"
                    VerticalContentAlignment="Center"
                    FontSize="12"
                    IsEnabled="False"
                    ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                    SelectedIndex="0"
                    Style="{StaticResource CustomComboBoxStyle}">
                    <ComboBoxItem Content="RGB" />
                </ComboBox>

                <!--  R  -->
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#666"
                        Text="红色(R)" />
                    <TextBox
                        x:Name="RInput"
                        Grid.Column="1"
                        Height="26"
                        Padding="4,2"
                        VerticalContentAlignment="Center"
                        BorderBrush="#d0d3d6"
                        BorderThickness="1"
                        FontSize="12"
                        MaxLength="3"
                        Text="232"
                        TextChanged="RgbInput_TextChanged" />
                </Grid>

                <!--  G  -->
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#666"
                        Text="绿色(G)" />
                    <TextBox
                        x:Name="GInput"
                        Grid.Column="1"
                        Height="26"
                        Padding="4,2"
                        VerticalContentAlignment="Center"
                        BorderBrush="#d0d3d6"
                        BorderThickness="1"
                        FontSize="12"
                        MaxLength="3"
                        Text="235"
                        TextChanged="RgbInput_TextChanged" />
                </Grid>

                <!--  B  -->
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#666"
                        Text="蓝色(B)" />
                    <TextBox
                        x:Name="BInput"
                        Grid.Column="1"
                        Height="26"
                        Padding="4,2"
                        VerticalContentAlignment="Center"
                        BorderBrush="#d0d3d6"
                        BorderThickness="1"
                        FontSize="12"
                        MaxLength="3"
                        Text="237"
                        TextChanged="RgbInput_TextChanged" />
                </Grid>

                <!--  Hex  -->
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#666"
                        Text="十六进制" />
                    <TextBox
                        x:Name="HexInput"
                        Grid.Column="1"
                        Height="26"
                        Padding="4,2"
                        VerticalContentAlignment="Center"
                        BorderBrush="#d0d3d6"
                        BorderThickness="1"
                        FontSize="12"
                        MaxLength="7"
                        Text="#e8ebed"
                        TextChanged="HexInput_TextChanged" />
                </Grid>
            </StackPanel>

            <!--  右下：按钮区域  -->
            <StackPanel
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,10,0,0"
                VerticalAlignment="Bottom">
                <Button
                    Margin="0,0,0,5"
                    Click="OkButton_Click"
                    Content="确定"
                    FontSize="13"
                    IsDefault="True"
                    Style="{StaticResource DialogButtonStyle}" />
                <Button
                    Click="CancelButton_Click"
                    Content="取消"
                    FontSize="13"
                    IsCancel="True"
                    Style="{StaticResource DialogButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
