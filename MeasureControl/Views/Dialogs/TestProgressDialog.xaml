<Window
    x:Class="MeasureControl.Views.Dialogs.TestProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="进度"
    Width="360"
    Height="120"
    BorderThickness="1"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="False"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1c1c1c" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="White"
                    Text="{Binding HeaderText}" />

                <Button
                    Grid.Column="1"
                    Width="30"
                    Height="30"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="CloseButton_Click"
                    Content="✖"
                    FontSize="16"
                    Foreground="White" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="10,15,10,0">
            <TextBlock
                Margin="0,0,0,5"
                FontSize="14"
                Text="{Binding StatusText}" />
            <ProgressBar
                Height="18"
                Margin="10,10,10,0"
                Maximum="{Binding Total}"
                Minimum="0"
                Value="{Binding Progress}" />
        </StackPanel>
    </Grid>
</Window>
