<Window
    x:Class="MeasureControl.Views.Dialogs.ReMessageBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="提示"
    Width="300"
    Height="140"
    BorderBrush="#1c1c1c"
    BorderThickness="1"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1c1c1c" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Width" Value="70" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4F5C87" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#4F5C87" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Height="30"
            Background="#1c1c1c"
            MouseLeftButtonDown="DragWindow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="TitleTextBlock"
                    Grid.Column="0"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="White"
                    Text="{Binding Title}" />
                <Button
                    x:Name="CloseButton"
                    Grid.Column="1"
                    Width="20"
                    Height="20"
                    HorizontalAlignment="Right"
                    Command="{Binding CancelCommand}"
                    Content="✖"
                    FontSize="14"
                    Style="{StaticResource DialogButtonStyle}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
                x:Name="IconImage"
                Width="36"
                Height="36"
                Margin="0,0,10,0"
                Source="{Binding IconPath}"
                Stretch="fill"
                Visibility="{Binding IsIconVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock
                x:Name="MessageTextBlock"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="14"
                Text="{Binding Message}"
                TextWrapping="Wrap" />
        </Grid>

        <Border Grid.Row="2" Background="#F0F0F0">
            <StackPanel
                x:Name="ButtonsPanel"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    x:Name="YesButton"
                    Width="50"
                    Height="20"
                    Margin="0,5,5,5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Command="{Binding YesCommand}"
                    Content="是"
                    FontSize="14"
                    Style="{StaticResource DialogButtonStyle}"
                    Visibility="{Binding IsYesButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button
                    x:Name="NoButton"
                    Width="50"
                    Height="20"
                    Margin="5,5,5,5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Command="{Binding NoCommand}"
                    Content="否"
                    FontSize="14"
                    Style="{StaticResource DialogButtonStyle}"
                    Visibility="{Binding IsNoButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button
                    x:Name="OkButton"
                    Width="50"
                    Height="20"
                    Margin="0,5,5,5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Command="{Binding OkCommand}"
                    Content="确定"
                    FontSize="14"
                    IsDefault="True"
                    Style="{StaticResource DialogButtonStyle}"
                    Visibility="{Binding IsOkButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button
                    x:Name="CancelButton"
                    Width="50"
                    Height="20"
                    Margin="5,5,5,5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Command="{Binding CancelCommand}"
                    Content="取消"
                    FontSize="14"
                    IsCancel="True"
                    Style="{StaticResource DialogButtonStyle}"
                    Visibility="{Binding IsCancelButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>