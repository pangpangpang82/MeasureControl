<Window
    x:Class="MeasureControl.Views.Dialogs.AddIcdMappingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Dialogs="clr-namespace:MeasureControl.ViewModels.Dialogs"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:MeasureControl.Helpers"
    xmlns:local="clr-namespace:MeasureControl.Views.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="新增映射"
    Width="500"
    Height="600"
    d:DataContext="{d:DesignInstance Type=Dialogs:AddIcdMappingDialogViewModel}"
    Background="#f5f5f5"
    BorderBrush="#1c1c1c"
    BorderThickness="1"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <helpers:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />

        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1c1c1c" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Width" Value="70" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4F5C87" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#4F5C87" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="BorderBrush" Value="#ccc" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="Red" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="BorderBrush" Value="#ccc" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Background" Value="#1c1c1c" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4a4a4a" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#333" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#ccc" />
                    <Setter Property="Foreground" Value="#666" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!--  标题栏  -->
        <Border
            Height="40"
            VerticalAlignment="Top"
            Background="#1c1c1c"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Margin="15,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{Binding Title}" />

                <Button
                    Grid.Column="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="CloseButton_Click"
                    Content="✖"
                    FontSize="16"
                    Foreground="White">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#ff4444" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!--  主内容区  -->
        <ScrollViewer Margin="0,40,0,60" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <!--  必填字段  -->
                <TextBlock
                    Margin="0,10,0,5"
                    FontWeight="SemiBold"
                    Text="信号标识 *" />
                <TextBox Text="{Binding MappingItem.SignalId, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入信号的唯一标识符" />

                <TextBlock
                    Margin="0,10,0,5"
                    FontWeight="SemiBold"
                    Text="信号说明 *" />
                <TextBox Text="{Binding MappingItem.Description, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入信号的详细说明" />

                <TextBlock
                    Margin="0,10,0,5"
                    FontWeight="SemiBold"
                    Text="绑定ICD配置表 *" />
                <ComboBox
                    ItemsSource="{Binding AvailableIcdTabels}"
                    SelectedItem="{Binding MappingItem.IcdTabelId, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="选择要绑定的ICD配置表" />

                <TextBlock
                    Margin="0,10,0,5"
                    FontWeight="SemiBold"
                    Text="绑定帧 *" />
                <ComboBox
                    DisplayMemberPath="FrameName"
                    ItemsSource="{Binding AvailableFrames}"
                    SelectedItem="{Binding MappingItem.FrameId, UpdateSourceTrigger=PropertyChanged}"
                    SelectedValuePath="FrameId"
                    SelectionChanged="FrameComboBox_SelectionChanged"
                    ToolTip="选择要绑定的帧（远程帧已被过滤）" />

                <TextBlock
                    Margin="0,10,0,5"
                    FontWeight="SemiBold"
                    Text="数据类型 *" />
                <ComboBox
                    ItemsSource="{x:Static Dialogs:AddIcdMappingDialogViewModel.AvailableDataTypes}"
                    SelectedItem="{Binding MappingItem.DataType, UpdateSourceTrigger=PropertyChanged}"
                    SelectionChanged="DataTypeComboBox_SelectionChanged"
                    ToolTip="选择信号的数据类型" />

                <!--  自动填充的基础信息（只读）  -->
                <Border
                    Margin="0,20,0,10"
                    Padding="10"
                    Background="#fafafa"
                    BorderBrush="#ddd"
                    BorderThickness="1">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="基础信息" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="帧名称:" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Text="{Binding FrameName}" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="消息ID:" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding MessageIdDisplay}" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Text="通道:" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Text="{Binding ChannelDisplay}" />

                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Text="数据包总大小:" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                Text="{Binding DlcDisplay}" />

                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="0"
                                Text="信号方向:" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="1"
                                Text="{Binding DirectionDisplay}" />

                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="0"
                                Text="周期:" />
                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="1"
                                Text="{Binding CycleDisplay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  可选字段  -->
                <TextBlock
                    Margin="0,10,0,5"
                    FontWeight="SemiBold"
                    Text="标定公式" />
                <TextBox Text="{Binding MappingItem.CalibrationFormula, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入标定公式，默认为'/'表示无标定" />

                <TextBlock
                    Margin="0,10,0,5"
                    FontWeight="SemiBold"
                    Text="位长" />
                <TextBox
                    Background="#f0f0f0"
                    IsReadOnly="True"
                    Text="{Binding MappingItem.BitLength}"
                    ToolTip="根据数据类型自动计算的位长" />

                <!--  拼接配置  -->
                <Border
                    Margin="0,20,0,10"
                    Padding="10"
                    Background="#fafafa"
                    BorderBrush="#ddd"
                    BorderThickness="1">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="拼接配置" />

                        <TextBlock Margin="0,0,0,5" Text="拼接个数" />
                        <TextBox Text="{Binding MappingItem.ConcatCount, UpdateSourceTrigger=PropertyChanged}" ToolTip="拼接的字节个数，0表示不参与拼接" />

                        <TextBlock Margin="0,10,0,5" Text="双字位数" />
                        <TextBox Text="{Binding MappingItem.DoubleWordBits, UpdateSourceTrigger=PropertyChanged}" ToolTip="双字中的位数" />

                        <TextBlock Margin="0,10,0,5" Text="字内位置" />
                        <TextBox Text="{Binding MappingItem.PositionInWord, UpdateSourceTrigger=PropertyChanged}" ToolTip="在字内的位置偏移" />

                        <TextBlock
                            Margin="0,10,0,0"
                            FontSize="12"
                            Foreground="#666"
                            Text="说明：当拼接个数、双字位数、字内位置全为0时，不参与拼接"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  验证消息  -->
                <TextBlock
                    Margin="0,10,0,0"
                    FontSize="12"
                    Foreground="Red"
                    Text="{Binding ValidationMessage}"
                    TextWrapping="Wrap"
                    Visibility="{Binding ValidationMessage, Converter={StaticResource StringToVisibilityConverter}}" />
            </StackPanel>
        </ScrollViewer>

        <!--  底部按钮区  -->
        <Border
            Height="60"
            VerticalAlignment="Bottom"
            Background="#f0f0f0"
            BorderBrush="#ddd"
            BorderThickness="0,1,0,0">
            <StackPanel
                Margin="20,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Command="{Binding SaveCommand}"
                    Content="保存"
                    IsEnabled="{Binding IsSaveEnabled}"
                    Style="{StaticResource DialogButtonStyle}" />
                <Button
                    Command="{Binding CancelCommand}"
                    Content="取消"
                    Style="{StaticResource DialogButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>