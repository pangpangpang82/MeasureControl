<Window
    x:Class="MeasureControl.Views.Dialogs.ChassisConnectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="连接设置"
    Width="250"
    Height="260"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ComboBoxStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="DialogButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#1c1c1c" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Width" Value="70" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Margin" Value="5" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#4F5C87" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#4F5C87" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderBrush="#1c1c1c" BorderThickness="1">
        <Grid Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  标题栏  -->
            <Border
                Grid.Row="0"
                Height="30"
                Background="#1c1c1c"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="White"
                    Text="机箱连接设置" />
            </Border>

            <!--  内容区域  -->
            <Grid
                Grid.Row="1"
                Margin="20,10,20,10"
                VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="25.893" />
                    <RowDefinition Height="4.887" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  源机箱  -->
                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,5"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,5"
                        FontSize="14"
                        Text="机箱1：" />
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#2d354d"
                        Text="{Binding SourceChassisName}" />
                </StackPanel>

                <!--  目标机箱  -->
                <StackPanel
                    Grid.Row="2"
                    Margin="0,0,0,10"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,5"
                        FontSize="14"
                        Text="机箱2：" />
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#2d354d"
                        Text="{Binding TargetChassisName}" />
                </StackPanel>

                <!--  连接类型选择  -->
                <StackPanel Grid.Row="3">
                    <TextBlock
                        Margin="0,0,0,5"
                        FontSize="14"
                        Text="连接方式：" />
                    <ComboBox
                        x:Name="Connect_method"
                        Width="{Binding ElementName=ConnectionNameTextBox, Path=ActualWidth}"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Left"
                        DisplayMemberPath="DisplayName"
                        ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                        ItemsSource="{Binding ConnectionTypes}"
                        SelectedItem="{Binding SelectedConnectionTypeItem, Mode=TwoWay}"
                        SelectedValue="{Binding SelectedConnectionType, Mode=TwoWay}"
                        SelectedValuePath="Type"
                        Style="{StaticResource CustomComboBoxStyle}" />
                </StackPanel>

                <!--  连接名称输入  -->
                <StackPanel Grid.Row="4" Margin="0,10,0,0">
                    <TextBlock
                        Margin="0,0,0,5"
                        FontSize="14"
                        Text="连接名称：" />
                    <Border
                        BorderBrush="#ebecef"
                        BorderThickness="1"
                        CornerRadius="3">
                        <TextBox
                            x:Name="ConnectionNameTextBox"
                            Height="{Binding ElementName=Connect_method, Path=ActualHeight}"
                            VerticalContentAlignment="Center"
                            BorderBrush="#ebecef"
                            BorderThickness="0"
                            FontSize="14"
                            Text="{Binding ConnectionName, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>
                </StackPanel>
            </Grid>

            <!--  按钮区域  -->
            <Border Grid.Row="2" Background="#F0F0F0">
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        x:Name="ConfirmButton"
                        Width="50"
                        Height="20"
                        Margin="0,5,5,5"
                        Command="{Binding ConfirmCommand}"
                        Content="确定"
                        Focusable="True"
                        FontSize="14"
                        IsDefault="True"
                        Style="{StaticResource DialogButtonStyle}" />
                    <Button
                        Width="50"
                        Height="20"
                        Margin="5,5,5,5"
                        Command="{Binding CancelCommand}"
                        Content="取消"
                        FontSize="14"
                        IsCancel="True"
                        Style="{StaticResource DialogButtonStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
