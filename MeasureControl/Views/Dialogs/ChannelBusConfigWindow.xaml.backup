<Window x:Class="MeasureControl.Views.Dialogs.ChannelBusConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:MeasureControl.Helpers"
        Title="通道总线设置" WindowStartupLocation="CenterOwner" Width="1100" Height="520"
        WindowStyle="None" Background="White" BorderBrush="#1c1c1c" BorderThickness="1" ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1c1c1c" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Width" Value="70" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4F5C87" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#4F5C87" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Inverse bool converter for enabling/disabling controls -->
        <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
        <!-- Baud number string converter -->
        <helpers:BaudNumberStringConverter x:Key="BaudNumberStringConverter" />
        <!-- Int equals converter -->
        <helpers:IntEqualsConverter x:Key="IntEqualsConverter" />
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar like AddChannelDialog -->
        <Border Grid.Row="0" Height="30" Background="#1c1c1c" MouseLeftButtonDown="DragWindow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" Foreground="White" Text="通道总线设置" />
                <Button Grid.Column="2" Width="30" Height="30" VerticalAlignment="Center" HorizontalAlignment="Right"
                        IsCancel="True" Click="Cancel_Click" Content="✖" FontSize="14" Style="{StaticResource DialogButtonStyle}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Width="100" VerticalAlignment="Center" Text="波特率 (bps):" />
                <ComboBox x:Name="BaudCombo" Width="120" SelectedValuePath="Tag" SelectedValue="{Binding nBaudRate, Mode=TwoWay}" SelectedIndex="6"
                          IsEnabled="{Binding IsChecked, ElementName=CustomBaudCheck, Converter={StaticResource InverseBoolConverter}}">
                    <ComboBoxItem Tag="10000">10k</ComboBoxItem>
                    <ComboBoxItem Tag="20000">20k</ComboBoxItem>
                    <ComboBoxItem Tag="50000">50k</ComboBoxItem>
                    <ComboBoxItem Tag="100000">100k</ComboBoxItem>
                    <ComboBoxItem Tag="125000">125k</ComboBoxItem>
                    <ComboBoxItem Tag="250000">250k</ComboBoxItem>
                    <ComboBoxItem Tag="500000">500k</ComboBoxItem>
                    <ComboBoxItem Tag="800000">800k</ComboBoxItem>
                    <ComboBoxItem Tag="1000000">1M</ComboBoxItem>
                </ComboBox>

                <CheckBox x:Name="CustomBaudCheck" VerticalAlignment="Center" Margin="20,0,10,0" Content="使用自定义波特率" />
                <TextBox x:Name="CustomBaudText" Width="120"
                         Text="{Binding nBaudRate, Mode=TwoWay, Converter={StaticResource BaudNumberStringConverter}, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsChecked, ElementName=CustomBaudCheck}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,4">
                <TextBlock Width="100" VerticalAlignment="Center" Text="工作模式:" />
                <ComboBox x:Name="WorkModeCombo" Width="120" SelectedValuePath="Tag" SelectedValue="{Binding nWorkMode, Mode=TwoWay}" SelectedIndex="0">
                    <ComboBoxItem Tag="0">正常发送</ComboBoxItem>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Grid.Row="4" Margin="0,4">
                <TextBlock Width="100" VerticalAlignment="Center" Text="滤波模式选择:" />
                <ComboBox x:Name="FilterCntCombo" Width="120" SelectedValuePath="Tag" SelectedValue="{Binding nAccFilterCnt, Mode=TwoWay}" SelectedIndex="0"
                          SelectionChanged="FilterCntCombo_SelectionChanged">
                    <ComboBoxItem Tag="0">不参与滤波</ComboBoxItem>
                    <ComboBoxItem Tag="1">单滤波</ComboBoxItem>
                </ComboBox>
            </StackPanel>

            <!-- Acceptance filter detailed settings -->
            <StackPanel Orientation="Horizontal" Grid.Row="5" Margin="0,4">
                <TextBlock Width="100" VerticalAlignment="Center" Text="验收码A (Hex):" />
                <TextBox Width="120" Text="{Binding nAccCodeA, Mode=TwoWay}" />
                <TextBlock Width="20" />
                <TextBlock Width="100" VerticalAlignment="Center" Text="屏蔽码A (Hex):" />
                <TextBox Width="120" Text="{Binding nAccMaskA, Mode=TwoWay}" />
            </StackPanel>

            <!-- Acceptance ID registers: 30 bits (ID00..ID29) -->
            <Border Grid.Row="6" BorderBrush="#E5EEF6" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock FontWeight="Bold" Margin="4,0,0,8" Text="验收 ID 寄存器:" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Height="260">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>


                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="520"/>
                                <ColumnDefinition Width="520"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel x:Name="IdTogglePanel" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                                <!-- IDs displayed as vertical toggle buttons: top 'ID', below numeric -->
                                <ToggleButton Width="32" Height="80" Margin="1" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock FontSize="16" Text="RTR" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="16" Text="29" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Width="32" Height="80" Margin="1" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock FontSize="16" Text="ID" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="16" Text="28" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Width="32" Height="80" Margin="1" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock FontSize="16" Text="ID" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="16" Text="27" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Width="32" Height="80" Margin="1" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock FontSize="16" Text="ID" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="16" Text="26" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Width="32" Height="80" Margin="1" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock FontSize="16" Text="ID" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="16" Text="25" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Width="32" Height="80" Margin="1,0,2,0" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock FontSize="16" Text="ID" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="16" Text="24" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Width="32" Height="80" Margin="2,0,1,0" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock FontSize="16" Text="ID" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="16" Text="23" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Width="32" Height="80" Margin="1" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock FontSize="16" Text="ID" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="16" Text="22" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Width="32" Height="80" Margin="1" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock FontSize="16" Text="ID" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="16" Text="21" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Width="32" Height="80" Margin="1" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock FontSize="16" Text="ID" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="16" Text="20" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ToggleButton>

                                <!-- remaining IDs -->
                                <ToggleButton Width="32" Height="80" Margin="1" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock FontSize="16" Text="ID" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="16" Text="19" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Width="32" Height="80" Margin="1" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock FontSize="16" Text="ID" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="16" Text="18" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Width="32" Height="80" Margin="1" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock FontSize="16" Text="ID" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="16" Text="17" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Width="32" Height="80" Margin="1,0,2,0" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock FontSize="16" Text="ID" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="16" Text="16" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Width="32" Height="80" Margin="2,0,1,0" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock FontSize="16" Text="ID" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="16" Text="15" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Width="32" Height="80" Margin="1" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock FontSize="16" Text="ID" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="16" Text="14" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Width="32" Height="80" Margin="1" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock FontSize="16" Text="ID" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="16" Text="13" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Width="32" Height="80" Margin="1" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock FontSize="16" Text="ID" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="16" Text="12" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Width="32" Height="80" Margin="1" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock FontSize="16" Text="ID" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="16" Text="11" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ToggleButton>

                                <ToggleButton Width="32" Height="80" Margin="1" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock FontSize="16" Text="ID" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="16" Text="10" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Width="32" Height="80" Margin="1" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock FontSize="16" Text="ID" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="16" Text="09" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Width="32" Height="80" Margin="1,0,2,0" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock FontSize="16" Text="ID" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="16" Text="08" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Width="32" Height="80" Margin="2,0,1,0" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock FontSize="16" Text="ID" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="16" Text="07" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Width="32" Height="80" Margin="1" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock FontSize="16" Text="ID" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="16" Text="06" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Width="32" Height="80" Margin="1" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock FontSize="16" Text="ID" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="16" Text="05" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Width="32" Height="80" Margin="1" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock FontSize="16" Text="ID" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="16" Text="04" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Width="32" Height="80" Margin="1" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock FontSize="16" Text="ID" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="16" Text="03" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Width="32" Height="80" Margin="1" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock FontSize="16" Text="ID" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="16" Text="02" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Width="32" Height="80" Margin="1" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock FontSize="16" Text="ID" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="16" Text="01" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Width="32" Height="80" Margin="1" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock FontSize="16" Text="ID" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="16" Text="00" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>

                            <StackPanel x:Name="IdButtonPanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0.5,0,0">
                                <Button Width="32" Height="32" Margin="1" Content="x" Click="CycleRegisterValue" />
                                <Button Width="32" Height="32" Margin="1" Content="x" Click="CycleRegisterValue" />
                                <Button Width="32" Height="32" Margin="1" Content="x" Click="CycleRegisterValue" />
                                <Button Width="32" Height="32" Margin="1" Content="x" Click="CycleRegisterValue" />
                                <Button Width="32" Height="32" Margin="1" Content="x" Click="CycleRegisterValue" />
                                <Button Width="32" Height="32" Margin="1,0,2,0" Content="x" Click="CycleRegisterValue" />
                                <Button Width="32" Height="32" Margin="2,0,1,0" Content="x" Click="CycleRegisterValue" />
                                <Button Width="32" Height="32" Margin="1" Content="x" Click="CycleRegisterValue" />
                                <Button Width="32" Height="32" Margin="1" Content="x" Click="CycleRegisterValue" />
                                <Button Width="32" Height="32" Margin="1" Content="x" Click="CycleRegisterValue" />
                                <Button Width="32" Height="32" Margin="1" Content="x" Click="CycleRegisterValue" />
                                <Button Width="32" Height="32" Margin="1" Content="x" Click="CycleRegisterValue" />
                                <Button Width="32" Height="32" Margin="1" Content="x" Click="CycleRegisterValue" />
                                <Button Width="32" Height="32" Margin="1,0,2,0" Content="x" Click="CycleRegisterValue" />
                                <Button Width="32" Height="32" Margin="2,0,1,0" Content="x" Click="CycleRegisterValue" />
                                <Button Width="32" Height="32" Margin="1" Content="x" Click="CycleRegisterValue" />
                                <Button Width="32" Height="32" Margin="1" Content="x" Click="CycleRegisterValue" />
                                <Button Width="32" Height="32" Margin="1" Content="x" Click="CycleRegisterValue" />
                                <Button Width="32" Height="32" Margin="1" Content="x" Click="CycleRegisterValue" />
                                <Button Width="32" Height="32" Margin="1" Content="x" Click="CycleRegisterValue" />
                                <Button Width="32" Height="32" Margin="1" Content="x" Click="CycleRegisterValue" />
                                <Button Width="32" Height="32" Margin="1,0,2,0" Content="x" Click="CycleRegisterValue" />
                                <Button Width="32" Height="32" Margin="2,0,1,0" Content="x" Click="CycleRegisterValue" />
                                <Button Width="32" Height="32" Margin="1" Content="x" Click="CycleRegisterValue" />
                                <Button Width="32" Height="32" Margin="1" Content="x" Click="CycleRegisterValue" />
                                <Button Width="32" Height="32" Margin="1" Content="x" Click="CycleRegisterValue" />
                                <Button Width="32" Height="32" Margin="1" Content="x" Click="CycleRegisterValue" />
                                <Button Width="32" Height="32" Margin="1" Content="x" Click="CycleRegisterValue" />
                                <Button Width="32" Height="32" Margin="1" Content="x" Click="CycleRegisterValue" />
                                <Button Width="32" Height="32" Margin="1" Content="x" Click="CycleRegisterValue" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Left" Margin="0,75,0,0">
                                <TextBlock Width="500" FontSize="14" VerticalAlignment="Center" Text="注：对应位显示为“x”表示此位为无关位，不参与滤波。" />
                            </StackPanel>
                            
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Left" Margin="0,50,0,0">
                                <TextBlock Width="520" FontSize="14" VerticalAlignment="Center" Text="屏蔽码某位为0时，对应验收码的位无论为0或1，帧ID标示符的位不参与过滤。" />
                                <TextBlock Width="520" FontSize="14" Margin="0,50,0,0" VerticalAlignment="Center" Text="屏蔽码某位为1时，对应验收码的位与帧ID标示符的位相同接收，否则拒绝。" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Grid.Row="7" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Width="80" Margin="0,0,50,0" IsDefault="True" Click="Ok_Click" Style="{StaticResource DialogButtonStyle}">滤波配置</Button>
                <Button Width="80" Margin="6,0" IsDefault="True" Click="Ok_Click" Style="{StaticResource DialogButtonStyle}">设置应用</Button>
                <Button Width="60" Margin="6,0" IsCancel="True" Click="Cancel_Click" Style="{StaticResource DialogButtonStyle}">关 闭</Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>