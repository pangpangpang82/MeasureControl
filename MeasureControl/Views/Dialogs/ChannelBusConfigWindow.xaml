                        <ComboBoxItem.Tag>
                            <sys:UInt32>10000</sys:UInt32>
                        </ComboBoxItem.Tag>
                        10k
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <ComboBoxItem.Tag>
                            <sys:UInt32>20000</sys:UInt32>
                        </ComboBoxItem.Tag>
                        20k
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <ComboBoxItem.Tag>
