<Window
    x:Class="MeasureControl.Views.Dialogs.SignalCalibrationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:MeasureControl.Helpers"
    Title="信号标定"
    Width="400"
    MinHeight="250"
    MaxHeight="400"
    Background="White"
    BorderBrush="#1c1c1c"
    BorderThickness="1"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ComboBoxStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <helpers:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <Style x:Key="DialogButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#1c1c1c" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Width" Value="70" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Margin" Value="5" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#4F5C87" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#4F5C87" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题栏  -->
        <Border
            Grid.Row="0"
            Height="30"
            Background="#1c1c1c"
            MouseLeftButtonDown="DragWindow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="White"
                    Text="信号标定" />
                <Button
                    Grid.Column="1"
                    Width="30"
                    Height="30"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding CancelCommand}"
                    Content="✖"
                    FontSize="14"
                    Style="{StaticResource DialogButtonStyle}" />
            </Grid>
        </Border>

        <!--  内容区域  -->
        <Grid Margin="20,15,20,15" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  信号信息  -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock
                    Margin="0,0,0,5"
                    FontSize="14"
                    Text="{Binding SignalInfo, StringFormat='信号：{0}'}" />
            </StackPanel>

            <!--  当前值显示  -->
            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <TextBlock
                    Margin="0,0,0,5"
                    FontSize="14"
                    Text="{Binding CurrentValueInfo, StringFormat='当前值：{0}'}" />
            </StackPanel>

            <!--  斜率  -->
            <StackPanel Grid.Row="2" Margin="0,0,0,15">
                <TextBlock
                    Margin="0,0,0,5"
                    FontSize="14"
                    Text="斜率 (Slope)：" />
                <Border
                    BorderBrush="#D9D9D9"
                    BorderThickness="1"
                    CornerRadius="3">
                    <TextBox
                        Height="28"
                        Margin="5,0"
                        VerticalContentAlignment="Center"
                        BorderThickness="0"
                        FontSize="14"
                        Text="{Binding Slope, UpdateSourceTrigger=PropertyChanged, StringFormat=F6}" />
                </Border>
            </StackPanel>

            <!--  截距  -->
            <StackPanel Grid.Row="3" Margin="0,0,0,15">
                <TextBlock
                    Margin="0,0,0,5"
                    FontSize="14"
                    Text="截距 (Intercept)：" />
                <Border
                    BorderBrush="#D9D9D9"
                    BorderThickness="1"
                    CornerRadius="3">
                    <TextBox
                        Height="28"
                        Margin="5,0"
                        VerticalContentAlignment="Center"
                        BorderThickness="0"
                        FontSize="14"
                        Text="{Binding Intercept, UpdateSourceTrigger=PropertyChanged, StringFormat=F6}" />
                </Border>
            </StackPanel>

            <!--  计算结果预览  -->
            <StackPanel Grid.Row="4" Margin="0,0,0,15">
                <TextBlock
                    Margin="0,0,0,5"
                    FontSize="14"
                    Text="{Binding PreviewResult, StringFormat='预览结果：{0}'}" />
            </StackPanel>
        </Grid>

        <!--  按钮区域  -->
        <Border
            Grid.Row="2"
            Background="#F0F0F0"
            BorderBrush="#E0E0E0"
            BorderThickness="0,1,0,0">
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Command="{Binding OkCommand}"
                    Content="确定"
                    FontSize="14"
                    IsDefault="True"
                    Style="{StaticResource DialogButtonStyle}" />
                <Button
                    Command="{Binding CancelCommand}"
                    Content="取消"
                    FontSize="14"
                    IsCancel="True"
                    Style="{StaticResource DialogButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
