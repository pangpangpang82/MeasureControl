<Window
    x:Class="MeasureControl.Views.Dialogs.HydraulicAutoTestSelectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="选择液压测试项"
    Width="380"
    Height="490"
    Background="White"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1c1c1c" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Width" Value="60" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="buttonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#4F5C87" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#4F5C87" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#4F5C87" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EnableCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="checkBoxBorder"
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                Background="White"
                                BorderBrush="#D9D9D9"
                                BorderThickness="1"
                                CornerRadius="2">
                                <Path
                                    x:Name="checkMark"
                                    Data="M 2 8 L 6 12 L 14 4"
                                    Stroke="White"
                                    StrokeThickness="2"
                                    Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                ContentSource="Content"
                                RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkBoxBorder" Property="Background" Value="#3b82f6" />
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#3b82f6" />
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#3b82f6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="checkBoxBorder" Property="Background" Value="#E5E5E5" />
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#CCCCCC" />
                                <Setter TargetName="checkMark" Property="Stroke" Value="#999999" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="Black" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="#1c1c1c"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Margin="15,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="White"
                        Text="液压自动测试" />

                    <Button
                        Grid.Column="1"
                        Width="40"
                        Height="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CloseButton_Click"
                        Content="✖"
                        FontSize="16"
                        Foreground="White"
                        Style="{StaticResource DialogButtonStyle}" />

                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="20,16,20,10">
                <TextBlock
                    FontSize="14"
                    Text="请勾选需要执行的测试项。"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,10,0,0"
                    Foreground="#C62828"
                    Text="{Binding ValidationMessage}" />
            </StackPanel>

            <Border
                Grid.Row="2"
                Margin="20,0,20,10"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="3">
                <DockPanel>
                    <StackPanel
                        Margin="10,10,10,6"
                        DockPanel.Dock="Top"
                        Orientation="Horizontal">
                        <Button
                            Margin="5,0,5,0"
                            Click="SelectAllButton_Click"
                            Content="全选"
                            Style="{StaticResource DialogButtonStyle}" />
                        <Button
                            Click="ClearAllButton_Click"
                            Content="清空"
                            Style="{StaticResource DialogButtonStyle}" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox
                                            Margin="12,6,4,6"
                                            Content="{Binding Name}"
                                            FontSize="14"
                                            IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource EnableCheckBoxStyle}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#C62828"
                                            Text="(必选)">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMandatory}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Row="3" Background="#f0f0f0">
                <StackPanel
                    Margin="5"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        x:Name="OkButton"
                        Margin="5,2.5,5,0"
                        Click="OkButton_Click"
                        Content="确定"
                        IsDefault="True"
                        Style="{StaticResource DialogButtonStyle}" />
                    <Button
                        Margin="5,2.5,5,0"
                        Click="CancelButton_Click"
                        Content="取消"
                        IsCancel="True"
                        Style="{StaticResource DialogButtonStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
