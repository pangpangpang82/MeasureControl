<Window
    x:Class="MeasureControl.Views.Dialogs.SelfInspectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:MeasureControl.Helpers"
    Title="自检"
    Width="400"
    Height="170"
    Background="White"
    BorderThickness="1"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ComboBoxStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <Style x:Key="DialogButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#1c1c1c" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Width" Value="70" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Margin" Value="5" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#4F5C87" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#4F5C87" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1c1c1c">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Margin="15,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="White"
                    Text="自检" />

                <Button
                    x:Name="CloseButton"
                    Grid.Column="1"
                    Width="20"
                    Height="20"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="CloseButton_Click"
                    Content="✖"
                    Foreground="White"
                    Style="{StaticResource DialogButtonStyle}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White">
            <StackPanel Margin="20,0,20,0" VerticalAlignment="Center">
                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="14"
                    Text="请选择机箱" />
                <ComboBox
                    DisplayMemberPath="Name"
                    FontSize="14"
                    ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                    ItemsSource="{Binding AvailableChassis}"
                    SelectedItem="{Binding SelectedChassis, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource CustomComboBoxStyle}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#f0f0f0">
            <StackPanel
                Margin="5"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    x:Name="OkButton"
                    Width="60"
                    Height="25"
                    Margin="5"
                    Click="OkButton_Click"
                    Content="确定"
                    IsDefault="True"
                    Style="{StaticResource DialogButtonStyle}" />
                <Button
                    x:Name="CancelButton"
                    Width="60"
                    Height="25"
                    Margin="5"
                    Click="CancelButton_Click"
                    Content="取消"
                    IsCancel="True"
                    Style="{StaticResource DialogButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
