<Window
    x:Class="MeasureControl.Views.Dialogs.CreateIcdConfigTabelDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="创建ICD配置表"
    Width="400"
    Height="320"
    BorderBrush="#1c1c1c"
    BorderThickness="1"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ComboBoxStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <Style x:Key="DialogButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#1c1c1c" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Width" Value="70" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Margin" Value="5" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#4F5C87" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#4F5C87" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="MessageBoxButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#1c1c1c" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#4F5C87" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#4F5C87" />
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="#6496C8" />
                                    <Setter Property="Background" Value="#4F5C87" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题栏  -->
        <Border Grid.Row="0" Background="#1c1c1c">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="White"
                    Text="创建ICD配置表" />
                <Button
                    x:Name="CloseButton"
                    Grid.Column="1"
                    Width="30"
                    Height="30"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="CloseButton_Click"
                    Content="✖"
                    Foreground="White" />
            </Grid>
        </Border>

        <!--  内容区  -->
        <Border Grid.Row="1" Background="White">
            <StackPanel Margin="20,0,20,0" VerticalAlignment="Center">
                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="14"
                    Text="配置表名称：" />

                <Border
                    Margin="0,0,0,10"
                    VerticalAlignment="Center"
                    BorderBrush="#D9D9D9"
                    BorderThickness="1"
                    CornerRadius="3">
                    <TextBox
                        x:Name="NameTextBox"
                        Height="35"
                        Padding="8,0"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        BorderThickness="0"
                        FontSize="14"
                        Text="{Binding TabelName, UpdateSourceTrigger=PropertyChanged}"
                        TextChanged="NameTextBox_TextChanged" />
                </Border>

                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="14"
                    Text="请选择协议：" />
                <ComboBox
                    x:Name="ProtocolComboBox"
                    Height="35"
                    FontSize="14"
                    ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                    ItemsSource="{Binding AvailableProtocols, RelativeSource={RelativeSource AncestorType=Window}}"
                    SelectedItem="{Binding SelectedProtocol, RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{StaticResource CustomComboBoxStyle}" />

                <TextBlock
                    Margin="0,15,0,10"
                    FontSize="14"
                    Text="请选择通讯通道：" />
                <ComboBox
                    Height="35"
                    FontSize="14"
                    ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                    ItemsSource="{Binding AvailableChannelBindings, RelativeSource={RelativeSource AncestorType=Window}}"
                    SelectedItem="{Binding SelectedChannelBinding, RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{StaticResource CustomComboBoxStyle}" />
            </StackPanel>
        </Border>

        <!--  按钮区  -->
        <Border Grid.Row="2" Background="#f0f0f0">
            <StackPanel
                Margin="5"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    x:Name="OkButton"
                    Width="60"
                    Height="25"
                    Margin="5"
                    Click="OkButton_Click"
                    Content="确定"
                    IsDefault="True"
                    Style="{StaticResource DialogButtonStyle}"  />
                <Button
                    x:Name="CancelButton"
                    Width="60"
                    Height="25"
                    Margin="5"
                    Click="CancelButton_Click"
                    Content="取消"
                    IsCancel="True"
                    Style="{StaticResource DialogButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
