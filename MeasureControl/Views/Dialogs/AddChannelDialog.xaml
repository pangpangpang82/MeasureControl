<Window
    x:Class="MeasureControl.Views.Dialogs.AddChannelDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:MeasureControl.Helpers"
    Title="新增通道"
    Width="450"
    MinHeight="300"
    MaxHeight="600"
    Background="White"
    BorderBrush="#1c1c1c"
    BorderThickness="1"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ComboBoxStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <helpers:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <helpers:CardNameDisplayConverter x:Key="CardNameDisplayConverter" />

            <!--  简洁的滚动条样式  -->
            <Style x:Key="SimpleScrollBarStyle" TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="8" />
                <Setter Property="MinWidth" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="Transparent" BorderThickness="0">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Style>
                                                <Style TargetType="Thumb">
                                                    <Setter Property="Background" Value="#CCCCCC" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderThickness="0"
                                                                    CornerRadius="4" />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#999999" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter Property="Background" Value="#666666" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Thumb.Style>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  简洁的ScrollViewer样式  -->
            <Style x:Key="SimpleScrollViewerStyle" TargetType="ScrollViewer">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="8" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ScrollContentPresenter
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="{TemplateBinding Padding}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />

                                <ScrollBar
                                    x:Name="PART_VerticalScrollBar"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Maximum="{TemplateBinding ScrollableHeight}"
                                    Orientation="Vertical"
                                    Style="{StaticResource SimpleScrollBarStyle}"
                                    ViewportSize="{TemplateBinding ViewportHeight}"
                                    Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                    Value="{TemplateBinding VerticalOffset}" />

                                <ScrollBar
                                    x:Name="PART_HorizontalScrollBar"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Maximum="{TemplateBinding ScrollableWidth}"
                                    Orientation="Horizontal"
                                    Style="{StaticResource SimpleScrollBarStyle}"
                                    ViewportSize="{TemplateBinding ViewportWidth}"
                                    Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                    Value="{TemplateBinding HorizontalOffset}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DialogButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#1c1c1c" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Width" Value="70" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Margin" Value="5" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#4F5C87" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#4F5C87" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题栏  -->
        <Border
            Grid.Row="0"
            Height="30"
            Background="#1c1c1c"
            MouseLeftButtonDown="DragWindow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="White"
                    Text="新增通道" />
                <Button
                    Grid.Column="1"
                    Width="30"
                    Height="30"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding CancelCommand}"
                    Content="✖"
                    FontSize="14"
                    Style="{StaticResource DialogButtonStyle}" />
            </Grid>
        </Border>

        <!--  内容区域  -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            Style="{StaticResource SimpleScrollViewerStyle}"
            VerticalScrollBarVisibility="Auto">
            <Grid Margin="20,10,20,10" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  通道类型  -->
                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock
                        Margin="0,0,0,5"
                        FontSize="14"
                        Text="通道类型：" />
                    <ComboBox
                        ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                        ItemsSource="{Binding AvailableChannelTypes}"
                        SelectedItem="{Binding SelectedChannelType}"
                        Style="{StaticResource CustomComboBoxStyle}" />
                </StackPanel>

                <!--  通道名称  -->
                <StackPanel Grid.Row="1" Margin="0,0,0,15">
                    <TextBlock
                        Margin="0,0,0,5"
                        FontSize="14"
                        Text="通道名称：" />
                    <Border
                        BorderBrush="#D9D9D9"
                        BorderThickness="1"
                        CornerRadius="3">
                        <TextBox
                            x:Name="ChannelNameTextBox"
                            Height="28"
                            Margin="5,0"
                            VerticalContentAlignment="Center"
                            BorderThickness="0"
                            FontSize="14"
                            KeyDown="ChannelNameTextBox_KeyDown"
                            Text="{Binding ChannelName, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>
                </StackPanel>

                <!--  所属板卡  -->
                <StackPanel Grid.Row="2" Margin="0,0,0,15">
                    <TextBlock
                        Margin="0,0,0,5"
                        FontSize="14"
                        Text="所属板卡：" />
                    <ComboBox
                        ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                        ItemsSource="{Binding AvailableCards}"
                        SelectedItem="{Binding SelectedCard}"
                        Style="{StaticResource CustomComboBoxStyle}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource CardNameDisplayConverter}">
                                            <Binding Path="CardName" />
                                            <Binding Path="Model" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!--  输入输出类型（关联节点）  -->
                <StackPanel
                    Grid.Row="3"
                    Margin="0,0,0,15"
                    Visibility="{Binding IsInputOutputTypeVisible, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='mode=bool;falsevalue=Hidden'}">
                    <TextBlock
                        Margin="0,0,0,5"
                        FontSize="14"
                        Text="关联节点：" />
                    <ComboBox
                        ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                        ItemsSource="{Binding AvailableInputOutputTypes}"
                        SelectedItem="{Binding SelectedInputOutputType}"
                        Style="{StaticResource CustomComboBoxStyle}" />
                </StackPanel>

                <!--  关联通道  -->
                <StackPanel Grid.Row="4" Margin="0,0,0,15">
                    <TextBlock
                        Margin="0,0,0,5"
                        FontSize="14"
                        Text="关联通道：" />
                    <ComboBox
                        ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                        ItemsSource="{Binding AvailableChannels}"
                        SelectedItem="{Binding SelectedAssociatedChannel}"
                        Style="{StaticResource CustomComboBoxStyle}" />
                </StackPanel>

                <!--  通道备注  -->
                <StackPanel Grid.Row="5" Margin="0,0,0,15">
                    <TextBlock
                        Margin="0,0,0,5"
                        FontSize="14"
                        Text="通道备注：" />
                    <Border
                        BorderBrush="#D9D9D9"
                        BorderThickness="1"
                        CornerRadius="3">
                        <TextBox
                            MinHeight="60"
                            Margin="5,5"
                            VerticalAlignment="Stretch"
                            AcceptsReturn="True"
                            BorderThickness="0"
                            FontSize="14"
                            Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!--  按钮区域  -->
        <Border
            Grid.Row="2"
            Background="#F0F0F0"
            BorderBrush="#E0E0E0"
            BorderThickness="0,1,0,0">
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Command="{Binding OkCommand}"
                    Content="确定"
                    FontSize="14"
                    IsDefault="True"
                    Style="{StaticResource DialogButtonStyle}" />
                <Button
                    Command="{Binding CancelCommand}"
                    Content="取消"
                    FontSize="14"
                    IsCancel="True"
                    Style="{StaticResource DialogButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

