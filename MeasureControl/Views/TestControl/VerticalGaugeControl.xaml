<UserControl
    x:Class="MeasureControl.Views.TestControl.VerticalGaugeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MeasureControl.Views.TestControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="220"
    d:DesignWidth="100"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  控件名称（上方显示）  -->
        <TextBlock
            x:Name="ControlNameText"
            Grid.Row="0"
            Margin="0,0,0,5"
            HorizontalAlignment="Center"
            FontSize="14"
            Foreground="Black"
            Text="竖形仪表" />

        <!--  仪表主体  -->
        <Grid
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  左侧刻度标签（使用Canvas精确定位，不遮挡仪表）  -->
            <Canvas
                x:Name="LabelsCanvas"
                Grid.Column="0"
                Width="35"
                Margin="0,0,5,0" />

            <!--  仪表主体（液位显示）  -->
            <Border
                x:Name="GaugeBody"
                Grid.Column="1"
                Width="30"
                MinHeight="150"
                Background="#e8ebed"
                BorderBrush="#d1d5db"
                BorderThickness="2"
                CornerRadius="4">
                <Grid>
                    <!--  液位填充（从底部向上）  -->
                    <Border
                        x:Name="LiquidFill"
                        Height="0"
                        VerticalAlignment="Bottom"
                        Background="#3b82f6"
                        CornerRadius="2,2,0,0" />

                    <!--  刻度线  -->
                    <Canvas x:Name="TickCanvas" />
                </Grid>
            </Border>
        </Grid>

        <!--  数值显示（下方显示）  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,5,0,0"
            HorizontalAlignment="Center"
            Orientation="Vertical">
            <TextBlock
                x:Name="ValueText"
                FontFamily="Consolas"
                FontSize="16"
                FontWeight="Bold"
                Foreground="Black"
                Text="0.00"
                TextAlignment="Center" />
            <TextBlock
                x:Name="UnitText"
                Margin="0,2,0,0"
                FontSize="12"
                Foreground="#666"
                Text=""
                TextAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
