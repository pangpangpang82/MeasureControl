<UserControl
    x:Class="MeasureControl.Views.TestControl.LabelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MeasureControl.Views.TestControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="32"
    d:DesignWidth="100"
    mc:Ignorable="d">
    <Border
        x:Name="MainBorder"
        MinWidth="60"
        MinHeight="28"
        Padding="8,4"
        Background="#e8ebed"
        BorderBrush="#d0d3d6"
        BorderThickness="1"
        CornerRadius="0"
        Cursor="IBeam"
        MouseLeftButtonDown="MainBorder_MouseLeftButtonDown">
        <Grid>
            <!--  显示模式  -->
            <StackPanel
                x:Name="DisplayPanel"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    x:Name="ValueText"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="20"
                    FontWeight="Medium"
                    Foreground="Black"
                    Text="0.00" />
                <TextBlock
                    x:Name="UnitText"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Foreground="Black"
                    Text="" />
            </StackPanel>
            <!--  编辑模式 (仅AO可用)  -->
            <TextBox
                x:Name="EditTextBox"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                FontFamily="Consolas"
                FontSize="20"
                FontWeight="Medium"
                Foreground="Black"
                KeyDown="EditTextBox_KeyDown"
                LostFocus="EditTextBox_LostFocus"
                Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
