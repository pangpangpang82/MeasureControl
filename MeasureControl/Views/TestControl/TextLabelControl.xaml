<UserControl
    x:Class="MeasureControl.Views.TestControl.TextLabelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MeasureControl.Views.TestControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="32"
    d:DesignWidth="100"
    mc:Ignorable="d">
    <!--  标签控件 - 纯文本，不绑定数据源  -->
    <Border
        x:Name="MainBorder"
        MinWidth="40"
        MinHeight="28"
        Padding="4,2"
        Background="Transparent">
        <TextBlock
            x:Name="LabelText"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            FontSize="20"
            Foreground="Black"
            Text="标签" />
    </Border>
</UserControl>
