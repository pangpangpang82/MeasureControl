<UserControl
    x:Class="MeasureControl.Views.TestControl.CircularGaugeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MeasureControl.Views.TestControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="200"
    d:DesignWidth="200"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  控件名称（上方显示）  -->
        <TextBlock
            x:Name="ControlNameText"
            Grid.Row="0"
            Margin="0,0,0,5"
            HorizontalAlignment="Center"
            FontSize="14"
            Foreground="Black"
            Text="环形仪表" />

        <!--  仪表主体（半圆形）  -->
        <Viewbox
            Grid.Row="1"
            Width="200"
            Height="150"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Stretch="Uniform">
            <Canvas
                x:Name="GaugeCanvas"
                Width="200"
                Height="150">

                <!--  半圆形仪表背景（灰色），开口向下  -->
                <!--  0值在9点钟（左侧），中间值在12点钟（顶部），最大值在3点钟（右侧）  -->
                <Path
                    x:Name="GaugeBackgroundArc"
                    Stroke="#e5e7eb"
                    StrokeEndLineCap="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="12">
                    <Path.Data>
                        <PathGeometry>
                            <!--  半圆：从180度（9点钟，左侧）顺时针到360度（3点钟，右侧），共180度  -->
                            <!--  中心点(100,120)，半径80  -->
                            <!--  180度：x=100+80*cos(180°)=20, y=120+80*sin(180°)=120  -->
                            <!--  360度：x=100+80*cos(0°)=180, y=120+80*sin(0°)=120  -->
                            <PathFigure StartPoint="20,120">
                                <ArcSegment
                                    IsLargeArc="False"
                                    Point="180,120"
                                    Size="80,80"
                                    SweepDirection="Clockwise" />
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>

                <!--  颜色分段弧形（绿色：0-20%，蓝灰色：20-80%，红色：80-100%）  -->
                <!--  由代码动态生成  -->

                <!--  刻度线和标签（11个等分刻度：0, MaxValue/10, 2*MaxValue/10, ..., MaxValue）  -->
                <!--  刻度线位置由代码动态生成  -->

                <!--  指针（起点在中心，终点在12点钟方向，旋转指示当前值）  -->
                <!--  中心点在(100,120)，指针指向12点钟方向(100,40)  -->
                <Line
                    x:Name="Needle"
                    Stroke="#fbbf24"
                    StrokeEndLineCap="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="3"
                    X1="100"
                    X2="100"
                    Y1="120"
                    Y2="40">
                    <Line.RenderTransform>
                        <RotateTransform x:Name="NeedleRotate" Angle="-90" CenterX="100" CenterY="120" />
                    </Line.RenderTransform>
                </Line>

                <!--  指针中心点  -->
                <Ellipse
                    Canvas.Left="95"
                    Canvas.Top="115"
                    Width="10"
                    Height="10"
                    Fill="#fbbf24"
                    Stroke="#fff"
                    StrokeThickness="1" />
            </Canvas>
        </Viewbox>

        <!--  数值显示（下方显示，靠近仪表区）  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,-5,0,0"
            HorizontalAlignment="Center"
            Orientation="Vertical">
            <TextBlock
                x:Name="ValueText"
                FontFamily="Consolas"
                FontSize="20"
                FontWeight="Bold"
                Foreground="#374151"
                Text="0.00"
                TextAlignment="Center" />
            <TextBlock
                x:Name="UnitText"
                Margin="0,2,0,0"
                FontSize="14"
                Foreground="#6b7280"
                Text=""
                TextAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
