<UserControl
    x:Class="MeasureControl.Views.TestControl.ButtonControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MeasureControl.Views.TestControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="40"
    d:DesignWidth="100"
    mc:Ignorable="d">
    <Button
        x:Name="MainButton"
        MinWidth="60"
        MinHeight="40"
        Padding="12,6"
        Background="#e8ebed"
        BorderBrush="#d0d3d6"
        BorderThickness="1"
        Click="MainButton_Click"
        Cursor="Hand">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border
                    x:Name="Border"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="0">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Border" Property="Background" Value="#d8dbde" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Border" Property="Background" Value="#c8cbce" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
        <TextBlock
            x:Name="ButtonText"
            FontSize="20"
            FontWeight="Medium"
            Foreground="Black"
            Text="按钮" />
    </Button>
</UserControl>
