<UserControl
    x:Class="MeasureControl.Views.TdmSystem.TDMSystem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:MeasureControl.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--  引入ComboBox样式  -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ComboBoxStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <helpers:EmptyStringToVisibilityConverter x:Key="EmptyToVisibility" />
            <Style TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#eaeaea" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#d0d0d0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <helpers:LevelToIndentConverter x:Key="LevelToIndentConverter" />
            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <helpers:BoolToExpansionIconConverter x:Key="BoolToExpansionIconConverter" />
            <helpers:StringToBrushConverter x:Key="StringToBrushConverter" />
            <helpers:ModelDisplayConverter x:Key="ModelDisplayConverter" />
            <helpers:DeviceTypeToBackgroundConverter x:Key="DeviceTypeToBackgroundConverter" />
            <helpers:DeviceTypeToHoverBackgroundConverter x:Key="DeviceTypeToHoverBackgroundConverter" />

            <!--  简洁的滚动条样式  -->
            <Style x:Key="SimpleScrollBarStyle" TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="8" />
                <Setter Property="MinWidth" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="Transparent" BorderThickness="0">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Style>
                                                <Style TargetType="Thumb">
                                                    <Setter Property="Background" Value="#CCCCCC" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderThickness="0"
                                                                    CornerRadius="4" />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#999999" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter Property="Background" Value="#666666" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Thumb.Style>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  简洁的ScrollViewer样式  -->
            <Style x:Key="SimpleScrollViewerStyle" TargetType="ScrollViewer">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="8" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ScrollContentPresenter
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="{TemplateBinding Padding}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />

                                <ScrollBar
                                    x:Name="PART_VerticalScrollBar"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Maximum="{TemplateBinding ScrollableHeight}"
                                    Orientation="Vertical"
                                    Style="{StaticResource SimpleScrollBarStyle}"
                                    ViewportSize="{TemplateBinding ViewportHeight}"
                                    Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                    Value="{TemplateBinding VerticalOffset}" />

                                <ScrollBar
                                    x:Name="PART_HorizontalScrollBar"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Maximum="{TemplateBinding ScrollableWidth}"
                                    Orientation="Horizontal"
                                    Style="{StaticResource SimpleScrollBarStyle}"
                                    ViewportSize="{TemplateBinding ViewportWidth}"
                                    Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                    Value="{TemplateBinding HorizontalOffset}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="White" MouseDown="ClearFocusOnOutsideClick">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3.6*" />
                <RowDefinition Height="95.4*" />
            </Grid.RowDefinitions>
            <Border
                x:Name="CenterRegion"
                Grid.Row="0"
                Background="#2d354d"
                Cursor="Hand"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border.Resources>
                    <!--  按钮样式定义在这里，这样浮动时也能保持样式  -->
                    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="Border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#3d455d" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#4d556d" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.5" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>
                <Grid>
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="White"
                        Text="远程接口" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Click="OnMinimizeButtonClick" Style="{StaticResource TitleBarButtonStyle}">
                            <Image
                                Width="30"
                                Margin="0,0,5,0"
                                Source="/Resources/Logo/min.png" />
                        </Button>
                        <Border Width="30" Margin="0,0,5,0">
                            <Button Click="OnFloatButtonClick" Style="{StaticResource TitleBarButtonStyle}">
                                <Image
                                    x:Name="FloatImage"
                                    Width="15"
                                    Source="/Resources/Logo/float.png" />
                            </Button>
                        </Border>
                        <Button Click="OnCloseButtonClick" Style="{StaticResource TitleBarButtonStyle}">
                            <Image Margin="0,0,5,0" Source="/Resources/Logo/close.png" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border
                                Grid.Row="0"
                                Margin="0,0,0,5"
                                BorderBrush="#D9D9D9"
                                BorderThickness="0,0,1.5,1.5">
                                <StackPanel
                                    Margin="30,15,0,0"
                                    HorizontalAlignment="Left"
                                    Orientation="Vertical">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Text="基础设置" />
                                    <TextBlock
                                        Margin="0,10,0,5"
                                        FontSize="13"
                                        Foreground="#636a77"
                                        Text="远程 IP" />
                                    <Border
                                        Width="300"
                                        Height="30"
                                        BorderBrush="#D9D9D9"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <TextBox
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            BorderThickness="0" />
                                    </Border>

                                    <TextBlock
                                        Margin="0,10,0,5"
                                        FontSize="13"
                                        Foreground="#636a77"
                                        Text="端口设置" />
                                    <Border
                                        Width="300"
                                        Height="30"
                                        BorderBrush="#D9D9D9"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <TextBox
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            BorderThickness="0" />
                                    </Border>

                                    <TextBlock
                                        Margin="0,10,0,5"
                                        FontSize="13"
                                        Foreground="#636a77"
                                        Text="通讯协议" />
                                    <ComboBox
                                        Width="300"
                                        Height="30"
                                        ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                                        Style="{StaticResource CustomComboBoxStyle}" />
                                    <TextBlock
                                        Margin="0,10,0,5"
                                        FontSize="13"
                                        Foreground="#636a77"
                                        Text="可访问区域" />
                                    <TextBlock
                                        Margin="20,5,0,5"
                                        FontSize="13"
                                        Foreground="#636a77"
                                        Text="项目文件 测试控制 反馈状态 结果文件" />
                                </StackPanel>
                            </Border>

                            <Border
                                Grid.Row="1"
                                Margin="0,5,0,0"
                                BorderBrush="#D9D9D9"
                                BorderThickness="0,1.5,1.5,0">
                                <StackPanel
                                    Margin="30,15,0,0"
                                    HorizontalAlignment="Left"
                                    Orientation="Vertical">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Text="触发设置" />
                                    <TextBlock
                                        Margin="0,10,0,5"
                                        FontSize="13"
                                        Foreground="#636a77"
                                        Text="触发条件" />
                                    <ComboBox
                                        Width="300"
                                        Height="30"
                                        ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                                        Style="{StaticResource CustomComboBoxStyle}" />
                                    <TextBlock
                                        Margin="0,10,0,5"
                                        FontSize="13"
                                        Foreground="#636a77"
                                        Text="触发频率" />
                                    <Border
                                        Width="300"
                                        Height="30"
                                        BorderBrush="#D9D9D9"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <TextBox
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            BorderThickness="0" />
                                    </Border>
                                    <TextBlock
                                        Margin="0,10,0,5"
                                        FontSize="13"
                                        Foreground="#636a77"
                                        Text="触发对象" />
                                    <TextBlock
                                        Margin="20,5,0,5"
                                        FontSize="13"
                                        Foreground="#636a77"
                                        Text="所有文件 指定目录 特定文件类型" />

                                    <TextBlock
                                        Margin="0,10,0,5"
                                        FontSize="13"
                                        Foreground="#636a77"
                                        Text="触发动作" />
                                    <ComboBox
                                        Width="300"
                                        Height="30"
                                        ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                                        Style="{StaticResource CustomComboBoxStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Margin="15,0,0,0"
                        BorderBrush="#D9D9D9"
                        BorderThickness="1.5,0,0,0">
                        <StackPanel
                            Margin="30,15,0,0"
                            HorizontalAlignment="Left"
                            Orientation="Vertical">
                            <TextBlock
                                FontSize="14"
                                FontWeight="Bold"
                                Text="手动上传" />

                            <Grid Width="300" Margin="0,10,0,5">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="#636a77"
                                    Text="文件操作" />
                                <Border HorizontalAlignment="Right">
                                    <Button
                                        Width="80"
                                        Height="30"
                                        VerticalAlignment="Center"
                                        Background="#f3f4f6">
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <Image
                                                    Width="10"
                                                    Height="10"
                                                    Margin="5,0,5,0"
                                                    Source="/Resources/Logo/add_b.png" />
                                                <TextBlock Margin="0,0,5,0" Text="选择文件" />
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>
                                </Border>
                            </Grid>

                            <Border
                                Width="300"
                                Height="120"
                                Margin="0,5,0,0"
                                BorderBrush="#D9D9D9"
                                BorderThickness="1.5"
                                CornerRadius="3" />

                            <Grid Width="300" Margin="0,20,0,10">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="#636a77"
                                    Text="上传控制" />
                                <Border HorizontalAlignment="Right">
                                    <Button
                                        Width="80"
                                        Height="30"
                                        VerticalAlignment="Center"
                                        Background="#3b82f6">
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <Image
                                                    Width="10"
                                                    Height="10"
                                                    Margin="5,0,5,0"
                                                    Source="/Resources/Logo/upload.png" />
                                                <TextBlock
                                                    Margin="0,0,5,0"
                                                    Foreground="White"
                                                    Text="开始上传" />
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>
                                </Border>
                            </Grid>

                            <StackPanel Orientation="Vertical">
                                <TextBlock
                                    Margin="0,0,0,5"
                                    FontSize="10"
                                    Foreground="#636a77"
                                    Text="上传进度：100%" />

                                <ProgressBar
                                    Height="5"
                                    Maximum="100"
                                    Value="75">
                                    <ProgressBar.Resources>
                                        <Style TargetType="ProgressBar">
                                            <Setter Property="Background" Value="#EFEFEF" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ProgressBar">
                                                        <Grid x:Name="Root">
                                                            <Border
                                                                x:Name="PART_Track"
                                                                Background="{TemplateBinding Background}"
                                                                CornerRadius="2" />
                                                            <Border
                                                                x:Name="PART_Indicator"
                                                                HorizontalAlignment="Left"
                                                                Background="#2CD96C"
                                                                CornerRadius="2" />
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ProgressBar.Resources>
                                </ProgressBar>
                            </StackPanel>

                            <StackPanel Margin="0,20,0,5">
                                <TextBlock
                                    Margin="0,0,0,10"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="#636a77"
                                    Text="上传设置" />
                                <TextBlock
                                    Margin="10,0,0,10"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="#636a77"
                                    Text="上传目标" />
                                <ComboBox
                                    Width="300"
                                    Height="30"
                                    ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                                    Style="{StaticResource CustomComboBoxStyle}" />

                                <TextBlock
                                    Margin="0,15,0,10"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="#636a77"
                                    Text="上传模式" />
                                <Border Margin="10,0,0,0" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Vertical">
                                        <Button
                                            Margin="0,0,0,10"
                                            Content="覆盖模式"
                                            Foreground="#636a77" />
                                        <Button Content="追加模式" Foreground="#636a77" />
                                    </StackPanel>
                                </Border>
                                <TextBlock
                                    Margin="0,20,0,10"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="#636a77"
                                    Text="附加信息" />
                                <Border
                                    Width="300"
                                    Height="55"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="1.5"
                                    CornerRadius="3">
                                    <Grid>
                                        <TextBox
                                            x:Name="AdditionalInfoTextBox"
                                            BorderThickness="0"
                                            Foreground="#636a77"
                                            TextChanged="TextBox_TextChanged" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Foreground="#D9D9D9"
                                            IsHitTestVisible="False"
                                            Text="请输入文件描述或其他备注信息"
                                            Visibility="{Binding Text, ElementName=AdditionalInfoTextBox, Converter={StaticResource EmptyToVisibility}}" />
                                    </Grid>
                                </Border>

                            </StackPanel>


                        </StackPanel>
                    </Border>


                    <Border Grid.Column="2">
                        <StackPanel
                            Margin="30,20,0,0"
                            HorizontalAlignment="Left"
                            Orientation="Vertical">
                            <TextBlock
                                FontSize="14"
                                FontWeight="Bold"
                                Text="上传历史" />
                            <Border
                                Width="300"
                                Height="500"
                                Margin="0,20,0,0"
                                BorderBrush="#D9D9D9"
                                BorderThickness="1.5"
                                CornerRadius="3" />
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>